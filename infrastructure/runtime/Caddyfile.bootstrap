{
	# Error logs also contain requests; do not retain OAuth queries or headers.
	log default {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
			}
		}
	}
	admin localhost:2019
}

# Optional reviewed web site; absent until separately deployed.
import /etc/caddy/sites/*.caddy

api.qa.rogi.chat {
	# No access log until a reviewed redaction policy is installed.
	# This is host readiness, explicitly not the future NestJS health endpoint.
	@hostkey path /_infra/ssh-host-key
	handle @hostkey {
		header Cache-Control "no-store"
		root * /srv/host-keys
		rewrite * /ssh_host_ed25519_key.pub
		file_server
	}
	@infra path /_infra/health
	handle @infra {
		respond "rogichat QA edge ready" 200
	}
	handle {
		header Retry-After "300"
		respond "로기챗 QA를 준비하고 있습니다." 503
	}
}
