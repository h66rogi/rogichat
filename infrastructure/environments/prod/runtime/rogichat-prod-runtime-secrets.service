[Unit]
Description=Deliver production application database credential to tmpfs
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/rogichat/operations/fetch_production_runtime_secret.py
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/rogichat-prod
RuntimeDirectory=rogichat-prod
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart

[Install]
WantedBy=multi-user.target
