{
  "name": "rogichat",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=24.21.0 <25" },
  "scripts": {
    "build": "pnpm --filter @rogichat/api build",
    "lint": "pnpm --filter @rogichat/api lint",
    "typecheck": "pnpm --filter @rogichat/api typecheck",
    "test:unit": "pnpm --filter @rogichat/api test:unit",
    "test:integration": "pnpm --filter @rogichat/api test:integration",
    "test:e2e": "pnpm --filter @rogichat/api test:e2e",
    "contracts:check": "pnpm --filter @rogichat/api contracts:check",
    "web:lint": "pnpm --filter @rogichat/web lint",
    "web:typecheck": "pnpm --filter @rogichat/web typecheck",
    "web:build": "pnpm --filter @rogichat/web build",
    "web:test:unit": "pnpm --filter @rogichat/web test:unit",
    "web:test": "pnpm --filter @rogichat/web test",
    "web:check": "pnpm --filter @rogichat/web check"
  }
}
