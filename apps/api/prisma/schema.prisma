generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETING
  DELETED
}

enum LinkStatus {
  VERIFIED
  REVOKED
}

enum RoomMode {
  FAN
  GROUP
}

enum RoomStatus {
  ACTIVE
  CLOSED
}

enum MemberRole {
  FAN
  STREAMER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  LEFT
  BANNED
}

enum HistoryPolicy {
  ALL_AVAILABLE
  SINCE_JOIN
}

enum JoinPolicy {
  OPEN_AUTHENTICATED
  INVITE_ONLY
  APPROVAL
  PASSWORD
}

enum StreamKind {
  ROOM_SHARED
  RESTRICTED
}

enum LoginStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum SessionTransport {
  WEB
  NATIVE
}

enum JobPurpose {
  REALTIME_HINT
  MEDIA
  PUBLICATION
  PURGE
  PUSH
  LEDGER_EXPORT
}

enum JobState {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum DeletionState {
  BLOCKED
  PURGING
  LIVE_PURGED
  BACKUPS_EXPIRED
}

enum PublicationState {
  PREPARING
  PUBLISHED
  REVOKED
}

model users {
  id                    String     @id @db.Char(36)
  status                UserStatus @default(ACTIVE)
  membership_generation BigInt     @default(0) @db.UnsignedBigInt
  terms_version         String?    @db.VarChar(32)
  created_at            DateTime   @default(now()) @db.DateTime(3)
  profile               user_profiles?
  soop                  platform_soop?
  identities            auth_identities[]
  sessions              auth_sessions[]
  members               room_members[]
  creator               creator_accounts?
  admin                 admin_capabilities?
  owned_messages        messages[]
  deletions             deletion_requests[]
  media                 media_assets[]
  media_usage           media_daily_usage[]
  registered_stickers   sticker_catalog[] @relation("sticker_registrar")
  approved_stickers     sticker_catalog[] @relation("sticker_approver")
  sticker_audit         sticker_audit_events[]
}

model user_profiles {
  user_id                       String  @id @db.Char(36)
  nickname                      String  @db.VarChar(40)
  birthday_month                Int?    @db.UnsignedTinyInt
  birthday_day                  Int?    @db.UnsignedTinyInt
  birthday_visible_to_streamers Boolean @default(false)
  revision                      BigInt  @default(1) @db.UnsignedBigInt
  avatar_asset_id               String? @unique @db.Char(36)
  avatar                        media_assets? @relation(fields: [avatar_asset_id], references: [id], onDelete: Restrict)
  user                          users   @relation(fields: [user_id], references: [id], onDelete: Restrict)
}

model platform_soop {
  id               String     @id @db.Char(36)
  user_id          String     @unique @db.Char(36)
  provider_subject Bytes      @unique @db.VarBinary(191)
  status           LinkStatus @default(VERIFIED)
  verified_at      DateTime   @db.DateTime(3)
  user             users      @relation(fields: [user_id], references: [id], onDelete: Restrict)
}

model auth_identities {
  id         String     @id @db.Char(36)
  user_id    String     @db.Char(36)
  provider   String     @db.VarChar(16)
  issuer     Bytes      @db.VarBinary(191)
  subject    Bytes      @db.VarBinary(191)
  status     LinkStatus @default(VERIFIED)
  user       users      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  @@unique([provider, issuer, subject])
}

model auth_sessions {
  id           String    @id @db.Char(36)
  user_id      String    @db.Char(36)
  token_digest Bytes     @unique @db.Binary(32)
  csrf_digest  Bytes     @db.Binary(32)
  audience     String    @db.VarChar(32)
  transport    SessionTransport @default(WEB)
  client_id    String?   @db.VarChar(32)
  created_at   DateTime  @default(now()) @db.DateTime(3)
  expires_at   DateTime  @db.DateTime(3)
  revoked_at   DateTime? @db.DateTime(3)
  user         users     @relation(fields: [user_id], references: [id], onDelete: Restrict)
  @@index([user_id, revoked_at])
  @@index([expires_at])
}

model login_transactions {
  id             String      @id @db.Char(36)
  state_digest   Bytes       @unique @db.Binary(32)
  browser_digest Bytes       @db.Binary(32)
  verifier       Bytes       @db.VarBinary(128)
  intent         String      @db.VarChar(16)
  terms_version  String?     @db.VarChar(32)
  audience       String      @db.VarChar(32)
  user_id        String?     @db.Char(36)
  session_id     String?     @db.Char(36)
  status         LoginStatus @default(PENDING)
  expires_at     DateTime    @db.DateTime(3)
  @@index([expires_at])
}

model creator_accounts {
  user_id String  @id @db.Char(36)
  enabled Boolean @default(false)
  user    users   @relation(fields: [user_id], references: [id], onDelete: Restrict)
}

model admin_capabilities {
  user_id      String  @id @db.Char(36)
  manage_rooms Boolean @default(false)
  manage_users Boolean @default(false)
  manage_stickers Boolean @default(false)
  user         users   @relation(fields: [user_id], references: [id], onDelete: Restrict)
}

model rooms {
  id              String       @id @db.Char(36)
  name            String       @db.VarChar(80)
  mode            RoomMode
  status          RoomStatus   @default(ACTIVE)
  policy_version  Int          @default(1) @db.UnsignedInt
  history_policy  HistoryPolicy @default(SINCE_JOIN)
  join_policy     JoinPolicy   @default(OPEN_AUTHENTICATED)
  owner_member_id String?      @db.Char(36)
  created_at      DateTime     @default(now()) @db.DateTime(3)
  owner           room_members? @relation("room_owner", fields: [id, owner_member_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  members         room_members[] @relation("room_members")
  counter         room_counters?
  streams         message_streams[]
  jobs            jobs[]
  media           media_assets[]
  media_policy    room_media_policy?
}

model room_counters {
  room_id    String @id @db.Char(36)
  last_order BigInt @default(0) @db.UnsignedBigInt
  room       rooms  @relation(fields: [room_id], references: [id], onDelete: Restrict)
}

model room_members {
  id               String       @id @db.Char(36)
  room_id          String       @db.Char(36)
  user_id          String       @db.Char(36)
  role             MemberRole
  status           MemberStatus @default(ACTIVE)
  active_period_id String?      @unique @db.Char(36)
  acl_epoch        BigInt       @default(0) @db.UnsignedBigInt
  room             rooms        @relation("room_members", fields: [room_id], references: [id], onDelete: Restrict)
  user             users        @relation(fields: [user_id], references: [id], onDelete: Restrict)
  owns             rooms[]      @relation("room_owner")
  periods          membership_periods[] @relation("period_member")
  active_period    membership_periods? @relation("active_period", fields: [room_id, id, active_period_id], references: [room_id, member_id, id], onDelete: Restrict, onUpdate: Restrict)
  grants           stream_grants[]
  messages         messages[]
  receipts         command_receipts[]
  pairs_left       stream_pairs[] @relation("pair_left")
  pairs_right      stream_pairs[] @relation("pair_right")
  publications     message_publications[]
  reactions        message_reactions[]
  @@unique([room_id, id, active_period_id])
  @@unique([room_id, user_id])
  @@unique([room_id, id])
}

// Body-free projection invalidation. A REALTIME_HINT with room_id NULL references this table.
model profile_changes {
  id               String @id @db.Char(36)
  user_id          String @db.Char(36)
  public_changed   Boolean
  streamer_changed Boolean
  created_at       DateTime @default(now()) @db.DateTime(3)
  @@index([user_id, created_at])
}

model membership_periods {
  id                 String        @id @db.Char(36)
  room_id            String        @db.Char(36)
  member_id          String        @db.Char(36)
  policy_version     Int           @db.UnsignedInt
  history_policy     HistoryPolicy
  visible_from_order BigInt        @db.UnsignedBigInt
  joined_at          DateTime      @default(now()) @db.DateTime(3)
  left_at            DateTime?     @db.DateTime(3)
  member             room_members  @relation("period_member", fields: [room_id, member_id], references: [room_id, id], onDelete: Restrict)
  active_for         room_members? @relation("active_period")
  @@unique([room_id, member_id, id])
}

model message_streams {
  id      String     @id @db.Char(36)
  room_id String     @db.Char(36)
  kind    StreamKind
  room    rooms      @relation(fields: [room_id], references: [id], onDelete: Restrict)
  grants  stream_grants[]
  messages messages[]
  pair     stream_pairs?
  @@unique([room_id, id])
}

model stream_grants {
  id            String       @id @db.Char(36)
  room_id       String       @db.Char(36)
  stream_id     String       @db.Char(36)
  member_id     String       @db.Char(36)
  can_read      Boolean      @default(false)
  can_send      Boolean      @default(false)
  valid_from    DateTime     @default(now()) @db.DateTime(3)
  expires_at    DateTime?    @db.DateTime(3)
  revoked_at    DateTime?    @db.DateTime(3)
  stream        message_streams @relation(fields: [room_id, stream_id], references: [room_id, id], onDelete: Restrict)
  member        room_members @relation(fields: [room_id, member_id], references: [room_id, id], onDelete: Restrict)
  @@unique([stream_id, member_id])
}

model rate_buckets {
  key_digest Bytes    @id @db.Binary(32)
  used       Int      @db.UnsignedInt
  expires_at DateTime @db.DateTime(3)
  @@index([expires_at])
}

// Operational action references are intentionally retained after future account deletion.
// No profile/message/credential payloads or identity-provider subjects belong here.
model audit_events {
  id            String   @id @db.Char(36)
  actor_user_id String   @db.Char(36)
  room_id       String   @db.Char(36)
  action        String   @db.VarChar(32)
  created_at    DateTime @default(now()) @db.DateTime(3)
  @@index([room_id, created_at])
}

model stream_pairs {
  id              String @id @db.Char(36)
  room_id         String @db.Char(36)
  left_member_id  String @db.Char(36)
  right_member_id String @db.Char(36)
  stream_id       String @unique @db.Char(36)
  left            room_members @relation("pair_left", fields: [room_id, left_member_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  right           room_members @relation("pair_right", fields: [room_id, right_member_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  stream          message_streams @relation(fields: [room_id, stream_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([room_id, left_member_id, right_member_id])
  @@unique([room_id, stream_id])
}

model messages {
  id                    String @id @db.Char(36)
  room_id               String @db.Char(36)
  stream_id             String @db.Char(36)
  sender_member_id      String @db.Char(36)
  content_owner_user_id String @db.Char(36)
  deletion_root_id      String? @db.Char(36)
  quote_id              String? @db.Char(36)
  content_kind          String @default("TEXT") @db.VarChar(16)
  text_content          String? @db.Text
  version               BigInt @default(1) @db.UnsignedBigInt
  content_revision      BigInt @default(1) @db.UnsignedBigInt
  created_order         BigInt @db.UnsignedBigInt
  created_at            DateTime @default(now()) @db.DateTime(3)
  deleted_at            DateTime? @db.DateTime(3)
  moderated             Boolean @default(false)
  stream                message_streams @relation(fields: [room_id, stream_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  sender                room_members @relation(fields: [room_id, sender_member_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  content_owner         users @relation(fields: [content_owner_user_id], references: [id], onDelete: Restrict)
  deletion_root         messages? @relation("deletion_root", fields: [room_id, deletion_root_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  publications          messages[] @relation("deletion_root")
  quote                 messages? @relation("quote", fields: [room_id, quote_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  quoted_by             messages[] @relation("quote")
  events                room_events[]
  publication_requests  message_publications[] @relation("publication_source")
  published_as          message_publications[] @relation("publication_result")
  reactions             message_reactions[]
  receipts              command_receipts[]
  deletion_requests     deletion_requests[]
  attachments           message_attachments[]
  sticker               message_stickers?
  @@unique([room_id, id])
  @@unique([room_id, stream_id, id])
  @@index([room_id, stream_id, created_order])
  @@index([room_id, created_order])
  @@index([content_owner_user_id, deleted_at])
}

model message_publications {
  id                    String @id @db.Char(36)
  room_id               String @db.Char(36)
  source_message_id     String @db.Char(36)
  source_version        BigInt @db.UnsignedBigInt
  publisher_member_id   String @db.Char(36)
  published_message_id  String? @db.Char(36)
  state                 PublicationState @default(PREPARING)
  created_at            DateTime @default(now()) @db.DateTime(3)
  source                messages @relation("publication_source", fields: [room_id, source_message_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  result                messages? @relation("publication_result", fields: [room_id, published_message_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  publisher             room_members @relation(fields: [room_id, publisher_member_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  media                 publication_media[]
  @@unique([room_id, source_message_id, source_version])
  @@unique([room_id, id])
}

// Storage reservation includes input, every derived object and in-flight attempts.
model media_budget {
  id             String @id @db.VarChar(16)
  reserved_bytes BigInt @default(0) @db.UnsignedBigInt
  limit_bytes    BigInt @default(10737418240) @db.UnsignedBigInt
}

model media_daily_usage {
  user_id     String @db.Char(36)
  day         DateTime @db.Date
  input_bytes BigInt @default(0) @db.UnsignedBigInt
  user        users @relation(fields: [user_id], references: [id], onDelete: Restrict)
  @@id([user_id, day])
}

model media_assets {
  id                 String @id @db.Char(36)
  owner_user_id      String @db.Char(36)
  room_id            String? @db.Char(36)
  kind               String @db.VarChar(16)
  content_type       String @db.VarChar(64)
  state              String @default("RESERVED") @db.VarChar(16)
  declared_bytes     BigInt @db.UnsignedBigInt
  reserved_bytes     BigInt @db.UnsignedBigInt
  upload_token       String? @db.Char(36)
  upload_until       DateTime? @db.DateTime(3)
  expires_at         DateTime @db.DateTime(3)
  created_at         DateTime @default(now()) @db.DateTime(3)
  deleted_at         DateTime? @db.DateTime(3)
  owner              users @relation(fields: [owner_user_id], references: [id], onDelete: Restrict)
  room               rooms? @relation(fields: [room_id], references: [id], onDelete: Restrict)
  objects            media_objects[]
  attachments        message_attachments[]
  avatar_profile     user_profiles?
  catalog_entry      sticker_catalog?
  publication_sources publication_media[] @relation("publication_media_source")
  publication_copy    publication_media? @relation("publication_media_destination")
  @@unique([room_id, id])
  @@index([owner_user_id, state, expires_at])
  @@index([state, upload_until])
}

model media_objects {
  id          String @id @db.Char(36)
  asset_id    String @db.Char(36)
  attempt_id  String @db.Char(36)
  variant     String @db.VarChar(16)
  object_key  String @unique @db.VarChar(191)
  state       String @default("ALLOCATED") @db.VarChar(16)
  byte_length BigInt? @db.UnsignedBigInt
  sha256      String? @db.Char(64)
  width       Int? @db.UnsignedInt
  height      Int? @db.UnsignedInt
  duration_ms Int? @db.UnsignedInt
  created_at  DateTime @default(now()) @db.DateTime(3)
  asset       media_assets @relation(fields: [asset_id], references: [id], onDelete: Restrict)
  publication_sources publication_media[]
  @@unique([asset_id, id])
  @@unique([asset_id, attempt_id, variant])
}

model message_attachments {
  id         String @id @db.Char(36)
  room_id    String @db.Char(36)
  message_id String @db.Char(36)
  asset_id   String @db.Char(36)
  position   Int @db.UnsignedTinyInt
  message    messages @relation(fields: [room_id, message_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  asset      media_assets @relation(fields: [room_id, asset_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([room_id, message_id, position])
  @@index([asset_id])
}

model room_media_policy {
  room_id       String @id @db.Char(36)
  photo_enabled Boolean @default(true)
  video_enabled Boolean @default(true)
  sticker_enabled Boolean @default(true)
  photo_max_bytes Int @default(10485760) @db.UnsignedInt
  video_max_bytes Int @default(52428800) @db.UnsignedInt
  room          rooms @relation(fields: [room_id], references: [id], onDelete: Restrict)
}

// Curated static stickers are reusable service assets, not user message uploads.
// DRAFT expires normally; approved catalog references survive registrar account deletion.
model sticker_catalog {
  id                    String @id @db.Char(36)
  asset_id              String @unique @db.Char(36)
  status                String @default("DRAFT") @db.VarChar(16)
  label                 String @db.VarChar(64)
  registered_by_user_id String @db.Char(36)
  approved_by_user_id   String? @db.Char(36)
  approved_at           DateTime? @db.DateTime(3)
  created_at            DateTime @default(now()) @db.DateTime(3)
  asset                 media_assets @relation(fields: [asset_id], references: [id], onDelete: Restrict)
  registrar             users @relation("sticker_registrar", fields: [registered_by_user_id], references: [id], onDelete: Restrict)
  approver              users? @relation("sticker_approver", fields: [approved_by_user_id], references: [id], onDelete: Restrict)
  messages              message_stickers[]
  audit                 sticker_audit_events[]
  @@index([status, id])
}

// Separate from room-owned PHOTO/VIDEO attachments: never weaken their scoped FK.
model message_stickers {
  room_id    String @db.Char(36)
  message_id String @db.Char(36)
  sticker_id String @db.Char(36)
  message    messages @relation(fields: [room_id, message_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  sticker    sticker_catalog @relation(fields: [sticker_id], references: [id], onDelete: Restrict)
  @@id([room_id, message_id])
}

// Global catalog operations cannot use room-scoped audit_events or invent a room identifier.
model sticker_audit_events {
  id            String @id @db.Char(36)
  sticker_id    String @db.Char(36)
  actor_user_id String @db.Char(36)
  action        String @db.VarChar(32)
  created_at    DateTime @default(now()) @db.DateTime(3)
  sticker       sticker_catalog @relation(fields: [sticker_id], references: [id], onDelete: Restrict)
  actor         users @relation(fields: [actor_user_id], references: [id], onDelete: Restrict)
  @@index([sticker_id, created_at])
}

// Durable provenance exists BEFORE any external copy, including before a public message exists.
model publication_media {
  id                   String @id @db.Char(36)
  room_id              String @db.Char(36)
  publication_id       String @db.Char(36)
  position             Int @db.UnsignedTinyInt
  source_asset_id      String @db.Char(36)
  source_object_id     String @db.Char(36)
  destination_asset_id String @unique @db.Char(36)
  created_at           DateTime @default(now()) @db.DateTime(3)
  publication          message_publications @relation(fields: [room_id, publication_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  source               media_assets @relation("publication_media_source", fields: [room_id, source_asset_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  source_object        media_objects @relation(fields: [source_asset_id, source_object_id], references: [asset_id, id], onDelete: Restrict, onUpdate: Restrict)
  destination          media_assets @relation("publication_media_destination", fields: [room_id, destination_asset_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([publication_id, position])
  @@unique([room_id, destination_asset_id])
}

model message_reactions {
  id          String @id @db.Char(36)
  room_id     String @db.Char(36)
  message_id  String @db.Char(36)
  member_id   String @db.Char(36)
  emoji       String @db.VarChar(64)
  created_at  DateTime @default(now()) @db.DateTime(3)
  message     messages @relation(fields: [room_id, message_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  member      room_members @relation(fields: [room_id, member_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([room_id, message_id, member_id])
}

model command_receipts {
  id                String @id @db.Char(36)
  room_id           String @db.Char(36)
  actor_id          String @db.Char(36)
  client_message_id String @db.Char(36)
  message_id        String @db.Char(36)
  digest_version    Int @default(1) @db.UnsignedTinyInt
  payload_digest    Bytes? @db.Binary(32)
  deleted           Boolean @default(false)
  created_at        DateTime @default(now()) @db.DateTime(3)
  actor             room_members @relation(fields: [room_id, actor_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  message           messages @relation(fields: [room_id, message_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([room_id, actor_id, client_message_id])
}

model room_events {
  id              String @id @db.Char(36)
  room_id         String @db.Char(36)
  stream_id       String @db.Char(36)
  message_id      String @db.Char(36)
  message_version BigInt @db.UnsignedBigInt
  event_order     BigInt @db.UnsignedBigInt
  kind            String @db.VarChar(32)
  created_at      DateTime @default(now()) @db.DateTime(3)
  message         messages @relation(fields: [room_id, stream_id, message_id], references: [room_id, stream_id, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([room_id, event_order])
  @@index([room_id, stream_id, event_order])
}

model deletion_requests {
  id            String @id @db.Char(36)
  actor_user_id String @db.Char(36)
  room_id       String @db.Char(36)
  message_id    String @db.Char(36)
  state         DeletionState @default(BLOCKED)
  requested_at  DateTime @default(now()) @db.DateTime(3)
  actor         users @relation(fields: [actor_user_id], references: [id], onDelete: Restrict)
  message       messages @relation(fields: [room_id, message_id], references: [room_id, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([actor_user_id, message_id])
}

// No body/token/URL payload: consumers resolve an authorized current resource.
model jobs {
  id              String @id @db.Char(36)
  purpose         JobPurpose
  room_id         String? @db.Char(36)
  resource_id     String? @db.Char(36)
  state           JobState @default(PENDING)
  generation      BigInt @default(0) @db.UnsignedBigInt
  lease_owner     String? @db.Char(36)
  lease_token     String? @db.Char(36)
  lease_until     DateTime? @db.DateTime(3)
  available_at    DateTime @default(now()) @db.DateTime(3)
  attempts        Int @default(0) @db.UnsignedInt
  max_attempts    Int @default(5) @db.UnsignedInt
  last_error_code String? @db.VarChar(32)
  dedupe_key      Bytes? @db.Binary(32)
  created_at      DateTime @default(now()) @db.DateTime(3)
  room            rooms? @relation(fields: [room_id], references: [id], onDelete: Restrict)
  @@unique([purpose, dedupe_key])
  @@index([purpose, state, available_at, id])
  @@index([purpose, state, lease_until, id])
}
