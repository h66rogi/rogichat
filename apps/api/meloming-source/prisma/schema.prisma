/// 콘텐츠 행위자 identity.
/// 역사적으로 "Organizer" 로 명명됐지만, 실제 역할은 SOOP/CHZZK/CIME 외부 채널
/// identity 를 멜로밍 Channel 에 느슨하게 연결하는 것이다. 그래서 콘텐츠 주최자뿐 아니라
/// 향후 ContentParticipation 의 참가자 identity 도 이 모델을 재사용한다.
/// 설계 결정: docs/decisions/2026-05-25-content-participation-organizer-identity.md
///
/// 주의: ETC identity 는 username 기반이라 동명이인 병합 위험이 있다. 참여자 매핑에서
/// 강한 정체성이 필요하면 SOOP/CHZZK/CIME 채널 URL 기반 Organizer 를 우선 사용하고,
/// 수동 입력 참가자는 참여 레코드에 표시 스냅샷을 별도로 남긴다.
model Organizer {
  id              Int           @id @default(autoincrement())
  type            OrganizerType @default(ETC)
  // 정체성(identity) 단일 키. 채널 기반="SOOP:{soopChannelId}"/"CHZZK:{chzzkChannelId}"/"CIME:{cimeChannelId}",
  // 채널 없는 ETC="ETC:{normalized(username)}". username 은 표시명일 뿐 정체성이 아니므로 @unique 를 두지 않는다
  // (동명의 다른 채널/주최자 공존 허용). create 는 이 키 기준 upsert 로 멱등 처리한다.
  identityKey     String        @unique @map("identity_key") @db.VarChar(255)
  username        String
  soopChannelId   String?       @unique @map("soop_channel_id")
  chzzkChannelId  String?       @unique @map("chzzk_channel_id")
  cimeChannelId   String?       @unique @map("cime_channel_id")
  profileImageUrl String?       @map("profile_image_url") @db.VarChar(500)
  soopGrade       SoopGrade?    @map("soop_grade")
  chzzkGrade      ChzzkGrade?   @map("chzzk_grade")
  // meloming 채널 연결 캐시 (nullable). null=orphan(미연결). 채널 플랫폼 인증 APPROVED 시
  // identityKey 매칭으로 세팅. 본질 매칭 키는 identityKey, channelId 는 연결 상태 캐시일 뿐.
  channelId       Int?          @map("channel_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.DateTime(0)

  channel                          Channel?               @relation("ChannelOrganizers", fields: [channelId], references: [id], onDelete: SetNull)
  contents                         Content[]
  // 향후 콘텐츠 참여 기록은 participantOrganizerId 로 이 모델을 참조한다.
  // 이 관계는 "주최자" 라는 이름이 아니라 "외부 채널 identity" 의미로 해석해야 한다.
  hostedContentParticipations      ContentParticipation[] @relation("ContentParticipationHostOrganizer")
  participantContentParticipations ContentParticipation[] @relation("ContentParticipationParticipantOrganizer")

  @@index([type], map: "idx_organizers_type")
  @@index([channelId], map: "idx_organizers_channel_id")
  @@map("organizers")
}

