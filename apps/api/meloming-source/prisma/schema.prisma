  mode        HaejuseyoProductMode   @default(DIRECT)
  contentKind HaejuseyoContentKind   @map("content_kind")
  status      HaejuseyoProductStatus @default(DRAFT)

  catalogProductTypeCode String?                      @map("catalog_product_type_code") @db.VarChar(80)
  catalogProductType     HaejuseyoCatalogProductType? @relation("HaejuseyoProductCatalogType", fields: [catalogProductTypeCode], references: [code], onDelete: SetNull, map: "haejuseyo_products_catalog_type_fk")

  title       String  @db.VarChar(120)
  description String? @db.Text

  baseContentAmount Int @map("base_content_amount")
  deliveryDays      Int @default(7) @map("delivery_days")

  coverImageUrl String? @map("cover_image_url") @db.VarChar(500)
  cardImageUrl  String? @map("card_image_url") @db.VarChar(500)

  assetRequirements Json? @map("asset_requirements")
  creatorConfig     Json? @map("creator_config")

  physicalOptions HaejuseyoProductPhysicalOption[]
  orders          HaejuseyoOrder[]
  goalRequests    HaejuseyoGoalRequest[]

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([channelId, status], map: "idx_haejuseyo_products_channel_status")
  @@index([contentKind, status], map: "idx_haejuseyo_products_kind_status")
  @@index([catalogProductTypeCode], map: "idx_haejuseyo_products_catalog_type")
  @@map("haejuseyo_products")
}

model HaejuseyoProductPhysicalOption {
  id        Int              @id @default(autoincrement())
  productId Int              @map("product_id")
  product   HaejuseyoProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  optionCode       String                @map("option_code") @db.VarChar(64)
  isEnabled        Boolean               @default(true) @map("is_enabled")
