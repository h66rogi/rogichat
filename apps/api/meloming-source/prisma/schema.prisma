// Platform Verification domain
// ===================================

/// 사용자 플랫폼 인증 정보 (유저-플랫폼 매칭)
model UserPlatformVerification {
  id                 Int            @id @default(autoincrement())
  userId             Int            @map("user_id")
  platform           StreamPlatform
  platformUserId     String         @map("platform_user_id") @db.VarChar(64) // 플랫폼 사용자 ID
  platformChannelId  String?        @map("platform_channel_id") @db.VarChar(64) // 플랫폼 채널 ID (SOOP는 userId와 동일, CHZZK는 별도)
  isVerified         Boolean        @default(false) @map("is_verified")
  verifiedAt         DateTime?      @map("verified_at") @db.DateTime(0)
  accessToken        String?        @map("access_token") @db.Text // [DEPRECATED] 평문 토큰. Phase 0 완료 후 제거 예정
  refreshToken       String?        @map("refresh_token") @db.Text // [DEPRECATED] 평문 토큰. Phase 0 완료 후 제거 예정
  accessTokenCipher  String?        @map("access_token_cipher") @db.Text // AES-256-GCM envelope 암호화 (EncryptionService)
  refreshTokenCipher String?        @map("refresh_token_cipher") @db.Text // AES-256-GCM envelope 암호화 (EncryptionService)
  tokenExpiresAt     DateTime?      @map("token_expires_at") @db.DateTime(0)
  createdAt          DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform], map: "uq_user_platform_verification") // 사용자당 플랫폼별 하나의 인증
  @@unique([platform, platformUserId], map: "uq_platform_user_id") // 플랫폼 계정 중복 방지
  @@index([userId, platform], map: "idx_user_platform")
  @@index([platform, platformUserId], map: "idx_platform_user_id")
  @@map("user_platform_verifications")
}

