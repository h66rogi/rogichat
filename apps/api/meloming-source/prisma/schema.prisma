  deliverables   HaejuseyoDeliverable[]
  productionJobs HaejuseyoProductionJob[]

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([buyerId, status], map: "idx_haejuseyo_orders_buyer_status")
  @@index([productId, status], map: "idx_haejuseyo_orders_product_status")
  @@index([voiceCommissionOrderId], map: "idx_haejuseyo_orders_voice_order")
  @@map("haejuseyo_orders")
}

model HaejuseyoGoalRequest {
