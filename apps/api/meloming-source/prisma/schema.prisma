  @@map("banner_event_logs")
}

// ── Marketing Popup ──────────────────────────────────────────────────────

enum MarketingPopupType {
  CENTER_MODAL @map("center_modal")
  BOTTOM_SHEET @map("bottom_sheet")
  FULLSCREEN   @map("fullscreen")
  SLIDE_IN     @map("slide_in")
}

enum MarketingPopupContentType {
  IMAGE     @map("image")
  RICH_TEXT @map("rich_text")
  MIXED     @map("mixed")
}

enum MarketingPopupDismissType {
  CLOSE_ONLY @map("close_only")
  TODAY      @map("today")
  FOREVER    @map("forever")
  PERIOD     @map("period")
}

enum MarketingPopupTargetAudience {
  ALL                 @map("all")
  LOGGED_IN           @map("logged_in")
  LOGGED_OUT          @map("logged_out")
  CHANNEL_OWNER       @map("channel_owner")
  NON_CHANNEL_OWNER   @map("non_channel_owner")
  IDENTITY_VERIFIED   @map("identity_verified")
  IDENTITY_UNVERIFIED @map("identity_unverified")
}

enum MarketingPopupFrequency {
  EVERY_VISIT      @map("every_visit")
  ONCE_PER_SESSION @map("once_per_session")
  ONCE_PER_DAY     @map("once_per_day")
  ONCE_EVER        @map("once_ever")
}

enum MarketingPopupAnimationType {
  FADE  @map("fade")
  SLIDE @map("slide")
  SCALE @map("scale")
  NONE  @map("none")
}

model MarketingPopup {
  id    Int    @id @default(autoincrement())
  title String @db.VarChar(255)

  // 콘텐츠
  contentType     MarketingPopupContentType @default(IMAGE) @map("content_type")
  imageUrl        String?                   @map("image_url") @db.VarChar(500)
  imageDarkUrl    String?                   @map("image_dark_url") @db.VarChar(500)
  imageAlt        String?                   @map("image_alt") @db.VarChar(255)
  richTextContent String?                   @map("rich_text_content") @db.Text
  linkUrl         String?                   @map("link_url") @db.VarChar(500)
  linkOpenInNew   Boolean                   @default(true) @map("link_open_in_new")
  linkButtonText  String?                   @map("link_button_text") @db.VarChar(100)

  // 디스플레이
  popupType      MarketingPopupType          @default(CENTER_MODAL) @map("popup_type")
  animationType  MarketingPopupAnimationType @default(FADE) @map("animation_type")
  overlayOpacity Int                         @default(50) @map("overlay_opacity")

  // 타겟팅
  targetPages    Json                         @default("[]") @map("target_pages")
  targetAudience MarketingPopupTargetAudience @default(ALL) @map("target_audience")

  // 스케줄링
  startAt DateTime? @map("start_at") @db.DateTime(0)
  endAt   DateTime? @map("end_at") @db.DateTime(0)

  // 노출 빈도 & 닫기
  frequency         MarketingPopupFrequency   @default(ONCE_PER_DAY) @map("frequency")
  dismissType       MarketingPopupDismissType @default(TODAY) @map("dismiss_type")
  dismissPeriodDays Int?                      @map("dismiss_period_days")
  maxImpressions    Int?                      @map("max_impressions")
  delaySeconds      Int                       @default(0) @map("delay_seconds")

  // 우선순위 & 그룹
  priority Int     @default(0)
  groupKey String? @map("group_key") @db.VarChar(100)

  // 상태
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  statsDaily MarketingPopupStatsDaily[]

  @@index([isActive, startAt, endAt])
  @@index([priority])
  @@map("marketing_popups")
}

model MarketingPopupStatsDaily {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  popupId     Int      @map("popup_id")
  impressions Int      @default(0)
  clicks      Int      @default(0)
  closes      Int      @default(0)
  dismissals  Int      @default(0)

  popup MarketingPopup @relation(fields: [popupId], references: [id], onDelete: Cascade)

  @@unique([popupId, date])
  @@map("marketing_popup_stats_daily")
}

