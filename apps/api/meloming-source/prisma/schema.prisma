}

/// 콘텐츠 종류별 멜로밍 제작 옵션 기본 정책.
///
/// 상품별 설정은 HaejuseyoProductPhysicalOption에 고정되지만, 이 테이블은
/// 새 상품에 적용할 타입별 판매가/배송비/제작 사양의 기준값을 관리한다.
model HaejuseyoContentTypeProductionOptionPolicy {
  id          Int                  @id @default(autoincrement())
  contentKind HaejuseyoContentKind @map("content_kind")
  optionCode  String               @map("option_code") @db.VarChar(64)

  isEnabled        Boolean @default(true) @map("is_enabled")
  productionAmount Int     @default(0) @map("production_amount")
  shippingAmount   Int     @default(0) @map("shipping_amount")

  assetConfig   Json?   @map("asset_config")
  variantConfig Json?   @map("variant_config")
  adminMemo     String? @map("admin_memo") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([contentKind, optionCode], map: "haejuseyo_content_type_option_policy_unique")
  @@index([contentKind, isEnabled], map: "idx_haejuseyo_content_type_option_policy_enabled")
  @@map("haejuseyo_content_type_production_option_policies")
}

model HaejuseyoOrder {
  id      Int   @id @default(autoincrement())
  orderId Int   @unique(map: "haejuseyo_orders_order_unique") @map("order_id")
  order   Order @relation(fields: [orderId], references: [id])

  buyerId Int  @map("buyer_id")
  buyer   User @relation("HaejuseyoOrderBuyer", fields: [buyerId], references: [id])

