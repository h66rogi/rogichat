/// 콘텐츠 조회 이력 (IP 기반 중복 방지)
model ContentViewLog {
  id        Int      @id @default(autoincrement())
  contentId Int      @map("content_id")
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress String   @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.DateTime(0)

  // 24h IP-based dedup 은 Redis SET NX EX (ContentService.incrementViewCount) 가 담당.
  // viewedAt 은 DateTime(0) (초 단위) 라 (contentId, ipAddress, viewedAt) unique 로는
  // 같은 초 내 동시 INSERT 만 막을 수 있고 dedup window(24h) 의미는 보장 X — 제거.
  @@index([contentId, viewedAt], map: "idx_content_view_content_viewed")
  @@index([userId, viewedAt], map: "idx_content_view_user_viewed")
  @@index([ipAddress, viewedAt], map: "idx_content_view_ip_viewed")
  @@map("content_view_logs")
}

/// 분산 락 테이블 (크론잡 중복 실행 방지)
model DistributedLock {
  lockKey   String   @id @map("lock_key") @db.VarChar(255)
  ownerId   String   @map("owner_id") @db.VarChar(255)
  lockedAt  DateTime @default(now()) @map("locked_at") @db.DateTime(0)
  expiresAt DateTime @map("expires_at") @db.DateTime(0)

  @@index([expiresAt], map: "idx_distributed_locks_expires_at")
  @@map("distributed_locks")
}

