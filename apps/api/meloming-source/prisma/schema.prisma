// Voice is a distinct media aggregate. It shares Talk V2 membership epochs,
// but it does not reuse the legacy song live or recording tables.
model TalkV2VoiceSession {
  id                          String                      @id @default(cuid()) @db.VarChar(36)
  roomId                      String                      @map("room_id") @db.VarChar(36)
  hostUserId                  Int                         @map("host_user_id")
  hostMembershipIdAtStart     String                      @map("host_membership_id_at_start") @db.VarChar(36)
  hostMembershipEpochAtStart  Int                         @map("host_membership_epoch_at_start")
  state                       TalkV2VoiceSessionState     @default(PROVISIONING)
  // MySQL cannot express a partial unique index. Active/provisioning sessions
  // use one deterministic key per room; terminal sessions switch to a
  // historical key in the same state transition.
  activeKey                   String                      @unique @map("active_key") @db.VarChar(191)
  // A native client retry uses this deterministic key. The raw host lease is
  // never stored; a retry from the same device receives a rotated lease.
  startRequestKey             String                      @unique @map("start_request_key") @db.VarChar(191)
  // The request key names a start attempt; this canonical semantic hash
  // prevents that key from being replayed with a different recording policy.
  // It remains nullable only for pre-receipt rows during rolling migration.
  startPayloadFingerprint     String?                     @map("start_payload_fingerprint") @db.Char(64)
  // Opaque nonce minted by Talk before provider provisioning. Every provider
  // callback must echo it; talkSessionId alone is never sufficient to attach
  // a late/stale stage event to this aggregate.
  providerCorrelationKey      String                      @unique @map("provider_correlation_key") @db.VarChar(191)
  providerSessionId           String?                     @unique @map("provider_session_id") @db.VarChar(191)
  providerStageArn            String?                     @map("provider_stage_arn") @db.Text
  providerStageSessionId      String?                     @map("provider_stage_session_id") @db.VarChar(191)
  recordingPrefix             String?                     @map("recording_prefix") @db.Text
  providerMetadata            Json?                       @map("provider_metadata")
  // Public Huyeor stage artwork. The raw media stays in the existing upload
  // store; this session-level URL lets every viewer resolve the same visual.
  presentationArtworkUrl      String?                     @map("presentation_artwork_url") @db.Text
  presentationArtworkKind     String                      @default("DEFAULT") @map("presentation_artwork_kind") @db.VarChar(16)
  // A provider's provision request is idempotent by Talk session id.  These
  // fields make response-loss retries and the STARTING deadline durable rather
  // than treating an HTTP timeout as proof that no provider stage exists.
  provisionAttempts           Int                         @default(0) @map("provision_attempts")
  provisionAvailableAt        DateTime?                   @map("provision_available_at") @db.DateTime(0)
  provisionDeadlineAt         DateTime?                   @map("provision_deadline_at") @db.DateTime(0)
  provisionLastError          String?                     @map("provision_last_error") @db.Text
  // Provision is an at-least-once provider command. A claim owner token
  // fences delayed success/failure responses after another Pod has reclaimed
  // the expired lease.
  provisionLockedBy           String?                     @map("provision_locked_by") @db.VarChar(191)
  provisionLockedAt           DateTime?                   @map("provision_locked_at") @db.DateTime(0)
  // End/unknown-cleanup is also at-least-once. The target snapshot is the
  // current providerSessionId (or null for an unknown-session cleanup), and
  // only the current claim owner may record a retry or terminal outcome.
  providerEndAttempts         Int                         @default(0) @map("provider_end_attempts")
  providerEndAvailableAt      DateTime?                   @map("provider_end_available_at") @db.DateTime(0)
  providerEndLockedBy         String?                     @map("provider_end_locked_by") @db.VarChar(191)
  providerEndLockedAt         DateTime?                   @map("provider_end_locked_at") @db.DateTime(0)
  // A terminal provider 4xx must stop automatic end/cleanup retries while
  // preserving the active session lock for an audited operator resolution.
  providerEndTerminalAt       DateTime?                   @map("provider_end_terminal_at") @db.DateTime(0)
  providerEndLastError        String?                     @map("provider_end_last_error") @db.Text
  // DATETIME(0) cannot safely distinguish repeated terminal errors in the
  // same second. The server-generated token is the operator-resolution CAS
  // identity; never accept it from a native/public client.
  providerEndTerminalMarkerId String?                     @map("provider_end_terminal_marker_id") @db.VarChar(36)
  providerLiveAt              DateTime?                   @map("provider_live_at") @db.DateTime(0)
  // A provider-confirmed host departure pauses listener admission while the
  // same fenced host may reconnect. The server, never a native timer, owns
  // this deadline and ends the session when it expires.
  hostInterruptedAt           DateTime?                   @map("host_interrupted_at") @db.DateTime(0)
  hostReconnectDeadlineAt     DateTime?                   @map("host_reconnect_deadline_at") @db.DateTime(0)
  sessionEpoch                Int                         @default(1) @map("session_epoch")
  aggregateRevision           Int                         @default(0) @map("aggregate_revision")
  // Persisted at creation; later policy changes never rewrite a session's
  // consent/recording rules. V1 always sets transcriptEnabled to false.
  policySnapshot              Json                        @map("policy_snapshot")
  recordingEnabled            Boolean                     @default(true) @map("recording_enabled")
  replayVisibility            TalkV2VoiceReplayVisibility @default(HOST_ONLY) @map("replay_visibility")
  transcriptEnabled           Boolean                     @default(false) @map("transcript_enabled")
  startedAt                   DateTime?                   @map("started_at") @db.DateTime(0)
  endedAt                     DateTime?                   @map("ended_at") @db.DateTime(0)
  createdAt                   DateTime                    @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                   DateTime                    @updatedAt @map("updated_at") @db.DateTime(0)

  // Voice sessions and consent records are retention/audit evidence. They are
  // archived explicitly; a physical room/user cleanup must not erase them by
  // following an incidental cascade.
  room             TalkV2Room                  @relation(fields: [roomId], references: [id], onDelete: Restrict)
  host             User                        @relation("TalkV2VoiceSessionHost", fields: [hostUserId], references: [id])
  participants     TalkV2VoiceParticipant[]
  hostLease        TalkV2VoiceHostLease?
  recording        TalkV2VoiceRecording?
  archiveConsents  TalkV2VoiceArchiveConsent[]
  providerEvents   TalkV2VoiceProviderEvent[]
  messages         TalkV2Message[]             @relation("TalkV2VoiceSessionMessages")
  fanThreads       TalkV2FanThread[]           @relation("TalkV2VoiceSessionFanThreads")
  visibilityStates TalkV2VisibilityReadState[] @relation("TalkV2VoiceSessionReadStates")
  joinReceipts     TalkV2VoiceJoinReceipt[]
  huyeorDonations  HuyeorDonation[]
  huyeorDonationRemoteAudits HuyeorDonationRemoteAudit[]
  huyeorReplay     HuyeorReplay?

  @@index([roomId, state, createdAt], map: "idx_tv2_voice_session_room_state")
  @@index([hostUserId, state], map: "idx_tv2_voice_session_host_state")
  @@index([state, provisionAvailableAt], map: "idx_tv2_voice_session_provision_retry")
  @@index([state, provisionAvailableAt, provisionLockedAt, provisionDeadlineAt], map: "idx_tv2_voice_session_provision_claim")
  @@index([state, providerEndAvailableAt, providerEndLockedAt, providerEndTerminalAt], map: "idx_tv2_voice_session_end_claim")
  @@index([state, providerEndTerminalAt], map: "idx_tv2_voice_session_end_terminal")
  @@index([providerEndTerminalMarkerId], map: "idx_tv2_voice_session_end_terminal_marker")
  @@index([state, hostReconnectDeadlineAt], map: "idx_tv2_voice_session_host_reconnect")
  @@map("talk_v2_voice_sessions")
}

model TalkV2VoiceParticipant {
  id                                 String                      @id @default(cuid()) @db.VarChar(36)
  sessionId                          String                      @map("session_id") @db.VarChar(36)
  userId                             Int                         @map("user_id")
  membershipIdAtJoin                 String                      @map("membership_id_at_join") @db.VarChar(36)
  membershipEpochAtJoin              Int                         @map("membership_epoch_at_join")
  authorizationVersionAtJoin         Int                         @map("authorization_version_at_join")
  role                               TalkV2VoiceParticipantRole
  // PENDING means the server issued a media token. Only the trusted provider
  // join callback promotes it to ACTIVE/presence, which gates session chat and
  // replay eligibility.
  state                              TalkV2VoiceParticipantState @default(PENDING)
  presenceEpoch                      Int                         @map("presence_epoch")
  activeKey                          String                      @unique @map("active_key") @db.VarChar(191)
  providerParticipantId              String?                     @unique @map("provider_participant_id") @db.VarChar(191)
  providerDisconnectAttempts         Int                         @default(0) @map("provider_disconnect_attempts")
  providerDisconnectAvailableAt      DateTime?                   @map("provider_disconnect_available_at") @db.DateTime(0)
  // Provider disconnect is also at-least-once. Only the current attempt
  // owner can record completion, terminal rejection, or a retry schedule.
  providerDisconnectLockedBy         String?                     @map("provider_disconnect_locked_by") @db.VarChar(191)
  providerDisconnectLockedAt         DateTime?                   @map("provider_disconnect_locked_at") @db.DateTime(0)
  // A provider 4xx is not retried automatically. Keep the opaque identity
  // for investigation but stop the scheduled disconnect loop.
  providerDisconnectTerminalAt       DateTime?                   @map("provider_disconnect_terminal_at") @db.DateTime(0)
  providerDisconnectLastError        String?                     @map("provider_disconnect_last_error") @db.Text
  providerDisconnectTerminalMarkerId String?                     @map("provider_disconnect_terminal_marker_id") @db.VarChar(36)
  providerDisconnectedAt             DateTime?                   @map("provider_disconnected_at") @db.DateTime(0)
  tokenIssuedAt                      DateTime                    @default(now()) @map("token_issued_at") @db.DateTime(0)
  joinedAt                           DateTime?                   @map("joined_at") @db.DateTime(0)
  leftAt                             DateTime?                   @map("left_at") @db.DateTime(0)
  revokedAt                          DateTime?                   @map("revoked_at") @db.DateTime(0)
  createdAt                          DateTime                    @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                          DateTime                    @updatedAt @map("updated_at") @db.DateTime(0)

  session     TalkV2VoiceSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  joinReceipt TalkV2VoiceJoinReceipt?

  @@unique([sessionId, userId, presenceEpoch], map: "talk_v2_voice_participant_epoch_key")
  @@index([sessionId, state, presenceEpoch], map: "idx_tv2_voice_participant_session")
  @@index([userId, state, updatedAt], map: "idx_tv2_voice_participant_user")
  @@index([state, providerDisconnectAvailableAt, providerDisconnectTerminalAt], map: "idx_tv2_voice_participant_disconnect")
  @@index([state, providerDisconnectAvailableAt, providerDisconnectLockedAt, providerDisconnectTerminalAt], map: "idx_tv2_voice_participant_disconnect_claim")
  @@index([providerDisconnectTerminalMarkerId], map: "idx_tv2_voice_participant_disconnect_terminal_marker")
  @@map("talk_v2_voice_participants")
}

// Huyeor moderation is scoped to one broadcast session. `activeKey` is set
