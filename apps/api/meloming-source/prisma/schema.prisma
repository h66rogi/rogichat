model PointshopItem {
  id                    Int                   @id @default(autoincrement())
  itemName              String                @map("item_name") @db.VarChar(255)
  category              PointshopItemCategory
  status                PointshopItemStatus   @default(PREPARING)
  isTaxDeductible       Boolean               @map("is_tax_deductible")
  isTaxUserBurden       Boolean?              @map("is_tax_user_burden")
  requiredPoints        Int                   @map("required_points")
  maxBetPerUser         Int                   @map("max_bet_per_user")
  rewardAmount          Int?                  @map("reward_amount")
  startAt               DateTime              @map("start_at") @db.DateTime(0)
  endAt                 DateTime              @map("end_at") @db.DateTime(0)
  announceAt            DateTime              @map("announce_at") @db.DateTime(0)
  winnerSelectionMethod WinnerSelectionMethod @map("winner_selection_method")
  winnerCount           Int                   @map("winner_count")
  description           String?               @db.Text
  thumbnailUrl          String?               @map("thumbnail_url") @db.VarChar(255)
  requireAddress        Boolean               @map("require_address")
  requireGiftReceiving  Boolean               @default(false) @map("require_gift_receiving")
  allowUserCancel       Boolean               @default(true) @map("allow_user_cancel")
  field1Label           String?               @map("field1_label") @db.VarChar(255)
  field2Label           String?               @map("field2_label") @db.VarChar(255)
  field3Label           String?               @map("field3_label") @db.VarChar(255)
  field4Label           String?               @map("field4_label") @db.VarChar(255)
  field5Label           String?               @map("field5_label") @db.VarChar(255)
