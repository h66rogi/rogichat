/// 채널별 클립 자동 생성 설정.
/// recording-worker session-wide agent (gpt-5.5) 가 SongRequest 가창 구간을 자동 추출한 결과를
/// 멜로밍 클립 페이지에 자동 게시할지 결정한다.
/// autoClipEnabled=true 인 채널만, confidence in (high, medium) + labelMismatch=false 인
/// 클립이 자동 게시된다. false 면 추출 결과는 어드민 검수 큐에만 노출되고 사용자 페이지 게시 X.
/// 게시 시 channel owner 와 SongRequest.requestUserId 사용자에게 in-app/push/email 발송.
model ChannelClipSettings {
  channelId       Int      @id @map("channel_id")
  // 기본 ON — row 없는 채널은 service null-safe 검증으로 ON. 명시적 false row 만 OFF.
  autoClipEnabled Boolean  @default(true) @map("auto_clip_enabled")
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("channel_clip_settings")
}

/// 글로벌 mirror(meloming.gg) opt-in 노출 설정 + override 필드.
/// 채널 운영자가 meloming.com manage 페이지에서 "글로벌 노출 ON" 토글 시 row 생성.
/// globalEnabled = true 인 채널만 meloming.gg 검색/리스트에 노출됨.
/// override 필드들은 NULL 이면 원본 Channel 의 값을 그대로 사용 (web fallback).
model ChannelGlobalProfile {
  id        Int @id @default(autoincrement())
  channelId Int @unique @map("channel_id")

  /// 글로벌 노출 토글 (opt-out 모델).
  /// 기본 true — meloming.gg 모든 채널 자동 노출. 채널 owner 가 manage 페이지에서 끌 수 있다.
  /// row 자체가 없는 채널도 default true 로 취급한다 (service 레이어에서 처리).
  globalEnabled Boolean @default(true) @map("global_enabled")

  /// 글로벌 채널명 override (예: 일본/영문 표기). NULL → Channel.name 사용.
  globalName String? @map("global_name") @db.VarChar(255)

  /// 글로벌 채널 설명 override. NULL → Channel.channelDescription 사용.
  globalDescription String? @map("global_description") @db.Text

  /// 글로벌 프로필 이미지 override. NULL → Channel.profileImageUrl 사용.
  globalProfileImageUrl String? @map("global_profile_image_url") @db.VarChar(500)

  /// 채널이 주로 사용하는 자막/콘텐츠 언어 (ISO 639-1, 예: "ja", "en").
  /// meloming.gg 추천/필터에 사용. NULL 이면 분류 없음.
  primaryLocale String? @map("primary_locale") @db.VarChar(8)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade, map: "fk_channel_global_profile_channel_id")

  @@index([globalEnabled], map: "idx_channel_global_profile_enabled")
  @@index([primaryLocale], map: "idx_channel_global_profile_locale")
  @@map("channel_global_profiles")
}

/// 채널 가격 설정 (신청곡 가격 기능)
model ChannelPricingSettings {
  id               Int      @id @default(autoincrement())
  channelId        Int      @unique @map("channel_id")
  defaultPrice     Int?     @map("default_price")
  difficultyPrices Json?    @map("difficulty_prices") // {"1": 100, "2": 200, ...}
  pricingEnabled   Boolean  @default(false) @map("pricing_enabled")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("channel_pricing_settings")
}

/// Streaming platform classification for a channel
enum StreamPlatform {
  SOOP     @map("soop")
  CHZZK    @map("chzzk")
  CIME     @map("cime")
  YOUTUBE  @map("youtube")
  MELOMING @map("meloming")
  OTHER    @map("other")
}

