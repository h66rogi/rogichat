  haejuseyoOrder             HaejuseyoOrder?
  haejuseyoGoalParticipation HaejuseyoGoalParticipation?
  homeworkSongOrder          HomeworkSongOrder?
  rentalOrder                RentalOrder?
  rentalAdditionalCharge     RentalAdditionalCharge?
  revenueCostEntries         RevenueCostEntry[]

  @@index([userId], map: "idx_orders_user_id")
