// ===================================
// Channel Verification domain
// ===================================

enum ChannelVerificationStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
  REVOKED  @map("revoked")
}

enum ChannelVerificationPendingReason {
  OTHER_PLATFORM     @map("other_platform")
  AUTO_VERIFY_FAILED @map("auto_verify_failed")
}

enum ChannelVerificationAction {
  SUBMITTED        @map("submitted")
  AUTO_APPROVED    @map("auto_approved")
  ADMIN_APPROVED   @map("admin_approved")
  ADMIN_REJECTED   @map("admin_rejected")
  RESUBMITTED      @map("resubmitted")
  CHANGE_REQUESTED @map("change_requested")
  REVOKED          @map("revoked")
}

enum ChannelVerificationActorType {
  USER   @map("user")
  ADMIN  @map("admin")
  SYSTEM @map("system")
}

/// 채널 인증 정보 (채널-플랫폼 소유권 인증)
model ChannelVerification {
  id        Int @id @default(autoincrement())
  channelId Int @map("channel_id")
  userId    Int @map("user_id")

  platform          StreamPlatform
  platformChannelId String?        @map("platform_channel_id") @db.VarChar(64)

  status        ChannelVerificationStatus         @default(PENDING)
  pendingReason ChannelVerificationPendingReason? @map("pending_reason")

  // OTHER 플랫폼용 증빙
  evidenceImageUrl    String? @map("evidence_image_url") @db.VarChar(500)
  evidenceDescription String? @map("evidence_description") @db.Text

  // 관리자 심사
  reviewedAt       DateTime? @map("reviewed_at") @db.DateTime(0)
  reviewedByUserId Int?      @map("reviewed_by_user_id")
  rejectionReason  String?   @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  channel        Channel                  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user           User                     @relation("ChannelVerificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedByUser User?                    @relation("ChannelVerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  logs           ChannelVerificationLog[]

  @@unique([channelId, platform], map: "uq_channel_platform")
  @@index([channelId, status], map: "idx_channel_status")
  @@index([userId, status])
  @@index([status, createdAt])
  @@map("channel_verifications")
}

/// 채널 인증 상태 변경 로그
model ChannelVerificationLog {
  id                    Int @id @default(autoincrement())
  channelVerificationId Int @map("channel_verification_id")

  action         ChannelVerificationAction
  previousStatus ChannelVerificationStatus? @map("previous_status")
  newStatus      ChannelVerificationStatus  @map("new_status")

  // 액션 수행자
  actorUserId Int?                         @map("actor_user_id")
  actorType   ChannelVerificationActorType @map("actor_type")

  // 추가 정보
  reason   String? @db.Text
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  channelVerification ChannelVerification @relation(fields: [channelVerificationId], references: [id], onDelete: Cascade)
  actorUser           User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([channelVerificationId, createdAt])
  @@map("channel_verification_logs")
}

