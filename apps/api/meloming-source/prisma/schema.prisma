  @@index([status, startAt, endAt], map: "idx_pointshop_items_status_time")
  @@index([category], map: "idx_pointshop_items_category")
  @@index([announceAt], map: "idx_pointshop_items_announce_at")
  @@map("pointshop_items")
}

model PointshopBetLog {
  id                 Int    @id @default(autoincrement())
  userId             Int    @map("user_id")
  itemId             Int    @map("item_id")
  usedPoints         Int    @map("used_points")
  pointTransactionId Int?   @map("point_transaction_id")
  idempotencyKey     String @unique(map: "uq_pointshop_bet_idem_key") @map("idempotency_key") @db.VarChar(64)
  shippingAddressId  Int?   @map("shipping_address_id")

  // 입력 필드 값 (스냅샷은 아래 별도 보강)
  field1Value String? @map("field1_value") @db.Text
  field2Value String? @map("field2_value") @db.Text
  field3Value String? @map("field3_value") @db.Text
  field4Value String? @map("field4_value") @db.Text
  field5Value String? @map("field5_value") @db.Text

  // 스냅샷(응모 시점 확정 정보)
  itemNameSnapshot       String? @map("item_name_snapshot") @db.VarChar(255)
  requiredPointsSnapshot Int?    @map("required_points_snapshot")

  createdAt   DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  betStatus   PointshopBetStatus  @default(ACTIVE) @map("bet_status")
  canceledAt  DateTime?           @map("canceled_at") @db.DateTime(0)
  isWin       Boolean             @default(false) @map("is_win")
  winStatus   PointshopWinStatus? @map("win_status")
  winMemo     String?             @map("win_memo") @db.Text
  announcedAt DateTime?           @map("announced_at") @db.DateTime(0)

  // Relations
  user             User              @relation(fields: [userId], references: [id])
  item             PointshopItem     @relation(fields: [itemId], references: [id])
  pointTransaction PointTransaction? @relation(fields: [pointTransactionId], references: [id])

  @@index([itemId, createdAt], map: "idx_pointshop_bet_item_created")
  @@index([userId, itemId], map: "idx_pointshop_bet_user_item")
  @@index([itemId, isWin], map: "idx_pointshop_bet_item_iswin")
  @@index([itemId, winStatus], map: "idx_pointshop_bet_item_winstatus")
  @@index([pointTransactionId], map: "idx_pointshop_bet_txid")
  @@index([itemId, betStatus, createdAt], map: "idx_pointshop_bet_item_status_created")
  @@index([userId, createdAt], map: "idx_pointshop_bet_user_created")
  @@index([itemId, usedPoints], map: "idx_pointshop_bet_item_points")
  @@index([shippingAddressId], map: "idx_pointshop_bet_shipping_address")
  @@map("pointshop_bet_logs")
}

model PointshopBan {
