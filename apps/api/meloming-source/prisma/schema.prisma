  ANONGIFT     @map("anongift")
  COMMISSION   @map("commission")
  PARTNERS     @map("partners")
  POINTS       @map("points")
  SUBSCRIPTION @map("subscription")
  PROMOTION    @map("promotion")
  SPOTLIGHT    @map("spotlight")
