  @@index([accessPolicy, createdAt], map: "idx_contents_access_policy_created")
  @@index([userId, createdAt], map: "idx_contents_user_created")
  @@index([contentAt], map: "idx_contents_content_at")
  @@index([viewCount], map: "idx_contents_view_count")
  @@map("contents")
}

/// 콘텐츠 참여 기록.
/// Content.kind=POST 의 "참여했어요" 상태를 저장한다. 참가자 identity 는 User 가 아니라
/// Organizer 를 사용한다. Organizer 는 역사적으로 주최자 이름이지만, 콘텐츠 도메인에서는
/// SOOP/CHZZK/CIME/ETC 외부 채널 identity 이므로 비회원 스트리머 참가도 표현할 수 있다.
/// 주최/등록/취소 행위자는 별도 필드로 남겨 identity 와 audit trail 이 섞이지 않게 한다.
model ContentParticipation {
  id                              Int                            @id @default(autoincrement())
  contentId                       Int                            @map("content_id")
  participantOrganizerId          Int                            @map("participant_organizer_id")
  participantChannelId            Int?                           @map("participant_channel_id")
  hostOrganizerId                 Int                            @map("host_organizer_id")
  hostChannelId                   Int?                           @map("host_channel_id")
  status                          ContentParticipationStatus     @default(ACTIVE)
  registeredByUserId              Int?                           @map("registered_by_user_id")
  registeredByRole                ContentParticipationActorRole  @map("registered_by_role")
  canceledByUserId                Int?                           @map("canceled_by_user_id")
  canceledByRole                  ContentParticipationActorRole? @map("canceled_by_role")
  canceledAt                      DateTime?                      @map("canceled_at") @db.DateTime(0)
  participantNameSnapshot         String?                        @map("participant_name_snapshot") @db.VarChar(255)
  participantProfileImageSnapshot String?                        @map("participant_profile_image_snapshot") @db.VarChar(500)
  note                            String?                        @db.Text
  createdAt                       DateTime                       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                       DateTime                       @updatedAt @map("updated_at") @db.DateTime(0)

  content              Content   @relation("ContentParticipations", fields: [contentId], references: [id], onDelete: Cascade)
  participantOrganizer Organizer @relation("ContentParticipationParticipantOrganizer", fields: [participantOrganizerId], references: [id], onDelete: Restrict)
  participantChannel   Channel?  @relation("ContentParticipationParticipantChannel", fields: [participantChannelId], references: [id], onDelete: SetNull)
  hostOrganizer        Organizer @relation("ContentParticipationHostOrganizer", fields: [hostOrganizerId], references: [id], onDelete: Restrict)
  hostChannel          Channel?  @relation("ContentParticipationHostChannel", fields: [hostChannelId], references: [id], onDelete: SetNull)
  registeredBy         User?     @relation("ContentParticipationRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: SetNull)
  canceledBy           User?     @relation("ContentParticipationCanceledBy", fields: [canceledByUserId], references: [id], onDelete: SetNull)

  @@unique([contentId, participantOrganizerId], map: "uq_content_participations_content_participant")
  @@index([contentId, status], map: "idx_content_participations_content_status")
  @@index([participantOrganizerId, status, createdAt], map: "idx_content_participations_participant_org_status_created")
  @@index([participantChannelId, status, createdAt], map: "idx_content_participations_participant_channel_status_created")
  @@index([hostOrganizerId, status], map: "idx_content_participations_host_org_status")
  @@index([registeredByUserId, createdAt], map: "idx_content_participations_registered_user_created")
  @@map("content_participations")
}

/// 콘텐츠 마감 제보
model ContentClosedReport {
  id              Int       @id @default(autoincrement())
  contentId       Int       @map("content_id")
