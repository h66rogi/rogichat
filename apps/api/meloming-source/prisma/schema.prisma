model TalkMessage {
  id          Int                   @id @default(autoincrement())
  talkRoomId  Int                   @map("talk_room_id")
  senderId    Int                   @map("sender_id")
  type        TalkMessageType       @default(TEXT)
  content     String                @db.Text
  attachments Json?
  visibility  TalkMessageVisibility @default(ALL)
  isDeleted   Boolean               @default(false) @map("is_deleted")
  editedAt    DateTime?             @map("edited_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  replyToId   Int?                  @map("reply_to_id")

  talkRoom     TalkRoom       @relation("RoomMessages", fields: [talkRoomId], references: [id], onDelete: Cascade)
