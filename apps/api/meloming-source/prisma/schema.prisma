  clearedBy User?   @relation("ContentClosedReportClearedBy", fields: [clearedByUserId], references: [id], onDelete: SetNull)

  @@unique([contentId, reporterUserId], map: "uq_content_closed_report_content_user")
  @@index([contentId, clearedAt], map: "idx_content_closed_reports_content_cleared")
  @@index([contentId, createdAt], map: "idx_content_closed_reports_content_created")
  @@index([reporterUserId, createdAt], map: "idx_content_closed_reports_user_created")
