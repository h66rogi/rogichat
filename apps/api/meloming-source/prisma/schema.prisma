  CONSENTED_SESSION_LISTENERS

  @@map("talk_v2_voice_replay_visibility")
}

enum TalkV2VoiceParticipantRole {
  HOST
  LISTENER

  @@map("talk_v2_voice_participant_role")
}

enum TalkV2VoiceParticipantState {
  PENDING
  ACTIVE
  LEFT
  REVOKED

  @@map("talk_v2_voice_participant_state")
}

enum TalkV2VoiceRecordingState {
  DISABLED
  PENDING
  RECORDING
  PROCESSING
  AVAILABLE
  FAILED
  DELETING
