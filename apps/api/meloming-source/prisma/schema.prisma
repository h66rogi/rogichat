  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  @@index([sessionId, targetUserId, actionType, expiresAt], map: "idx_tv2_huyeor_moderation_session_target")
  @@index([channelId, targetUserId, actionType, createdAt], map: "idx_tv2_huyeor_moderation_escalation")
  @@index([targetUserId, createdAt], map: "idx_tv2_huyeor_moderation_target_created")
  @@map("talk_v2_huyeor_moderation_actions")
}

// A native join retry must be bound to one immutable participant/presence
// attempt. Keep the receipt separate from the participant so a host can be
// created at broadcast start and atomically attached on its first media join.
model TalkV2VoiceJoinReceipt {
  id                 String   @id @default(cuid()) @db.VarChar(36)
  sessionId          String   @map("session_id") @db.VarChar(36)
  actorUserId        Int      @map("actor_user_id")
  clientInstanceId   String   @map("client_instance_id") @db.VarChar(191)
  joinRequestId      String   @map("join_request_id") @db.VarChar(191)
  payloadFingerprint String   @map("payload_fingerprint") @db.Char(64)
  participantId      String   @unique @map("participant_id") @db.VarChar(36)
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  session     TalkV2VoiceSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  actor       User                   @relation("TalkV2VoiceJoinReceiptActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  participant TalkV2VoiceParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, sessionId, clientInstanceId, joinRequestId], map: "tv2_voice_join_receipt_actor_session_request_key")
  @@index([sessionId, actorUserId, createdAt], map: "idx_tv2_voice_join_receipt_session_actor")
  @@map("talk_v2_voice_join_receipts")
}

model TalkV2VoiceHostLease {
  id                  String   @id @default(cuid()) @db.VarChar(36)
  sessionId           String   @unique @map("session_id") @db.VarChar(36)
  hostUserId          Int      @map("host_user_id")
  hostMembershipId    String   @map("host_membership_id") @db.VarChar(36)
  hostMembershipEpoch Int      @map("host_membership_epoch")
  clientInstanceId    String   @map("client_instance_id") @db.VarChar(191)
  leaseTokenHash      String   @map("lease_token_hash") @db.VarChar(128)
  fence               Int      @default(1)
  expiresAt           DateTime @map("expires_at") @db.DateTime(0)
  lastRenewedAt       DateTime @default(now()) @map("last_renewed_at") @db.DateTime(0)
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(0)
