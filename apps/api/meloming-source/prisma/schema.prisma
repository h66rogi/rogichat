model GlobalSongLyrics {
  globalSongId            Int          @id @map("global_song_id")
  source                  LyricsSource @default(MUSIXMATCH) @map("source")
  externalId              String?      @map("external_id") @db.VarChar(50)
  body                    String       @db.MediumText
  // Korean phonetic transliteration of `body` (Phase A1f).
  // Generated when language is non-Korean (esp. ja). Best-effort via LLM.
  // null = not generated yet, '' = generation attempted but failed.
  bodyKoPron              String?      @map("body_ko_pron") @db.MediumText
  bodyKoPronAt            DateTime?    @map("body_ko_pron_at")
  // Korean translation from Musixmatch for non-Korean lyrics.
  bodyTranslation         String?      @map("body_translation") @db.MediumText
  bodyTranslationLanguage String?      @map("body_translation_language") @db.VarChar(8)
  bodyTranslationAt       DateTime?    @map("body_translation_at")
  language                String?      @db.VarChar(8)
  hasSubtitle             Boolean      @default(false) @map("has_subtitle")
  subtitleId              String?      @map("subtitle_id") @db.VarChar(50)
  subtitleBody            String?      @map("subtitle_body") @db.MediumText
  subtitleLength          Int?         @map("subtitle_length")
  hasRichsync             Boolean      @default(false) @map("has_richsync")
  richsyncId              String?      @map("richsync_id") @db.VarChar(50)
  richsyncBody            String?      @map("richsync_body") @db.LongText
  copyrightLine           String?      @map("copyright_line") @db.VarChar(500)
  trackingScript          String?      @map("tracking_script_url") @db.Text
  trackingPixel           String?      @map("tracking_pixel_url") @db.Text
  shareUrl                String?      @map("share_url") @db.Text
  restrictedKr            Boolean      @default(false) @map("restricted_kr")
  restrictionsRaw         Json?        @map("restrictions_raw")
  fetchedAt               DateTime     @map("fetched_at")
  expiresAt               DateTime?    @map("expires_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  globalSong GlobalSong @relation(fields: [globalSongId], references: [id], onDelete: Cascade)

  @@index([fetchedAt])
  @@index([expiresAt])
  @@map("global_song_lyrics")
}

