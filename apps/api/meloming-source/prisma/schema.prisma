generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  SUBSCRIPTION @map("subscription")
  PROMOTION    @map("promotion")
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXEMPT
}

enum UserPersonaType {
  STREAMER
  FAN
  COMMISSION_CREATOR
}

model User {
  id                              Int                          @id @default(autoincrement())
  email                           String                       @unique(map: "users_email_unique")
  password                        String                       @db.VarChar(255)
  nickname                        String                       @db.VarChar(255)
  phone                           String?                      @db.VarChar(20)
  phoneVerifiedAt                 DateTime?                    @map("phone_verified_at") @db.DateTime(0)
  phoneCountryCode                String?                      @map("phone_country_code") @db.VarChar(2)
  profileImageUrl                 String?                      @map("profile_image_url") @db.VarChar(500)
  isApproved                      Boolean?                     @default(false) @map("is_approved")
  isEmailVerified                 Boolean?                     @default(false) @map("is_email_verified")
  isIdentityVerified              Boolean?                     @default(false) @map("is_identity_verified")
  isAdmin                         Boolean?                     @default(false) @map("is_admin")
  /// Deprecated: anongift scoped role policy is disabled. anongift admin access uses isAdmin only.
  anongiftAdminRole               AnongiftAdminRole?           @map("anongift_admin_role")
  isAmbassador                    Boolean?                     @default(false) @map("is_ambassador")
  userType                        UserType?                    @default(creator) @map("user_type")
  referralCode                    String?                      @unique(map: "users_referral_code_unique") @map("referral_code") @db.VarChar(10)
  marketingConsent                Boolean?                     @map("marketing_consent")
  isActive                        Boolean?                     @default(true) @map("is_active")
  // Monotonically increases whenever an otherwise Talk-eligible account is
  // restricted. New Talk grants snapshot this value so a fast restore can
  // never revive a grant issued before the restriction was processed.
  talkAccessEpoch                 Int                          @default(1) @map("talk_access_epoch")
  isSuspended                     Boolean?                     @default(false) @map("is_suspended")
  isBanned                        Boolean?                     @default(false) @map("is_banned")
  isDeleted                       Boolean?                     @default(false) @map("is_deleted")
  suspendedAt                     DateTime?                    @map("suspended_at") @db.DateTime(0)
  suspendedUntil                  DateTime?                    @map("suspended_until") @db.DateTime(0)
  suspendedReason                 String?                      @map("suspended_reason") @db.Text
  bannedAt                        DateTime?                    @map("banned_at") @db.DateTime(0)
  bannedReason                    String?                      @map("banned_reason") @db.Text
  deletedAt                       DateTime?                    @map("deleted_at") @db.DateTime(0)
  deletedReason                   String?                      @map("deleted_reason") @db.Text
  emailVerificationCode           String?                      @map("email_verification_code") @db.VarChar(255)
  emailVerificationExpires        DateTime?                    @map("email_verification_expires") @db.DateTime(0)
  resetPasswordToken              String?                      @map("reset_password_token") @db.VarChar(255)
  resetPasswordExpires            DateTime?                    @map("reset_password_expires") @db.DateTime(0)
  createdAt                       DateTime?                    @default(now()) @map("created_at") @db.DateTime(0)
  lastLoginAt                     DateTime?                    @map("last_login_at") @db.DateTime(0)
  isProSubscriber                 Boolean?                     @default(false) @map("is_pro_subscriber")
  proSubscriptionEndAt            DateTime?                    @map("pro_subscription_end_at") @db.DateTime(0)
  acceptGifts                     Boolean                      @default(true) @map("accept_gifts")
  talkDmSetting                   TalkDmSetting                @default(ALL) @map("talk_dm_setting")
  channels                        Channel[]
  lyricsQuotaWindow               LyricsQuotaWindow?
  lyricsQuotaConsumptions         LyricsQuotaConsumption[]
  lyricsQuotaResetActions         LyricsQuotaResetAudit[]      @relation("LyricsQuotaResetActor")
  youtubeChannels                 YouTubeChannel[]
  subscriptionGiftOrdersReceived  SubscriptionOrder[]          @relation("SubscriptionGiftRecipientUser")
  referralsMade                   Referral[]                   @relation("ReferrerUser")
  referralReceived                Referral?                    @relation("NewUser")
  channelFavorites                UserChannelFavorite[]
  songLikes                       UserSongLike[]
  channelManagerRoles             ChannelManager[]             @relation("ManagerUser")
  channelManagerGrants            ChannelManager[]             @relation("GrantedByUser")
  socialAccounts                  SocialAccount[]
  contents                        Content[]
  hiddenContents                  Content[]                    @relation("hiddenContents")
  contentParticipationsRegistered ContentParticipation[]       @relation("ContentParticipationRegisteredBy")
  contentParticipationsCanceled   ContentParticipation[]       @relation("ContentParticipationCanceledBy")
  contentClosedReports            ContentClosedReport[]        @relation("ContentClosedReportReporter")
  contentClosedReportsCleared     ContentClosedReport[]        @relation("ContentClosedReportClearedBy")
  pointTransactions               PointTransaction[]
  pointBalance                    UserPointBalance?
  cashTransactions                CashTransaction[]
  cashBalance                     UserCashBalance?
  cashLots                        CashLot[]
  donationsMade                   Donation[]                   @relation("DonationDonor")
  donationsReceived               Donation[]                   @relation("DonationRecipient")
  fundingProjects                 FundingProject[]             @relation("FundingProjectOwner")
  cashTopupOrders                 CashTopupOrder[]
  payments                        Payment[]
  billingKeys                     BillingKey[]
  orders                          Order[]
  haejuseyoOrders                 HaejuseyoOrder[]             @relation("HaejuseyoOrderBuyer")
  haejuseyoGoalParticipations     HaejuseyoGoalParticipation[] @relation("HaejuseyoGoalParticipant")
  attendanceLogs                  AttendanceLog[]
  attendanceStreak                AttendanceStreak?
  pushSubscriptions               PushSubscription[]
  notificationPreferences         NotificationPreference?
  notifications                   Notification[]
  channelGuestbookEntries         ChannelGuestbookEntry[]
  ChannelGuestbookReply           ChannelGuestbookReply[]
  uploadedEmoticons               ChannelEmoticon[]            @relation("EmoticonUploader")
  reviewedEmoticons               ChannelEmoticon[]            @relation("EmoticonReviewer")
  subscriptionTerms               UserSubscriptionTerm[]
  channelMembershipTerms          ChannelMembershipTerm[]      @relation("ChannelMembershipMember")
  channelMembershipCheckouts      ChannelMembershipCheckout[]  @relation("ChannelMembershipCheckoutPurchaser")
  channelSchedulesAuthored        ChannelSchedule[]
  scheduleImageRenders            ScheduleImageRender[]        @relation("ScheduleImageRenderRequester")
  userIdentities                  UserIdentity[]
  // Community relations
  communityComments               CommunityComment[]
  communityReplies                CommunityReply[]
  communityPostAttachments        CommunityPostAttachment[]    @relation("CommunityPostAttachmentUploader")
  communityChannelBlocks          CommunityChannelUserBlock[]  @relation("CommunityBlockedUser")
  communityChannelBlocksCreated   CommunityChannelUserBlock[]  @relation("CommunityBlockCreator")

  // Clip relations
  clipViews ClipView[]

  // Pointshop relations
  pointshopBetLogs PointshopBetLog[]
  pointshopBans    PointshopBan[]

  // ChannelTransfer relation
  channelTransfersAsCurrentOwner ChannelTransferRequest[] @relation("ChannelTransfer_CurrentOwner")
  channelTransfersAsTargetUser   ChannelTransferRequest[] @relation("ChannelTransfer_TargetUser")
  channelTransfersReviewed       ChannelTransferRequest[] @relation("ChannelTransfer_ReviewedByAdmin")

  // Platform verification relations (신규)
  platformVerifications UserPlatformVerification[]
  upboBalances          UpboBalance[]              @relation("UpboBalanceMatchedUser")
  upboLedgers           UpboLedger[]               @relation("UpboLedgerMatchedUser")
  upboLedgerActions     UpboLedger[]               @relation("UpboLedgerCreatedBy")
  upboImportBatches     UpboImportBatch[]          @relation("UpboImportBatchCreatedBy")

  // Song request relations
  songRequests                   SongRequest[]          @relation("userSongRequests")
  songRequestBlocksCreated       SongRequestUserBlock[] @relation("SongRequestUserBlockCreator")
  songRequestBlocksTargetingUser SongRequestUserBlock[] @relation("SongRequestUserBlockTargetUser")

  // 사용자가 만든 클립 신고들
  clipReports ClipReport[] @relation("UserClipReports")

  // Custom survey relations
  customSurveys CustomSurvey[]

  // Apps relations
  ownedApps           App[]              @relation("AppOwner")
  reviewedAppVersions AppVersion[]       @relation("AppVersionReviewedBy")
  appStatusHistories  AppStatusHistory[] @relation("AppStatusChangedBy")

  // Coupons relations
  coupons Coupon[]

  // Content view logs
  contentViewLogs ContentViewLog[]

  // OAuth consents
  oauthConsents OAuthConsent[]

  // Softcone connection relation
  softconeConnection SoftconeConnection?

  // Channel verification relations
  channelVerifications         ChannelVerification[]    @relation("ChannelVerificationOwner")
  channelVerificationsReviewed ChannelVerification[]    @relation("ChannelVerificationReviewer")
  channelVerificationLogs      ChannelVerificationLog[]

  // Live session relations
  liveSessions LiveSession[]

  // Clip relations
  clipComments ClipComment[]
  clipReplies  ClipReply[]

  // ClipRequest relations
  clipRequestsSubmitted ClipRequest[] @relation("ClipRequestRequester")
  clipRequestsProcessed ClipRequest[] @relation("ClipRequestProcessor")

  // SongAddRequest relations
  songAddRequestsSubmitted SongAddRequest[] @relation("SongAddRequestRequester")
  songAddRequestsProcessed SongAddRequest[] @relation("SongAddRequestProcessor")

  // Recruit relations
  recruitPostsAuthored            RecruitPost[]             @relation("RecruitPostAuthor")
  recruitPostsReviewed            RecruitPost[]             @relation("RecruitPostReviewer")
  recruitApplicationsSubmitted    RecruitApplication[]      @relation("RecruitApplicationApplicant")
  recruitPostBookmarks            RecruitPostBookmark[]
  recruitPostClosedReports        RecruitPostClosedReport[]
  recruitPostClosedReportsCleared RecruitPostClosedReport[] @relation("RecruitClosedReportClearedBy")
  recruitStatusChanges            RecruitStatusHistory[]    @relation("RecruitStatusChangedBy")

  // Ranking opt-out relations
  rankingViewerOptOut   RankingViewerOptOut?
  rankingChannelOptOuts RankingChannelOptOut[]

  // Talk relations
  talkMessages            TalkMessage[]            @relation("TalkMessageSender")
  talkParticipants        TalkParticipant[]
  talkBlocksMade          TalkBlock[]              @relation("TalkBlocker")
  talkBlocksReceived      TalkBlock[]              @relation("TalkBlocked")
  talkReactions           TalkReaction[]           @relation("TalkReactions")
  talkChannelRoomRequests TalkChannelRoomRequest[] @relation("TalkChannelRoomRequester")

  // Talk V2 relations — legacy Talk tables above are intentionally not reused.
  talkV2RoomHosts                TalkV2Room[]                       @relation("TalkV2RoomHost")
  talkV2FanAccessPoliciesUpdated TalkV2FanAccessPolicy[]            @relation("TalkV2FanAccessPolicyUpdatedBy")
  talkV2FanActivityDaily         TalkV2FanActivityDaily[]
  talkV2Memberships              TalkV2RoomMembership[]
  talkV2AccessGrants             TalkV2RoomAccessGrant[]
  talkV2Messages                 TalkV2Message[]                    @relation("TalkV2MessageSender")
  talkV2MessageRecipients        TalkV2MessageRecipient[]
  talkV2MessageReactions         TalkV2MessageReaction[]
  talkV2FanThreads               TalkV2FanThread[]
  talkV2VisibilityReadStates     TalkV2VisibilityReadState[]
  talkV2DmRequestsSent           TalkV2DirectMessageRequest[]       @relation("TalkV2DmRequestSender")
  talkV2DmRequestsReceived       TalkV2DirectMessageRequest[]       @relation("TalkV2DmRequestRecipient")
  talkV2GroupInvitesSent         TalkV2GroupInvite[]                @relation("TalkV2GroupInviteInviter")
  talkV2GroupInvitesReceived     TalkV2GroupInvite[]                @relation("TalkV2GroupInviteInvitee")
  talkV2GroupMutationReceipts    TalkV2GroupMutationReceipt[]       @relation("TalkV2GroupMutationReceiptActor")
  talkV2BlocksMade               TalkV2Block[]                      @relation("TalkV2Blocker")
  talkV2BlocksReceived           TalkV2Block[]                      @relation("TalkV2Blocked")
  talkV2EventRecipients          TalkV2EventRecipient[]
  talkV2EventCursors             TalkV2EventCursor[]
  talkV2NotificationPreferences  TalkV2RoomNotificationPreference[]
  talkV2ModerationReports        TalkV2ModerationReport[]           @relation("TalkV2ReportReporter")
  talkV2LegacyArchiveAccesses    TalkV2LegacyArchiveAccess[]
  talkV2VoiceSessionsHosted      TalkV2VoiceSession[]               @relation("TalkV2VoiceSessionHost")
  talkV2VoiceParticipants        TalkV2VoiceParticipant[]
  talkV2VoiceJoinReceipts        TalkV2VoiceJoinReceipt[]           @relation("TalkV2VoiceJoinReceiptActor")
  talkV2VoiceArchiveConsents     TalkV2VoiceArchiveConsent[]
  talkV2AccountAccessRevocations TalkV2AccountAccessRevocation[]
  huyeorDonationRemoteAudits     HuyeorDonationRemoteAudit[]         @relation("HuyeorDonationRemoteAuditHost")
  huyeorReplaysHosted            HuyeorReplay[]                     @relation("HuyeorReplayHost")
  huyeorReplayTranscriptMessages HuyeorReplayTranscriptMessage[]    @relation("HuyeorReplayTranscriptAuthor")
  huyeorReplayComments           HuyeorReplayComment[]              @relation("HuyeorReplayCommentAuthor")

  // SyncRoom relations
  syncRooms        SyncRoom[]
  syncRoomChannels SyncRoomChannel[]

  // Playlist relations
  playlists Playlist[]

  // Spotlight relations
  spotlightOrders SpotlightOrder[]
  spotlightBlocks SpotlightBlock[]

  // Issue broadcast relations
  issueBroadcastOrders IssueBroadcastOrder[]

  // Organization relations
  organizationMembers    OrganizationMember[]
  orgInvitationsSent     OrganizationInvitation[] @relation("orgInviter")
  orgInvitationsReceived OrganizationInvitation[] @relation("orgInvitee")
  approvedOrgs           Organization[]           @relation("orgApprover")
  rejectedOrgs           Organization[]           @relation("orgRejector")
  decidedFeatures        OrganizationFeature[]    @relation("featureDecider")

  // SyncRoom Posts relations
  syncRoomPosts              SyncRoomPost[]              @relation("SyncRoomPostAuthor")
  syncRoomPostComments       SyncRoomPostComment[]       @relation("SyncRoomPostCommentAuthor")
  syncRoomPostSubscriptions  SyncRoomPostSubscription[]  @relation("SyncRoomPostSubscriber")
  syncSubscription           SyncSubscription?           @relation("SyncFeatureSubscriber")
  syncRoomPostReports        SyncRoomPostReport[]        @relation("SyncRoomPostReporter")
  syncRoomPostCommentReports SyncRoomPostCommentReport[] @relation("SyncRoomPostCommentReporter")

  // Bulk email platform relations
  marketingConsentLogs   MarketingConsentLog[]
  createdEmailCampaigns  EmailCampaign[]         @relation("UserCreatedEmailCampaigns")
  emailAdminAuditLogs    EmailAdminAuditLog[]    @relation("UserEmailAdminAuditLogs")
  emailUnsubscribeTokens EmailUnsubscribeToken[]

  // Unified ID onboarding. Absence means a legacy/exempt account.
  onboarding UserOnboarding?
  personas   UserPersona[]

  // Account security (MFA + passkeys)
  mfaMethods       UserMfaMethod[]
  mfaRecoveryCodes UserMfaRecoveryCode[]
  passkeys         UserPasskey[]

  // SNS publishing relations (Phase 2)
  snsCredentials          UserSnsCredential[]
  scheduleSnsPublications ScheduleSnsPublication[] @relation("ScheduleSnsPublicationUser")

  // Collection page relations
  collectionPagesOwned       CollectionPage[]       @relation("CollectionPageOwner")
  collectionPageReportsFiled CollectionPageReport[] @relation("CollectionPageReportReporter")

  // Meloming Store relations (Phase 0+)
  /// 멜로밍 스토어 선물 받기 토글 (스트리머용). User.acceptGifts(구독 선물용)와는 별도.
  giftReceivingEnabled                Boolean                          @default(false) @map("gift_receiving_enabled")
  /// 선물 수령용으로 지정한 StoreUserAddress (1명당 1개. unique FK)
  giftReceivingAddressId              Int?                             @unique(map: "users_gift_receiving_address_unique") @map("gift_receiving_address_id")
  giftReceivingAddress                StoreUserAddress?                @relation("UserGiftReceivingAddress", fields: [giftReceivingAddressId], references: [id])
  storeAddresses                      StoreUserAddress[]               @relation("UserStoreAddresses")
  storeOrdersReceived                 StoreOrder[]                     @relation("StoreOrderGiftRecipient")
  storeGiftRequestsReceived           StoreGiftRequest[]               @relation("StoreGiftRequestRecipient")
  storeGiftRequestsRequested          StoreGiftRequest[]               @relation("StoreGiftRequestRequester")
  storeKmsAuditLogs                   StoreKmsAuditLog[]
  storeReceiptsReceived               StoreGoodsReceipt[]              @relation("StoreReceiptReceiver")
  storeConsignmentDispatches          StoreConsignmentDispatch[]       @relation("StoreConsignmentDispatcher")
  storeWishlistItems                  StoreWishlistItem[]
  storeProductReviews                 StoreProductReview[]
  reviewsAuthored                     Review[]                         @relation("ReviewAuthor")
  reviewReactions                     ReviewReaction[]
  reviewRepliesAuthored               ReviewReply[]                    @relation("ReviewReplyAuthor")
  storePackagingMovements             StorePackagingMaterialMovement[]
  storeStocktakes                     StoreStocktake[]
  storeDiscountRedemptions            StoreDiscountRedemption[]
  storeRmaRequestsFiled               StoreRmaRequest[]                @relation("StoreRmaRequester")
  storeRmaRequestsResolved            StoreRmaRequest[]                @relation("StoreRmaResolver")
  storePickAndMixSnackRequests        StorePickAndMixSnackRequest[]    @relation("StorePickAndMixSnackRequester")
  storePickAndMixSnackRequestSmsSends StorePickAndMixSnackRequest[]    @relation("StorePickAndMixSnackRequestSmsSender")
  revenueCostEntriesRecorded          RevenueCostEntry[]               @relation("RevenueCostEntryRecorder")
  anongiftRecipientProfile            AnongiftRecipientProfile?
  anongiftOrdersSent                  AnongiftOrder[]                  @relation("AnongiftOrderSender")
  anongiftOrdersReceived              AnongiftOrder[]                  @relation("AnongiftOrderRecipient")

  // Voice Commission buyer orders
  voiceCommissionBuyerOrders VoiceCommissionOrder[] @relation("VoiceCommissionBuyer")

  // Homework Song buyer orders
  homeworkSongBuyerOrders HomeworkSongOrder[] @relation("HomeworkSongBuyer")

  // Meloming Rental relations
  rentalOrders                 RentalOrder[]               @relation("RentalOrderUser")
  rentalProductWishlistItems   RentalProductWishlistItem[]
  rentalAdditionalChargesFiled RentalAdditionalCharge[]    @relation("RentalAdditionalChargeAdmin")
  rentalOutboundShipmentsFiled RentalOutboundShipment[]    @relation("RentalOutboundShipmentAdmin")
  rentalReturnPickupsFiled     RentalReturnPickup[]        @relation("RentalReturnPickupAdmin")
  rentalInspectionsFiled       RentalInspection[]          @relation("RentalInspectionAdmin")
  rentalNotificationLogsFiled  RentalNotificationLog[]     @relation("RentalNotificationLogAdmin")

  @@index([phone], map: "idx_users_phone")
  @@map("users")
}

/// 개인정보 유출 사고 당시 확정된 사용자별 노출 코호트.
/// 현재 users/user_identity 상태와 분리된 불변 감사 데이터셋으로만 사용한다.
model PrivacyIncidentExposureSnapshot {
  id               BigInt   @id @default(autoincrement())
  incidentId       String   @map("incident_id") @db.VarChar(64)
  userId           Int      @map("user_id")
  audience         String   @db.VarChar(32)
  cohortKey        String   @map("cohort_key") @db.VarChar(32)
  sourceAuditToken String   @map("source_audit_token") @db.Char(64)
  sourceEventAt    DateTime @map("source_event_at") @db.DateTime(3)
  capturedAt       DateTime @default(now()) @map("captured_at") @db.DateTime(3)

  @@unique([incidentId, userId], map: "uq_privacy_incident_snapshot_incident_user")
  @@unique([incidentId, sourceAuditToken], map: "uq_privacy_incident_snapshot_incident_audit")
  @@index([userId], map: "idx_privacy_incident_snapshot_user")
  @@map("privacy_incident_exposure_snapshots")
}

enum UserMfaMethodType {
  TOTP
  SMS
  EMAIL
}

model UserMfaMethod {
  id              Int               @id @default(autoincrement())
  userId          Int               @map("user_id")
  type            UserMfaMethodType
  secretEncrypted String?           @map("secret_encrypted") @db.LongText
  enabled         Boolean           @default(false)
  verifiedAt      DateTime?         @map("verified_at") @db.DateTime(0)
  lastUsedAt      DateTime?         @map("last_used_at") @db.DateTime(0)
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, type], map: "uq_user_mfa_methods_user_type")
  @@index([userId, enabled], map: "idx_user_mfa_methods_user_enabled")
  @@map("user_mfa_methods")
}

model UserMfaRecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @unique(map: "uq_user_mfa_recovery_codes_hash") @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, usedAt], map: "idx_user_mfa_recovery_codes_user_used")
  @@map("user_mfa_recovery_codes")
}

model UserPasskey {
  id                   Int       @id @default(autoincrement())
  userId               Int       @map("user_id")
  credentialId         String    @unique(map: "uq_user_passkeys_credential_id") @map("credential_id") @db.VarChar(512)
  publicKey            String    @map("public_key") @db.LongText
  counter              BigInt    @default(0)
  transports           Json?
  credentialDeviceType String    @map("credential_device_type") @db.VarChar(32)
  credentialBackedUp   Boolean   @default(false) @map("credential_backed_up")
  name                 String    @db.VarChar(80)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  lastUsedAt           DateTime? @map("last_used_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt], map: "idx_user_passkeys_user_created")
  @@map("user_passkeys")
}

model UserOnboarding {
  userId              Int              @id @map("user_id")
  version             Int              @default(1)
  status              OnboardingStatus @default(PENDING)
  currentStep         Int              @default(1) @map("current_step")
  termsAcceptedAt     DateTime?        @map("terms_accepted_at") @db.DateTime(0)
  profileConfirmedAt  DateTime?        @map("profile_confirmed_at") @db.DateTime(0)
  personasSelectedAt  DateTime?        @map("personas_selected_at") @db.DateTime(0)
  tasksShownAt        DateTime?        @map("tasks_shown_at") @db.DateTime(0)
  marketingPromptedAt DateTime?        @map("marketing_prompted_at") @db.DateTime(0)
  completedAt         DateTime?        @map("completed_at") @db.DateTime(0)
  createdAt           DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, createdAt], map: "idx_user_onboardings_status_created")
  @@map("user_onboardings")
}

model UserPersona {
  id        Int             @id @default(autoincrement())
  userId    Int             @map("user_id")
  persona   UserPersonaType
  isPrimary Boolean         @default(false) @map("is_primary")
  createdAt DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, persona], map: "uq_user_personas_user_persona")
  @@index([userId, isPrimary], map: "idx_user_personas_user_primary")
  @@map("user_personas")
}

model PendingRegistration {
  id               Int       @id @default(autoincrement())
  email            String    @unique(map: "pending_registrations_email_unique")
  password         String    @db.VarChar(255)
  nickname         String    @db.VarChar(255)
  profileImageUrl  String?   @map("profile_image_url") @db.VarChar(500)
  referralCode     String?   @map("referral_code") @db.VarChar(255)
  marketingConsent Boolean?  @map("marketing_consent")
  webPath          String    @unique(map: "pending_registrations_web_path_unique") @map("web_path") @db.VarChar(255)
  platformUrl      String?   @unique(map: "pending_registrations_platform_url_unique") @map("platform_url")
  additionalLinks  Json      @map("additional_links")
  themeColor       String?   @default("#3B82F6") @map("theme_color")
  createdAt        DateTime? @default(now()) @map("created_at") @db.DateTime(0)

  @@map("pending_registrations")
}

model Category {
  id             Int            @id @default(autoincrement())
  name           String
  color          String
  channelId      Int            @map("channel_id")
  displayOrder   Int?           @map("display_order")
  price          Int? // 카테고리별 가격 (신청곡 기능용)
  currencyPrices Json?          @map("currency_prices") // 재화별 카테고리 가격
  createdAt      DateTime?      @default(now()) @map("created_at") @db.DateTime(0)
  channel        Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "categories_channel_id_fkey")
  songCategories SongCategory[]

  @@index([channelId], map: "idx_categories_channel_id")
  @@index([channelId, displayOrder], map: "idx_categories_channel_display_order")
  @@map("categories")
}

model Artist {
  id             Int       @id @default(autoincrement())
  name           String
  /// 검색용 정규화 키 — NFKC + lowercase + 공백/비가시 문자 제거된 name.
  /// normalizeForSearch() 와 동기화 (src/song/utils/search-normalize.ts).
  /// 노래책 검색에서 `nameSearchable contains` 로 매칭에 사용된다.
  /// NOT NULL — backfill 완료 후 schema 차원에서 NULL 잔존 방지.
  /// 새 mutation path 가 normalize 호출을 잊으면 INSERT 가 즉시 fail.
  nameSearchable String    @default("") @map("name_searchable") @db.VarChar(255)
  channelId      Int       @map("channel_id")
  createdAt      DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  channel        Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "artists_channel_id_fkey")
  songs          Song[]

  @@index([channelId], map: "idx_artists_channel_id")
  @@index([nameSearchable], map: "idx_artists_name_searchable")
  @@map("artists")
}

model Song {
  id                      Int            @id @default(autoincrement())
  title                   String
  /// 검색용 정규화 키 — NFKC + lowercase + 공백/비가시 문자 제거된 title.
  /// normalizeForSearch() 와 동기화 (src/song/utils/search-normalize.ts).
  /// 노래책 검색에서 `titleSearchable contains` 로 매칭에 사용된다.
  /// NOT NULL — backfill 완료 후 schema 차원에서 NULL 잔존 방지.
  /// 새 mutation path 가 normalize 호출을 잊으면 INSERT 가 즉시 fail.
  titleSearchable         String         @default("") @map("title_searchable") @db.VarChar(255)
  artistId                Int            @map("artist_id")
  channelId               Int            @map("channel_id")
  globalSongId            Int?           @map("global_song_id")
  albumArt                String?        @map("album_art") @db.Text
  karaokeUrl              String?        @map("karaoke_url") @db.Text
  /// media-gateway-cdn object cache key. 채워져 있으면 CDN URL 발급, 비면 /play write-through.
  /// 형식: `youtube/{videoId}/itag18.mp4` (buildR2CacheKey)
  r2CacheKey              String?        @map("r2_cache_key") @db.VarChar(200)
  coverUrl                String?        @map("cover_url") @db.Text
  originalUrl             String?        @map("original_url") @db.Text
  /// 업로드된 MR 영상 public URL. 값이 있으면 리모컨 재생에서 karaoke/original URL보다 우선한다.
  mrVideoUrl              String?        @map("mr_video_url") @db.Text
  /// meloming-upload S3 object key. 삭제/검증용이며 public URL은 mrVideoUrl에 보관한다.
  mrVideoKey              String?        @map("mr_video_key") @db.VarChar(500)
  difficulty              Int?           @default(1)
  proficiency             Int?
  songKey                 String?        @map("song_key")
  bpm                     Int?
  /// 콘솔(리모컨) 키 조절(pitch shift) 저장값. 사용자가 영상에서 키 맞춘 뒤 명시적으로 저장한
  /// semitone 오프셋. -12..+12 (UI 는 ±6 으로 클램프). 본질적으로 영상-종속이라
  /// karaokeUrl 이 바뀌면 자동 null 로 초기화되어야 한다 (r2CacheKey 와 동일 패턴).
  preferredPitchSemitones Int?           @map("preferred_pitch_semitones")
  /// 콘솔 가사 sync 보정값(ms). 현재 karaokeUrl 영상에 대한 denormalized 값.
  /// source of truth 는 SongVideoPreference 이며 기존 큐/소켓 payload 호환용으로 유지한다.
  preferredLyricsOffsetMs Int?           @map("preferred_lyrics_offset_ms")
  lyricsLink              String?        @map("lyrics_link") @db.Text
  lyricsText              String?        @map("lyrics_text") @db.Text
  description             String?        @db.Text
  price                   Int? // 곡 자체 가격 (신청곡 기능용)
  currencyPrices          Json?          @map("currency_prices") // 재화별 곡 가격
  createdAt               DateTime?      @default(now()) @map("created_at") @db.DateTime(0)
  songCategories          SongCategory[]
  channel                 Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_songs_channel_id")
  artist                  Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "songs_ibfk_2")
  globalSong              GlobalSong?    @relation(fields: [globalSongId], references: [id], onDelete: SetNull)
  userLikes               UserSongLike[]

  // Song request relations
  songRequests SongRequest[]

  // Clip relations
  clipChannels ClipChannel[]
  clipRequests ClipRequest[]

  // SongAddRequest relation
  songAddRequest SongAddRequest?

  // Sheet music relation (Phase 1.6)
  sheetMusics SongSheetMusic[]

  // Console video-specific preferences. `preferredLyricsOffsetMs` remains as
  // a denormalized current-video value for existing queue/socket payloads.
  videoPreferences SongVideoPreference[]

  // (channel_id, global_song_id) UNIQUE — 노래책 추가 race 방지 + Song duplicate 데이터 정합성.
  // global_song_id NULL 인 row 는 MySQL 동작상 다중 허용되므로 미매핑 곡에는 영향 없음.
  // prod 기존 중복 row(335개)는 사전 정제 후 적용 — prisma/data-cleanup/2026-05-09-dedupe-songs-channel-globalsong.sql
  @@unique([channelId, globalSongId], map: "unique_songs_channel_globalsong")
  @@index([channelId], map: "idx_songs_channel_id")
  @@index([artistId], map: "idx_songs_artist_id")
  @@index([titleSearchable], map: "idx_songs_title_searchable")
  @@map("songs")
}

/// media-gateway-cdn R2 캐시 entry. video 단위(videoId PK)로 1:1 — Song row와
/// 무관하게 같은 영상은 한 번만 cached. console-playback / warming 모두 이 테이블만 본다.
/// (legacy `Song.r2_cache_key` 는 deprecate 후 별도 PR 에서 drop 예정)
model VideoCacheEntry {
  videoId   String    @id @map("video_id") @db.VarChar(20)
  r2Key     String    @map("r2_key") @db.VarChar(200)
  itag      String    @default("18") @db.VarChar(20)
  source    String    @default("youtube") @db.VarChar(20)
  cachedAt  DateTime  @default(now()) @map("cached_at") @db.DateTime(0)
  lastHitAt DateTime? @map("last_hit_at") @db.DateTime(0)

  @@map("video_cache_entries")
}

model SongVideoPreference {
  id                      Int      @id @default(autoincrement())
  songId                  Int      @map("song_id")
  /// Stable key for the karaoke/MR video. YouTube URLs use `youtube:{videoId}`;
  /// non-YouTube URLs use `url:{sha256(normalizedUrl)}`.
  videoKey                String   @map("video_key") @db.VarChar(128)
  videoId                 String?  @map("video_id") @db.VarChar(20)
  videoUrl                String?  @map("video_url") @db.Text
  preferredLyricsOffsetMs Int?     @map("preferred_lyrics_offset_ms")
  createdAt               DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([songId, videoKey], map: "unique_song_video_preferences_song_video")
  @@index([videoId], map: "idx_song_video_preferences_video_id")
  @@map("song_video_preferences")
}

enum SheetMusicType {
  PDF
  IMAGE
  MUSICXML
}

model SongSheetMusic {
  id        Int            @id @default(autoincrement())
  // Phase 2 (2026-05-06): @unique 제거. 한 곡에 여러 슬롯 (PDF + Image 혼용,
  // 다중 페이지 사진) 가능. 동시성 race 는 application 레이어가 capacity 검증
  // 과 sortOrder 계산을 트랜잭션 안에서 처리.
  songId    Int
  url       String         @db.Text
  type      SheetMusicType
  fileName  String?        @db.VarChar(255)
  fileSize  Int?
  // Phase 2: 슬롯 정렬 키. 새 row 는 max(sortOrder)+1 로 추가. drag-reorder 시
  // PATCH /reorder 가 일괄 갱신. 같은 songId 안에서만 의미.
  sortOrder Int            @default(0)
  // Phase 2 잔재 — 기존 단일 contract 코드 호환을 위해 유지. sortOrder == 0
  // 슬롯이 sheetMusicUrl/Type 레거시 필드로 노출되는 첫 row. Phase 2C 에서 제거.
  isPrimary Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId, sortOrder])
}

model SongCategory {
  id         Int      @id @default(autoincrement())
  songId     Int      @map("song_id")
  categoryId Int      @map("category_id")
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "song_categories_ibfk_1")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "song_categories_ibfk_2")

  @@index([categoryId], map: "idx_song_categories_category_id")
  @@index([songId], map: "idx_song_categories_song_id")
  @@map("song_categories")
}

model Announcement {
