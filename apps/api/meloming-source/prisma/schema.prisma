/// 라이브 신청곡 가사 노출의 FREE/PRO 7일 한도 설정.
/// limit=null은 무제한이며, row가 아직 없을 때도 서비스는 무제한으로 해석한다.
model LyricsQuotaSettings {
  id              Int      @id @default(1)
  freeLimit       Int?     @map("free_limit")
  proLimit        Int?     @map("pro_limit")
