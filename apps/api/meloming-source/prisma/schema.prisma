  @@index([expiresAt])
  @@map("talk_v2_voice_host_leases")
}

model TalkV2VoiceRecording {
  id                    String                    @id @default(cuid()) @db.VarChar(36)
  sessionId             String                    @unique @map("session_id") @db.VarChar(36)
  state                 TalkV2VoiceRecordingState @default(DISABLED)
  providerRecordingId   String?                   @unique @map("provider_recording_id") @db.VarChar(191)
  storageKey            String?                   @map("storage_key") @db.Text
  startedAt             DateTime?                 @map("started_at") @db.DateTime(0)
  completedAt           DateTime?                 @map("completed_at") @db.DateTime(0)
  expiresAt             DateTime?                 @map("expires_at") @db.DateTime(0)
  lastError             String?                   @map("last_error") @db.Text
  // Retention purge is an at-least-once provider command. The per-attempt
  // claim fence prevents a stale worker from overwriting a newer completion
  // or retry outcome after a lease has been reclaimed.
  purgeAttemptCount     Int                       @default(0) @map("purge_attempt_count")
  purgeAvailableAt      DateTime?                 @map("purge_available_at") @db.DateTime(0)
  purgeLockedBy         String?                   @map("purge_locked_by") @db.VarChar(191)
  purgeLockedAt         DateTime?                 @map("purge_locked_at") @db.DateTime(0)
  // A terminal prefix/fence rejection is held for audited manual resolution;
  // it must not become an endless retention purge loop.
  purgeTerminalAt       DateTime?                 @map("purge_terminal_at") @db.DateTime(0)
  purgeTerminalMarkerId String?                   @map("purge_terminal_marker_id") @db.VarChar(36)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.DateTime(0)

  session TalkV2VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([state, expiresAt, purgeTerminalAt])
  @@index([state, expiresAt, purgeAvailableAt, purgeLockedAt, purgeTerminalAt], map: "idx_tv2_voice_recording_purge_claim")
  @@index([purgeTerminalMarkerId], map: "idx_tv2_voice_recording_purge_terminal_marker")
  @@map("talk_v2_voice_recordings")
}

// One immutable operator request is allowed for each server-generated
// terminal marker. The mutable row is a one-shot command job; every state
// transition is also written to the append-only audit table below.
model TalkV2VoiceOperatorResolution {
  id                    String                                  @id @default(cuid()) @db.VarChar(36)
  operatorRequestId     String                                  @unique @map("operator_request_id") @db.VarChar(36)
  targetKind            TalkV2VoiceOperatorResolutionTargetKind @map("target_kind")
  targetId              String                                  @map("target_id") @db.VarChar(36)
  sessionId             String                                  @map("session_id") @db.VarChar(36)
  terminalMarkerId      String                                  @map("terminal_marker_id") @db.VarChar(36)
  safeErrorCode         String                                  @map("safe_error_code") @db.VarChar(64)
  reasonCode            String                                  @map("reason_code") @db.VarChar(64)
  incidentRef           String                                  @map("incident_ref") @db.VarChar(100)
  actorUserId           Int                                     @map("actor_user_id")
  actorIp               String?                                 @map("actor_ip") @db.VarChar(64)
  actorUserAgent        String?                                 @map("actor_user_agent") @db.VarChar(512)
  status                TalkV2VoiceOperatorResolutionStatus     @default(PENDING)
  attemptCount          Int                                     @default(0) @map("attempt_count")
  lockedBy              String?                                 @map("locked_by") @db.VarChar(191)
  lockedAt              DateTime?                               @map("locked_at") @db.DateTime(0)
  leaseExpiresAt        DateTime?                               @map("lease_expires_at") @db.DateTime(0)
  commandAttemptedAt    DateTime?                               @map("command_attempted_at") @db.DateTime(0)
  commandAcceptedAt     DateTime?                               @map("command_accepted_at") @db.DateTime(0)
  // A bounded confirmation scan must rotate through old accepted/unknown
  // jobs. This timestamp records observation only; it never authorizes a
  // second provider command.
  confirmationCheckedAt DateTime?                               @map("confirmation_checked_at") @db.DateTime(0)
  confirmedAt           DateTime?                               @map("confirmed_at") @db.DateTime(0)
  lastError             String?                                 @map("last_error") @db.VarChar(64)
  createdAt             DateTime                                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime                                @updatedAt @map("updated_at") @db.DateTime(0)

  audits TalkV2VoiceOperatorResolutionAudit[]

  @@unique([targetKind, targetId, terminalMarkerId], map: "talk_v2_voice_operator_resolution_marker_key")
  @@index([status, createdAt], map: "idx_tv2_voice_operator_resolution_status_created")
  @@index([status, leaseExpiresAt], map: "idx_tv2_voice_operator_resolution_status_lease")
  @@index([status, confirmationCheckedAt, createdAt], map: "idx_tv2_voice_operator_resolution_confirmation_scan")
  @@index([sessionId, createdAt], map: "idx_tv2_voice_operator_resolution_session_created")
  @@map("talk_v2_voice_operator_resolutions")
}

model TalkV2VoiceOperatorResolutionAudit {
  id            String                                   @id @default(cuid()) @db.VarChar(36)
  resolutionId  String                                   @map("resolution_id") @db.VarChar(36)
  action        TalkV2VoiceOperatorResolutionAuditAction
  actorUserId   Int?                                     @map("actor_user_id")
  safeErrorCode String?                                  @map("safe_error_code") @db.VarChar(64)
  createdAt     DateTime                                 @default(now()) @map("created_at") @db.DateTime(0)

  resolution TalkV2VoiceOperatorResolution @relation(fields: [resolutionId], references: [id], onDelete: Restrict, map: "tv2_voice_operator_audit_resolution_fkey")

  @@index([resolutionId, createdAt], map: "idx_tv2_voice_operator_resolution_audit_resolution")
  @@map("talk_v2_voice_operator_resolution_audits")
}

model TalkV2VoiceArchiveConsent {
