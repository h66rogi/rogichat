/// 반복 일정 (요일별 정기 방송/휴방)
model ChannelRecurringSchedule {
  id        Int                     @id @default(autoincrement())
  channelId Int                     @map("channel_id")
  dayOfWeek Int                     @map("day_of_week") // 0(일) ~ 6(토)
  title     String                  @db.VarChar(100) // 일정 이름 (자동 생성 일정의 제목으로 사용)
  startTime String?                 @map("start_time") @db.VarChar(5) // "HH:mm", 휴방은 null
  status    RecurringScheduleStatus @default(LIVE)
  isActive  Boolean                 @default(true) @map("is_active")
  createdAt DateTime                @default(now()) @map("created_at") @db.DateTime(0)
