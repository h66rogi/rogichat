}

// ===================================
// Homework Song domain
// ===================================

enum HomeworkSongStatus {
  PENDING_PAYMENT  @map("pending_payment")
  PENDING_REVIEW   @map("pending_review") // 결제 완료, 채널 수락 대기
  IN_PROGRESS      @map("in_progress") // 수락 -> 연습 중
  DELIVERED        @map("delivered") // 노래 영상 클립 업로드
  COMPLETED        @map("completed")
  DECLINED         @map("declined")
  AUTO_CANCELED    @map("auto_canceled") // 납품기한 초과 자동 환불
  REFUND_REQUESTED @map("refund_requested")
  REFUNDED         @map("refunded")
}

// 채널별 숙제곡 설정 (단가 + 기한 선설정)
model HomeworkSongChannel {
  id        Int     @id @default(autoincrement())
  channelId Int?     @unique @map("channel_id")
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  isActive        Boolean @default(false) @map("is_active") // 11.4 게이팅 통과 시에만 true
  acceptingOrders Boolean @default(true) @map("accepting_orders")
  maxConcurrent   Int     @default(3) @map("max_concurrent")

  price        Int // 숙제곡 1건 단가 (VAT 포함)
  deliveryDays Int     @map("delivery_days") // 납품기한 (1..60, 1일 단위)
  introduction String? @db.Text
  guide        String? @db.Text

  totalOrders Int      @default(0) @map("total_orders")
  avgRating   Decimal? @map("avg_rating") @db.Decimal(3, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders HomeworkSongOrder[]

  @@index([isActive])
  @@map("homework_song_channels")
}

model HomeworkSongOrder {
  id      Int   @id @default(autoincrement())
  orderId Int   @unique @map("order_id")
  order   Order @relation(fields: [orderId], references: [id])

  hsChannelId Int                 @map("hs_channel_id")
  hsChannel   HomeworkSongChannel @relation(fields: [hsChannelId], references: [id])
  buyerId     Int                 @map("buyer_id")
  buyer       User                @relation("HomeworkSongBuyer", fields: [buyerId], references: [id])

  // 결제 스냅샷 (gross 기준)
  grossAmount  Int @map("gross_amount")
  supplyAmount Int @map("supply_amount")
  vatAmount    Int @map("vat_amount")

  // 신청 곡 정보 (자유 입력 — 노래책 연동 X)
  songTitle    String  @map("song_title")
  songArtist   String? @map("song_artist")
  referenceUrl String? @map("reference_url") // 원곡 참고 링크 (유튜브 등)
  buyerNote    String? @map("buyer_note") @db.Text

  // 라이프사이클
  status         HomeworkSongStatus @default(PENDING_PAYMENT)
  acceptedAt     DateTime?          @map("accepted_at")
  declinedAt     DateTime?          @map("declined_at")
  declineReason  String?            @map("decline_reason")
  deadlineAt     DateTime?          @map("deadline_at") // 수락 시점 + hsChannel.deliveryDays (납품기한)
  deliveredAt    DateTime?          @map("delivered_at")
  autoCanceledAt DateTime?          @map("auto_canceled_at")
  refundedAt     DateTime?          @map("refunded_at")
  completedAt    DateTime?          @map("completed_at")

  payoutEmittedAt DateTime? @map("payout_emitted_at")
  payoutEventId   String?   @map("payout_event_id")

  reviewRating Int?      @map("review_rating")
  reviewText   String?   @map("review_text") @db.Text
  reviewedAt   DateTime? @map("reviewed_at")

  delivery HomeworkSongDelivery?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hsChannelId, status])
  @@index([buyerId, status])
  @@index([status, deadlineAt])
  @@map("homework_song_orders")
}

model HomeworkSongDelivery {
  id      Int               @id @default(autoincrement())
  orderId Int               @unique @map("order_id")
  order   HomeworkSongOrder @relation(fields: [orderId], references: [id])

  // 결과물 = 파일 업로드 또는 외부 링크 (둘 중 하나). 파일/링크 내용 검증 X
  videoFileKey    String? @map("video_file_key") // S3 key (파일 업로드 시)
  deliveryUrl     String? @map("delivery_url") // 외부 링크 (유튜브 등) — 검증 안 함
  durationSeconds Int?    @map("duration_seconds")
  fileSizeBytes   Int?    @map("file_size_bytes")

  // 노래책 추가 (납품 과정에 포함 — 채널이 deliver 시 함께 입력)
  songbookTitle   String? @map("songbook_title") // 노래책에 추가할 곡 제목
  songbookArtist  String? @map("songbook_artist")
  addedToSongbook Boolean @default(false) @map("added_to_songbook") // 실제 노래책 반영 완료 여부

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("homework_song_deliveries")
}
