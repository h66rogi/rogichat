  rewardUsedAmount    Int               @default(0) @map("reward_used_amount")
  rewardEarnedAmount  Int               @default(0) @map("reward_earned_amount")
  rewardEarnRateBps   Int               @default(0) @map("reward_earn_rate_bps")
  rewardSettledAt     DateTime?         @map("reward_settled_at") @db.DateTime(0)
  totalPayableAmount  Int               @map("total_payable_amount")
  status              OrderStatus       @default(PENDING)
  pgOrderId           String?           @map("pg_order_id") @db.VarChar(64)
  version             Int               @default(1)
  userInput           Json?             @map("user_input")
  createdAt           DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.DateTime(0)

  // Relations
  payments                   Payment[]
  promotionOrders            PromotionOrder[]
  subscriptionOrders         SubscriptionOrder[]
  subscriptionTerm           UserSubscriptionTerm?
  couponRedemptions          CouponRedemption[]
  usedCoupons                Coupon[]                    @relation("CouponUsedOrder")
  // adjustments removed
  spotlightOrders            SpotlightOrder[]
  issueBroadcastOrders       IssueBroadcastOrder[]
  activationFailureJobs      ActivationFailureJob[]
  storeOrders                StoreOrder[]
  storeProductReviews        StoreProductReview[]
  reviews                    Review[]
  anongiftOrder              AnongiftOrder?
