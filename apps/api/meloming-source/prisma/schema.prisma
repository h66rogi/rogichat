  imageUrl             String?       @map("image_url") @db.VarChar(500)
  pinnedMessageId      Int?          @unique @map("pinned_message_id")
  dmUserMinId          Int?          @map("dm_user_min_id")
  dmUserMaxId          Int?          @map("dm_user_max_id")
  dmRequestSenderId    Int?          @map("dm_request_sender_id")
  dmRequestRecipientId Int?          @map("dm_request_recipient_id")
