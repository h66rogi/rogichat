// ===================================
// Clip domain (유튜브/SOOP/CHZZK 클립)
// ===================================

/// 클립 플랫폼 (트위치 제외)
enum ClipPlatform {
  YOUTUBE  @map("youtube")
  SOOP     @map("soop")
  CHZZK    @map("chzzk")
  MELOMING @map("meloming") // recording-worker 자동 생성 또는 자체 호스팅 클립 (videoUrl 직접 저장)
}

/// 클립 재생 방식 (player 분기 기준).
/// EMBED       : iframe 임베드 (YouTube/SOOP/CHZZK + 외부 임베드 가능 URL).
/// DIRECT_FILE : HTML5 <video> 직접 재생 (mp4/webm 등). selfHosted=true 면 backend
///               S3 의 key 라 presigned URL 발급, false 면 외부 직접 URL.
/// HLS/DASH 는 worker 가 그 format 을 출력 시작할 때 enum 확장.
enum ClipMediaType {
  EMBED       @map("embed")
  DIRECT_FILE @map("direct_file")
}

/// 클립 콘텐츠 분류. 채널 클립 탭 안에서 노래 기반 클립과 직접 업로드 영상,
/// 이후 다시보기/기타 영상 도메인을 같은 aggregate 로 확장하기 위한 기준.
enum ClipContentType {
  SONG_CLIP     @map("song_clip")
  UPLOADED_CLIP @map("uploaded_clip")
}

/// 클립 모델 (메인)
model Clip {
  id               Int             @id @default(autoincrement())
  title            String          @db.VarChar(255)
  description      String?         @db.Text
  platform         ClipPlatform    @default(MELOMING)
  videoId          String?         @map("video_id") @db.VarChar(100) // YouTube/SOOP/CHZZK ID (프론트 렌더링용)
  videoUrl         String?         @map("video_url") @db.Text // MELOMING 플랫폼용 또는 전체 URL. selfHosted=true 인 경우 backend S3 key.
  thumbnailUrl     String?         @map("thumbnail_url") @db.Text
  duration         Int? // 초 단위
  status           PostStatus?     @default(VISIBLE)
  contentType      ClipContentType @default(SONG_CLIP) @map("content_type")
  publishToHotClip Boolean         @default(true) @map("publish_to_hot_clip")

  // 재생 방식 (player 분기 — EMBED ↔ iframe / DIRECT_FILE ↔ HTML5 video)
  mediaType     ClipMediaType @default(EMBED) @map("media_type")
  // backend S3 자체 보관 여부. true 면 videoUrl 이 S3 key 이고 presigned URL 발급 path.
  // 자동 게시 클립 + (장래) 사용자 mp4 직접 업로드 시 true.
  selfHosted    Boolean       @default(false) @map("self_hosted")
  // recording-worker session-wide agent 자동 생성 여부 (badge 분기).
  autoGenerated Boolean       @default(false) @map("auto_generated")

  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)

  // N:M 관계 (채널-노래 세트)
  clipChannels ClipChannel[] // 1개 이상 필수
  stat         ClipStat?
  comments     ClipComment[]
  replies      ClipReply[]
  views        ClipView[] // CF용 조회 기록

  // 클립 신청으로부터 승인된 경우
  approvedRequest ClipRequest?

  // Playlist relations
  playlistClips PlaylistClip[]

  // YouTube 영상 ↔ 클립 1:1 매칭 (Phase 3 자동 매칭 결과)
  matchedYouTubeVideo YouTubeVideo? @relation("YouTubeVideoMatchedClip")

  // 이 Clip 을 source 로 가리키는 SongRequest 들 (autoGenerated=true 인 경우).
  // 단일 채널 자동 게시: 1 SongRequest. 멀티채널 콜라보 라이브 (멜로밍 싱크): N SongRequest.
  sourceSongRequests SongRequest[] @relation("SongRequestAutoClip")

  // 사용자 신고 (잘못된 클립 식별 등)
  reports ClipReport[]

  @@index([status, createdAt], map: "idx_clips_status_created")
  @@index([platform, videoId], map: "idx_clips_platform_video_id")
  @@index([contentType, status, createdAt], map: "idx_clips_content_type_status_created")
  @@index([publishToHotClip, status, createdAt], map: "idx_clips_hot_publish_status_created")
  @@index([autoGenerated, status], map: "idx_clips_auto_generated_status")
  @@index([mediaType, selfHosted], map: "idx_clips_media_type_self_hosted")
  @@map("clips")
}

/// 사용자 클립 신고 — 자동 게시 false positive (잘못된 곡 등) 빠른 발견 + 어드민 review 큐.
model ClipReport {
  id        Int      @id @default(autoincrement())
  clipId    Int      @map("clip_id")
  userId    Int?     @map("user_id")
  reason    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  clip Clip  @relation(fields: [clipId], references: [id], onDelete: Cascade)
  user User? @relation("UserClipReports", fields: [userId], references: [id], onDelete: SetNull)

  @@index([clipId], map: "idx_clip_reports_clip")
  @@index([createdAt], map: "idx_clip_reports_created")
  @@map("clip_reports")
}

/// 클립-채널-노래 중간 테이블
/// 듀엣/단체곡 지원을 위해 하나의 클립에 여러 채널 연결 가능
/// isPrimary: 메인 채널(소유권, 수정/삭제 권한), 태그 채널(출연 표시만)
model ClipChannel {
  id        Int      @id @default(autoincrement())
  clipId    Int      @map("clip_id")
  channelId Int      @map("channel_id")
  songId    Int?     @map("song_id") // 노래클립은 필수, 업로드 클립은 null
  isPrimary Boolean  @default(false) @map("is_primary") // 메인 채널 여부
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  clip    Clip    @relation(fields: [clipId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  song    Song?   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([clipId, channelId], map: "uq_clip_channel") // 한 클립에 같은 채널 중복 방지
  @@index([clipId], map: "idx_clip_channels_clip_id")
  @@index([channelId], map: "idx_clip_channels_channel_id")
  @@index([songId], map: "idx_clip_channels_song_id")
  @@index([isPrimary], map: "idx_clip_channels_is_primary")
  @@map("clip_channels")
}

/// 클립 통계
/// 주의: hotScore는 내부 정렬용으로만 사용, API 응답에 절대 노출 금지!
model ClipStat {
  clipId       Int   @id @map("clip_id")
  likeCount    Int   @default(0) @map("like_count")
  commentCount Int   @default(0) @map("comment_count")
  viewCount    Int   @default(0) @map("view_count")
  hotScore     Float @default(0) @map("hot_score") // API 응답에서 제외

  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([hotScore], map: "idx_clip_stats_hot_score")
  @@map("clip_stats")
}

/// 클립 조회 기록 (Collaborative Filtering 용)
/// User-Clip 그래프의 엣지 역할
model ClipView {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  clipId        Int      @map("clip_id")
  viewedAt      DateTime @default(now()) @map("viewed_at") @db.DateTime(0)
  watchDuration Int?     @map("watch_duration") // 시청 시간 (초 단위)
  completed     Boolean  @default(false) // 시청 완료 여부
  ip            String?  @db.VarChar(45) // IPv6 대응
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  referrer      String?  @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt], map: "idx_clip_views_user_viewed")
  @@index([clipId, viewedAt], map: "idx_clip_views_clip_viewed")
  @@index([userId, clipId], map: "idx_clip_views_user_clip") // CF 쿼리 최적화
  @@map("clip_views")
}

/// 클립 댓글 (1-depth)
model ClipComment {
  id        Int         @id @default(autoincrement())
  clipId    Int         @map("clip_id")
  userId    Int         @map("user_id")
  content   String      @db.Text
  status    PostStatus? @default(VISIBLE)
  createdAt DateTime?   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime?   @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt DateTime?   @map("deleted_at") @db.DateTime(0)

  clip    Clip        @relation(fields: [clipId], references: [id], onDelete: Cascade)
  author  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies ClipReply[]

  @@index([clipId, createdAt], map: "idx_clip_comments_clip_created")
  @@index([userId, createdAt], map: "idx_clip_comments_user_created")
  @@map("clip_comments")
}

/// 클립 대댓글 (2-depth)
model ClipReply {
  id        Int         @id @default(autoincrement())
  clipId    Int         @map("clip_id")
  commentId Int         @map("comment_id")
  userId    Int         @map("user_id")
  content   String      @db.Text
  status    PostStatus? @default(VISIBLE)
  createdAt DateTime?   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime?   @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt DateTime?   @map("deleted_at") @db.DateTime(0)

  clip    Clip        @relation(fields: [clipId], references: [id], onDelete: Cascade)
  comment ClipComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clipId, createdAt], map: "idx_clip_replies_clip_created")
  @@index([commentId, createdAt], map: "idx_clip_replies_comment_created")
  @@index([userId, createdAt], map: "idx_clip_replies_user_created")
  @@map("clip_replies")
}

// ===================================
// Playlist domain
// ===================================

model Playlist {
  id           Int                @id @default(autoincrement())
  shareKey     String             @unique @default(uuid()) @map("share_key") @db.VarChar(36)
  ownerType    PlaylistOwnerType  @map("owner_type")
  userId       Int?               @map("user_id")
  channelId    Int?               @map("channel_id")
  title        String             @db.VarChar(100)
  description  String?            @db.VarChar(500)
  thumbnailUrl String?            @map("thumbnail_url") @db.Text
  visibility   PlaylistVisibility @default(PUBLIC)
  status       PostStatus?        @default(VISIBLE)
  clipsVersion Int                @default(0) @map("clips_version")
  createdAt    DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt    DateTime?          @map("deleted_at") @db.DateTime(0)

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       Channel?       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  playlistClips PlaylistClip[]
  stat          PlaylistStat?

  @@index([userId, status], map: "idx_playlists_user_status")
  @@index([channelId, status], map: "idx_playlists_channel_status")
  @@index([visibility, status, createdAt], map: "idx_playlists_visibility_status_created")
  @@map("playlists")
}

model PlaylistClip {
  id         Int      @id @default(autoincrement())
  playlistId Int      @map("playlist_id")
  clipId     Int      @map("clip_id")
  position   Int
  addedAt    DateTime @default(now()) @map("added_at") @db.DateTime(0)

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  clip     Clip     @relation(fields: [clipId], references: [id], onDelete: Restrict)

  @@unique([playlistId, clipId], map: "uq_playlist_clips_playlist_clip")
  @@unique([playlistId, position], map: "uq_playlist_clips_playlist_position")
  @@index([clipId], map: "idx_playlist_clips_clip_id")
  @@map("playlist_clips")
}

model PlaylistStat {
  playlistId Int   @id @map("playlist_id")
  clipCount  Int   @default(0) @map("clip_count")
  viewCount  Int   @default(0) @map("view_count")
  saveCount  Int   @default(0) @map("save_count")
  hotScore   Float @default(0) @map("hot_score")

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([hotScore], map: "idx_playlist_stats_hot_score")
  @@map("playlist_stats")
}

// ===================================
// Clip Request domain
// ===================================

enum ClipRequestStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
  CANCELED @map("canceled")
}

enum SongAddRequestStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
  CANCELED @map("canceled")
}

/// 클립 등록 신청 모델
/// 권한 없는 사용자가 특정 채널에 클립 등록을 신청할 때 사용
model ClipRequest {
  id               Int               @id @default(autoincrement())
  requesterId      Int               @map("requester_id")
  channelId        Int               @map("channel_id")
  songId           Int               @map("song_id")
  title            String            @db.VarChar(255)
  description      String?           @db.Text
  platform         ClipPlatform      @default(MELOMING)
  videoId          String?           @map("video_id") @db.VarChar(100)
  videoUrl         String?           @map("video_url") @db.Text
  thumbnailUrl     String?           @map("thumbnail_url") @db.Text
  duration         Int?
  publishToHotClip Boolean           @default(true) @map("publish_to_hot_clip")
  status           ClipRequestStatus @default(PENDING)
  processedById    Int?              @map("processed_by_id")
  processedAt      DateTime?         @map("processed_at") @db.DateTime(0)
  rejectionReason  String?           @map("rejection_reason") @db.VarChar(500)
  approvedClipId   Int?              @unique @map("approved_clip_id")
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  requester    User    @relation("ClipRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  channel      Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  song         Song    @relation(fields: [songId], references: [id], onDelete: Cascade)
  processedBy  User?   @relation("ClipRequestProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  approvedClip Clip?   @relation(fields: [approvedClipId], references: [id], onDelete: SetNull)

  @@index([requesterId, status], map: "idx_clip_requests_requester_status")
  @@index([channelId, status], map: "idx_clip_requests_channel_status")
  @@map("clip_requests")
}

/// 노래 등록 신청 모델
/// 권한 없는 사용자가 특정 채널에 노래 등록을 신청할 때 사용
model SongAddRequest {
  id          Int @id @default(autoincrement())
  requesterId Int @map("requester_id")
  channelId   Int @map("channel_id")

  // 노래 정보
  title         String  @db.VarChar(255)
  artistName    String  @map("artist_name") @db.VarChar(255)
  albumArt      String? @map("album_art") @db.Text
  karaokeUrl    String? @map("karaoke_url") @db.Text
  coverUrl      String? @map("cover_url") @db.Text
  originalUrl   String? @map("original_url") @db.Text
  difficulty    Int?
  proficiency   Int?
  songKey       String? @map("song_key") @db.VarChar(20)
  bpm           Int?
  lyricsLink    String? @map("lyrics_link") @db.Text
  lyricsText    String? @map("lyrics_text") @db.Text
  categoryNames String? @map("category_names") @db.Text

  // 처리 정보
  status          SongAddRequestStatus @default(PENDING)
  processedById   Int?                 @map("processed_by_id")
  processedAt     DateTime?            @map("processed_at") @db.DateTime(0)
  rejectionReason String?              @map("rejection_reason") @db.VarChar(500)
  approvedSongId  Int?                 @unique @map("approved_song_id")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  requester    User    @relation("SongAddRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  channel      Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  processedBy  User?   @relation("SongAddRequestProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  approvedSong Song?   @relation(fields: [approvedSongId], references: [id], onDelete: SetNull)

  @@index([requesterId, status], map: "idx_song_add_requests_requester_status")
  @@index([channelId, status], map: "idx_song_add_requests_channel_status")
  @@map("song_add_requests")
}

// ===================================
// Recruit domain (구인구직)
// ===================================

enum RecruitPostStatus {
  DRAFT            @map("draft")
  PENDING          @map("pending")
  APPROVED         @map("approved")
  REJECTED         @map("rejected")
  CLOSED           @map("closed")
  PENDING_REVISION @map("pending_revision")
}

/// @deprecated 새로운 RecruitCategory 시스템으로 대체됨
enum RecruitPostType {
  CLUB          @map("club")
  PART_TIME     @map("part_time")
  COLLABORATION @map("collaboration")
  OTHER         @map("other")
}

/// 구인 카테고리 (계층 구조 지원)
model RecruitCategory {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100) // "영상", "음향" 등
  slug         String   @unique @db.VarChar(50) // "video", "audio" 등
  parentId     Int?     @map("parent_id") // 2차 카테고리용
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  parent   RecruitCategory?      @relation("RecruitCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children RecruitCategory[]     @relation("RecruitCategoryHierarchy")
  posts    RecruitPostCategory[]

  @@index([parentId], map: "idx_recruit_categories_parent")
  @@index([isActive, displayOrder], map: "idx_recruit_categories_active_order")
  @@map("recruit_categories")
}

/// 공고-카테고리 다대다 연결
model RecruitPostCategory {
  id         Int      @id @default(autoincrement())
  postId     Int      @map("post_id")
  categoryId Int      @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)

  post     RecruitPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category RecruitCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([postId, categoryId], map: "uq_recruit_post_category")
  @@index([categoryId], map: "idx_recruit_post_categories_category")
  @@map("recruit_post_categories")
}

enum RecruitApplicationStatus {
  SUBMITTED @map("submitted")
  VIEWED    @map("viewed")
  IN_REVIEW @map("in_review")
  ACCEPTED  @map("accepted")
  REJECTED  @map("rejected")
  WITHDRAWN @map("withdrawn")
}

enum RecruitTagType {
  RECRUIT     @map("recruit")
  REQUIREMENT @map("requirement")
}

enum RecruitApplyType {
  DIRECT @map("direct")
  LINK   @map("link")
}

/// 고용 형태
enum RecruitEmploymentType {
  PROJECT   @map("project") // 건당계약 (동부모집) - 기본값
  CONTRACT  @map("contract") // 계약직
  FULL_TIME @map("full_time") // 정규직
}

/// 급여 유형
enum RecruitPayType {
  PER_PROJECT @map("per_project") // 건당
  HOURLY      @map("hourly") // 시급
  WEEKLY      @map("weekly") // 주급
  MONTHLY     @map("monthly") // 월급
}

enum RecruitFieldType {
  TEXT     @map("text")
  TEXTAREA @map("textarea")
  SELECT   @map("select")
  URL      @map("url")
  FILE     @map("file")
}

/// 구인 공고
model RecruitPost {
  id                    Int                   @id @default(autoincrement())
  authorUserId          Int                   @map("author_user_id")
  channelId             Int?                  @map("channel_id")
  customProfileName     String?               @map("custom_profile_name") @db.VarChar(255)
  customProfileImageUrl String?               @map("custom_profile_image_url") @db.VarChar(500)
  postingOnBehalf       Boolean               @default(false) @map("posting_on_behalf")
  thumbnailImageUrl     String?               @map("thumbnail_image_url") @db.VarChar(500)
  title                 String                @db.VarChar(255)
  description           String                @db.Text
  postType              RecruitPostType       @default(OTHER) @map("post_type")
  headcount             Int? // 모집 인원 (null = 제한 없음)
  deadlineAt            DateTime?             @map("deadline_at") @db.DateTime(0)
  applyType             RecruitApplyType      @default(DIRECT) @map("apply_type")
  applyUrl              String?               @map("apply_url") @db.VarChar(500)
  employmentType        RecruitEmploymentType @default(PROJECT) @map("employment_type")
  payType               RecruitPayType?       @map("pay_type")
  payAmount             Int?                  @map("pay_amount") // 원화 단위
  weeklyHours           Int?                  @map("weekly_hours") // 주간 근무 시간 (시급/주급/월급 시 필수)
  status                RecruitPostStatus     @default(DRAFT)
  pendingData           Json?                 @map("pending_data")
  viewCount             Int                   @default(0) @map("view_count")
  applicationCount      Int                   @default(0) @map("application_count")
  rejectionReason       String?               @map("rejection_reason") @db.Text
  reviewedByUserId      Int?                  @map("reviewed_by_user_id")
  reviewedAt            DateTime?             @map("reviewed_at") @db.DateTime(0)
  createdAt             DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.DateTime(0)

  author        User                      @relation("RecruitPostAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  channel       Channel?                  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  reviewedBy    User?                     @relation("RecruitPostReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  customFields  RecruitPostCustomField[]
  applications  RecruitApplication[]
  bookmarks     RecruitPostBookmark[]
  closedReports RecruitPostClosedReport[]
  history       RecruitStatusHistory[]
  categories    RecruitPostCategory[]
  tags          RecruitPostTag[]

  @@index([authorUserId, status], map: "idx_recruit_posts_author_status")
  @@index([channelId, status], map: "idx_recruit_posts_channel_status")
  @@index([status, createdAt], map: "idx_recruit_posts_status_created")
  @@index([postType, status], map: "idx_recruit_posts_type_status")
  @@index([deadlineAt], map: "idx_recruit_posts_deadline")
  @@map("recruit_posts")
}

/// 공고 태그
model RecruitTag {
  id         Int            @id @default(autoincrement())
  name       String         @db.VarChar(50)
  normalized String         @db.VarChar(60)
  type       RecruitTagType
  createdAt  DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.DateTime(0)

  posts RecruitPostTag[]

  @@unique([type, normalized], map: "uq_recruit_tags_type_normalized")
  @@index([type], map: "idx_recruit_tags_type")
  @@map("recruit_tags")
}

/// 공고-태그 다대다 연결
model RecruitPostTag {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  tagId     Int      @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  post RecruitPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  RecruitTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId], map: "uq_recruit_post_tag")
  @@index([tagId], map: "idx_recruit_post_tags_tag")
  @@index([postId], map: "idx_recruit_post_tags_post")
  @@map("recruit_post_tags")
}

/// 공고별 커스텀 필드 정의
model RecruitPostCustomField {
  id           Int              @id @default(autoincrement())
  postId       Int              @map("post_id")
  fieldName    String           @map("field_name") @db.VarChar(100)
  fieldType    RecruitFieldType @map("field_type")
  isRequired   Boolean          @default(false) @map("is_required")
  options      Json? // SELECT 필드 옵션 목록
  placeholder  String?          @db.VarChar(255)
  displayOrder Int              @default(0) @map("display_order")
  createdAt    DateTime         @default(now()) @map("created_at") @db.DateTime(0)

  post        RecruitPost                    @relation(fields: [postId], references: [id], onDelete: Cascade)
  fieldValues RecruitApplicationFieldValue[]

  @@index([postId, displayOrder], map: "idx_recruit_custom_fields_post_order")
  @@map("recruit_post_custom_fields")
}

/// 지원서
model RecruitApplication {
  id              Int                      @id @default(autoincrement())
  postId          Int                      @map("post_id")
  applicantUserId Int                      @map("applicant_user_id")
  status          RecruitApplicationStatus @default(SUBMITTED)
  introduction    String                   @db.Text // 자기소개/지원동기 (기본 필드)
  contactTime     String?                  @map("contact_time") @db.VarChar(255) // 연락 가능 시간대 (기본 필드)
  viewedAt        DateTime?                @map("viewed_at") @db.DateTime(0)
  statusNote      String?                  @map("status_note") @db.Text // 합격/불합격 메시지
  createdAt       DateTime                 @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.DateTime(0)

  post        RecruitPost                    @relation(fields: [postId], references: [id], onDelete: Cascade)
  applicant   User                           @relation("RecruitApplicationApplicant", fields: [applicantUserId], references: [id], onDelete: Cascade)
  fieldValues RecruitApplicationFieldValue[]

  @@unique([postId, applicantUserId], map: "uq_recruit_application_post_applicant")
  @@index([postId, status], map: "idx_recruit_applications_post_status")
  @@index([applicantUserId, status], map: "idx_recruit_applications_applicant_status")
  @@map("recruit_applications")
}

/// 지원서 커스텀 필드 값
model RecruitApplicationFieldValue {
  id            Int      @id @default(autoincrement())
  applicationId Int      @map("application_id")
  fieldId       Int      @map("field_id")
  value         String?  @db.Text
  fileUrl       String?  @map("file_url") @db.VarChar(500) // FILE 타입용
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)

  application RecruitApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  field       RecruitPostCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([applicationId, fieldId], map: "uq_recruit_field_value_app_field")
  @@index([applicationId], map: "idx_recruit_field_values_application")
  @@map("recruit_application_field_values")
}

/// 공고 찜하기
model RecruitPostBookmark {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  post RecruitPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId], map: "uq_recruit_bookmark_post_user")
  @@index([userId, createdAt], map: "idx_recruit_bookmarks_user_created")
  @@map("recruit_post_bookmarks")
}

/// 공고 마감 제보
model RecruitPostClosedReport {
  id              Int       @id @default(autoincrement())
  postId          Int       @map("post_id")
  reporterUserId  Int       @map("reporter_user_id")
  clearedByUserId Int?      @map("cleared_by_user_id")
  clearedAt       DateTime? @map("cleared_at") @db.DateTime(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  post      RecruitPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter  User        @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  clearedBy User?       @relation("RecruitClosedReportClearedBy", fields: [clearedByUserId], references: [id], onDelete: SetNull)

  @@unique([postId, reporterUserId], map: "uq_recruit_closed_report_post_user")
  @@index([postId, clearedAt], map: "idx_recruit_closed_reports_post_cleared")
  @@index([postId, createdAt], map: "idx_recruit_closed_reports_post_created")
  @@index([reporterUserId, createdAt], map: "idx_recruit_closed_reports_user_created")
  @@map("recruit_post_closed_reports")
}

/// 공고 상태 변경 이력
model RecruitStatusHistory {
  id              Int                @id @default(autoincrement())
  postId          Int                @map("post_id")
  previousStatus  RecruitPostStatus? @map("previous_status")
  newStatus       RecruitPostStatus  @map("new_status")
  reason          String?            @db.Text
  changedByUserId Int?               @map("changed_by_user_id")
  createdAt       DateTime           @default(now()) @map("created_at") @db.DateTime(0)

  post      RecruitPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  changedBy User?       @relation("RecruitStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt], map: "idx_recruit_status_history_post_created")
  @@map("recruit_status_histories")
}

// ============================================================
// Global Song Matching (additive - existing models untouched)
// ============================================================

model GlobalArtist {
  id            Int      @id @default(autoincrement())
  canonicalName String   @map("canonical_name") @db.VarChar(255)
  normKey       String   @unique @map("norm_key") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  aliases      GlobalArtistAlias[]
  songs        GlobalSong[]
  mergedLosers GlobalArtistMerge[] @relation("GlobalArtistMergeWinner")

  @@map("global_artists")
}

model GlobalArtistMerge {
  loserId  Int      @id @map("loser_id")
  winnerId Int      @map("winner_id")
  reason   String   @db.VarChar(500)
  mergedAt DateTime @default(now()) @map("merged_at")

  winner GlobalArtist @relation("GlobalArtistMergeWinner", fields: [winnerId], references: [id])

  @@index([winnerId])
  @@map("global_artist_merges")
}

model GlobalArtistAlias {
  id             Int      @id @default(autoincrement())
  globalArtistId Int      @map("global_artist_id")
  alias          String   @db.VarChar(255)
  normAlias      String   @map("norm_alias") @db.VarChar(255)
  frequency      Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")

  globalArtist GlobalArtist @relation(fields: [globalArtistId], references: [id])

  @@unique([globalArtistId, normAlias])
  @@index([normAlias])
  @@map("global_artist_aliases")
}

model GlobalSong {
  id                Int                     @id @default(autoincrement())
  title             String                  @db.VarChar(255)
  normTitle         String                  @map("norm_title") @db.VarChar(255)
  globalArtistId    Int                     @map("global_artist_id")
  albumArt          String?                 @map("album_art") @db.Text
  channelCount      Int                     @default(0) @map("channel_count")
  normVersion       Int                     @default(1) @map("norm_version") @db.SmallInt
  entityConfidence  GlobalSongConfidence    @default(MEDIUM) @map("entity_confidence")
  // === Musixmatch 매핑 (Phase A1a) ===
  // commontrack_id는 unique 아님 — 같은 commontrack로 매칭되는 두 GlobalSong이
  // 일시적으로 공존 가능 (자동/수동 dedup 큐로 처리). spec Section 4.4 참조
  mxmCommontrackId  Int?                    @map("mxm_commontrack_id")
  mxmTrackId        Int?                    @map("mxm_track_id")
  mxmHasLyrics      Boolean                 @default(false) @map("mxm_has_lyrics")
  mxmHasSubtitles   Boolean                 @default(false) @map("mxm_has_subtitles")
  mxmHasRichsync    Boolean                 @default(false) @map("mxm_has_richsync")
  mxmInstrumental   Boolean                 @default(false) @map("mxm_instrumental")
  mxmShareUrl       String?                 @map("mxm_share_url") @db.Text
  // Phase A1f — track/album metadata
  mxmAlbumId        Int?                    @map("mxm_album_id")
  mxmAlbumName      String?                 @map("mxm_album_name") @db.VarChar(255)
  mxmAlbumArtUrl    String?                 @map("mxm_album_art_url") @db.Text
  mxmTrackLengthSec Int?                    @map("mxm_track_length_sec")
  mxmRating         Int?                    @map("mxm_rating")
  mxmExplicit       Boolean?                @map("mxm_explicit")
  mxmGenresJson     Json?                   @map("mxm_genres_json")
  primaryIsrc       String?                 @map("primary_isrc") @db.VarChar(15)
  iswc              String?                 @map("iswc") @db.VarChar(15)
  spotifyTrackId    String?                 @map("spotify_track_id") @db.VarChar(30)
  matcherStatus     GlobalSongMatcherStatus @default(PENDING) @map("matcher_status")
  matcherAttempts   Int                     @default(0) @map("matcher_attempts")
  matcherLastAt     DateTime?               @map("matcher_last_at")
  matcherConfidence MatcherConfidence?      @map("matcher_confidence")
  // Phase A1g — who/what produced the current match. Null while PENDING/UNMATCHED.
  // Used for audit + agent unwind detection.
  matcherSource     MatcherSource?          @map("matcher_source")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at")

  globalArtist GlobalArtist      @relation(fields: [globalArtistId], references: [id])
  aliases      GlobalSongAlias[]
  songs        Song[]
  mergedLosers GlobalSongMerge[] @relation("GlobalSongMergeWinner")
  lyrics       GlobalSongLyrics?

  @@unique([normTitle, globalArtistId])
  @@index([normTitle])
  @@index([globalArtistId])
  @@index([channelCount(sort: Desc)])
  @@index([mxmTrackId])
  @@index([mxmCommontrackId])
  @@index([primaryIsrc])
  @@index([matcherLastAt])
  // backfill 우선순위 쿼리 + matcherStatus 단독 필터 모두 left-prefix로 커버
  @@index([matcherStatus, matcherAttempts, channelCount(sort: Desc)])
  @@map("global_songs")
}

model GlobalSongMerge {
  loserId  Int      @id @map("loser_id")
  winnerId Int      @map("winner_id")
  reason   String   @db.VarChar(500)
  mergedAt DateTime @default(now()) @map("merged_at")

  winner GlobalSong @relation("GlobalSongMergeWinner", fields: [winnerId], references: [id])

  @@index([winnerId])
  @@map("global_song_merges")
}

model GlobalSongAlias {
  id             Int      @id @default(autoincrement())
  globalSongId   Int      @map("global_song_id")
  aliasTitle     String   @map("alias_title") @db.VarChar(255)
  normAliasTitle String   @map("norm_alias_title") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")

  globalSong GlobalSong @relation(fields: [globalSongId], references: [id])

  @@unique([globalSongId, normAliasTitle])
  @@index([normAliasTitle])
  @@map("global_song_aliases")
}

enum GlobalSongConfidence {
  HIGH
  MEDIUM
  LOW
}

// ============================================================
// Musixmatch Integration (Phase A1a)
// spec: docs/superpowers/specs/2026-04-28-musixmatch-integration-design.md
