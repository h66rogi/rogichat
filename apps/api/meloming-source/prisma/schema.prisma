  PROCESSING
  PUBLISHED
  FAILED
  EXPIRING
  DELETED

  @@map("huyeor_replay_state")
}

enum HuyeorReplayVisibility {
  PUBLIC
  FAVORITES_ONLY
  MEMBERS_ONLY

  @@map("huyeor_replay_visibility")
}

enum HuyeorReplayRetentionState {
  PENDING_SUPPORT
  RETAINED
  EXPIRING
  DELETED

  @@map("huyeor_replay_retention_state")
}

enum HuyeorReplayTranscriptMessageState {
  VISIBLE
  HIDDEN
  DELETED

  @@map("huyeor_replay_transcript_message_state")
}

enum HuyeorReplayCommentState {
  VISIBLE
  HIDDEN
  DELETED

  @@map("huyeor_replay_comment_state")
}

enum TalkV2VoiceProviderEventStatus {
  RECEIVED
  PROCESSING
  APPLIED
  FAILED
  DEAD_LETTER

  @@map("talk_v2_voice_provider_event_status")
}

// A terminal provider error must be resolved through a bounded, auditable
// backoffice command. These are deliberately separate from the callback inbox:
// no public/mobile caller can turn a provider terminal marker into a retry.
enum TalkV2VoiceOperatorResolutionTargetKind {
  SESSION_END
  PARTICIPANT_DISCONNECT
  RECORDING_PURGE

  @@map("talk_v2_voice_operator_resolution_target_kind")
}

enum TalkV2VoiceOperatorResolutionStatus {
  PENDING
  PROCESSING
  COMMAND_ACCEPTED
  CONFIRMED
  REJECTED
  FAILED
  UNKNOWN_OUTCOME

  @@map("talk_v2_voice_operator_resolution_status")
}

enum TalkV2VoiceOperatorResolutionAuditAction {
  REQUESTED
  CLAIMED
  COMMAND_ACCEPTED
  CONFIRMED
  REJECTED
  FAILED
  UNKNOWN_OUTCOME

  @@map("talk_v2_voice_operator_resolution_audit_action")
}

model TalkV2Room {
  id                String                 @id @default(cuid()) @db.VarChar(36)
  type              TalkV2RoomType
  channelId         Int?                   @map("channel_id")
  hostUserId        Int?                   @map("host_user_id")
  directPairKey     String?                @map("direct_pair_key") @db.VarChar(191)
  // MySQL has no partial unique indexes. On archive/replacement this value is
  // changed to a historical key in the same transaction before a new room is made.
  uniquenessKey     String                 @unique @map("uniqueness_key") @db.VarChar(191)
  title             String?                @db.VarChar(200)
  membershipPolicy  TalkV2MembershipPolicy @default(PUBLIC) @map("membership_policy")
  lastRoomSeq       BigInt                 @default(0) @map("last_room_seq")
  aggregateRevision Int                    @default(0) @map("aggregate_revision")
  archivedAt        DateTime?              @map("archived_at") @db.DateTime(0)
  createdAt         DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.DateTime(0)

  // Room history survives channel deletion. The aggregate is detached so
  // messages and moderation evidence remain available to their participants.
  channel                 Channel?                           @relation("TalkV2ChannelRooms", fields: [channelId], references: [id], onDelete: SetNull)
  host                    User?                              @relation("TalkV2RoomHost", fields: [hostUserId], references: [id], onDelete: Restrict)
  memberships             TalkV2RoomMembership[]
  accessGrants            TalkV2RoomAccessGrant[]
  messages                TalkV2Message[]
  pinnedMessage           TalkV2PinnedMessage?
  fanThreads              TalkV2FanThread[]
  visibilityReadStates    TalkV2VisibilityReadState[]
  notificationPreferences TalkV2RoomNotificationPreference[]
  groupInvites            TalkV2GroupInvite[]
  groupMutationReceipts   TalkV2GroupMutationReceipt[]       @relation("TalkV2GroupMutationReceiptRoom")
  acceptedDirectRequests  TalkV2DirectMessageRequest[]       @relation("TalkV2AcceptedDirectRequest")
  blocks                  TalkV2Block[]
  moderationReports       TalkV2ModerationReport[]
  voiceSessions           TalkV2VoiceSession[]
  accessPolicy            TalkV2FanAccessPolicy?
  fanActivityDaily        TalkV2FanActivityDaily[]

  @@index([channelId, archivedAt])
  @@index([hostUserId, archivedAt])
  @@index([directPairKey, archivedAt])
  @@map("talk_v2_rooms")
}

// A FAN_CHANNEL's entry policy is intentionally a dedicated aggregate rather
// than an overloaded membership enum. This lets hosts compose safe gates
// (favorite, identity, Meloming subscription and recent Talk activity) while
// keeping existing PUBLIC/INVITE_ONLY room semantics compatible.
model TalkV2FanAccessPolicy {
  roomId                      String   @id @map("room_id") @db.VarChar(36)
  requireFavorite             Boolean  @default(true) @map("require_favorite")
  requireIdentityVerification Boolean  @default(false) @map("require_identity_verification")
  requireProSubscription      Boolean  @default(false) @map("require_pro_subscription")
  minMessagesLast30Days       Int      @default(0) @map("min_messages_last_30_days")
  updatedByUserId             Int      @map("updated_by_user_id")
  createdAt                   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  room      TalkV2Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  updatedBy User       @relation("TalkV2FanAccessPolicyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@map("talk_v2_fan_access_policies")
}

// Exact daily activity source for the "last 30 days N messages" channel-talk
// gate/ranking. This is deliberately separate from external live-platform
// rankings: only successful Core V2 room messages increment it.
model TalkV2FanActivityDaily {
  id           String   @id @default(cuid()) @db.VarChar(36)
  roomId       String   @map("room_id") @db.VarChar(36)
  userId       Int      @map("user_id")
  activityDate DateTime @map("activity_date") @db.Date
  messageCount Int      @default(0) @map("message_count")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  room TalkV2Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId, activityDate], map: "talk_v2_fan_activity_daily_room_user_day_key")
  @@index([roomId, activityDate, messageCount], map: "talk_v2_fan_activity_daily_room_day_count_idx")
  @@index([roomId, userId, activityDate], map: "talk_v2_fan_activity_daily_room_user_day_idx")
  @@map("talk_v2_fan_activity_daily")
}

model TalkV2RoomMembership {
  id                        String                @id @default(cuid()) @db.VarChar(36)
  roomId                    String                @map("room_id") @db.VarChar(36)
  userId                    Int                   @map("user_id")
  role                      TalkV2MembershipRole  @default(MEMBER)
  state                     TalkV2MembershipState @default(ACTIVE)
  // The pair (membership id, epoch) is copied into messages/events. A renewed
  // membership always receives a new epoch rather than reactivating this row.
  membershipEpoch           Int                   @map("membership_epoch")
  // Snapshot of User.talkAccessEpoch at grant creation. Account recovery does
  // not change this value; an older membership therefore remains unusable.
  accountAccessEpochAtGrant Int                   @map("account_access_epoch_at_grant")
  authorizationVersion      Int                   @default(1) @map("authorization_version")
  historyVisibleFromRoomSeq BigInt                @default(0) @map("history_visible_from_room_seq")
  // Only an active host carries this key ("host:{roomId}"). Clearing it in
  // the same transaction as revocation enforces the single active host rule.
  activeHostKey             String?               @unique @map("active_host_key") @db.VarChar(191)
  // GROUP has exactly one current owner as well. This is a separate key from
  // FAN_CHANNEL host authority and is never set for a normal member.
  activeOwnerKey            String?               @unique @map("active_owner_key") @db.VarChar(191)
  activeKey                 String                @unique @map("active_key") @db.VarChar(191)
  joinedAt                  DateTime              @default(now()) @map("joined_at") @db.DateTime(0)
  leftAt                    DateTime?             @map("left_at") @db.DateTime(0)
  stateChangedAt            DateTime              @default(now()) @map("state_changed_at") @db.DateTime(0)
  revokedAt                 DateTime?             @map("revoked_at") @db.DateTime(0)
  revokedByUserId           Int?                  @map("revoked_by_user_id")
  createdAt                 DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                 DateTime              @updatedAt @map("updated_at") @db.DateTime(0)

  room TalkV2Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId, membershipEpoch], map: "talk_v2_room_memberships_room_epoch_key")
  @@index([roomId, state, membershipEpoch], map: "talk_v2_room_memberships_room_state_epoch_idx")
  @@index([userId, state, accountAccessEpochAtGrant], map: "talk_v2_room_memberships_user_state_epoch_idx")
  @@index([userId, state, updatedAt], map: "talk_v2_room_memberships_user_state_updated_idx")
  @@map("talk_v2_room_memberships")
}

model TalkV2RoomAccessGrant {
  id                        String                  @id @default(cuid()) @db.VarChar(36)
  roomId                    String                  @map("room_id") @db.VarChar(36)
  userId                    Int                     @map("user_id")
  // Snapshot at grant creation. A restored account never regains an older
  // invite-only room grant simply because its current account is eligible.
  accountAccessEpochAtGrant Int                     @map("account_access_epoch_at_grant")
  source                    TalkV2AccessGrantSource
  grantKey                  String                  @unique @map("grant_key") @db.VarChar(191)
  grantedByUserId           Int?                    @map("granted_by_user_id")
  expiresAt                 DateTime?               @map("expires_at") @db.DateTime(0)
  revokedAt                 DateTime?               @map("revoked_at") @db.DateTime(0)
  createdAt                 DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                 DateTime                @updatedAt @map("updated_at") @db.DateTime(0)

  room TalkV2Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, userId, expiresAt], map: "talk_v2_room_access_grants_room_user_expires_idx")
  @@index([userId, revokedAt, expiresAt], map: "talk_v2_room_access_grants_user_revoked_expires_idx")
  @@index([userId, revokedAt, accountAccessEpochAtGrant], map: "talk_v2_room_access_grants_user_epoch_idx")
  @@map("talk_v2_room_access_grants")
}

model TalkV2Message {
  id                          String              @id @default(cuid()) @db.VarChar(36)
  roomId                      String              @map("room_id") @db.VarChar(36)
  roomSeq                     BigInt              @map("room_seq")
  senderUserId                Int                 @map("sender_user_id")
  senderMembershipIdAtSend    String              @map("sender_membership_id_at_send") @db.VarChar(36)
  senderMembershipEpochAtSend Int                 @map("sender_membership_epoch_at_send")
  type                        TalkV2MessageType   @default(TEXT)
  audience                    TalkV2Audience      @default(ROOM_PUBLIC)
  timelineScope               TalkV2TimelineScope @default(ROOM) @map("timeline_scope")
  // This remains an opaque session id until the voice migration adds the FK.
  voiceSessionId              String?             @map("voice_session_id") @db.VarChar(36)
  clientMessageId             String?             @map("client_message_id") @db.VarChar(191)
  content                     String              @db.Text
  metadata                    Json?
  replyToId                   String?             @map("reply_to_id") @db.VarChar(36)
  revision                    Int                 @default(1)
  editedAt                    DateTime?           @map("edited_at") @db.DateTime(0)
  deletedAt                   DateTime?           @map("deleted_at") @db.DateTime(0)
  createdAt                   DateTime            @default(now()) @map("created_at") @db.DateTime(0)

  room              TalkV2Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender            User                     @relation("TalkV2MessageSender", fields: [senderUserId], references: [id])
  recipients        TalkV2MessageRecipient[]
  reactions         TalkV2MessageReaction[]
  pinnedEntries     TalkV2PinnedMessage[]
  replyTo           TalkV2Message?           @relation("TalkV2MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies           TalkV2Message[]          @relation("TalkV2MessageReply")
  moderationReports TalkV2ModerationReport[]
  voiceSession      TalkV2VoiceSession?      @relation("TalkV2VoiceSessionMessages", fields: [voiceSessionId], references: [id], onDelete: SetNull)

  @@unique([roomId, roomSeq], map: "talk_v2_messages_room_seq_key")
  @@unique([roomId, senderUserId, clientMessageId], map: "talk_v2_messages_idempotency_key")
  @@index([roomId, timelineScope, voiceSessionId, roomSeq], map: "talk_v2_messages_room_timeline_voice_seq_idx")
  @@index([roomId, audience, roomSeq], map: "talk_v2_messages_room_audience_seq_idx")
  @@index([voiceSessionId], map: "idx_tv2_msg_voice_session")
  @@index([senderUserId, createdAt])
  @@map("talk_v2_messages")
}

model TalkV2MessageRecipient {
  id                             String              @id @default(cuid()) @db.VarChar(36)
  messageId                      String              @map("message_id") @db.VarChar(36)
  userId                         Int                 @map("user_id")
  role                           TalkV2RecipientRole
  recipientMembershipIdAtSend    String              @map("recipient_membership_id_at_send") @db.VarChar(36)
  recipientMembershipEpochAtSend Int                 @map("recipient_membership_epoch_at_send")
  createdAt                      DateTime            @default(now()) @map("created_at") @db.DateTime(0)

  message TalkV2Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId], map: "talk_v2_message_recipients_message_user_key")
  @@index([userId, createdAt], map: "talk_v2_message_recipients_user_created_at_idx")
  @@map("talk_v2_message_recipients")
}

model TalkV2MessageReaction {
  id        String   @id @default(cuid()) @db.VarChar(36)
  messageId String   @map("message_id") @db.VarChar(36)
  userId    Int      @map("user_id")
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  message TalkV2Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji], map: "talk_v2_message_reactions_message_user_emoji_key")
  @@index([messageId])
  @@map("talk_v2_message_reactions")
}

model TalkV2PinnedMessage {
  id             String   @id @default(cuid()) @db.VarChar(36)
  roomId         String   @unique @map("room_id") @db.VarChar(36)
  messageId      String   @map("message_id") @db.VarChar(36)
  pinnedByUserId Int      @map("pinned_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  room    TalkV2Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  message TalkV2Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("talk_v2_pinned_messages")
}

model TalkV2FanThread {
  id                             String              @id @default(cuid()) @db.VarChar(36)
  roomId                         String              @map("room_id") @db.VarChar(36)
  fanUserId                      Int                 @map("fan_user_id")
  // Private fan threads are partitioned by the immutable host recipient
  // snapshot. A channel transfer must not make the next host inherit the
  // previous host's private inbox rows.
  hostMembershipIdAtRecipient    String?             @map("host_membership_id_at_recipient") @db.VarChar(36)
  hostMembershipEpochAtRecipient Int?                @map("host_membership_epoch_at_recipient")
  timelineScope                  TalkV2TimelineScope @default(ROOM) @map("timeline_scope")
  voiceSessionId                 String?             @map("voice_session_id") @db.VarChar(36)
  // Encodes the nullable scope fields and remains stable for the life of a thread.
  threadKey                      String              @unique @map("thread_key") @db.VarChar(191)
  latestMessageId                String?             @map("latest_message_id") @db.VarChar(36)
  hostUnreadCount                Int                 @default(0) @map("host_unread_count")
  createdAt                      DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                      DateTime            @updatedAt @map("updated_at") @db.DateTime(0)

  room         TalkV2Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fan          User                        @relation(fields: [fanUserId], references: [id], onDelete: Cascade)
  voiceSession TalkV2VoiceSession?         @relation("TalkV2VoiceSessionFanThreads", fields: [voiceSessionId], references: [id], onDelete: SetNull)
  readStates   TalkV2VisibilityReadState[]

  @@index([roomId, fanUserId, updatedAt], map: "talk_v2_fan_threads_room_fan_updated_idx")
  @@index([roomId, hostMembershipIdAtRecipient, timelineScope, updatedAt], map: "talk_v2_fan_threads_room_host_scope_updated_idx")
  @@index([voiceSessionId], map: "idx_tv2_fan_thread_voice_session")
  @@map("talk_v2_fan_threads")
}

model TalkV2VisibilityReadState {
  id                    String              @id @default(cuid()) @db.VarChar(36)
  roomId                String              @map("room_id") @db.VarChar(36)
  userId                Int                 @map("user_id")
  membershipIdAtRead    String?             @map("membership_id_at_read") @db.VarChar(36)
  membershipEpochAtRead Int?                @map("membership_epoch_at_read")
  audience              TalkV2Audience
  timelineScope         TalkV2TimelineScope @default(ROOM) @map("timeline_scope")
  voiceSessionId        String?             @map("voice_session_id") @db.VarChar(36)
  fanThreadId           String?             @map("fan_thread_id") @db.VarChar(36)
  // Required because MySQL unique indexes permit multiple NULL combinations.
  scopeKey              String              @unique @map("scope_key") @db.VarChar(191)
  lastReadRoomSeq       BigInt              @default(0) @map("last_read_room_seq")
  lastReadMessageId     String?             @map("last_read_message_id") @db.VarChar(36)
  createdAt             DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.DateTime(0)

  room         TalkV2Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fanThread    TalkV2FanThread?    @relation(fields: [fanThreadId], references: [id], onDelete: SetNull)
  voiceSession TalkV2VoiceSession? @relation("TalkV2VoiceSessionReadStates", fields: [voiceSessionId], references: [id], onDelete: SetNull)

  @@index([roomId, userId, audience, updatedAt], map: "talk_v2_visibility_read_states_room_user_audience_updated_idx")
  @@index([voiceSessionId], map: "idx_tv2_read_voice_session")
  @@index([fanThreadId])
  @@map("talk_v2_visibility_read_states")
}

model TalkV2RoomNotificationPreference {
  id        String                    @id @default(cuid()) @db.VarChar(36)
  roomId    String                    @map("room_id") @db.VarChar(36)
  userId    Int                       @map("user_id")
  setting   TalkV2NotificationSetting @default(ALL)
  createdAt DateTime                  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime                  @updatedAt @map("updated_at") @db.DateTime(0)

  room TalkV2Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId], map: "talk_v2_room_notification_preferences_room_user_key")
  @@index([userId, setting], map: "talk_v2_room_notification_preferences_user_setting_idx")
  @@map("talk_v2_room_notification_preferences")
}

model TalkV2DirectMessageRequest {
  id                                  String                           @id @default(cuid()) @db.VarChar(36)
  requestKey                          String                           @unique @map("request_key") @db.VarChar(191)
  clientRequestId                     String?                          @map("client_request_id") @db.VarChar(191)
  senderUserId                        Int                              @map("sender_user_id")
  recipientUserId                     Int                              @map("recipient_user_id")
  senderAccountAccessEpochAtCreate    Int                              @map("sender_account_access_epoch_at_create")
  recipientAccountAccessEpochAtCreate Int                              @map("recipient_account_access_epoch_at_create")
  status                              TalkV2DirectMessageRequestStatus @default(PENDING)
  acceptedRoomId                      String?                          @map("accepted_room_id") @db.VarChar(36)
  initialMessage                      String?                          @map("initial_message") @db.Text
  expiresAt                           DateTime?                        @map("expires_at") @db.DateTime(0)
  resolvedAt                          DateTime?                        @map("resolved_at") @db.DateTime(0)
  createdAt                           DateTime                         @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                           DateTime                         @updatedAt @map("updated_at") @db.DateTime(0)

  sender       User        @relation("TalkV2DmRequestSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient    User        @relation("TalkV2DmRequestRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  acceptedRoom TalkV2Room? @relation("TalkV2AcceptedDirectRequest", fields: [acceptedRoomId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, status, createdAt], map: "talk_v2_direct_message_requests_recipient_status_created_idx")
  @@index([senderUserId, status, createdAt], map: "talk_v2_direct_message_requests_sender_status_created_idx")
  @@index([recipientUserId, status, recipientAccountAccessEpochAtCreate], map: "talk_v2_direct_message_requests_recipient_epoch_idx")
  @@index([senderUserId, status, senderAccountAccessEpochAtCreate], map: "talk_v2_direct_message_requests_sender_epoch_idx")
  // Pair-scoped request throttling deliberately counts every terminal state,
  // not only PENDING rows, so repeated decline/expiry retries cannot bypass
  // the server-owned 24-hour limit.
  @@index([senderUserId, recipientUserId, createdAt], map: "talk_v2_direct_message_requests_sender_recipient_created_idx")
  @@map("talk_v2_direct_message_requests")
}

model TalkV2GroupInvite {
  id                                String                  @id @default(cuid()) @db.VarChar(36)
  inviteKey                         String                  @unique @map("invite_key") @db.VarChar(191)
  // This exists only while the invite is PENDING and prevents duplicate active
  // invites without relying on a nullable compound unique index.
  pendingKey                        String?                 @unique @map("pending_key") @db.VarChar(191)
  roomId                            String                  @map("room_id") @db.VarChar(36)
  inviterUserId                     Int                     @map("inviter_user_id")
  inviteeUserId                     Int                     @map("invitee_user_id")
  inviterAccountAccessEpochAtCreate Int                     @map("inviter_account_access_epoch_at_create")
  inviteeAccountAccessEpochAtCreate Int                     @map("invitee_account_access_epoch_at_create")
  status                            TalkV2GroupInviteStatus @default(PENDING)
  expiresAt                         DateTime?               @map("expires_at") @db.DateTime(0)
  resolvedAt                        DateTime?               @map("resolved_at") @db.DateTime(0)
  createdAt                         DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                         DateTime                @updatedAt @map("updated_at") @db.DateTime(0)

  room    TalkV2Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inviter User       @relation("TalkV2GroupInviteInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitee User       @relation("TalkV2GroupInviteInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@index([roomId, status], map: "talk_v2_group_invites_room_status_idx")
  @@index([inviteeUserId, status, createdAt], map: "talk_v2_group_invites_invitee_status_created_idx")
  @@index([inviteeUserId, status, inviteeAccountAccessEpochAtCreate], map: "talk_v2_group_invites_invitee_epoch_idx")
  @@index([inviterUserId, status, inviterAccountAccessEpochAtCreate], map: "talk_v2_group_invites_inviter_epoch_idx")
  @@map("talk_v2_group_invites")
