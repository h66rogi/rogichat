  assetConfig   Json?   @map("asset_config")
  variantConfig Json?   @map("variant_config")
  adminMemo     String? @map("admin_memo") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([productId, optionCode], map: "haejuseyo_product_options_product_code_unique")
  @@index([optionCode, isEnabled], map: "idx_haejuseyo_product_options_code_enabled")
