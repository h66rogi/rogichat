model UserPointBalance {
  userId    Int      @id @map("user_id")
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id])

  @@map("user_point_balances")
}

// ===================================
// Cash domain (멜로밍 캐시 — 유상 재화)
// ===================================

enum CashTransactionType {
  CREDIT   @map("credit")
  DEBIT    @map("debit")
  REVERSAL @map("reversal")
}

/// 캐시 충전 환불 진행 상태 (PG retry 관리, 부분 환불 N회 멱등성 보장).
enum CashTopupRefundStatus {
  PENDING         @map("pending")
  PG_REQUESTED    @map("pg_requested")
  SUCCESS         @map("success")
  FAILED          @map("failed")
  FAILED_RETRYING @map("failed_retrying")
}

/// 캐시 거래의 사용처 분류 (referenceType 컬럼 enum).
/// TS union 과의 sync 부재 결함을 schema 레벨 강제로 해결.
enum CashReferenceType {
  CASH_TOPUP_ORDER @map("cash_topup_order")
  CASH_STORE_TOPUP @map("cash_store_topup")
  DONATION         @map("donation")
  SUBSCRIPTION     @map("subscription")
  REWARD_REQUEST   @map("reward_request")
  ADMIN_ADJUSTMENT @map("admin_adjustment")
  REFUND           @map("refund")
}

/// 사용자별 캐시 잔액 (단일 행).
/// lifetimeCreditedAmount = 적립 합 − 환불 합. 누적 한도 검증의 source of truth.
model UserCashBalance {
  userId                 Int      @id @map("user_id")
  balance                Int      @default(0)
  lifetimeCreditedAmount Int      @default(0) @map("lifetime_credited_amount")
  updatedAt              DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id])

  @@map("user_cash_balances")
}

/// 캐시 거래 원장. type 으로 방향 결정, amount 는 항상 양수.
/// 멱등성은 uniqueKey 로 보장 — 호출자가 결정적 키를 부여해야 함.
model CashTransaction {
  id               Int                 @id @default(autoincrement())
  userId           Int                 @map("user_id")
  type             CashTransactionType
  amount           Int
  balanceAfter     Int                 @map("balance_after")
  reason           String?
  action           String?             @db.VarChar(50)
  referenceType    CashReferenceType?  @map("reference_type")
  referenceId      String?             @map("reference_id") @db.VarChar(100)
  uniqueKey        String?             @unique(map: "uq_cash_tx_unique_key") @map("unique_key") @db.VarChar(150)
  createdByAdminId Int?                @map("created_by_admin_id")
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(0)

  user               User                @relation(fields: [userId], references: [id])
  donation           Donation?
  cashLotAllocations CashLotAllocation[]

  @@index([userId, createdAt], map: "idx_cash_tx_user_created")
  @@index([referenceType, referenceId], map: "idx_cash_tx_reference")
  @@map("cash_transactions")
}

/// 캐시 충전 주문. Order 와 1:1 sub-table 패턴.
/// surchargeRate / policyVersion 은 적용 시점 snapshot — 정책 후속 변경에도 영수증/환불 계산 일관성 보장.
/// policyVersion 은 CashTopupPolicy.id FK (P1 리뷰 반영).
model CashTopupOrder {
  id             Int             @id @default(autoincrement())
  orderId        Int             @unique @map("order_id")
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         Int             @map("user_id")
  user           User            @relation(fields: [userId], references: [id])
  cashAmount     Int             @map("cash_amount")
  surchargeRate  Int             @map("surcharge_rate")
  paymentAmount  Int             @map("payment_amount")
  policyVersion  Int             @map("policy_version")
  policy         CashTopupPolicy @relation(fields: [policyVersion], references: [id])
  creditedAt     DateTime?       @map("credited_at") @db.DateTime(0)
  refundedAt     DateTime?       @map("refunded_at") @db.DateTime(0)
  refundedAmount Int             @default(0) @map("refunded_amount")
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(0)

  refunds CashTopupRefund[]
  cashLot CashLot?
  storePurchase CashTopupStorePurchase?

  @@index([userId, createdAt], map: "idx_cash_topup_user_created")
  @@index([policyVersion], map: "idx_cash_topup_policy_version")
  @@map("cash_topup_orders")
}

/// 모바일 스토어에서 판매하는 소비성 캐시 팩. 상품 식별자와 캐시 지급량은
/// 서버가 관리하며 앱에서 받은 가격·캐시 수량은 절대 신뢰하지 않는다.
enum CashStorePlatform {
  IOS_APP_STORE      @map("ios_app_store")
  ANDROID_GOOGLE_PLAY @map("android_google_play")
}

enum CashStorePurchaseState {
  ACTIVE  @map("active")
  REVOKED @map("revoked")
}

enum CashStoreRecoveryState {
  PENDING  @map("pending")
  RESOLVED @map("resolved")
}

model CashTopupStoreProduct {
  id            Int               @id @default(autoincrement())
  platform      CashStorePlatform
  productId     String            @map("product_id") @db.VarChar(191)
  cashAmount    Int               @map("cash_amount")
  storePriceKrw Int               @map("store_price_krw")
  isActive      Boolean           @default(true) @map("is_active")
  createdByAdminId Int?           @map("created_by_admin_id")
  createdAt     DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([platform, productId], map: "uq_cash_store_products_platform_product")
  @@index([platform, isActive], map: "idx_cash_store_products_platform_active")
  @@map("cash_topup_store_products")
}

/// RevenueCat가 검증한 한 번의 StoreKit/Play Billing 소비성 결제. 기존
/// CashTopupOrder/Payment/CashLot 원장을 그대로 재사용해 Payple 충전과
/// 잔액·사용 배분이 갈라지지 않도록 한다.
model CashTopupStorePurchase {
  id                 Int                    @id @default(autoincrement())
  cashTopupOrderId   Int                    @unique(map: "uq_cash_store_purchases_topup_order") @map("cash_topup_order_id")
  cashTopupOrder     CashTopupOrder         @relation(fields: [cashTopupOrderId], references: [id], onDelete: Cascade)
  platform           CashStorePlatform
  productId          String                 @map("product_id") @db.VarChar(191)
  transactionId      String                 @map("transaction_id") @db.VarChar(191)
  originalTransactionId String?             @map("original_transaction_id") @db.VarChar(191)
  state              CashStorePurchaseState @default(ACTIVE)
  revokedAt          DateTime?              @map("revoked_at") @db.DateTime(0)
  recoveryOutstandingAmount Int             @default(0) @map("recovery_outstanding_amount")
  rawPurchasePayload Json?                  @map("raw_purchase_payload")
  lastEventAt        DateTime               @map("last_event_at") @db.DateTime(0)
  createdAt          DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.DateTime(0)

  events     CashTopupStoreEvent[]
  recoveries CashTopupStoreRecovery[]

  @@unique([platform, transactionId], map: "uq_cash_store_purchases_platform_transaction")
  @@index([platform, originalTransactionId], map: "idx_cash_store_purchases_platform_original")
  @@index([state, updatedAt], map: "idx_cash_store_purchases_state_updated")
  @@map("cash_topup_store_purchases")
}

/// RevenueCat 전달은 at-least-once다. event id를 불변 원장으로 저장해
/// 재시도·순서 뒤바뀜에도 캐시가 한 번만 적립/회수되게 한다.
model CashTopupStoreEvent {
  id              String                 @id @default(cuid()) @db.VarChar(36)
  storePurchaseId Int                    @map("store_purchase_id")
  storePurchase   CashTopupStorePurchase @relation(fields: [storePurchaseId], references: [id], onDelete: Cascade)
  eventId         String                 @unique(map: "uq_cash_store_events_event_id") @map("event_id") @db.VarChar(191)
  eventType       String                 @map("event_type") @db.VarChar(64)
  occurredAt      DateTime               @map("occurred_at") @db.DateTime(0)
  payload         Json                   @map("payload")
  appliedAt       DateTime               @default(now()) @map("applied_at") @db.DateTime(0)

  @@index([storePurchaseId, occurredAt], map: "idx_cash_store_events_purchase_occurred")
  @@map("cash_topup_store_events")
}

/// 앱 마켓에서 결제 취소가 확정됐는데 이미 사용한 캐시가 있는 경우의
/// 회수 보류 원장. 잔액을 음수로 만들지 않고, 후원/캐시 사용을 서버에서
/// 차단한 뒤 운영자가 정산·CS 처리 후에만 해제한다.
model CashTopupStoreRecovery {
  id              String                 @id @default(cuid()) @db.VarChar(36)
  storePurchaseId Int                    @map("store_purchase_id")
  storePurchase   CashTopupStorePurchase @relation(fields: [storePurchaseId], references: [id], onDelete: Cascade)
  userId          Int                    @map("user_id")
  amount          Int
  state           CashStoreRecoveryState @default(PENDING)
  reason          String                 @db.VarChar(64)
  resolutionNote  String?                @map("resolution_note") @db.VarChar(500)
  resolvedAt      DateTime?              @map("resolved_at") @db.DateTime(0)
  resolvedByAdminId Int?                 @map("resolved_by_admin_id")
  createdAt       DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([userId, state, createdAt], map: "idx_cash_store_recoveries_user_state")
  @@unique([storePurchaseId], map: "uq_cash_store_recoveries_purchase")
  @@index([storePurchaseId, state], map: "idx_cash_store_recoveries_purchase_state")
  @@map("cash_topup_store_recoveries")
}

/// 충전 건별 유상 캐시 원장. 사용자 환불은 이 로트가 한 번도 사용되지 않은
/// 경우에만 허용한다. 기존 충전 건에는 로트가 없으므로 새 환불 정책의 대상이
/// 되지 않으며, 운영자는 기존 관리자 절차를 계속 사용한다.
model CashLot {
  id                  Int       @id @default(autoincrement())
  userId              Int       @map("user_id")
  cashTopupOrderId    Int       @unique(map: "uq_cash_lots_topup_order_id") @map("cash_topup_order_id")
  initialCashAmount   Int       @map("initial_cash_amount")
  remainingCashAmount Int       @map("remaining_cash_amount")
  refundEligibleUntil DateTime  @map("refund_eligible_until") @db.DateTime(0)
  refundRequestedAt   DateTime? @map("refund_requested_at") @db.DateTime(0)
  refundedAt          DateTime? @map("refunded_at") @db.DateTime(0)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  user           User                @relation(fields: [userId], references: [id])
  cashTopupOrder CashTopupOrder      @relation(fields: [cashTopupOrderId], references: [id], onDelete: Cascade)
  allocations    CashLotAllocation[]

  @@index([userId, refundEligibleUntil], map: "idx_cash_lots_user_refund_eligible")
  @@index([userId, remainingCashAmount], map: "idx_cash_lots_user_remaining")
  @@map("cash_lots")
}

/// 각 캐시 차감이 어느 충전 로트를 소비했는지 기록한다. 한 차감은 여러 로트를
/// 사용할 수 있고, 로트가 없는 기존/무상 잔액은 이 표에 기록하지 않는다.
model CashLotAllocation {
  id                Int      @id @default(autoincrement())
  cashLotId         Int      @map("cash_lot_id")
  cashTransactionId Int      @map("cash_transaction_id")
  amount            Int
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(0)

  cashLot         CashLot         @relation(fields: [cashLotId], references: [id], onDelete: Cascade)
  cashTransaction CashTransaction @relation(fields: [cashTransactionId], references: [id], onDelete: Cascade)

  @@unique([cashLotId, cashTransactionId], map: "uq_cash_lot_allocations_lot_tx")
  @@index([cashTransactionId], map: "idx_cash_lot_allocations_tx")
  @@map("cash_lot_allocations")
}

/// 캐시 충전 환불 원장. 부분 환불 N회를 추적 — Codex P0-B 반영.
/// uniqueKey 멱등성: cash_topup_reversal_<refundId>.
model CashTopupRefund {
  id                 Int                   @id @default(autoincrement())
  cashTopupOrderId   Int                   @map("cash_topup_order_id")
  cashTopupOrder     CashTopupOrder        @relation(fields: [cashTopupOrderId], references: [id], onDelete: Cascade)
  paymentId          Int                   @map("payment_id")
  payment            Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  refundAmount       Int                   @map("refund_amount")
  reason             String?               @db.Text
  isSelfService      Boolean               @default(false) @map("is_self_service")
  pgRefundTxId       String?               @unique(map: "uq_cash_topup_refund_pg_tx_id") @map("pg_refund_tx_id") @db.VarChar(64)
  status             CashTopupRefundStatus @default(PENDING)
  failCode           String?               @map("fail_code") @db.VarChar(50)
  failMessage        String?               @map("fail_message") @db.Text
  rawResponse        Json?                 @map("raw_response")
  retryAttempts      Int                   @default(0) @map("retry_attempts")
  requestedByAdminId Int?                  @map("requested_by_admin_id")
  createdAt          DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([cashTopupOrderId, createdAt], map: "idx_cash_topup_refund_order_created")
  @@index([paymentId], map: "idx_cash_topup_refund_payment")
  @@index([status], map: "idx_cash_topup_refund_status")
  @@map("cash_topup_refunds")
}

/// 캐시 충전 정책. 단일 활성 행 + INSERT-only 패턴 → 자동 이력 보존.
/// surchargeRate 단위: basis points (1000 = 10.00%).
/// single-active 보장: admin policy update 시 분산 락 + 트랜잭션 안에서 기존 활성 행 마감 후 신규 INSERT (application 책임).
model CashTopupPolicy {
  id                   Int       @id @default(autoincrement())
  minTopupAmount       Int       @default(1000) @map("min_topup_amount")
  maxTopupAmount       Int       @default(300000) @map("max_topup_amount")
  perUserLifetimeLimit Int       @default(500000) @map("per_user_lifetime_limit")
  surchargeRate        Int       @default(1000) @map("surcharge_rate")
  isActive             Boolean   @default(true) @map("is_active")
  effectiveFrom        DateTime  @default(now()) @map("effective_from") @db.DateTime(0)
  effectiveUntil       DateTime? @map("effective_until") @db.DateTime(0)
  createdByAdminId     Int?      @map("created_by_admin_id")
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  cashTopupOrders CashTopupOrder[]

  @@index([isActive, effectiveFrom], map: "idx_cash_topup_policy_active_from")
  @@map("cash_topup_policies")
}

// ===================================
// Donation domain (후원 공통 원장)
// ===================================

enum DonationType {
  CONTENT_FUNDING @map("content_funding")
  HUYEOR          @map("huyeor")
}

enum DonationStatus {
  COMPLETED @map("completed")
  REFUNDED  @map("refunded")
  CANCELED  @map("canceled")
}

enum ContentFundingCampaignStatus {
  ACTIVE   @map("active")
  PAUSED   @map("paused")
  ENDED    @map("ended")
  CANCELED @map("canceled")
}

enum FundingProjectStatus {
  DRAFT      @map("draft")
  ACTIVE     @map("active")
  PAUSED     @map("paused")
  SUCCESSFUL @map("successful")
  FAILED     @map("failed")
  CANCELED   @map("canceled")
}

enum FundingProjectVisibility {
  PUBLIC   @map("public")
  UNLISTED @map("unlisted")
  PRIVATE  @map("private")
}

model Donation {
  id                    Int            @id @default(autoincrement())
  donationType          DonationType   @map("donation_type")
  donorUserId           Int            @map("donor_user_id")
  recipientUserId       Int            @map("recipient_user_id")
  channelId             Int?           @map("channel_id")
  amount                Int
  status                DonationStatus @default(COMPLETED)
  message               String?        @db.VarChar(500)
  isAnonymous           Boolean        @default(false) @map("is_anonymous")
  cashTransactionId     Int?           @unique(map: "uq_donations_cash_transaction_id") @map("cash_transaction_id")
  settlementPublishedAt DateTime?      @map("settlement_published_at") @db.DateTime(0)
  settlementEventId     String?        @map("settlement_event_id") @db.VarChar(100)
  disclaimerVersion     String         @map("disclaimer_version") @db.VarChar(32)
  disclaimerAcceptedAt  DateTime       @map("disclaimer_accepted_at") @db.DateTime(0)
  createdAt             DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.DateTime(0)

  donor                  User                    @relation("DonationDonor", fields: [donorUserId], references: [id])
  recipient              User                    @relation("DonationRecipient", fields: [recipientUserId], references: [id])
  channel                Channel?                @relation(fields: [channelId], references: [id], onDelete: SetNull)
  cashTransaction        CashTransaction?        @relation(fields: [cashTransactionId], references: [id], onDelete: SetNull)
  contentFundingDonation ContentFundingDonation?
  fundingBacking         FundingBacking?
  huyeorDonation         HuyeorDonation?
  huyeorReplayDonation   HuyeorReplayDonation?

  @@index([donationType, status, settlementPublishedAt], map: "idx_donations_type_status_settlement")
  @@index([recipientUserId, createdAt], map: "idx_donations_recipient_created")
  @@index([channelId, createdAt], map: "idx_donations_channel_created")
  @@index([donorUserId, createdAt], map: "idx_donations_donor_created")
  @@map("donations")
}

/// 후여르 방송 단위의 캐시 후원 상세. 후원 메시지와 익명 여부는 Donation에
/// 보관하고, 이 모델에는 리모컨·효과·방송 한정 배지에 필요한 불변 스냅샷만 둔다.
model HuyeorDonation {
  id               Int      @id @default(autoincrement())
  donationId       Int      @unique(map: "uq_huyeor_donations_donation_id") @map("donation_id")
  voiceSessionId   String   @map("voice_session_id") @db.VarChar(36)
  cumulativeAmount Int      @map("cumulative_amount")
  badgeTier        String?  @map("badge_tier") @db.VarChar(32)
  isFirstDonation  Boolean  @default(false) @map("is_first_donation")
  isStreakDonation Boolean  @default(false) @map("is_streak_donation")
  effectPreset     String   @default("FLAME") @map("effect_preset") @db.VarChar(32)
  // The donation fee is immutable at the moment a fan sends support. Future
  // admin changes must never recalculate historical streamer revenue.
  settlementFeePolicyId    String?  @map("settlement_fee_policy_id") @db.VarChar(36)
  settlementFeeBps         Int      @default(1000) @map("settlement_fee_bps")
  streamerSettlementAmount Int      @default(0) @map("streamer_settlement_amount")
  createdAt                DateTime @default(now()) @map("created_at") @db.DateTime(0)

  donation            Donation                 @relation(fields: [donationId], references: [id], onDelete: Cascade)
  voiceSession        TalkV2VoiceSession       @relation(fields: [voiceSessionId], references: [id], onDelete: Restrict)
  settlementFeePolicy HuyeorDonationFeePolicy? @relation(fields: [settlementFeePolicyId], references: [id], onDelete: SetNull)
  settlementOutbox    HuyeorDonationSettlementOutbox[]

  @@index([voiceSessionId, id], map: "idx_huyeor_donations_session_id")
  @@index([voiceSessionId, createdAt], map: "idx_huyeor_donations_session_created")
  @@map("huyeor_donations")
}

/// A durable record of every host-only disclosure of donor identity in the
/// live remote. Donation IDs are intentionally snapshotted without a foreign
/// key so the audit remains intact even if a payment record is later removed
/// through a regulated retention workflow.
model HuyeorDonationRemoteAudit {
  id            String                          @id @default(cuid()) @db.VarChar(36)
  voiceSessionId String                          @map("voice_session_id") @db.VarChar(36)
  hostUserId    Int                             @map("host_user_id")
  action        HuyeorDonationRemoteAuditAction
  donationIds   Json                            @map("donation_ids")
  itemCount     Int                             @default(0) @map("item_count")
  createdAt     DateTime                        @default(now()) @map("created_at") @db.DateTime(0)

  voiceSession TalkV2VoiceSession @relation(fields: [voiceSessionId], references: [id], onDelete: Restrict)
  host         User               @relation("HuyeorDonationRemoteAuditHost", fields: [hostUserId], references: [id], onDelete: Restrict)

  @@index([voiceSessionId, createdAt], map: "idx_huyeor_donation_remote_audit_session_created")
  @@index([hostUserId, createdAt], map: "idx_huyeor_donation_remote_audit_host_created")
  @@map("huyeor_donation_remote_audits")
}

enum HuyeorDonationRemoteAuditAction {
  IDENTITY_QUEUE_VIEWED

  @@map("huyeor_donation_remote_audit_action")
}

/// Versioned channel-independent policy for the platform's retained portion
/// of a Huyeor donation. Operators create a future policy instead of editing
/// an old row; every donation snapshots the resolved bps and streamer amount.
model HuyeorDonationFeePolicy {
  id               String    @id @default(cuid()) @db.VarChar(36)
  platformFeeBps   Int       @default(1000) @map("platform_fee_bps")
  effectiveFrom    DateTime  @map("effective_from") @db.DateTime(0)
  deactivatedAt    DateTime? @map("deactivated_at") @db.DateTime(0)
  createdByAdminId Int?    @map("created_by_admin_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  donations HuyeorDonation[]

  @@index([effectiveFrom, deactivatedAt], map: "idx_huyeor_donation_fee_policies_active")
  @@map("huyeor_donation_fee_policies")
}

enum HuyeorDonationSettlementOutboxKind {
  ORIGINAL
  REFUND

  @@map("huyeor_donation_settlement_outbox_kind")
}

/// A donation reaches partners-back only after it is committed locally.
/// Failed Redis publication stays retryable here, so a stream outage cannot
/// drop a creator's weekly Huyeor settlement.
model HuyeorDonationSettlementOutbox {
  id                String                             @id @default(cuid()) @db.VarChar(36)
  huyeorDonationId  Int                                @map("huyeor_donation_id")
  kind              HuyeorDonationSettlementOutboxKind @map("event_kind")
  /// Immutable producer-side identity. `original` is reserved for the
  /// source donation; each StoreKit/Play chargeback uses the revoked store
  /// purchase and cash-lot allocation so retries cannot create a second
  /// creator settlement adjustment.
  adjustmentKey     String                             @default("original") @map("adjustment_key") @db.VarChar(191)
  amount            Int
  occurredAt        DateTime                          @map("occurred_at") @db.DateTime(0)
  publishedAt       DateTime?                         @map("published_at") @db.DateTime(0)
  streamEventId     String?                            @unique(map: "uq_huyeor_donation_settlement_outbox_stream_event") @map("stream_event_id") @db.VarChar(64)
  attempts          Int                               @default(0)
  lastError         String?                           @map("last_error") @db.Text
  createdAt         DateTime                          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime                          @updatedAt @map("updated_at") @db.DateTime(0)

  huyeorDonation HuyeorDonation @relation(fields: [huyeorDonationId], references: [id], onDelete: Cascade)

  @@unique([huyeorDonationId, kind, adjustmentKey], name: "unique_huyeor_donation_outbox_kind_key", map: "uq_huyeor_donation_outbox_kind_key")
  @@index([publishedAt, occurredAt], map: "idx_huyeor_donation_settlement_outbox_pending")
  @@map("huyeor_donation_settlement_outbox")
}

/// Per-donor, per-live-session accumulator. This is deliberately separate
/// from the immutable donation rows so concurrent retries from the same fan
/// cannot lose the cumulative amount used for Huyeor session badges.
model HuyeorDonationProgress {
  id               Int      @id @default(autoincrement())
  voiceSessionId   String   @map("voice_session_id") @db.VarChar(36)
  donorUserId      Int      @map("donor_user_id")
  cumulativeAmount Int      @default(0) @map("cumulative_amount")
  donationCount    Int      @default(0) @map("donation_count")
  lastDonatedAt    DateTime @map("last_donated_at") @db.DateTime(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([voiceSessionId, donorUserId], map: "uq_huyeor_donation_progress_session_donor")
  @@index([voiceSessionId], map: "idx_huyeor_donation_progress_session")
  @@map("huyeor_donation_progress")
}

// HuyeorReplay is the channel-facing VOD aggregate. It is not a copy of the
// provider recording job: media readiness, audience authorization, comments,
// replay donations, and the 14-day retention rule are product concerns.
model HuyeorReplay {
  id                       String                     @id @default(cuid()) @db.VarChar(36)
  voiceSessionId           String                     @unique(map: "uq_huyeor_replays_voice_session_id") @map("voice_session_id") @db.VarChar(36)
  channelId                Int?                       @map("channel_id")
  hostUserId               Int                        @map("host_user_id")
  state                    HuyeorReplayState          @default(PROCESSING)
  visibility               HuyeorReplayVisibility     @default(PUBLIC)
  title                    String?                    @db.VarChar(80)
  presentationArtworkUrl   String?                    @map("presentation_artwork_url") @db.Text
  presentationArtworkKind  String                     @default("DEFAULT") @map("presentation_artwork_kind") @db.VarChar(16)
  recordingStorageKey      String?                    @map("recording_storage_key") @db.Text
  playbackManifestKey      String?                    @map("playback_manifest_key") @db.Text
  providerChatRoomArn      String?                    @map("provider_chat_room_arn") @db.Text
  thumbnailKey             String?                    @map("thumbnail_key") @db.Text
  durationMilliseconds     Int?                       @map("duration_milliseconds")
  transcriptWatermarkAt    DateTime?                  @map("transcript_watermark_at") @db.DateTime(0)
  publishedAt              DateTime?                  @map("published_at") @db.DateTime(0)
  supportDeadlineAt        DateTime?                  @map("support_deadline_at") @db.DateTime(0)
  qualifyingDonationAmount Int                        @default(0) @map("qualifying_donation_amount")
  retentionState           HuyeorReplayRetentionState @default(PENDING_SUPPORT) @map("retention_state")
  scheduledDeleteAt        DateTime?                  @map("scheduled_delete_at") @db.DateTime(0)
  // Replay media deletion is an at-least-once S3 operation. Keep the claim
  // durable so a pod restart cannot either skip an expired VOD or delete the
  // same prefix concurrently with a late donation.
  purgeAttemptCount        Int                        @default(0) @map("purge_attempt_count")
  purgeAvailableAt         DateTime?                  @map("purge_available_at") @db.DateTime(0)
  purgeLockedBy            String?                    @map("purge_locked_by") @db.VarChar(191)
  purgeLockedAt            DateTime?                  @map("purge_locked_at") @db.DateTime(0)
  purgeTerminalAt          DateTime?                  @map("purge_terminal_at") @db.DateTime(0)
  purgeLastError           String?                    @map("purge_last_error") @db.Text
  deletedAt                DateTime?                  @map("deleted_at") @db.DateTime(0)
  createdAt                DateTime                   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                DateTime                   @updatedAt @map("updated_at") @db.DateTime(0)

  voiceSession      TalkV2VoiceSession                @relation(fields: [voiceSessionId], references: [id], onDelete: Restrict)
  channel           Channel?                          @relation(fields: [channelId], references: [id], onDelete: SetNull)
  host              User                              @relation("HuyeorReplayHost", fields: [hostUserId], references: [id], onDelete: Restrict)
  transcripts       HuyeorReplayTranscriptMessage[]
  transcriptImports HuyeorReplayTranscriptLogImport[]
  comments          HuyeorReplayComment[]
  donations         HuyeorReplayDonation[]
  retentionAudits   HuyeorReplayRetentionAudit[]

  @@index([channelId, state, publishedAt], map: "idx_huyeor_replays_channel_state_published")
  @@index([retentionState, scheduledDeleteAt], map: "idx_huyeor_replays_retention_schedule")
  @@index([retentionState, scheduledDeleteAt, purgeAvailableAt, purgeLockedAt], map: "idx_huyeor_replays_retention_claim")
  @@index([hostUserId, createdAt], map: "idx_huyeor_replays_host_created")
  @@map("huyeor_replays")
}

// Projection of IVS Chat logging for replay. providerMessageId is the durable
// idempotency key; replay sequence can be rebuilt without changing it.
model HuyeorReplayTranscriptMessage {
  id                 String                             @id @default(cuid()) @db.VarChar(36)
  replayId           String                             @map("replay_id") @db.VarChar(36)
  providerMessageId  String                             @map("provider_message_id") @db.VarChar(191)
  sequence           Int
  offsetMilliseconds Int                                @map("offset_milliseconds")
  authorUserId       Int?                               @map("author_user_id")
  authorDisplayName  String                             @map("author_display_name") @db.VarChar(100)
  content            String                             @db.VarChar(500)
  state              HuyeorReplayTranscriptMessageState @default(VISIBLE)
  sentAt             DateTime                           @map("sent_at") @db.DateTime(0)
  deletedAt          DateTime?                          @map("deleted_at") @db.DateTime(0)
  createdAt          DateTime                           @default(now()) @map("created_at") @db.DateTime(0)

  replay HuyeorReplay @relation(fields: [replayId], references: [id], onDelete: Restrict)
  author User?        @relation("HuyeorReplayTranscriptAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@unique([replayId, providerMessageId], map: "uq_huyeor_replay_transcript_provider_message")
  @@unique([replayId, sequence], map: "uq_huyeor_replay_transcript_sequence")
  @@index([replayId, offsetMilliseconds], map: "idx_huyeor_replay_transcript_offset")
  @@index([authorUserId, createdAt], map: "idx_huyeor_replay_transcript_author")
  @@map("huyeor_replay_transcript_messages")
}

/// Idempotency ledger for the immutable IVS Chat S3 log objects consumed into
/// a replay transcript. The log object stays in audit storage; this row only
/// records successful projection so multiple backend pods never duplicate it.
model HuyeorReplayTranscriptLogImport {
  id            String   @id @default(cuid()) @db.VarChar(36)
  replayId      String   @map("replay_id") @db.VarChar(36)
  objectKey     String   @map("object_key") @db.Text
  objectKeyHash String   @map("object_key_hash") @db.Char(64)
  messageCount  Int      @default(0) @map("message_count")
  importedAt    DateTime @default(now()) @map("imported_at") @db.DateTime(0)

  replay HuyeorReplay @relation(fields: [replayId], references: [id], onDelete: Restrict)

  @@unique([replayId, objectKeyHash], name: "unique_huyeor_replay_transcript_log_import", map: "uq_huyeor_replay_transcript_log_imports_replay_object")
  @@index([replayId, importedAt], map: "idx_huyeor_replay_transcript_log_imports_replay_imported")
  @@map("huyeor_replay_transcript_log_imports")
}

model HuyeorReplayComment {
  id           String                   @id @default(cuid()) @db.VarChar(36)
  replayId     String                   @map("replay_id") @db.VarChar(36)
  authorUserId Int                      @map("author_user_id")
  content      String                   @db.VarChar(500)
  state        HuyeorReplayCommentState @default(VISIBLE)
  hiddenReason String?                  @map("hidden_reason") @db.VarChar(64)
  deletedAt    DateTime?                @map("deleted_at") @db.DateTime(0)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.DateTime(0)

  replay HuyeorReplay @relation(fields: [replayId], references: [id], onDelete: Restrict)
  author User         @relation("HuyeorReplayCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([replayId, state, createdAt], map: "idx_huyeor_replay_comments_replay_state_created")
  @@index([authorUserId, createdAt], map: "idx_huyeor_replay_comments_author_created")
  @@map("huyeor_replay_comments")
}

// VOD support has the existing immutable Donation as its money ledger; this
// row supplies replay-specific display and retention accounting data.
model HuyeorReplayDonation {
  id                Int      @id @default(autoincrement())
  donationId        Int      @unique(map: "uq_huyeor_replay_donations_donation_id") @map("donation_id")
  replayId          String   @map("replay_id") @db.VarChar(36)
  publicDisplayName String   @map("public_display_name") @db.VarChar(100)
  isAnonymous       Boolean  @default(false) @map("is_anonymous")
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(0)

  donation Donation     @relation(fields: [donationId], references: [id], onDelete: Cascade)
  replay   HuyeorReplay @relation(fields: [replayId], references: [id], onDelete: Restrict)

  @@index([replayId, createdAt], map: "idx_huyeor_replay_donations_replay_created")
  @@map("huyeor_replay_donations")
}

model HuyeorReplayRetentionAudit {
  id                     String   @id @default(cuid()) @db.VarChar(36)
  replayId               String   @map("replay_id") @db.VarChar(36)
  eventType              String   @map("event_type") @db.VarChar(64)
