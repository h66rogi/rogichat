  title                  String
  description            String?
  descriptionHtml        String?     @map("description_html") @db.LongText
  announcementUrl        String?     @map("announcement_url")
  announcementMethod     String?     @map("announcement_method") @db.LongText
  thumbnailImageUrl      String?     @map("thumbnail_image_url") @db.VarChar(500)
  platform               String?     @db.VarChar(20)
  recruitCountMin        Int         @default(1) @map("recruit_count_min")
  recruitCountMax        Int?        @map("recruit_count_max")
  recruitStartAt         DateTime?   @map("recruit_start_at") @db.DateTime(0)
  recruitEndAt           DateTime?   @map("recruit_end_at") @db.DateTime(0)
  announcementAt         DateTime?   @map("announcement_at") @db.DateTime(0)
  contentAt              DateTime?   @map("content_at") @db.DateTime(0)
  contentAtText          String?     @map("content_at_text") @db.VarChar(100)
  contentScheduleDetails String?     @map("content_schedule_details")
  prizes                 String?
  viewCount              Int         @default(0) @map("view_count")
  createdIp              String?     @map("created_ip") @db.VarChar(45)
  isDeleted              Boolean?    @default(false) @map("is_deleted")
  deletedAt              DateTime?   @map("deleted_at") @db.DateTime(0)
  createdAt              DateTime    @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt              DateTime    @updatedAt @map("updated_at") @db.DateTime(0)

  isHidden       Boolean   @default(false) @map("is_hidden")
  hiddenAt       DateTime? @map("hidden_at") @db.DateTime(0)
  hiddenReason   String?   @map("hidden_reason") @db.VarChar(500)
  hiddenByUserId Int?      @map("hidden_by_user_id")
  hiddenByUser   User?     @relation("hiddenContents", fields: [hiddenByUserId], references: [id])

  organizerId Int       @map("organizer_id")
  organizer   Organizer @relation(fields: [organizerId], references: [id])

  // 등록자 (서비스 User)
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  contentsTags            ContentTag[]
  requirements            Requirement[]
  viewLogs                ContentViewLog[]
  closedReports           ContentClosedReport[]
  participations          ContentParticipation[]   @relation("ContentParticipations")
  contentFundingCampaign  ContentFundingCampaign?
  contentFundingDonations ContentFundingDonation[]
  linkedFundingProjects   FundingProject[]
