// -------- Gift Request (선물 수락 대기) --------

enum StoreGiftRequestStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REJECTED @map("rejected")
  EXPIRED  @map("expired")
}

/// 토글 OFF 또는 주소 미등록 스트리머에게 선물 시도 시 생성.
/// 3일 이내 수락/거부/만료. 거부 시 사유 필수 (구매자에게 전달).
model StoreGiftRequest {
  id                 Int                    @id @default(autoincrement())
  recipientUserId    Int                    @map("recipient_user_id")
  recipientUser      User                   @relation("StoreGiftRequestRecipient", fields: [recipientUserId], references: [id])
  /// 검색 진입점 (UI/알림용 채널 식별)
  recipientChannelId Int?                   @map("recipient_channel_id")
  recipientChannel   Channel?               @relation("StoreGiftRequestRecipientChannel", fields: [recipientChannelId], references: [id], onDelete: SetNull)
  requesterUserId    Int                    @map("requester_user_id")
  requester          User                   @relation("StoreGiftRequestRequester", fields: [requesterUserId], references: [id])
  status             StoreGiftRequestStatus @default(PENDING)
  expiresAt          DateTime               @map("expires_at") @db.DateTime(0)
  acceptedAt         DateTime?              @map("accepted_at") @db.DateTime(0)
  rejectedAt         DateTime?              @map("rejected_at") @db.DateTime(0)
  rejectionReason    String?                @map("rejection_reason") @db.VarChar(1000)
  /// SMS/Push 발송 기록: [{channel, sentAt, status}]
  notificationsSent  Json?                  @map("notifications_sent")
  createdAt          DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.DateTime(0)

  storeOrder StoreOrder?

  @@index([recipientUserId], map: "idx_store_gift_requests_recipient_user")
  @@index([recipientChannelId], map: "idx_store_gift_requests_recipient_channel")
  @@index([status, expiresAt], map: "idx_store_gift_requests_status_expires") // EXPIRED 스캐너용
  @@map("store_gift_requests")
}

// -------- KMS Audit Log --------

enum StoreKmsDecryptReason {
  SHIPMENT_LABEL   @map("shipment_label") // 송장 출력 (한진 기사 화면)
  ADMIN_VIEW       @map("admin_view") // admin 마스킹 해제
  GIFT_REQUEST_OPS @map("gift_request_ops") // 선물 요청 처리
  DEBUG            @map("debug") // 운영 디버깅 (이상시 알람)
}

/// StoreUserAddress 복호화 호출 1건당 1행 INSERT.
/// 본인 자기 주소 조회는 미기록 (audit explosion 방지).
/// 송장/admin/디버깅 복호화만 기록 → reason 인자 강제 (decryptUserAddressForOps 시그니처).
model StoreKmsAuditLog {
  id                Int                   @id @default(autoincrement())
  userAddressId     Int?                  @map("user_address_id")
  userAddress       StoreUserAddress?     @relation(fields: [userAddressId], references: [id], onDelete: SetNull)
  decryptedByUserId Int                   @map("decrypted_by_user_id")
  decryptedBy       User                  @relation(fields: [decryptedByUserId], references: [id])
  reason            StoreKmsDecryptReason
  storeOrderId      Int?                  @map("store_order_id")
  ipAddress         String?               @map("ip_address") @db.VarChar(45)
  userAgent         String?               @map("user_agent") @db.VarChar(500)
  decryptedAt       DateTime              @default(now()) @map("decrypted_at") @db.DateTime(0)

  @@index([userAddressId, decryptedAt], map: "idx_store_kms_audit_logs_addr_at")
  @@index([decryptedByUserId, decryptedAt], map: "idx_store_kms_audit_logs_user_at")
  @@index([decryptedAt], map: "idx_store_kms_audit_logs_at")
  @@map("store_kms_audit_logs")
}

// -------- Store Order --------

enum StoreOrderStatus {
  PENDING_PAYMENT @map("pending_payment")
  GIFT_PENDING    @map("gift_pending") // 선물 수락 대기
  ACCEPTED        @map("accepted") // 사용자 노출: 접수 완료
  DISPATCHED      @map("dispatched") // 사용자 노출: 배송 시작
  IN_TRANSIT      @map("in_transit") // 사용자 노출: 배송 중
  DELIVERED       @map("delivered") // 사용자 노출: 배송 완료
  CANCELED        @map("canceled")
  REFUNDED        @map("refunded")
  GIFT_REJECTED   @map("gift_rejected")
  GIFT_EXPIRED    @map("gift_expired")
}

model StoreOrder {
  id      Int   @id @default(autoincrement())
  orderId Int   @unique(map: "store_orders_order_unique") @map("order_id")
  order   Order @relation(fields: [orderId], references: [id])

  isGift                  Boolean @default(false) @map("is_gift")
  /// 비-선물 주문 시 plaintext 스냅샷 (출고 시점, KMS 복호화 비용 절감)
  shippingAddressSnapshot Json?   @map("shipping_address_snapshot")

  /// 선물 시 받는 사람 (KMS 주소 link via user.giftReceivingAddressId)
  giftRecipientUserId    Int?              @map("gift_recipient_user_id")
  giftRecipientUser      User?             @relation("StoreOrderGiftRecipient", fields: [giftRecipientUserId], references: [id])
  /// 선물 시 UI/알림용 채널 (검색 진입점)
  giftRecipientChannelId Int?              @map("gift_recipient_channel_id")
  giftRecipientChannel   Channel?          @relation("StoreOrderGiftRecipientChannel", fields: [giftRecipientChannelId], references: [id], onDelete: SetNull)
  giftMessage            String?           @map("gift_message") @db.Text
  /// 일반 주문의 배송 메모 (admin 출고 화면 표시).
  shippingMemo           String?           @map("shipping_memo") @db.VarChar(200)
  giftRequestId          Int?              @unique(map: "store_orders_gift_request_unique") @map("gift_request_id")
  giftRequest            StoreGiftRequest? @relation(fields: [giftRequestId], references: [id])

  subtotalAmount Int @map("subtotal_amount")
  shippingFee    Int @map("shipping_fee")
  totalAmount    Int @map("total_amount")

  status StoreOrderStatus @default(PENDING_PAYMENT)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  items                   StoreOrderItem[]
  shipment                StoreShipment?
  haejuseyoProductionJobs HaejuseyoProductionJob[]
  rmaRequests             StoreRmaRequest[]
  discountRedemptions     StoreDiscountRedemption[]
  revenueCostEntries      RevenueCostEntry[]

  @@index([giftRecipientUserId], map: "idx_store_orders_gift_user")
  @@index([giftRecipientChannelId], map: "idx_store_orders_gift_channel")
  @@index([status], map: "idx_store_orders_status")
  @@map("store_orders")
}

model StoreOrderItem {
  id           Int        @id @default(autoincrement())
  storeOrderId Int        @map("store_order_id")
  storeOrder   StoreOrder @relation(fields: [storeOrderId], references: [id], onDelete: Cascade)

  variantId Int?                   @map("variant_id")
  variant   StoreProductVariant?   @relation(fields: [variantId], references: [id])
  /// @deprecated. 신규 골라담기 OrderItem 은 bundleId=null + pickSelectionSnapshot 만 set.
  /// 컬럼은 과거 주문 데이터 보존 위해 유지.
  bundleId  Int?                   @map("bundle_id")
  bundle    StorePickAndMixBundle? @relation(fields: [bundleId], references: [id])

  quantity              Int
  /// 주문 시점 effective unit price 스냅샷 (variant.salePrice ?? product 인라인 할인 ?? retailPrice).
  unitPrice             Int           @map("unit_price")
  /// 주문 시점 product.saleType 스냅샷
  saleTypeSnapshot      StoreSaleType @map("sale_type_snapshot")
  /// 골라담기 [{variantId, qty}] 스냅샷. set 되어 있으면 골라담기 라인.
  pickSelectionSnapshot Json?         @map("pick_selection_snapshot")

  lotAllocations         StoreOrderItemLotAllocation[]
  consignmentDispatch    StoreConsignmentDispatch?
  rmaRequestItems        StoreRmaRequestItem[]
  haejuseyoProductionJob HaejuseyoProductionJob?

  @@index([storeOrderId], map: "idx_store_order_items_order")
  @@map("store_order_items")
}

/// 출고 시 lot 할당 (FEFO, 1 OrderItem : N lot 가능 — 부족하면 여러 lot 결합)
model StoreOrderItemLotAllocation {
  id                Int               @id @default(autoincrement())
  orderItemId       Int               @map("order_item_id")
  orderItem         StoreOrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  inventoryLotId    Int               @map("inventory_lot_id")
  inventoryLot      StoreInventoryLot @relation(fields: [inventoryLotId], references: [id])
  quantity          Int
  /// = lot.unitCost 스냅샷 (수익률 계산용)
  costAtFulfillment Int               @map("cost_at_fulfillment")

  @@index([orderItemId], map: "idx_store_oila_order_item")
  @@index([inventoryLotId], map: "idx_store_oila_lot")
  @@map("store_order_item_lot_allocations")
}

// -------- Shipment --------

enum StoreShipmentCarrier {
  HANJIN @map("hanjin")
  CJ     @map("cj")
  EPOST  @map("epost")
  LOTTE  @map("lotte")
  LOGEN  @map("logen")
  DOOBAL @map("doobal")
  OTHER  @map("other")
}

enum StoreShipmentStatus {
  ACCEPTED   @map("accepted")
  DISPATCHED @map("dispatched")
  IN_TRANSIT @map("in_transit")
  DELIVERED  @map("delivered")
  EXCEPTION  @map("exception")
}

/// 택배사 자동 접수의 결과. 실제 출고/수거 상태와 분리해 접수 완료를
/// 실제 인계 완료로 오인하지 않도록 한다.
enum FulfillmentAutomationStatus {
  PLANNED   @map("planned")
  REQUESTED @map("requested")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  CANCELED  @map("canceled")
}

model StoreShipment {
  id                    Int                          @id @default(autoincrement())
  storeOrderId          Int                          @unique(map: "store_shipments_store_order_unique") @map("store_order_id")
  storeOrder            StoreOrder                   @relation(fields: [storeOrderId], references: [id])
  carrier               StoreShipmentCarrier         @default(HANJIN)
  /// ⚠️ admin only — 사용자에게 절대 노출 X. 4단계 displayStatus만 노출
  trackingNumber        String?                      @map("tracking_number") @db.VarChar(50)
  status                StoreShipmentStatus          @default(ACCEPTED)
  shippedAt             DateTime?                    @map("shipped_at") @db.DateTime(0)
  deliveredAt           DateTime?                    @map("delivered_at") @db.DateTime(0)
  automationStatus      FulfillmentAutomationStatus? @map("automation_status")
  externalRequestId     String?                      @map("external_request_id") @db.VarChar(120)
  automationLabelUrl    String?                      @map("automation_label_url") @db.VarChar(500)
  automationRequestedAt DateTime?                    @map("automation_requested_at") @db.DateTime(0)
  automationCanceledAt  DateTime?                    @map("automation_canceled_at") @db.DateTime(0)
  automationMetadata    Json?                        @map("automation_metadata")
  /// 부자재 BOM 스냅샷: [{materialId, qty}]
  packagingMaterials    Json?                        @map("packaging_materials")
  createdAt             DateTime                     @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([carrier, trackingNumber], map: "idx_store_shipments_carrier_tracking")
  @@index([automationStatus, automationRequestedAt], map: "idx_store_shipments_automation_requested")
  @@map("store_shipments")
}

// -------- RMA (취소 / 반품 / 교환 요청) --------

enum StoreRmaType {
  CANCEL   @map("cancel")
  RETURN   @map("return")
  EXCHANGE @map("exchange")
}

enum StoreRmaStatus {
  REQUESTED @map("requested")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  RECEIVED  @map("received")
  COMPLETED @map("completed")
  CANCELED  @map("canceled")
}

/// 주문 취소/반품/교환 요청. 결제 취소/환불은 Payment 레코드와 별도로 RMA 의사결정 이력을 보존한다.
model StoreRmaRequest {
  id               Int            @id @default(autoincrement())
  storeOrderId     Int            @map("store_order_id")
  storeOrder       StoreOrder     @relation(fields: [storeOrderId], references: [id], onDelete: Cascade)
  requesterUserId  Int?           @map("requester_user_id")
  requester        User?          @relation("StoreRmaRequester", fields: [requesterUserId], references: [id])
  type             StoreRmaType
  status           StoreRmaStatus @default(REQUESTED)
  reason           String         @db.VarChar(1000)
  detail           String?        @db.Text
  adminMemo        String?        @map("admin_memo") @db.Text
  resolution       String?        @db.Text
  refundAmount     Int?           @map("refund_amount")
  resolvedByUserId Int?           @map("resolved_by_user_id")
  resolvedBy       User?          @relation("StoreRmaResolver", fields: [resolvedByUserId], references: [id])
  requestedAt      DateTime       @default(now()) @map("requested_at") @db.DateTime(0)
  approvedAt       DateTime?      @map("approved_at") @db.DateTime(0)
  rejectedAt       DateTime?      @map("rejected_at") @db.DateTime(0)
  receivedAt       DateTime?      @map("received_at") @db.DateTime(0)
  completedAt      DateTime?      @map("completed_at") @db.DateTime(0)
  canceledAt       DateTime?      @map("canceled_at") @db.DateTime(0)
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.DateTime(0)

  items StoreRmaRequestItem[]

  @@index([storeOrderId, status], map: "idx_store_rma_order_status")
  @@index([requesterUserId, requestedAt(sort: Desc)], map: "idx_store_rma_requester_recent")
  @@index([type, status], map: "idx_store_rma_type_status")
  @@map("store_rma_requests")
}

model StoreRmaRequestItem {
  id               Int             @id @default(autoincrement())
  rmaRequestId     Int             @map("rma_request_id")
  rmaRequest       StoreRmaRequest @relation(fields: [rmaRequestId], references: [id], onDelete: Cascade)
  storeOrderItemId Int             @map("store_order_item_id")
  storeOrderItem   StoreOrderItem  @relation(fields: [storeOrderItemId], references: [id])
  quantity         Int
  reason           String?         @db.VarChar(1000)
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([rmaRequestId, storeOrderItemId], map: "store_rma_items_request_item_unique")
  @@index([storeOrderItemId], map: "idx_store_rma_items_order_item")
  @@map("store_rma_request_items")
}

// -------- Consignment Dispatch (위탁 발주 — 드랍쉬핑) --------

enum StoreConsignmentStatus {
  PENDING    @map("pending")
  DISPATCHED @map("dispatched")
  CONFIRMED  @map("confirmed")
  FAILED     @map("failed")
}

/// 위탁(드랍쉬핑) 발주 기록. EMAIL/SHEET/API/MANUAL 채널로 도매상에 발송 + 외부 송장 회수.
/// 1 OrderItem(saleType=CONSIGNMENT) : 1 ConsignmentDispatch
model StoreConsignmentDispatch {
  id                     Int                     @id @default(autoincrement())
  storeOrderItemId       Int                     @unique(map: "store_consignment_order_item_unique") @map("store_order_item_id")
  storeOrderItem         StoreOrderItem          @relation(fields: [storeOrderItemId], references: [id])
  supplierId             Int                     @map("supplier_id")
  supplier               StoreSupplier           @relation(fields: [supplierId], references: [id])
  channel                SupplierDispatchChannel
  /// 도매상에 보낸 정보 (주문번호/상품/배송지)
  payload                Json
  externalTrackingNumber String?                 @map("external_tracking_number") @db.VarChar(50)
  externalCarrier        StoreShipmentCarrier?   @map("external_carrier")
  /// 발주 시점 도매가 스냅샷 (수익률 계산용 — ProductSupplier.lastUnitCost 변동 무관)
  unitCostSnapshot       Int                     @map("unit_cost_snapshot")
  status                 StoreConsignmentStatus  @default(PENDING)
  dispatchedAt           DateTime?               @map("dispatched_at") @db.DateTime(0)
  dispatchedByUserId     Int?                    @map("dispatched_by_user_id")
  dispatchedBy           User?                   @relation("StoreConsignmentDispatcher", fields: [dispatchedByUserId], references: [id])
  confirmedAt            DateTime?               @map("confirmed_at") @db.DateTime(0)
  failedAt               DateTime?               @map("failed_at") @db.DateTime(0)
  failureReason          String?                 @map("failure_reason") @db.VarChar(500)
  createdAt              DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([supplierId], map: "idx_store_consignment_supplier")
  @@index([status], map: "idx_store_consignment_status")
  @@map("store_consignment_dispatches")
}

// -------- Packaging Material (부자재) --------

enum StorePackagingMaterialType {
  BOX    @map("box")
  FILLER @map("filler")
  BAG    @map("bag")
  LABEL  @map("label")
  TAPE   @map("tape")
  OTHER  @map("other")
}

/// 박스/완충재/라벨/테이프 등 출고 부자재. Shipment.packagingMaterials JSON에 BOM 스냅샷.
/// 모든 부자재는 단위(개) 기준 재고로 관리. 입고/소진/조정 변동은 모두 StorePackagingMaterialMovement 에 ledger 로 기록.
model StorePackagingMaterial {
  id            Int                        @id @default(autoincrement())
  name          String                     @db.VarChar(200)
  type          StorePackagingMaterialType
  unitCost      Int                        @map("unit_cost")
  currentStock  Int                        @default(0) @map("current_stock")
  reorderPoint  Int?                       @map("reorder_point")
  /// 외부 치수 (mm). 모든 부자재 옵셔널 — 박스 외형 / 봉투 평면 사이즈 등 표기용
  widthMm       Int?                       @map("width_mm")
  depthMm       Int?                       @map("depth_mm")
  heightMm      Int?                       @map("height_mm")
  /// 내부 치수 (mm). BOX 추천 계산용 — 변종 외형이 내부 치수에 들어가야 적재 가능.
  innerWidthMm  Int?                       @map("inner_width_mm")
  innerDepthMm  Int?                       @map("inner_depth_mm")
  innerHeightMm Int?                       @map("inner_height_mm")
  /// 적재 한도 무게 (g). 주로 BOX. 초과 시 추천 제외.
  maxLoadGram   Int?                       @map("max_load_gram")
  /// 공급처 (필수). 모든 부자재는 공급사를 가져야 함.
  supplierId    Int                        @map("supplier_id")
  supplier      StoreSupplier              @relation(fields: [supplierId], references: [id])
  isActive      Boolean                    @default(true) @map("is_active")
  createdAt     DateTime                   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.DateTime(0)

  movements StorePackagingMaterialMovement[]

  @@index([supplierId], map: "idx_store_packaging_materials_supplier")
  @@map("store_packaging_materials")
}

/// 부자재 재고 변동 종류.
/// RECEIPT: 입고 (+). CONSUMPTION: 소진 (-, 출고/배송/실사용). ADJUSTMENT: 조정 (±, 감모/실수정정/주기 재고조사).
enum StorePackagingMovementType {
  RECEIPT     @map("receipt")
  CONSUMPTION @map("consumption")
  ADJUSTMENT  @map("adjustment")
}

/// 부자재 재고 변동 ledger. 모든 currentStock 변동은 이 테이블에 1줄 기록.
/// quantityDelta 는 signed: RECEIPT=양수, CONSUMPTION=음수, ADJUSTMENT=양/음 둘 다.
/// balanceAfter 는 변동 적용 후 currentStock snapshot — 시계열 추적 / 회계 검증용.
model StorePackagingMaterialMovement {
  id              Int                        @id @default(autoincrement())
  materialId      Int                        @map("material_id")
  material        StorePackagingMaterial     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  type            StorePackagingMovementType
  quantityDelta   Int                        @map("quantity_delta")
  balanceAfter    Int                        @map("balance_after")
  /// 사유 (자유 텍스트 라벨, 예: "주문 #1234 출고", "월간 실사 차이").
  reason          String?                    @db.VarChar(255)
  /// 외부 reference 의 종류 (예: "store_order", "store_shipment", "store_goods_receipt", "manual").
  referenceType   String?                    @map("reference_type") @db.VarChar(50)
  /// 외부 reference id (자유 형식 — 보통 숫자 PK 의 문자열 표현).
  referenceId     String?                    @map("reference_id") @db.VarChar(50)
  createdByUserId Int?                       @map("created_by_user_id")
  createdByUser   User?                      @relation(fields: [createdByUserId], references: [id])
  occurredAt      DateTime                   @default(now()) @map("occurred_at") @db.DateTime(0)
  memo            String?                    @db.Text
  createdAt       DateTime                   @default(now()) @map("created_at") @db.DateTime(0)

  @@index([materialId, occurredAt(sort: Desc)], map: "idx_store_packaging_movements_material_recent")
  @@map("store_packaging_material_movements")
}

// -------- Phase 4: Wishlist (찜) --------

/// 사용자의 변종(variant) 단위 찜 목록.
/// 1 user × 1 variant 유일 — 동일 variant 중복 찜 X.
model StoreWishlistItem {
  id        Int                 @id @default(autoincrement())
  userId    Int                 @map("user_id")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId Int                 @map("variant_id")
  variant   StoreProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([userId, variantId], map: "store_wishlist_user_variant_unique")
  @@index([userId, createdAt(sort: Desc)], map: "idx_store_wishlist_user_recent")
  @@map("store_wishlist_items")
}

// -------- Phase 4: Reviews (별점/후기) --------

/// 사용자 작성 상품 후기. orderId 와 variantId 묶음 + 1 user 당 1 review (변종 단위).
/// rating 1-5, content 텍스트, photos[] URL 배열 (Json).
model StoreProductReview {
  id        Int                 @id @default(autoincrement())
  orderId   Int                 @map("order_id")
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    Int                 @map("user_id")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId Int                 @map("variant_id")
  variant   StoreProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId Int                 @map("product_id")
  product   StoreProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int                 @db.TinyInt
  content   String              @db.Text
  /// 선택 — 사용자 업로드 이미지 URL 배열 (Json).
  photos    Json?
  isHidden  Boolean             @default(false) @map("is_hidden")
  createdAt DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([userId, orderId, variantId], map: "store_review_user_order_variant_unique")
  @@index([productId, createdAt(sort: Desc)], map: "idx_store_review_product_recent")
  @@index([variantId, createdAt(sort: Desc)], map: "idx_store_review_variant_recent")
  @@map("store_product_reviews")
}

// -------- Unified Reviews (서비스 공통 리뷰 도메인) --------

enum ReviewService {
  STORE            @map("store")
  ANONGIFT         @map("anongift")
  VOICE_COMMISSION @map("voice_commission")
  HOMEWORK_SONG    @map("homework_song")
  RENTAL           @map("rental")
}

enum ReviewStatus {
  PUBLISHED @map("published")
  HIDDEN    @map("hidden")
  DELETED   @map("deleted")
}

enum ReviewAttachmentType {
  IMAGE @map("image")
  VIDEO @map("video")
}

enum ReviewReactionValue {
  THUMBS_UP   @map("thumbs_up")
  THUMBS_DOWN @map("thumbs_down")
}

/// 서비스/대상별 리뷰 정책. targetId="global" 행이 서비스 기본값이고,
/// targetType+targetId 조합으로 상품/채널/주문 단위 override 가 가능하다.
model ReviewSetting {
  id      Int           @id @default(autoincrement())
  service ReviewService

  targetType String @default("service") @map("target_type") @db.VarChar(50)
  targetId   String @default("global") @map("target_id") @db.VarChar(100)

  ratingEnabled  Boolean @default(true) @map("rating_enabled")
  ratingRequired Boolean @default(true) @map("rating_required")

  attachmentsEnabled  Boolean @default(false) @map("attachments_enabled")
  imageEnabled        Boolean @default(false) @map("image_enabled")
  videoEnabled        Boolean @default(false) @map("video_enabled")
  maxAttachments      Int     @default(0) @map("max_attachments")
  maxImageAttachments Int     @default(0) @map("max_image_attachments")
  maxVideoAttachments Int     @default(0) @map("max_video_attachments")

  minTextLength    Int @default(0) @map("min_text_length")
  maxTextLength    Int @default(1000) @map("max_text_length")
  reviewWindowDays Int @default(14) @map("review_window_days")

  reactionsEnabled Boolean @default(false) @map("reactions_enabled")
  repliesEnabled   Boolean @default(false) @map("replies_enabled")

  autoPublish Boolean @default(true) @map("auto_publish")
  publicList  Boolean @default(true) @map("public_list")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([service, targetType, targetId], map: "review_settings_service_target_unique")
  @@index([service, targetType], map: "idx_review_settings_service_target_type")
  @@map("review_settings")
}

/// 모든 서비스 리뷰를 모으는 공통 테이블. orderId 는 구매 검증이 필요한 리뷰에 연결하고,
/// targetType/targetId 는 각 서비스 UI 가 해석할 수 있는 공개 대상 키다.
model Review {
  id      Int           @id @default(autoincrement())
  service ReviewService
  status  ReviewStatus  @default(PUBLISHED)

  reviewKey String @unique(map: "reviews_review_key_unique") @map("review_key") @db.VarChar(191)

  authorUserId Int  @map("author_user_id")
  author       User @relation("ReviewAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  orderId Int?   @map("order_id")
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  targetType String @map("target_type") @db.VarChar(50)
  targetId   String @map("target_id") @db.VarChar(100)

  rating  Int?    @db.TinyInt
  content String? @db.Text

  /// 서비스별 display/context payload. 예: variantId, productName, songTitle.
  metadata Json?

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)

  attachments ReviewAttachment[]
  reactions   ReviewReaction[]
  replies     ReviewReply[]

  @@index([service, targetType, targetId, status, createdAt(sort: Desc)], map: "idx_reviews_target_public_recent")
  @@index([authorUserId, createdAt(sort: Desc)], map: "idx_reviews_author_recent")
  @@index([orderId], map: "idx_reviews_order")
  @@map("reviews")
}

model ReviewAttachment {
  id           Int                  @id @default(autoincrement())
  reviewId     Int                  @map("review_id")
  review       Review               @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  type         ReviewAttachmentType
  url          String               @db.VarChar(500)
  thumbnailUrl String?              @map("thumbnail_url") @db.VarChar(500)
  sortOrder    Int                  @default(0) @map("sort_order")
  metadata     Json?
  createdAt    DateTime             @default(now()) @map("created_at") @db.DateTime(0)

  @@index([reviewId, sortOrder], map: "idx_review_attachments_review_sort")
  @@map("review_attachments")
}

model ReviewReaction {
  id        Int                 @id @default(autoincrement())
  reviewId  Int                 @map("review_id")
  review    Review              @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    Int                 @map("user_id")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     ReviewReactionValue
  createdAt DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([reviewId, userId], map: "review_reactions_review_user_unique")
  @@index([reviewId, value], map: "idx_review_reactions_review_value")
  @@map("review_reactions")
}

model ReviewReply {
  id           Int      @id @default(autoincrement())
  reviewId     Int      @map("review_id")
  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorUserId Int      @map("author_user_id")
  author       User     @relation("ReviewReplyAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  content      String   @db.Text
  isOfficial   Boolean  @default(false) @map("is_official")
  isHidden     Boolean  @default(false) @map("is_hidden")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([reviewId, createdAt], map: "idx_review_replies_review_created")
  @@map("review_replies")
}

// ===================================================================
// Store Settings (사이트 정책 / 판매자 정보 / SKU 자동 생성)
// ===================================================================

/// 멜로밍 스토어 사이트 단일 설정 row. 다중 사이트 대비 key 컬럼 유지 (기본 "default").
model StoreSetting {
  id                   Int      @id @default(autoincrement())
  key                  String   @unique(map: "store_settings_key_unique") @db.VarChar(50)
  /// 판매자 (사업자) 정보 — 상품 상세/푸터 노출
  sellerName           String?  @map("seller_name") @db.VarChar(200)
  sellerBusinessNumber String?  @map("seller_business_number") @db.VarChar(50)
  sellerRepresentative String?  @map("seller_representative") @db.VarChar(100)
  sellerAddress        String?  @map("seller_address") @db.VarChar(500)
  sellerEmail          String?  @map("seller_email") @db.VarChar(255)
  sellerPhone          String?  @map("seller_phone") @db.VarChar(50)
  /// 통신판매업 신고번호 (전자상거래 표시 의무)
  sellerMailOrderRegNo String?  @map("seller_mail_order_reg_no") @db.VarChar(100)
  /// CS 운영 시간 (자유 텍스트)
  csHoursText          String?  @map("cs_hours_text") @db.VarChar(255)
  /// 상품 상세에 노출되는 정책 텍스트들. null = 미설정 (사용자 측 미노출).
  shippingPolicyText   String?  @map("shipping_policy_text") @db.Text
  returnPolicyText     String?  @map("return_policy_text") @db.Text
  exchangePolicyText   String?  @map("exchange_policy_text") @db.Text
  refundPolicyText     String?  @map("refund_policy_text") @db.Text
  /// 활성 carriers (Json string[] — StoreShipmentCarrier 값들). null/empty = 모두 사용 가능.
  activeCarriers       Json?    @map("active_carriers")
  /// SKU 자동 생성 prefix (예: "MELO"). null = 자동 생성 비활성.
  skuAutoPrefix        String?  @map("sku_auto_prefix") @db.VarChar(20)
  /// 자동 생성 다음 시퀀스 (atomic increment 기반, 1-base).
  skuAutoNextSeq       Int      @default(1) @map("sku_auto_next_seq")
  /// 통화 ISO 4217. 기본 KRW.
  currency             String   @default("KRW") @db.VarChar(10)
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("store_settings")
}

// ===================================================================
// Shipping Zones / Rates
// ===================================================================

/// 배송 권역. 한국 단일 시작 + 도서산간/해외 확장 대비.
model StoreShippingZone {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  /// 적용 지역 코드 (Json string[]: ["KR_DEFAULT"], ["KR_REMOTE_ISLANDS"], ["OVERSEAS_JP"] 등)
  regionCodes Json     @map("region_codes")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  rates StoreShippingRate[]

  @@map("store_shipping_zones")
}

/// 배송 요금 결정 모드.
/// FLAT: 모든 주문 동일 정액
/// WEIGHT_TIERS: 무게 단계별 (Json: [{maxGram, fee}, ...] asc)
/// PRICE_TIERS: 주문 금액 단계별 (Json: [{maxAmount, fee}, ...] asc)
/// FREE_THRESHOLD: 주문 금액 freeThresholdAmount 이상 무료, 미만 baseFee.
enum StoreShippingMode {
  FLAT           @map("flat")
  WEIGHT_TIERS   @map("weight_tiers")
  PRICE_TIERS    @map("price_tiers")
  FREE_THRESHOLD @map("free_threshold")
}

/// 권역 안의 한 배송 옵션 (사용자에게 카드 단위로 노출).
model StoreShippingRate {
  id                  Int                  @id @default(autoincrement())
  zoneId              Int                  @map("zone_id")
  zone                StoreShippingZone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name                String               @db.VarChar(100)
  carrier             StoreShipmentCarrier
  mode                StoreShippingMode
  /// 기본/하한 요금 (FLAT / FREE_THRESHOLD 미만 / TIER 외 fallback)
  baseFee             Int                  @map("base_fee")
  /// FREE_THRESHOLD 모드 전용
  freeThresholdAmount Int?                 @map("free_threshold_amount")
  /// WEIGHT_TIERS 모드 전용 — Json: [{maxGram, fee}, ...]
  weightTiers         Json?                @map("weight_tiers")
  /// PRICE_TIERS 모드 전용 — Json: [{maxAmount, fee}, ...]
  priceTiers          Json?                @map("price_tiers")
  /// 도착 예상 일수 라벨 (UI 표기). 예: "1~2영업일"
  etaDaysText         String?              @map("eta_days_text") @db.VarChar(100)
  isActive            Boolean              @default(true) @map("is_active")
  sortOrder           Int                  @default(0) @map("sort_order")
  createdAt           DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([zoneId, sortOrder], map: "idx_store_shipping_rates_zone")
  @@map("store_shipping_rates")
}

// ===================================================================
// Discount (할인 / 코드)
// ===================================================================

enum StoreDiscountType {
  AMOUNT        @map("amount")
  PERCENT       @map("percent")
  FREE_SHIPPING @map("free_shipping")
}

enum StoreDiscountScope {
  ORDER      @map("order")
  PRODUCT    @map("product")
  COLLECTION @map("collection")
}

/// 할인. code=null → 자동 적용 (조건 만족 시 cart 적용). code set → 사용자 입력 코드.
model StoreDiscount {
  id                Int                @id @default(autoincrement())
  name              String             @db.VarChar(200)
  /// null = 자동 적용. 설정 시 unique.
  code              String?            @unique(map: "store_discounts_code_unique") @db.VarChar(64)
  type              StoreDiscountType
  scope             StoreDiscountScope
  /// type=AMOUNT: 원, PERCENT: 0~100, FREE_SHIPPING: 0(무시).
  value             Int                @default(0)
  minOrderAmount    Int?               @map("min_order_amount")
  /// 정률(PERCENT) 시 절대 한도. null = 무한.
  maxDiscountAmount Int?               @map("max_discount_amount")
  startsAt          DateTime?          @map("starts_at") @db.DateTime(0)
  endsAt            DateTime?          @map("ends_at") @db.DateTime(0)
  /// 전체 사용 한도. null = 무제한.
  usageLimit        Int?               @map("usage_limit")
  /// 사용자별 사용 한도. null = 무제한.
  perUserLimit      Int?               @map("per_user_limit")
  /// scope=PRODUCT 일 때 대상 productId 배열 (Json int[]).
  productIds        Json?              @map("product_ids")
  /// scope=COLLECTION 일 때 대상 collectionId 배열 (Json int[]).
  collectionIds     Json?              @map("collection_ids")
  /// 누적 사용 횟수 (cache; redemptions 가 truth).
  usedCount         Int                @default(0) @map("used_count")
  isActive          Boolean            @default(true) @map("is_active")
  description       String?            @db.Text
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(0)

  redemptions StoreDiscountRedemption[]

  @@index([code], map: "idx_store_discounts_code")
  @@index([startsAt, endsAt], map: "idx_store_discounts_window")
  @@map("store_discounts")
}

/// 할인 사용 내역 (atomic 검증 + 통계).
enum StoreDiscountRedemptionStatus {
  PENDING  @map("pending")
  APPLIED  @map("applied")
  CANCELED @map("canceled")
}

model StoreDiscountRedemption {
  id            Int                           @id @default(autoincrement())
  discountId    Int                           @map("discount_id")
  discount      StoreDiscount                 @relation(fields: [discountId], references: [id], onDelete: Cascade)
  userId        Int?                          @map("user_id")
  user          User?                         @relation(fields: [userId], references: [id])
  /// 적용된 StoreOrder.id
  storeOrderId  Int?                          @map("store_order_id")
  storeOrder    StoreOrder?                   @relation(fields: [storeOrderId], references: [id])
  /// 실제 차감된 할인 금액 (원).
  appliedAmount Int                           @map("applied_amount")
  status        StoreDiscountRedemptionStatus @default(APPLIED)
  redeemedAt    DateTime                      @default(now()) @map("redeemed_at") @db.DateTime(0)
  appliedAt     DateTime?                     @map("applied_at") @db.DateTime(0)
  canceledAt    DateTime?                     @map("canceled_at") @db.DateTime(0)
  cancelReason  String?                       @map("cancel_reason") @db.VarChar(255)

  @@index([discountId, redeemedAt], map: "idx_store_discount_redemptions_discount")
  @@index([userId, discountId], map: "idx_store_discount_redemptions_user")
  @@index([storeOrderId, status], map: "idx_store_discount_redemptions_order_status")
  @@index([status], map: "idx_store_discount_redemptions_status")
  @@map("store_discount_redemptions")
}

// ===================================================================
// Collection (큐레이션 — 카테고리 트리와 별개)
// ===================================================================

enum StoreCollectionRule {
  MANUAL @map("manual")
  SMART  @map("smart")
}

/// 큐레이션 묶음 — 마케팅 페이지 단위 (예: "여름 굿즈", "신상", "베스트").
/// 카테고리(Tree) 와 별도 — 한 상품이 여러 컬렉션에 속할 수 있음.
model StoreCollection {
  id              Int                 @id @default(autoincrement())
  name            String              @db.VarChar(200)
  slug            String              @unique(map: "store_collections_slug_unique") @db.VarChar(100)
  description     String?             @db.Text
  thumbnailUrl    String?             @map("thumbnail_url") @db.VarChar(500)
  /// 컬렉션 페이지 상단 큰 이미지
  heroUrl         String?             @map("hero_url") @db.VarChar(500)
  rule            StoreCollectionRule @default(MANUAL)
  /// SMART 일 때 조건 (예: {"saleType":"IN_STOCK","tags":["신상"],"onSaleOnly":true,"categoryIds":[3]})
  ruleConfig      Json?               @map("rule_config")
  sortOrder       Int                 @default(0) @map("sort_order")
  isActive        Boolean             @default(true) @map("is_active")
  metaTitle       String?             @map("meta_title") @db.VarChar(255)
  metaDescription String?             @map("meta_description") @db.Text
  createdAt       DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.DateTime(0)

  productLinks StoreCollectionProduct[]

  @@index([sortOrder], map: "idx_store_collections_sort")
  @@map("store_collections")
}

/// MANUAL 컬렉션의 상품 매핑. SMART 는 service 단에서 동적 계산 (이 테이블 사용 X).
model StoreCollectionProduct {
  id           Int             @id @default(autoincrement())
  collectionId Int             @map("collection_id")
  collection   StoreCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    Int             @map("product_id")
  product      StoreProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int             @default(0) @map("sort_order")
  createdAt    DateTime        @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([collectionId, productId], map: "store_collection_products_unique")
  @@index([productId], map: "idx_store_collection_products_product")
  @@map("store_collection_products")
}

// ===================================================================
// Home Sections / Banners (메인 페이지 큐레이션)
// ===================================================================

enum StoreHomeSectionType {
  BANNER_SLIDER @map("banner_slider")
  PRODUCT_GRID  @map("product_grid")
  COLLECTION    @map("collection")
  CTA           @map("cta")
  HTML          @map("html")
}

/// 메인 페이지(또는 다른 CMS 영역) 섹션. type 별 구체 설정은 config Json.
/// BANNER_SLIDER: { bannerIds: number[] }
/// PRODUCT_GRID:  { productIds: number[], displayCount?: number }
/// COLLECTION:    { collectionId: number, displayCount?: number }
/// CTA:           { headline, description, buttonText, buttonHref, imageUrl? }
/// HTML:          { html }
model StoreHomeSection {
  id        Int                  @id @default(autoincrement())
  type      StoreHomeSectionType
  title     String?              @db.VarChar(200)
  subtitle  String?              @db.VarChar(500)
  config    Json
  sortOrder Int                  @default(0) @map("sort_order")
  isActive  Boolean              @default(true) @map("is_active")
  startsAt  DateTime?            @map("starts_at") @db.DateTime(0)
  endsAt    DateTime?            @map("ends_at") @db.DateTime(0)
  createdAt DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([sortOrder], map: "idx_store_home_sections_sort")
  @@map("store_home_sections")
}

enum StoreBannerPlacement {
  HOME_HERO      @map("home_hero")
  HOME_PROMO_BAR @map("home_promo_bar")
  HOME_INLINE    @map("home_inline")
  MODAL_POPUP    @map("modal_popup")
}

/// 재사용 가능한 배너. 메인 슬라이더(BANNER_SLIDER section)에서 ID 참조 또는 placement 별 자체 노출.
model StoreBanner {
  id             Int                  @id @default(autoincrement())
  imageUrl       String               @map("image_url") @db.VarChar(500)
  imageUrlMobile String?              @map("image_url_mobile") @db.VarChar(500)
  title          String?              @db.VarChar(200)
  subtitle       String?              @db.VarChar(500)
  linkUrl        String?              @map("link_url") @db.VarChar(500)
  altText        String?              @map("alt_text") @db.VarChar(255)
  placement      StoreBannerPlacement
  sortOrder      Int                  @default(0) @map("sort_order")
  isActive       Boolean              @default(true) @map("is_active")
  startsAt       DateTime?            @map("starts_at") @db.DateTime(0)
  endsAt         DateTime?            @map("ends_at") @db.DateTime(0)
  createdAt      DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([placement, sortOrder], map: "idx_store_banners_placement_sort")
  @@map("store_banners")
}

// ===================================================================
// Phase 8: 도서산간 (제주/도서) 우편번호 + 상품별 추가 요금 override
// ===================================================================

enum StoreSurchargeZoneKind {
  JEJU          @map("jeju")
  REMOTE_ISLAND @map("remote_island")
  CUSTOM        @map("custom")
}

/// 도서산간 추가 요금 권역. 기본 제주 / 도서산간 + 커스텀.
/// 우편번호와 1:N. 상품별 override 와 1:N.
model StorePostalSurchargeZone {
  id               Int                    @id @default(autoincrement())
  name             String                 @db.VarChar(100)
  kind             StoreSurchargeZoneKind @default(CUSTOM)
  /// 사이트 기본 추가 요금 (원). 상품별 override 가 없으면 적용.
  defaultSurcharge Int                    @default(0) @map("default_surcharge")
  description      String?                @db.Text
  isActive         Boolean                @default(true) @map("is_active")
  createdAt        DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.DateTime(0)

  postalCodes               StoreRemotePostalCode[]
  productSurchargeOverrides StoreProductSurcharge[]

  // kind=JEJU/REMOTE_ISLAND 는 1개만 — service 단에서 강제 (MySQL 부분 unique 미지원).
  @@map("store_postal_surcharge_zones")
}

/// 도서산간 우편번호 → zone 매핑. 우편번호 단위 unique.
model StoreRemotePostalCode {
  zipCode      String                   @id @map("zip_code") @db.VarChar(10)
  zoneId       Int                      @map("zone_id")
  zone         StorePostalSurchargeZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  /// 사용자 노출용 주소 (선택). seed 에서 채움.
  addressLabel String?                  @map("address_label") @db.VarChar(255)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.DateTime(0)

  @@index([zoneId], map: "idx_store_remote_postal_codes_zone")
  @@map("store_remote_postal_codes")
}

/// 상품별 zone 추가 요금 override. 없으면 zone.defaultSurcharge 적용.
model StoreProductSurcharge {
  id        Int                      @id @default(autoincrement())
  productId Int                      @map("product_id")
  product   StoreProduct             @relation(fields: [productId], references: [id], onDelete: Cascade)
  zoneId    Int                      @map("zone_id")
  zone      StorePostalSurchargeZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  /// 이 상품 + 이 zone 추가 요금 (원). 0 = 무료, default 보다 높을 수도/낮을 수도.
  surcharge Int
  createdAt DateTime                 @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime                 @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([productId, zoneId], map: "store_product_surcharges_product_zone_unique")
  @@index([productId], map: "idx_store_product_surcharges_product")
  @@map("store_product_surcharges")
}

// ===================================
// Anongift domain — 양방향 익명 선물 중개
// spec: docs/superpowers/specs/2026-05-11-anongift-design.md
// ===================================

enum AnongiftKind {
  FAN_TO_STREAMER                @map("fan_to_streamer")
  STREAMER_TO_FAN                @map("streamer_to_fan")
  PROXY_PURCHASE_FAN_TO_STREAMER @map("proxy_purchase_fan_to_streamer")
}

enum AnongiftItemRequestType {
  BOX   @map("box")
  PROXY @map("proxy")
}

enum AnongiftSize {
  SMALL  @map("small")
  MEDIUM @map("medium")
  LARGE  @map("large")
}

/// AnongiftTemperatureTier — 박스 보관 온도대. 냉장/냉동은 출고 시 아이스팩 교체/드라이아이스 처리 + 박스당 추가요금.
enum AnongiftTemperatureTier {
  AMBIENT      @map("ambient")
  REFRIGERATED @map("refrigerated")
  FROZEN       @map("frozen")
}

enum AnongiftStatus {
  PENDING_PAYMENT            @map("pending_payment")
  AWAITING_INBOUND           @map("awaiting_inbound")
  INBOUND_RECEIVED           @map("inbound_received")
  INSPECTION_PASSED          @map("inspection_passed")
  INSPECTION_REJECTED        @map("inspection_rejected")
  ADDITIONAL_PAYMENT_PENDING @map("additional_payment_pending")
  OUTBOUND_DISPATCHED        @map("outbound_dispatched")
  DELIVERED                  @map("delivered")
  RETURNED                   @map("returned")
  CANCELED                   @map("canceled")
  // PROXY 전용: 멜로밍 운영팀이 쇼핑몰에서 대신 결제 진행 중. PROXY 신청 결제 완료 후 진입.
  PROXY_PURCHASING           @map("proxy_purchasing")
  // PROXY 전용: 쇼핑몰 결제 완료 → 쇼핑몰에서 스트리머 주소로 직배송 중. 멜로밍 사무실 거치지 않음.
  PROXY_PURCHASED_SHIPPING   @map("proxy_purchased_shipping")
}

enum AnongiftItemStatus {
  AWAITING_INBOUND           @map("awaiting_inbound")
  INBOUND_RECEIVED           @map("inbound_received")
  INSPECTION_PASSED          @map("inspection_passed")
  INSPECTION_REJECTED        @map("inspection_rejected")
  ADDITIONAL_PAYMENT_PENDING @map("additional_payment_pending")
  OUTBOUND_DISPATCHED        @map("outbound_dispatched")
  DELIVERED                  @map("delivered")
  RETURNED                   @map("returned")
  PROXY_PURCHASING           @map("proxy_purchasing")
  PROXY_PURCHASED_SHIPPING   @map("proxy_purchased_shipping")
}

enum AnongiftRejectionReason {
  SIZE_EXCEEDED         @map("size_exceeded")
  WEIGHT_EXCEEDED       @map("weight_exceeded")
  PROHIBITED_ITEM       @map("prohibited_item")
  INAPPROPRIATE         @map("inappropriate")
  COD_RECEIVED          @map("cod_received")
  REMOTE_AREA_SURCHARGE @map("remote_area_surcharge")
  OTHER                 @map("other")
}

enum AnongiftInspectionResult {
  PASS                     @map("pass")
  REJECT                   @map("reject")
  NEEDS_ADDITIONAL_PAYMENT @map("needs_additional_payment")
}

enum AnongiftUnclaimedStatus {
  STORED          @map("stored")
  LINKED_TO_ORDER @map("linked_to_order")
  DISPOSED        @map("disposed")
}

enum AnongiftAdditionalPaymentReason {
  SIZE_UPGRADE           @map("size_upgrade")
  WEIGHT_OVER            @map("weight_over")
  COD_FEE                @map("cod_fee")
  REMOTE_AREA_SURCHARGE  @map("remote_area_surcharge")
  // PROXY 전용: 멜로밍이 쇼핑몰에서 결제 시도 시 실제 결제 금액이 사용자 입력 금액보다 큰 경우 차액.
  PROXY_PRICE_DIFFERENCE @map("proxy_price_difference")
}

enum AnongiftAdditionalPaymentStatus {
  PENDING  @map("pending")
  PAID     @map("paid")
  EXPIRED  @map("expired")
  CANCELED @map("canceled")
}

/// Deprecated: anongift scoped admin roles are no longer used by runtime policy.
/// Keep the enum until a separately reviewed DB cleanup migration removes the column safely.
enum AnongiftAdminRole {
  VIEWER   @map("viewer")
  OPERATOR @map("operator")
  ADMIN    @map("admin")
}

enum AnongiftNotificationChannel {
  ALIMTALK @map("alimtalk")
  EMAIL    @map("email")
  SMS      @map("sms")
}

/// AnongiftOrder — 익명 선물 주문 (박스 N개)
model AnongiftOrder {
  id      Int   @id @default(autoincrement())
  orderId Int   @unique(map: "anongift_orders_order_unique") @map("order_id")
  order   Order @relation(fields: [orderId], references: [id])

  kind               AnongiftKind
  senderUserId       Int          @map("sender_user_id")
  sender             User         @relation("AnongiftOrderSender", fields: [senderUserId], references: [id])
  recipientUserId    Int          @map("recipient_user_id")
  recipient          User         @relation("AnongiftOrderRecipient", fields: [recipientUserId], references: [id])
  recipientChannelId Int?         @map("recipient_channel_id")

  itemCount           Int     @map("item_count")
  itemsBaseAmount     Int     @map("items_base_amount")
  couponId            Int?    @map("coupon_id")
  discountAmount      Int     @default(0) @map("discount_amount")
  eventDiscountAmount Int     @default(0) @map("event_discount_amount")
  eventCode           String? @map("event_code") @db.VarChar(50)
  totalPaidAmount     Int     @map("total_paid_amount")

  status        AnongiftStatus @default(PENDING_PAYMENT)
  senderMessage String?        @map("sender_message") @db.Text

  paidAt               DateTime? @map("paid_at") @db.DateTime(0)
  inboundReceivedAt    DateTime? @map("inbound_received_at") @db.DateTime(0)
  inspectionPassedAt   DateTime? @map("inspection_passed_at") @db.DateTime(0)
  outboundDispatchedAt DateTime? @map("outbound_dispatched_at") @db.DateTime(0)
  deliveredAt          DateTime? @map("delivered_at") @db.DateTime(0)
  canceledAt           DateTime? @map("canceled_at") @db.DateTime(0)

  /// 운영팀이 택배사/수거처에 실제 문 앞 수거 신청을 완료한 협업 플래그.
  /// 발신자의 옵션 선택(userInput.inboundDeliveryOption=DOORSTEP_PICKUP)과 별개다.
  doorstepPickupRequestedAt        DateTime? @map("doorstep_pickup_requested_at") @db.DateTime(0)
  doorstepPickupRequestedByAdminId Int?      @map("doorstep_pickup_requested_by_admin_id")
  doorstepPickupRequestNote        String?   @map("doorstep_pickup_request_note") @db.VarChar(500)

  rejectionReason AnongiftRejectionReason? @map("rejection_reason")
  rejectionNote   String?                  @map("rejection_note") @db.Text

  /// 발신자가 결제 단계에서 선택한 입고 방식. DIRECT_HOME_DELIVERY = 일반택배
  /// (멜로밍 본사 주소로 임의 발송). HALF_PRICE_CVS = 반값택배 (편의점 수신 점포
  /// 배정 필요). 기본 DIRECT_HOME_DELIVERY 로 기존 주문 호환.
  inboundDeliveryOption AnongiftInboundDeliveryOption @default(DIRECT_HOME_DELIVERY) @map("inbound_delivery_option")

  items                    AnongiftItem[]
  additionalPayments       AnongiftAdditionalPayment[]
  notifications            AnongiftNotification[]
  pickupReservation        AnongiftPickupReservation?
  doorstepPickupAutomation AnongiftDoorstepPickupAutomation?
  revenueCostEntries       RevenueCostEntry[]

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([senderUserId, createdAt], map: "idx_anongift_orders_sender")
  @@index([recipientUserId, status], map: "idx_anongift_orders_recipient_status")
  @@index([status, createdAt], map: "idx_anongift_orders_status_created")
  @@index([eventCode], map: "idx_anongift_orders_event_code")
  @@map("anongift_orders")
}

/// First-gift 990원 이벤트 사용 이력 — DI 기준 1인 1회 보장 (unique 제약).
/// race 회피: createOrder 트랜잭션 내부에서 insert 시도하여 unique 위반 시 자격 X.
model AnongiftFirstGiftRedemption {
  id              Int      @id @default(autoincrement())
  di              String   @unique(map: "anongift_first_gift_redemptions_di_unique") @db.VarChar(200)
  userId          Int      @map("user_id")
  anongiftOrderId Int      @unique(map: "anongift_first_gift_redemptions_order_unique") @map("anongift_order_id")
  redeemedAt      DateTime @default(now()) @map("redeemed_at") @db.DateTime(0)

  @@index([userId], map: "idx_anongift_first_gift_redemptions_user")
  @@map("anongift_first_gift_redemptions")
}

/// PRO 구독자 월 1회 무료 발송 사용 이력 — (user_id, year_month) unique 로 1인 1월 1회 race-free.
/// race 회피: createOrder 트랜잭션 내부에서 insert 시도하여 unique 위반 시 자격 X.
/// year_month 는 YYYYMM 정수 (예: 202605). 쿠폰 시스템을 거치지 않고 결제 시점에 PRO 구독 + 잔여 사용권 직접 판정.
model AnongiftProMonthlyRedemption {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  yearMonth       Int      @map("year_month")
  anongiftOrderId Int      @unique(map: "anongift_pro_monthly_redemptions_order_unique") @map("anongift_order_id")
  redeemedAt      DateTime @default(now()) @map("redeemed_at") @db.DateTime(0)

  @@unique([userId, yearMonth], map: "anongift_pro_monthly_redemptions_user_month_unique")
  @@index([userId], map: "idx_anongift_pro_monthly_redemptions_user")
  @@map("anongift_pro_monthly_redemptions")
}

/// AnongiftItem — 박스 단위 (BOX: 1 주문 = N 박스) OR 대리 구매 항목 (PROXY: 1 URL = 1 item).
/// requestType=BOX 는 sizeTier 필수, PROXY 는 사이즈 미정 → 검수 시 measuredSize 로 결정.
/// PROXY 의 baseAmount = mallAmount + serviceFee (사용자가 멜로밍에 결제하는 금액).
model AnongiftItem {
  id              Int           @id @default(autoincrement())
  anongiftOrderId Int           @map("anongift_order_id")
  anongiftOrder   AnongiftOrder @relation(fields: [anongiftOrderId], references: [id])

  requestType     AnongiftItemRequestType @default(BOX) @map("request_type")
  sizeTier        AnongiftSize?           @map("size_tier")
  baseAmount      Int                     @map("base_amount")
  temperatureTier AnongiftTemperatureTier @default(AMBIENT) @map("temperature_tier")
  itemDescription String?                 @map("item_description") @db.Text

  // PROXY (저거 보내주세요) 전용. requestType=BOX 일 때 모두 null.
  proxyProductDescription String? @map("proxy_product_description") @db.Text
  proxyExternalUrl        String? @map("proxy_external_url") @db.Text
  proxyOptionsMemo        String? @map("proxy_options_memo") @db.Text
  proxyMallAmount         Int?    @map("proxy_mall_amount")
  proxyServiceFee         Int?    @map("proxy_service_fee")

  status AnongiftItemStatus @default(AWAITING_INBOUND)

  inboundShipmentId Int?                     @unique(map: "anongift_items_inbound_shipment_unique") @map("inbound_shipment_id")
  inboundShipment   AnongiftInboundShipment? @relation(fields: [inboundShipmentId], references: [id])

  outboundShipmentId Int?                      @unique(map: "anongift_items_outbound_shipment_unique") @map("outbound_shipment_id")
  outboundShipment   AnongiftOutboundShipment? @relation(fields: [outboundShipmentId], references: [id])

  unclaimedInboundId Int?                      @unique(map: "anongift_items_unclaimed_unique") @map("unclaimed_inbound_id")
  unclaimedInbound   AnongiftUnclaimedInbound? @relation(fields: [unclaimedInboundId], references: [id])

  inspections        AnongiftInspection[]
  additionalPayments AnongiftAdditionalPayment[] @relation("AnongiftItemAdditionalPayment")
  outboundAutomation AnongiftOutboundAutomation?

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([anongiftOrderId, status], map: "idx_anongift_items_order_status")
  @@index([requestType, status], map: "idx_anongift_items_request_type_status")
  @@map("anongift_items")
}

/// AnongiftInboundShipment — 고객 → 멜로밍
model AnongiftInboundShipment {
  id                Int                  @id @default(autoincrement())
  carrier           StoreShipmentCarrier
  trackingNumber    String?              @map("tracking_number") @db.VarChar(50)
  senderNameOnLabel String?              @map("sender_name_on_label") @db.VarChar(100)
  receivedAt        DateTime             @map("received_at") @db.DateTime(0)
  receivedByAdminId Int?                 @map("received_by_admin_id")
  isCOD             Boolean              @default(false) @map("is_cod")
  codAmount         Int?                 @map("cod_amount")
  measuredSize      AnongiftSize?        @map("measured_size")
  measuredWeightG   Int?                 @map("measured_weight_g")
  inboundPhotos     Json?                @map("inbound_photos")
  notes             String?              @db.Text

  item AnongiftItem?

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([carrier, trackingNumber], map: "anongift_inbound_carrier_tracking_unique")
  @@index([receivedAt], map: "idx_anongift_inbound_received")
  @@map("anongift_inbound_shipments")
}

/// AnongiftOutboundShipment — 멜로밍 → 수신자 (한진택배 고정)
model AnongiftOutboundShipment {
  id                       Int                  @id @default(autoincrement())
  carrier                  StoreShipmentCarrier @default(HANJIN)
  trackingNumber           String               @map("tracking_number") @db.VarChar(50)
  dispatchedAt             DateTime             @map("dispatched_at") @db.DateTime(0)
  dispatchedByAdminId      Int?                 @map("dispatched_by_admin_id")
  recipientAddressSnapshot Json                 @map("recipient_address_snapshot")
  outboundLabelName        String               @map("outbound_label_name") @db.VarChar(255)
  deliveredAt              DateTime?            @map("delivered_at") @db.DateTime(0)
  returnedAt               DateTime?            @map("returned_at") @db.DateTime(0)
  returnReason             String?              @map("return_reason") @db.Text
  notes                    String?              @map("notes") @db.Text

  item AnongiftItem?

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([carrier, trackingNumber], map: "anongift_outbound_carrier_tracking_unique")
  @@index([dispatchedAt], map: "idx_anongift_outbound_dispatched")
  @@map("anongift_outbound_shipments")
}

/// 선물하기 발신자 문 앞 → 멜로밍 입고 우체국 방문수거 자동 접수 이력.
/// 실제 입고 완료와 분리된 외부 접수 원장이다.
model AnongiftDoorstepPickupAutomation {
  id                  Int                         @id @default(autoincrement())
  anongiftOrderId     Int                         @unique(map: "anongift_doorstep_pickup_automation_order_unique") @map("anongift_order_id")
  anongiftOrder       AnongiftOrder               @relation(fields: [anongiftOrderId], references: [id], onDelete: Cascade)
  carrier             StoreShipmentCarrier        @default(EPOST)
  status              FulfillmentAutomationStatus @default(PLANNED)
  externalRequestId   String?                     @map("external_request_id") @db.VarChar(120)
  trackingNumber      String?                     @map("tracking_number") @db.VarChar(50)
  pickupRequestedDate DateTime?                   @map("pickup_requested_date") @db.Date
  requestedByAdminId  Int?                        @map("requested_by_admin_id")
  requestedAt         DateTime?                   @map("requested_at") @db.DateTime(0)
  canceledAt          DateTime?                   @map("canceled_at") @db.DateTime(0)
  metadata            Json?
  createdAt           DateTime                    @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime                    @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([status, pickupRequestedDate], map: "idx_anongift_pickup_automation_status_date")
  @@index([carrier, trackingNumber], map: "idx_anongift_pickup_automation_carrier_tracking")
  @@map("anongift_doorstep_pickup_automations")
}

/// 선물하기 검수 완료 박스의 한진 출고 등록 원장.
/// 운송장 등록과 실제 한진 인계 완료를 분리해 중복 접수와 조기 배송 전이를 방지한다.
model AnongiftOutboundAutomation {
  id                 Int                         @id @default(autoincrement())
  anongiftItemId     Int                         @unique(map: "anongift_outbound_automation_item_unique") @map("anongift_item_id")
  anongiftItem       AnongiftItem                @relation(fields: [anongiftItemId], references: [id], onDelete: Cascade)
  carrier            StoreShipmentCarrier        @default(HANJIN)
  status             FulfillmentAutomationStatus @default(PLANNED)
  externalRequestId  String?                     @map("external_request_id") @db.VarChar(120)
  trackingNumber     String?                     @map("tracking_number") @db.VarChar(50)
  labelUrl           String?                     @map("label_url") @db.VarChar(500)
  requestedByAdminId Int?                        @map("requested_by_admin_id")
  requestedAt        DateTime?                   @map("requested_at") @db.DateTime(0)
  handedOverAt       DateTime?                   @map("handed_over_at") @db.DateTime(0)
  canceledAt         DateTime?                   @map("canceled_at") @db.DateTime(0)
  metadata           Json?
  createdAt          DateTime                    @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([status, requestedAt], map: "idx_anongift_outbound_automation_status_requested")
  @@index([carrier, trackingNumber], map: "idx_anongift_outbound_automation_carrier_tracking")
  @@map("anongift_outbound_automations")
}

/// AnongiftInspection — 검수 이력
model AnongiftInspection {
  id                 Int                      @id @default(autoincrement())
  anongiftItemId     Int                      @map("anongift_item_id")
  anongiftItem       AnongiftItem             @relation(fields: [anongiftItemId], references: [id])
  inspectedByAdminId Int                      @map("inspected_by_admin_id")
  result             AnongiftInspectionResult
  rejectionReason    AnongiftRejectionReason? @map("rejection_reason")
  inspectionPhotos   Json?                    @map("inspection_photos")
  notes              String?                  @db.Text
  createdAt          DateTime                 @default(now()) @map("created_at") @db.DateTime(0)

  @@index([anongiftItemId, createdAt], map: "idx_anongift_inspection_item")
  @@map("anongift_inspections")
}

/// AnongiftUnclaimedInbound — 미접수 입고 (14일 보관 후 폐기)
model AnongiftUnclaimedInbound {
  id                  Int                     @id @default(autoincrement())
  carrier             StoreShipmentCarrier
  trackingNumber      String                  @map("tracking_number") @db.VarChar(50)
  senderNameOnLabel   String?                 @map("sender_name_on_label") @db.VarChar(100)
  senderPhoneOnLabel  String?                 @map("sender_phone_on_label") @db.VarChar(50)
  receivedAt          DateTime                @map("received_at") @db.DateTime(0)
  receivedByAdminId   Int?                    @map("received_by_admin_id")
  isCOD               Boolean                 @default(false) @map("is_cod")
  codAmount           Int?                    @map("cod_amount")
  measuredSize        AnongiftSize?           @map("measured_size")
  measuredWeightG     Int?                    @map("measured_weight_g")
  inboundPhotos       Json?                   @map("inbound_photos")
  notes               String?                 @db.Text
  status              AnongiftUnclaimedStatus @default(STORED)
  disposalScheduledAt DateTime                @map("disposal_scheduled_at") @db.DateTime(0)
  disposedAt          DateTime?               @map("disposed_at") @db.DateTime(0)

  linkedItem AnongiftItem?

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([carrier, trackingNumber], map: "anongift_unclaimed_carrier_tracking_unique")
  @@index([status, disposalScheduledAt], map: "idx_anongift_unclaimed_status_disposal")
  @@map("anongift_unclaimed_inbounds")
}

/// AnongiftAdditionalPayment — 추가금 결제 (사이즈/무게/착불)
/// 박스별 1:1 매핑: anongiftItemId 가 박스를 가리키고, 결제 성공 시 해당 박스만 INSPECTION_PASSED 로 전이된다.
model AnongiftAdditionalPayment {
  id              Int           @id @default(autoincrement())
  anongiftOrderId Int           @map("anongift_order_id")
  anongiftOrder   AnongiftOrder @relation(fields: [anongiftOrderId], references: [id])
  anongiftItemId  Int?          @map("anongift_item_id")
  anongiftItem    AnongiftItem? @relation("AnongiftItemAdditionalPayment", fields: [anongiftItemId], references: [id])
  orderId         Int           @unique(map: "anongift_additional_payments_order_unique") @map("order_id")
  order           Order         @relation("AnongiftAdditionalOrder", fields: [orderId], references: [id])

  reason          AnongiftAdditionalPaymentReason
  requestedAmount Int                             @map("requested_amount")
  paidAmount      Int?                            @map("paid_amount")
  paidAt          DateTime?                       @map("paid_at") @db.DateTime(0)
  expiredAt       DateTime                        @map("expired_at") @db.DateTime(0)

  status AnongiftAdditionalPaymentStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([status, expiredAt], map: "idx_anongift_additional_payment_status_expired")
  @@index([anongiftOrderId], map: "idx_anongift_additional_payment_order")
  @@index([anongiftItemId], map: "idx_anongift_additional_payment_item")
  @@map("anongift_additional_payments")
}

/// AnongiftSizeTier — 사이즈별 가격 (admin 조정 가능)
model AnongiftSizeTier {
  id            Int          @id @default(autoincrement())
  size          AnongiftSize
  price         Int
  description   String?      @db.Text
  effectiveFrom DateTime     @map("effective_from") @db.DateTime(0)
  effectiveTo   DateTime?    @map("effective_to") @db.DateTime(0)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([size, effectiveFrom], map: "anongift_size_tiers_size_effective_from_idx")
  @@map("anongift_size_tiers")
}

/// AnongiftDoorstepPickupSetting — 문 앞 수거 옵션 가격/제약/수거처 (admin 조정 가능)
model AnongiftDoorstepPickupSetting {
  id                 Int          @id @default(autoincrement())
  size               AnongiftSize @unique(map: "anongift_doorstep_pickup_settings_size_unique")
  maxTotalLengthCm   Int          @map("max_total_length_cm")
  maxWeightKg        Int          @map("max_weight_kg")
  baseCostAmount     Int          @map("base_cost_amount")
  serviceFeeAmount   Int          @map("service_fee_amount")
  pickupProviderName String       @map("pickup_provider_name") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("anongift_doorstep_pickup_settings")
}

/// AnongiftRecipientProfile — 스트리머/팬 양방향 수령 프로필
model AnongiftRecipientProfile {
  userId Int  @id @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  isReceivingEnabled      Boolean           @default(false) @map("is_receiving_enabled")
  addressId               Int?              @unique(map: "anongift_profile_address_unique") @map("address_id")
  address                 StoreUserAddress? @relation("AnongiftRecipientAddress", fields: [addressId], references: [id])
  publicNickname          String?           @map("public_nickname") @db.VarChar(100)
  recipientCode           String?           @unique(map: "anongift_profile_recipient_code_unique") @map("recipient_code") @db.VarChar(32)
  packagingTapePreference String            @default("MELOMING") @map("packaging_tape_preference") @db.VarChar(20)
  acceptedTermsAt         DateTime?         @map("accepted_terms_at") @db.DateTime(0)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("anongift_recipient_profiles")
}

/// AnongiftNotification — 알림 발송 추적 (Alimtalk + Email fan-out)
model AnongiftNotification {
  id              Int            @id @default(autoincrement())
  anongiftOrderId Int?           @map("anongift_order_id")
  anongiftOrder   AnongiftOrder? @relation(fields: [anongiftOrderId], references: [id])

  triggerCode     String                      @map("trigger_code") @db.VarChar(64)
  channel         AnongiftNotificationChannel
  templateCode    String                      @map("template_code") @db.VarChar(128)
  recipientUserId Int                         @map("recipient_user_id")
  senderUserId    Int?                        @map("sender_user_id")
  rateLimitKey    String?                     @map("rate_limit_key") @db.VarChar(128)
  payload         Json
  sentAt          DateTime?                   @map("sent_at") @db.DateTime(0)
  failureReason   String?                     @map("failure_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([triggerCode, recipientUserId], map: "idx_anongift_notif_trigger_recipient")
  @@index([anongiftOrderId, channel], map: "idx_anongift_notif_order_channel")
  @@index([rateLimitKey, createdAt], map: "idx_anongift_notif_rate_limit")
  @@index([recipientUserId, triggerCode, senderUserId], map: "idx_anongift_notif_recipient_trigger_sender")
  @@map("anongift_notifications")
}

/// 발신자가 anongift 결제 단계에서 고르는 입고 방식.
/// DIRECT_HOME_DELIVERY = 일반택배 (멜로밍 본사 주소로 임의 발송, 기존 흐름).
/// HALF_PRICE_CVS = 반값택배 (편의점 수신 점포 풀에서 자동 배정).
enum AnongiftInboundDeliveryOption {
  DIRECT_HOME_DELIVERY @map("direct_home_delivery")
  HALF_PRICE_CVS       @map("half_price_cvs")
}

/// 반값택배 수신 편의점 브랜드.
enum AnongiftConvenienceBrand {
  GS25 @map("gs25")
  CU   @map("cu")
}

/// 점포 자리 reservation 상태.
/// ACTIVE = 자리 차지 중 (count 됨). RELEASED = 멜로밍 본사 입고 처리로 자리 해제.
/// CANCELED = 결제 실패/취소로 자리 해제.
enum AnongiftPickupReservationStatus {
  ACTIVE   @map("active")
  RELEASED @map("released")
  CANCELED @map("canceled")
}

/// AnongiftPickupStore — 반값택배 수신 점포 풀.
/// 멜로밍이 운영팀에서 직접 등록/관리 (meloming-store-admin). 발신자는 종류만
/// 선택하고 시스템이 sortOrder + 잔여 capacity 기반 자동 배정.
model AnongiftPickupStore {
  id             Int                      @id @default(autoincrement())
  brand          AnongiftConvenienceBrand
  name           String                   @db.VarChar(200)
  /// 점포 주소 (도로명 전체). 발신자에게 노출.
  address        String                   @db.VarChar(500)
  /// 점포 대표 전화 (선택). 발신자가 영업시간 등 직접 확인용.
  contactPhone   String?                  @map("contact_phone") @db.VarChar(50)
  /// 영업시간 (자유 텍스트). 예: "매일 24시간".
  operatingHours String?                  @map("operating_hours") @db.VarChar(200)
  /// 어드민이 직접 부여하는 우선순위. 낮을수록 먼저 배정.
  sortOrder      Int                      @map("sort_order")
  /// 동시 입고 대기 가능한 최대 박스 수.
  maxCapacity    Int                      @map("max_capacity")
  /// 점포 비활성화 토글 (어드민 운영용). false 면 신규 배정 제외.
  isActive       Boolean                  @default(true) @map("is_active")
  /// 운영 메모 (어드민 전용). 예: 운영팀 연락처, 특이사항.
  operatorMemo   String?                  @map("operator_memo") @db.Text

  reservations AnongiftPickupReservation[]

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([brand, isActive, sortOrder], map: "idx_anongift_pickup_store_brand_active_sort")
  @@map("anongift_pickup_stores")
}

/// AnongiftPickupReservation — anongift 주문 1건이 점포 1곳에 예약한 자리.
/// orderId unique 라 1주문 1예약. ACTIVE 만 자리 카운트에 포함.
/// 결제 트랜잭션 내에서 SELECT FOR UPDATE 로 점포 락 + 잔여 capacity 검사 +
/// reservation INSERT 가 atomic 하게 진행.
model AnongiftPickupReservation {
  id      Int           @id @default(autoincrement())
  orderId Int           @unique(map: "anongift_pickup_reservation_order_unique") @map("order_id")
  order   AnongiftOrder @relation(fields: [orderId], references: [id])

  storeId Int                 @map("store_id")
  store   AnongiftPickupStore @relation(fields: [storeId], references: [id])

  status        AnongiftPickupReservationStatus @default(ACTIVE)
  reservedAt    DateTime                        @default(now()) @map("reserved_at") @db.DateTime(0)
  releasedAt    DateTime?                       @map("released_at") @db.DateTime(0)
  /// release / cancel 사유 메모. 운영팀 수동 해제 시 사유 기록.
  releaseReason String?                         @map("release_reason") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([storeId, status], map: "idx_anongift_pickup_reservation_store_status")
  @@map("anongift_pickup_reservations")
}

// ===================================
// Voice Commission domain
// ===================================

enum VoiceContentType {
  MESSAGE      @map("message") // 멘트
  SONG         @map("song") // 노래 불러주기
  ASMR         @map("asmr")
  MORNING_CALL @map("morning_call")
}

enum VoiceOrderStatus {
  PENDING_PAYMENT  @map("pending_payment")
  PENDING_REVIEW   @map("pending_review") // 결제 완료, 채널 검토 대기
  IN_PROGRESS      @map("in_progress") // 채널 수락 / 작업 중
  DELIVERED        @map("delivered")
  COMPLETED        @map("completed")
  DECLINED         @map("declined")
  AUTO_CANCELED    @map("auto_canceled") // 기한 만료 자동 취소
  REFUND_REQUESTED @map("refund_requested")
  REFUNDED         @map("refunded")
}

// 채널별 보이스 커미션 설정 (탭 활성화 + 프로필)
model VoiceCommissionChannel {
  id        Int     @id @default(autoincrement())
  channelId Int?     @unique @map("channel_id") // 멜로밍 channel (삭제 시 주문 이력 보존을 위해 NULL)
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  isActive        Boolean @default(false) @map("is_active") // 11.4 정산프로필 게이팅 통과 시에만 true
  acceptingOrders Boolean @default(true) @map("accepting_orders")
  maxConcurrent   Int     @default(5) @map("max_concurrent")
  pausedReason    String? @map("paused_reason")

  introduction String? @db.Text
  guide        String? @db.Text // 안내사항 (개인소장 원칙 등)

  totalOrders      Int      @default(0) @map("total_orders")
  avgRating        Decimal? @map("avg_rating") @db.Decimal(3, 2)
  avgResponseHours Int?     @map("avg_response_hours")

  recommendedFrom      DateTime? @map("recommended_from")
  recommendedUntil     DateTime? @map("recommended_until")
  recommendedSortOrder Int       @default(0) @map("recommended_sort_order")
  recommendedMemo      String?   @map("recommended_memo") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products VoiceCommissionProduct[]
  orders   VoiceCommissionOrder[]

  @@index([isActive])
  @@index([recommendedFrom, recommendedUntil, recommendedSortOrder], map: "idx_voice_channels_recommended_window")
  @@map("voice_commission_channels")
}

// 보이스커미션 공통 상품 종류
model VoiceCommissionProductType {
  id          Int              @id @default(autoincrement())
  code        String           @db.VarChar(64)
  name        String           @db.VarChar(80)
  contentType VoiceContentType @default(MESSAGE) @map("content_type")
  description String?          @db.Text
  isActive    Boolean          @default(true) @map("is_active")
  isDefault   Boolean          @default(false) @map("is_default")
  sortOrder   Int              @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products VoiceCommissionProduct[]

  @@unique([code], map: "voice_commission_product_types_code_unique")
  @@index([isActive, sortOrder], map: "idx_voice_product_types_active_sort")
  @@map("voice_commission_product_types")
}

// 채널별 상품 (한 채널이 여러 상품 등록)
model VoiceCommissionProduct {
  id            Int                         @id @default(autoincrement())
  vcChannelId   Int                         @map("vc_channel_id")
  vcChannel     VoiceCommissionChannel      @relation(fields: [vcChannelId], references: [id])
  productTypeId Int?                        @map("product_type_id")
  productType   VoiceCommissionProductType? @relation(fields: [productTypeId], references: [id], onDelete: SetNull)

  contentType     VoiceContentType @map("content_type")
  durationSeconds Int              @map("duration_seconds") // 30..300, 10초 grid (검증: 30<=x<=300 && x%10==0)
  repeatCount     Int              @default(1) @map("repeat_count") // 패키지 묶음 수

  title        String // "30초 멘트", "1분 노래 불러주기"
  description  String? @db.Text
  sampleVoices Json?   @map("sample_voices") // 선택 등록 샘플 보이스 메타데이터 배열

  price        Int // VAT 포함 결제가, 채널 자유 설정
  deliveryDays Int       @default(7) @map("delivery_days") // 작업 납품 기한 (일). 최소 1, 1일 단위 채널 조정
  isActive     Boolean   @default(true) @map("is_active")
  sortOrder    Int       @default(0) @map("sort_order")
  deletedAt    DateTime? @map("deleted_at") @db.DateTime(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders           VoiceCommissionOrder[]
  haejuseyoProduct HaejuseyoProduct?

  @@index([vcChannelId, isActive])
  @@index([deletedAt], map: "idx_voice_commission_products_deleted_at")
  @@index([productTypeId], map: "idx_voice_commission_products_product_type")
  @@map("voice_commission_products")
}

model VoiceCommissionOrder {
  id      Int   @id @default(autoincrement())
  orderId Int   @unique @map("order_id")
  order   Order @relation(fields: [orderId], references: [id])

  vcChannelId Int                    @map("vc_channel_id")
  vcChannel   VoiceCommissionChannel @relation(fields: [vcChannelId], references: [id])
  productId   Int                    @map("product_id")
  product     VoiceCommissionProduct @relation(fields: [productId], references: [id])
  buyerId     Int                    @map("buyer_id")
  buyer       User                   @relation("VoiceCommissionBuyer", fields: [buyerId], references: [id])

  // 결제 스냅샷 (정산 발행용 — gross 기준, 수수료는 partners-back FeePolicy)
  grossAmount  Int @map("gross_amount") // 결제 총액 (VAT 포함)
  supplyAmount Int @map("supply_amount") // 공급가 (VAT 제외)
  vatAmount    Int @map("vat_amount")

  // 주문 내용
  contentType     VoiceContentType @map("content_type")
  script          String           @db.Text // 멘트/요청 내용
  durationSeconds Int              @map("duration_seconds")
  repeatCount     Int              @default(1) @map("repeat_count")
  buyerNote       String?          @map("buyer_note") @db.Text

  // 라이프사이클 (멜로밍 커미션 약관 일치)
  status          VoiceOrderStatus @default(PENDING_PAYMENT)
  acceptedAt      DateTime?        @map("accepted_at")
  declinedAt      DateTime?        @map("declined_at")
  declineReason   String?          @map("decline_reason")
  deadlineAt      DateTime?        @map("deadline_at") // 결제 시점 + product.deliveryDays
  deliveredAt     DateTime?        @map("delivered_at")
  deliveryComment String?          @map("delivery_comment") @db.Text
  autoCanceledAt  DateTime?        @map("auto_canceled_at")
  refundedAt      DateTime?        @map("refunded_at")
  completedAt     DateTime?        @map("completed_at")

  // 정산 emit (commission-back 미러)
  payoutEmittedAt DateTime? @map("payout_emitted_at")
  payoutEventId   String?   @map("payout_event_id")

  reviewRating Int?      @map("review_rating")
  reviewText   String?   @map("review_text") @db.Text
  reviewedAt   DateTime? @map("reviewed_at")

  deliveries     VoiceCommissionDelivery[]
  haejuseyoOrder HaejuseyoOrder?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([vcChannelId, status])
  @@index([buyerId, status])
  @@index([status, deadlineAt])
  @@map("voice_commission_orders")
}

model VoiceCommissionDelivery {
  id      Int                  @id @default(autoincrement())
  orderId Int                  @map("order_id")
  order   VoiceCommissionOrder @relation(fields: [orderId], references: [id])

  trackIndex      Int      @map("track_index") // 1..repeatCount
  audioFileKey    String   @map("audio_file_key") // S3 key (signed URL 동적 발급)
  durationSeconds Int      @map("duration_seconds")
  fileSizeBytes   Int      @map("file_size_bytes")
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  @@unique([orderId, trackIndex])
  @@map("voice_commission_deliveries")
}

