enum RevenueCostEntryStatus {
  ACTIVE @map("active")
  VOIDED @map("voided")
}

/// 전사 수익 대시보드용 비용/손실 ledger.
/// 실제 배송 원가, 무료배송/PRO/마케팅 보조, PG 수수료 보정 등 주문 단위 또는 서비스 단위 비용을 기록한다.
model RevenueCostEntry {
  id          Int                    @id @default(autoincrement())
  source      RevenueCostSource
  kind        RevenueCostKind
  status      RevenueCostEntryStatus @default(ACTIVE)
  amount      Int
  currency    String                 @default("KRW") @db.VarChar(3)
  occurredAt  DateTime               @default(now()) @map("occurred_at") @db.DateTime(0)
  description String?                @db.VarChar(500)
  metadata    Json?

  orderId         Int?           @map("order_id")
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  storeOrderId    Int?           @map("store_order_id")
  storeOrder      StoreOrder?    @relation(fields: [storeOrderId], references: [id], onDelete: SetNull)
  anongiftOrderId Int?           @map("anongift_order_id")
  anongiftOrder   AnongiftOrder? @relation(fields: [anongiftOrderId], references: [id], onDelete: SetNull)

  recordedByAdminId Int?     @map("recorded_by_admin_id")
  recordedByAdmin   User?    @relation("RevenueCostEntryRecorder", fields: [recordedByAdminId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([source, kind, occurredAt], map: "idx_revenue_cost_entries_source_kind_at")
  @@index([status, occurredAt], map: "idx_revenue_cost_entries_status_at")
  @@index([orderId], map: "idx_revenue_cost_entries_order")
  @@index([storeOrderId, kind], map: "idx_revenue_cost_entries_store_kind")
  @@index([anongiftOrderId, kind], map: "idx_revenue_cost_entries_anongift_kind")
  @@map("revenue_cost_entries")
}

model Payment {
  id Int @id @default(autoincrement())

  // Order linkage
  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Provider & Method
  provider PaymentProvider
  method   PaymentMethod
  status   PaymentStatus   @default(READY)

  // Monetary
  amount   Int
  currency String @default("KRW") @db.VarChar(3)

  // Danal merchant (CPID)
  merchantId String? @map("merchant_id") @db.VarChar(20)

  // Idempotency / provider Tx
  idempotencyKey String? @unique(map: "uq_payments_idempotency_key") @map("idempotency_key") @db.VarChar(64)
  providerTxId   String? @map("provider_tx_id") @db.VarChar(64)

  // Optional user linkage
  userId    Int?  @map("user_id")
  user      User? @relation(fields: [userId], references: [id])
  // Arbitrary user-provided payload at purchase time
  userInput Json? @map("user_input")

  // Billing key linkage (for subscription payments)
  billingKeyId Int?        @map("billing_key_id")
  billingKey   BillingKey? @relation(fields: [billingKeyId], references: [id])

  // Method specific details / normalized codes
  providerToken String? @map("provider_token") @db.VarChar(255)
  issuerCode    String? @map("issuer_code") @db.VarChar(10)
  bankCode      String? @map("bank_code") @db.VarChar(10)
  methodDetails Json?   @map("method_details")

  // Timestamps
  approvedAt DateTime? @map("approved_at") @db.DateTime(0)
  canceledAt DateTime? @map("canceled_at") @db.DateTime(0)
  failedAt   DateTime? @map("failed_at") @db.DateTime(0)
  expiredAt  DateTime? @map("expired_at") @db.DateTime(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  // Error / diagnostics
  failCode              String?   @map("fail_code") @db.VarChar(50)
  failMessage           String?   @map("fail_message") @db.Text
  rawPayload            Json?     @map("raw_payload")
  webhookLastReceivedAt DateTime? @map("webhook_last_received_at") @db.DateTime(0)

  // Relations
  events            PaymentEvent[]
  subscriptionTerms UserSubscriptionTerm[]
  cashTopupRefunds  CashTopupRefund[]
  rentalBaseOrder   RentalOrder?            @relation("RentalOrderBasePayment")
  rentalCharge      RentalAdditionalCharge? @relation("RentalAdditionalChargePayment")

  @@unique([provider, providerTxId], map: "uq_payments_provider_txid")
  @@index([status, createdAt], map: "idx_payments_status_created")
  @@index([status, orderId], map: "idx_payments_status_order_id")
  @@index([status, expiredAt], map: "idx_payments_status_expired")
  @@index([orderId], map: "idx_payments_order_id")
  @@index([userId, createdAt], map: "idx_payments_user_created")
  @@map("payments")
}

/// 빌링키 (정기결제용 결제수단 등록)
model BillingKey {
  id Int @id @default(autoincrement())

  // 포트원 빌링키
  billingKey String @unique @map("billing_key") @db.VarChar(100)

  // 사용자 연결
  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 결제 정보
  provider PaymentProvider  @default(PORTONE)
  method   PaymentMethod
  status   BillingKeyStatus @default(ISSUED)

  // 카드/결제수단 정보 (마스킹된 정보 저장)
  methodDetails Json? @map("method_details")

  // 채널 정보
  channelKey String? @map("channel_key") @db.VarChar(100)

  // 우선순위 (낮을수록 우선)
  priority Int @default(0)

  // 메타데이터
  customData String? @map("custom_data") @db.Text

  // 타임스탬프
  issuedAt  DateTime  @default(now()) @map("issued_at") @db.DateTime(0)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  // 관계
  payments          Payment[]
  subscriptionTerms UserSubscriptionTerm[]
  rentalOrders      RentalOrder[]
  rentalCharges     RentalAdditionalCharge[]

  @@index([userId], map: "idx_billing_keys_user")
  @@index([status], map: "idx_billing_keys_status")
  @@index([userId, status, priority], map: "idx_billing_keys_user_status_priority")
  @@map("billing_keys")
}

/// Payment Events (return/webhook/confirm logs)
model PaymentEvent {
  id        Int     @id @default(autoincrement())
  paymentId Int     @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  provider    PaymentProvider
  eventType   String          @map("event_type") @db.VarChar(50)
  eventStatus String?         @map("event_status") @db.VarChar(50)

  providerTxId String? @map("provider_tx_id") @db.VarChar(64)
  eventId      String? @unique(map: "uq_payment_events_event_id") @map("event_id") @db.VarChar(128)

  occurredAt DateTime? @map("occurred_at") @db.DateTime(0)
  receivedAt DateTime  @default(now()) @map("received_at") @db.DateTime(0)

  rawRequest  Json? @map("raw_request")
  rawResponse Json? @map("raw_response")
  headers     Json? @map("headers")

  @@unique([provider, providerTxId, eventType], map: "uq_payment_events_dedup")
  @@index([paymentId, receivedAt], map: "idx_payment_events_payment_received")
  @@map("payment_events")
}

