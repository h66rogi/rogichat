enum AppVersionStatus {
  DRAFT    @map("draft")
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

enum AppIntegrationType {
  IFRAME @map("iframe")
  LINK   @map("link")
  NATIVE @map("native")
}

enum AppHistoryAction {
  CREATE         @map("create")
  CREATE_VERSION @map("create_version")
  UPDATE_DRAFT   @map("update_draft")
  SUBMIT         @map("submit")
  APPROVE        @map("approve")
  REJECT         @map("reject")
  PUBLISH        @map("publish")
  UNPUBLISH      @map("unpublish")
}

model App {
  id            Int     @id @default(autoincrement())
  slug          String  @unique(map: "apps_slug_unique") @db.VarChar(64)
  ownerUserId   Int     @map("owner_user_id")
  liveVersionId Int?    @map("live_version_id")
  isPublished   Boolean @default(false) @map("is_published")
  managedByTeam Boolean @default(false) @map("managed_by_team")

  /// Per-app version counter to allocate version numbers atomically.
  versionSeq Int @default(0) @map("version_seq")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  owner       User               @relation("AppOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  liveVersion AppVersion?        @relation("AppLiveVersion", fields: [liveVersionId], references: [id], onDelete: SetNull)
  versions    AppVersion[]
  histories   AppStatusHistory[]

  @@index([ownerUserId, createdAt], map: "idx_apps_owner_created")
  @@index([isPublished, liveVersionId], map: "idx_apps_publish_live")
  @@map("apps")
}

model AppVersion {
  id Int @id @default(autoincrement())

  appId   Int @map("app_id")
  app     App @relation(fields: [appId], references: [id], onDelete: Cascade)
  version Int

  status          AppVersionStatus
  name            String             @db.VarChar(30)
  description     String?            @db.Text
  category        String             @db.VarChar(50)
  iconUrl         String?            @map("icon_url") @db.VarChar(500)
  lucideIconName  String?            @map("lucide_icon_name") @db.VarChar(64)
  themeColor      String?            @map("theme_color") @db.VarChar(20)
  screenshots     Json?              @map("screenshots")
  integrationType AppIntegrationType @map("integration_type")
  /// For integrationType=IFRAME/LINK only. For NATIVE, use nativeKey.
  appUrl          String?            @map("app_url") @db.VarChar(500)
  nativeKey       String?            @map("native_key") @db.VarChar(64)
  allowedDomains  Json?              @map("allowed_domains")

  rejectionReason       String?   @map("rejection_reason") @db.Text
  submittedAt           DateTime? @map("submitted_at") @db.DateTime(0)
  reviewedAt            DateTime? @map("reviewed_at") @db.DateTime(0)
  reviewedByAdminUserId Int?      @map("reviewed_by_admin_user_id")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  reviewedByAdminUser User?              @relation("AppVersionReviewedBy", fields: [reviewedByAdminUserId], references: [id], onDelete: SetNull)
  liveInApps          App[]              @relation("AppLiveVersion")
  histories           AppStatusHistory[]

  @@unique([appId, version], map: "uq_app_versions_app_version")
  @@index([appId, status, createdAt], map: "idx_app_versions_app_status_created")
  @@map("app_versions")
}

model AppStatusHistory {
  id Int @id @default(autoincrement())

  appId     Int  @map("app_id")
  versionId Int? @map("version_id")

  changedByUserId Int @map("changed_by_user_id")

  previousStatus String?          @map("previous_status") @db.VarChar(50)
  newStatus      String?          @map("new_status") @db.VarChar(50)
  actionType     AppHistoryAction @map("action_type")
  memo           String?          @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  app       App         @relation(fields: [appId], references: [id], onDelete: Cascade)
  version   AppVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  changedBy User        @relation("AppStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt], map: "idx_app_histories_app_created")
  @@index([versionId], map: "idx_app_histories_version")
  @@map("app_status_histories")
}

