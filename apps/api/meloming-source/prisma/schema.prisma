// ===================================
// Spotlight domain
// ===================================

enum SpotlightOrderStatus {
  RESERVED  @map("reserved")
  ACTIVE    @map("active")
  CANCELED  @map("canceled")
  COMPLETED @map("completed")

  @@map("spotlight_order_status")
}

model SpotlightOrder {
  id          Int                  @id @default(autoincrement())
  userId      Int                  @map("user_id")
  // Nullable so a channel can be deleted without losing the payment/billing
  // ledger. Channel deletion sets this to NULL via FK ON DELETE SET NULL.
  channelId   Int?                 @map("channel_id")
  // UTC instant at which the 1-hour slot starts. Authoritative; legacy split
  // columns below are kept nullable during the transition and dropped in a
  // follow-up migration once all rows are backfilled.
  slotStartAt DateTime?            @map("slot_start_at") @db.DateTime(0)
  slotDate    DateTime?            @map("slot_date") @db.Date
  slotHour    Int?                 @map("slot_hour")
  paymentType String               @map("payment_type") @db.VarChar(10) // POINT | CASH
  pointAmount Int?                 @map("point_amount")
  orderId     Int?                 @map("order_id")
  // 동시 송출 시 어느 플랫폼 라이브를 spotlight 노출 대상으로 삼을지.
  // 사용자가 구매 시 자신의 APPROVED non-OTHER 인증 플랫폼 중 1개를 선택.
  // 신규 정책 도입 전 생성된 행은 NULL(legacy) — 라이브 시 모든 플랫폼 fallback.
  platform    StreamPlatform?
  status      SpotlightOrderStatus @default(ACTIVE)
  createdAt   DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.DateTime(0)

  user    User     @relation(fields: [userId], references: [id])
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id])

  @@index([slotStartAt, status], name: "idx_spotlight_slot_start_status")
  @@index([slotDate, slotHour, status], name: "idx_spotlight_slot_status")
  @@index([userId, status], name: "idx_spotlight_user")
  @@index([channelId], name: "idx_spotlight_channel")
  @@map("spotlight_orders")
}

model SpotlightBlock {
  id          Int       @id @default(autoincrement())
  slotStartAt DateTime? @map("slot_start_at") @db.DateTime(0)
  slotDate    DateTime? @map("slot_date") @db.Date
  slotHour    Int?      @map("slot_hour")
  reason      String?   @db.VarChar(500)
  createdBy   Int       @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  creator User @relation(fields: [createdBy], references: [id])

  @@unique([slotStartAt], name: "uq_spotlight_block_slot_start")
  @@unique([slotDate, slotHour], name: "uq_spotlight_block_slot")
  @@map("spotlight_blocks")
}

// ===================================
// Issue Broadcast (이슈 방송) domain
// ===================================
// 스포트라이트와 동일한 예약형 구조이나 차이점:
// - 신청당 고정 1,000P / ₩1,000 (시간당 과금 X)
// - 스트리머(채널 소유 + 플랫폼 인증 완료) 본인만 신청 가능
// - KST 캘린더 월(1일~말일) 1회 제한
// - 1~3시간 연속 블록 예약, 같은 구간 독점(겹치는 ACTIVE/RESERVED 예약 불가)
// 노출: 스포트라이트 섹션 아래 '이슈 방송' 섹션에 동일 디자인으로, 예약 구간 내 라이브일 때만.

enum IssueBroadcastOrderStatus {
  RESERVED  @map("reserved")
  ACTIVE    @map("active")
  CANCELED  @map("canceled")
  COMPLETED @map("completed")

  @@map("issue_broadcast_order_status")
}

model IssueBroadcastOrder {
  id            Int                       @id @default(autoincrement())
  userId        Int                       @map("user_id")
  // 채널 삭제 시 결제/환불 원장 보존을 위해 nullable (FK ON DELETE SET NULL).
  channelId     Int?                      @map("channel_id")
  // 예약 구간의 UTC 시작/종료 instant. slotEndAt = slotStartAt + durationHours.
  // 겹침(독점) 판정 및 현재 노출 판정에 사용.
  slotStartAt   DateTime                  @map("slot_start_at") @db.DateTime(0)
  slotEndAt     DateTime                  @map("slot_end_at") @db.DateTime(0)
  durationHours Int                       @map("duration_hours") // 1 ~ 3
  // KST 캘린더 월("YYYY-MM"). 슬롯 시작 기준 불변값 — 월 1회 제한 카운트용.
  slotMonth     String                    @map("slot_month") @db.VarChar(7)
  paymentType   String                    @map("payment_type") @db.VarChar(10) // POINT | CASH
  pointAmount   Int?                      @map("point_amount")
  orderId       Int?                      @map("order_id")
  // 동시 송출 시 노출 대상 플랫폼. APPROVED + platformChannelId 보유 인증 중 1개.
  platform      StreamPlatform?
  status        IssueBroadcastOrderStatus @default(ACTIVE)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.DateTime(0)

  user    User     @relation(fields: [userId], references: [id])
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id])

  @@index([slotStartAt, slotEndAt, status], name: "idx_issue_bc_window_status")
  @@index([userId, slotMonth, status], name: "idx_issue_bc_user_month")
  @@index([channelId], name: "idx_issue_bc_channel")
  @@index([orderId], name: "idx_issue_bc_order")
  @@map("issue_broadcast_orders")
}

// Organization system

enum OrgMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum OrgStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum OrgFeatureStatus {
  REQUESTED
  ENABLED
  REJECTED
}

enum ExpenseProofType {
  TAX_INVOICE
  CASH_RECEIPT
}

enum CashReceiptPurpose {
  PERSONAL_DEDUCTION
  BUSINESS_EXPENSE
}

enum AlertChannelType {
  SLACK
  DISCORD
  PUSH
}

model Organization {
  id              Int       @id @default(autoincrement())
  name            String
  status          OrgStatus @default(PENDING)
  rejectionReason String?   @db.VarChar(500)
  approvedBy      Int?
  rejectedBy      Int?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members            OrganizationMember[]
  invitations        OrganizationInvitation[]
  keywordAlertConfig KeywordAlertConfig?
  features           OrganizationFeature[]
  expenseProof       OrganizationExpenseProof?
  approver           User?                     @relation("orgApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  rejector           User?                     @relation("orgRejector", fields: [rejectedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model OrganizationMember {
  id             Int           @id @default(autoincrement())
  organizationId Int
  userId         Int
  role           OrgMemberRole
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvitation {
  id             Int              @id @default(autoincrement())
  organizationId Int
  inviterId      Int
  inviteeId      Int
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  respondedAt    DateTime?
  expiresAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("orgInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee      User         @relation("orgInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, inviteeId, status])
  @@index([inviteeId, status])
}

model OrganizationFeature {
  id              Int              @id @default(autoincrement())
  organizationId  Int
  featureKey      String           @db.VarChar(50)
  status          OrgFeatureStatus
  requestedAt     DateTime         @default(now())
  decidedAt       DateTime?
  decidedBy       Int?
  rejectionReason String?          @db.VarChar(500)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decider      User?        @relation("featureDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, featureKey])
  @@index([status])
}

model OrganizationExpenseProof {
  id             Int              @id @default(autoincrement())
  organizationId Int              @unique
  type           ExpenseProofType

  // TAX_INVOICE fields
  businessRegistrationNumber String? @db.VarChar(20)
  businessName               String? @db.VarChar(200)
  representativeName         String? @db.VarChar(100)
  businessAddress            String? @db.VarChar(500)
  businessType               String? @db.VarChar(100)
  businessItem               String? @db.VarChar(200)
  email                      String? @db.VarChar(200)

  // CASH_RECEIPT fields
  cashReceiptPurpose    CashReceiptPurpose?
  cashReceiptIdentifier String?             @db.VarChar(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model KeywordAlertConfig {
  id             Int      @id @default(autoincrement())
  organizationId Int      @unique
  isActive       Boolean  @default(true)
  // legacy — kept nullable for safe rollback. dropped in cleanup PR.
  keywords       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channels     KeywordAlertChannel[]
  groups       KeywordAlertGroup[]
  userGroups   KeywordAlertUserGroup[]
}

model KeywordAlertChannel {
  id         Int              @id @default(autoincrement())
  configId   Int
  name       String?          @db.VarChar(100)
  type       AlertChannelType
  webhookUrl String?
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())

  config         KeywordAlertConfig             @relation(fields: [configId], references: [id], onDelete: Cascade)
  groupLinks     KeywordAlertGroupChannel[]
  userGroupLinks KeywordAlertUserGroupChannel[]

  @@index([configId])
}

model KeywordAlertGroup {
  id        Int      @id @default(autoincrement())
  configId  Int
  name      String   @db.VarChar(100)
  keywords  Json     @default("[]")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config       KeywordAlertConfig         @relation(fields: [configId], references: [id], onDelete: Cascade)
  channelLinks KeywordAlertGroupChannel[]

  @@index([configId])
}

model KeywordAlertGroupChannel {
  id        Int @id @default(autoincrement())
  groupId   Int
  channelId Int

  group   KeywordAlertGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  channel KeywordAlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([groupId, channelId])
  @@index([channelId])
}

model KeywordAlertUserGroup {
  id        Int      @id @default(autoincrement())
  configId  Int
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config       KeywordAlertConfig             @relation(fields: [configId], references: [id], onDelete: Cascade)
  users        KeywordAlertUserGroupUser[]
  channelLinks KeywordAlertUserGroupChannel[]

  @@index([configId])
}

model KeywordAlertUserGroupUser {
  id             Int      @id @default(autoincrement())
  groupId        Int
  platform       String   @db.VarChar(50)
  platformUserId String   @db.VarChar(200)
  displayLabel   String?  @db.VarChar(200)
  createdAt      DateTime @default(now())

  group KeywordAlertUserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, platform, platformUserId])
  @@index([groupId])
}

model KeywordAlertUserGroupChannel {
  id        Int @id @default(autoincrement())
  groupId   Int
  channelId Int

  group   KeywordAlertUserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  channel KeywordAlertChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([groupId, channelId])
  @@index([channelId])
}

// ===================================
// Sync Posts domain (Phase 6)
// ===================================

enum SyncPostStatus {
  OPEN
  MATCHED
  CLOSED
  EXPIRED

  @@map("sync_post_status")
}

enum SyncPostModerationStatus {
  NORMAL
  HIDDEN_BY_REPORT
  HIDDEN_BY_ADMIN
  CLEARED

  @@map("sync_post_moderation_status")
}

enum SyncPostReportReason {
  SPAM
  INAPPROPRIATE
  FRAUD
  OTHER

  @@map("sync_post_report_reason")
}

model SyncRoomPost {
  id                  Int                      @id @default(autoincrement())
  authorUserId        Int                      @map("author_user_id")
  title               String                   @db.VarChar(100)
  content             String                   @db.Text
  preferredTimeText   String?                  @map("preferred_time_text") @db.VarChar(100)
  desiredChannelCount Int?                     @map("desired_channel_count")
  status              SyncPostStatus           @default(OPEN)
  moderation          SyncPostModerationStatus @default(NORMAL) @map("moderation")
  hiddenAt            DateTime?                @map("hidden_at")
  syncRoomCode        String?                  @map("sync_room_code") @db.VarChar(16)
  contentHash         String                   @map("content_hash") @db.Char(64)
  authorLiveAtPublish Boolean                  @default(false) @map("author_live_at_publish")
  commentCount        Int                      @default(0) @map("comment_count")
  subscriberCount     Int                      @default(0) @map("subscriber_count")
  reportCount         Int                      @default(0) @map("report_count")
  expiresAt           DateTime                 @map("expires_at")
  deletedAt           DateTime?                @map("deleted_at")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  author        User                       @relation("SyncRoomPostAuthor", fields: [authorUserId], references: [id])
  syncRoom      SyncRoom?                  @relation("SyncRoomPostLinked", fields: [syncRoomCode], references: [code], onDelete: SetNull)
  comments      SyncRoomPostComment[]
  subscriptions SyncRoomPostSubscription[]
  reports       SyncRoomPostReport[]

  @@index([status, moderation, createdAt(sort: Desc), id(sort: Desc)])
  @@index([deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorUserId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorUserId, status, createdAt])
  @@index([expiresAt])
  @@index([syncRoomCode])
  @@index([contentHash, authorUserId, createdAt])
  @@map("sync_room_posts")
}

model SyncRoomPostComment {
  id           Int       @id @default(autoincrement())
  postId       Int       @map("post_id")
  authorUserId Int       @map("author_user_id")
  content      String    @db.Text
  reportCount  Int       @default(0) @map("report_count")
  hiddenAt     DateTime? @map("hidden_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  post    SyncRoomPost                @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User                        @relation("SyncRoomPostCommentAuthor", fields: [authorUserId], references: [id])
  reports SyncRoomPostCommentReport[]

  @@index([postId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorUserId])
  @@map("sync_room_post_comments")
}

model SyncRoomPostSubscription {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post SyncRoomPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User         @relation("SyncRoomPostSubscriber", fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([userId])
  @@map("sync_room_post_subscriptions")
}

model SyncSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  liveOnly  Boolean  @default(false) @map("live_only")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation("SyncFeatureSubscriber", fields: [userId], references: [id])

  @@index([liveOnly])
  @@map("sync_subscriptions")
}

model SyncRoomPostReport {
  id             Int                  @id @default(autoincrement())
  postId         Int                  @map("post_id")
  reporterId     Int                  @map("reporter_id")
  reason         SyncPostReportReason
  detail         String?              @db.VarChar(500)
  resolvedAt     DateTime?            @map("resolved_at")
  resolvedAction String?              @map("resolved_action") @db.VarChar(40)
  createdAt      DateTime             @default(now()) @map("created_at")

  post     SyncRoomPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User         @relation("SyncRoomPostReporter", fields: [reporterId], references: [id])

  @@unique([postId, reporterId])
  @@index([resolvedAt])
  @@map("sync_room_post_reports")
}

model SyncRoomPostCommentReport {
  id             Int                  @id @default(autoincrement())
  commentId      Int                  @map("comment_id")
  reporterId     Int                  @map("reporter_id")
  reason         SyncPostReportReason
  detail         String?              @db.VarChar(500)
  resolvedAt     DateTime?            @map("resolved_at")
  resolvedAction String?              @map("resolved_action") @db.VarChar(40)
  createdAt      DateTime             @default(now()) @map("created_at")

  comment  SyncRoomPostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User                @relation("SyncRoomPostCommentReporter", fields: [reporterId], references: [id])

  @@unique([commentId, reporterId])
  @@index([resolvedAt])
  @@map("sync_room_post_comment_reports")
}

model SyncPostNotificationEvent {
  id              Int       @id @default(autoincrement())
  type            String    @db.VarChar(40)
  postId          Int       @map("post_id")
  commentId       Int?      @map("comment_id")
  enqueuedAt      DateTime? @map("enqueued_at")
  enqueueAttempts Int       @default(0) @map("enqueue_attempts")
  completedAt     DateTime? @map("completed_at")
  failedAt        DateTime? @map("failed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([completedAt, failedAt, enqueuedAt])
  @@map("sync_post_notification_events")
}

model BannedDiHash {
  id        Int      @id @default(autoincrement())
  diHash    String   @unique @map("di_hash") @db.VarChar(128)
  reason    String?  @db.VarChar(500)
  bannedAt  DateTime @default(now()) @map("banned_at")
  bannedBy  Int?     @map("banned_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("banned_di_hashes")
}

model PersonBenefitUsage {
  id         Int      @id @default(autoincrement())
  diHash     String   @map("di_hash") @db.VarChar(128)
  benefitKey String   @map("benefit_key") @db.VarChar(100)
  userId     Int      @map("user_id")
  usedAt     DateTime @default(now()) @map("used_at")

  @@unique([diHash, benefitKey])
  @@index([diHash])
  @@map("person_benefit_usage")
}

// === Marketing Consent Log ===
model MarketingConsentLog {
  id                 Int                    @id @default(autoincrement())
  userId             Int                    @map("user_id")
  action             MarketingConsentAction
  source             String                 @db.VarChar(64)
  consentTextVersion String?                @map("consent_text_version") @db.VarChar(32)
  ipAddress          String?                @map("ip_address") @db.VarChar(64)
  userAgent          String?                @map("user_agent") @db.VarChar(512)
  metadata           Json?
  createdAt          DateTime               @default(now()) @map("created_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "marketing_consent_logs_user_id_fkey")

  @@index([userId, createdAt], map: "idx_consent_log_user_created")
  @@map("marketing_consent_logs")
}

enum MarketingConsentAction {
  GRANTED
  REVOKED
}

// === Email Suppression ===
model EmailSuppression {
  id        Int                    @id @default(autoincrement())
  /// Suppression is keyed on email address (not userId) because:
  /// 1. Applies to non-member emails uploaded in campaigns
  /// 2. Survives user deletion (retention for legal/deliverability)
  /// 3. Applies even if user changes their email later
  email     String                 @db.VarChar(320)
  scope     EmailSuppressionScope  @default(MARKETING_ONLY)
  reason    EmailSuppressionReason
  note      String?                @db.VarChar(500)
  createdAt DateTime               @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([email, scope], map: "uq_suppression_email_scope")
  @@index([email], map: "idx_suppression_email")
  @@map("email_suppressions")
}

enum EmailSuppressionScope {
  MARKETING_ONLY
  ALL
}

enum EmailSuppressionReason {
  HARD_BOUNCE
  COMPLAINED
  MANUAL
  UNSUBSCRIBED
}

// === Email Unsubscribe Token ===
model EmailUnsubscribeToken {
  id         Int       @id @default(autoincrement())
  jti        String    @unique(map: "uq_unsubtoken_jti") @db.VarChar(64)
  kid        String    @db.VarChar(16)
  userId     Int?      @map("user_id")
  email      String    @db.VarChar(320)
  campaignId Int?      @map("campaign_id")
  expiresAt  DateTime  @map("expires_at") @db.DateTime(0)
  usedAt     DateTime? @map("used_at") @db.DateTime(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  campaign EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "email_unsubscribe_tokens_campaign_id_fkey")
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "email_unsubscribe_tokens_user_id_fkey")

  @@index([email], map: "idx_unsubtoken_email")
  @@index([expiresAt], map: "idx_unsubtoken_expires")
  @@map("email_unsubscribe_tokens")
}

// === Weekly Recap 발송 로그 ===
// email 기준(EmailSuppression 과 동일 사유: 비회원/유저 삭제/이메일 변경에도 survive). FK 없음.
// (email, campaign_type, year_week) UNIQUE 로 같은 주 중복 발송을 원천 차단(idempotency) +
// 타입별 opt-out 배포 시 이 로그로 수신자 백필.
model RecapEmailSend {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  email        String   @db.VarChar(320)
  campaignType String   @map("campaign_type") @db.VarChar(40)
  yearWeek     String   @map("year_week") @db.VarChar(10)
  status       String   @db.VarChar(16)
  resendId     String?  @map("resend_id") @db.VarChar(64)
  unsubJti     String?  @map("unsub_jti") @db.VarChar(64)
  errorMessage String?  @map("error_message") @db.VarChar(500)
  sentAt       DateTime @default(now()) @map("sent_at") @db.DateTime(0)

  @@unique([email, campaignType, yearWeek], map: "uq_recap_send_email_type_week")
  @@index([campaignType, yearWeek], map: "idx_recap_send_type_week")
  @@map("recap_email_sends")
}

// === Email Topic Opt-out (캠페인 타입/리스트별 수신거부) ===
// 정보성(NOTICE) 스트림(예: weekly_recap)을 마케팅 전체 차단 없이 개별 거부.
// EmailSuppression(딜리버리 차단)과 분리 — 의미 오염 방지. email 기준.
model EmailTopicOptout {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(320)
  topic     String   @db.VarChar(64)
  userId    Int?     @map("user_id")
  source    String?  @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([email, topic], map: "uq_email_topic_optout")
  @@index([topic], map: "idx_email_topic_optout_topic")
  @@map("email_topic_optouts")
}

// === Email Campaign ===
model EmailCampaign {
  id              Int                 @id @default(autoincrement())
  type            EmailCampaignType
  status          EmailCampaignStatus @default(DRAFT)
  title           String              @db.VarChar(200)
  subject         String              @db.VarChar(300)
  bodyHtml        String              @map("body_html") @db.LongText
  fromName        String              @map("from_name") @db.VarChar(100)
  fromEmail       String              @map("from_email") @db.VarChar(320)
  replyTo         String?             @map("reply_to") @db.VarChar(320)
  policy          Json
  totalRecipients Int                 @default(0) @map("total_recipients")
  createdById     Int                 @map("created_by_id")
  createdAt       DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  sentAt          DateTime?           @map("sent_at") @db.DateTime(0)

  createdBy   User                     @relation("UserCreatedEmailCampaigns", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "email_campaigns_created_by_id_fkey")
  recipients  EmailCampaignRecipient[]
  unsubTokens EmailUnsubscribeToken[]
  auditLogs   EmailAdminAuditLog[]

  @@index([status, createdAt], map: "idx_campaign_status_created")
  @@map("email_campaigns")
}

enum EmailCampaignType {
  NOTICE
  MARKETING
}

enum EmailCampaignStatus {
  DRAFT
  VALIDATED
  SENDING
  FLUSHING
  RECONCILING
  DONE
  PAUSED
  ABORTED
  FAILED
}

// === Email Campaign Recipient ===
model EmailCampaignRecipient {
  id            Int                  @id @default(autoincrement())
  campaignId    Int                  @map("campaign_id")
  userId        Int?                 @map("user_id")
  email         String               @db.VarChar(320)
  status        EmailRecipientStatus @default(READY)
  excludeReason String?              @map("exclude_reason") @db.VarChar(64)
  resendEmailId String?              @map("resend_email_id") @db.VarChar(64)
  payloadHash   String?              @map("payload_hash") @db.VarChar(64)
  chunkNo       Int?                 @map("chunk_no")
  lastEventAt   DateTime?            @map("last_event_at") @db.DateTime(0)
  errorCode     String?              @map("error_code") @db.VarChar(64)
  errorMessage  String?              @map("error_message") @db.VarChar(500)
  createdAt     DateTime             @default(now()) @map("created_at") @db.DateTime(0)

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "email_campaign_recipients_campaign_id_fkey")

  @@unique([campaignId, email], map: "uq_recipient_campaign_email")
  @@index([resendEmailId], map: "idx_recipient_resend_id")
  @@index([campaignId, status], map: "idx_recipient_campaign_status")
  @@map("email_campaign_recipients")
}

enum EmailRecipientStatus {
  READY
  EXCLUDED
  QUEUED
  API_ACCEPTED
  DELIVERED
  OPENED
  CLICKED
  BOUNCED_SOFT
  BOUNCED_HARD
  COMPLAINED
  SUPPRESSED
  FAILED
}

// === Email Webhook Event (dedupe + raw event) ===
model EmailWebhookEvent {
  id             Int       @id @default(autoincrement())
  svixId         String    @unique(map: "uq_wh_event_svix_id") @map("svix_id") @db.VarChar(64)
  eventType      String    @map("event_type") @db.VarChar(64)
  resendEmailId  String?   @map("resend_email_id") @db.VarChar(64)
  recipientEmail String?   @map("recipient_email") @db.VarChar(320)
  payload        Json
  processedAt    DateTime? @map("processed_at") @db.DateTime(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([resendEmailId, eventType], map: "uq_wh_event_email_type")
  @@index([eventType, createdAt], map: "idx_wh_event_type_created")
  @@map("email_webhook_events")
}

// === Email Admin Audit Log ===
model EmailAdminAuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  campaignId Int?     @map("campaign_id")
  action     String   @db.VarChar(64)
  detail     Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)

  user     User           @relation("UserEmailAdminAuditLogs", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "email_admin_audit_logs_user_id_fkey")
  campaign EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "email_admin_audit_logs_campaign_id_fkey")

  @@index([campaignId, createdAt], map: "idx_audit_campaign_created")
  @@index([userId, createdAt], map: "idx_audit_user_created")
  @@map("email_admin_audit_logs")
}

// ===================================
// SNS Publishing domain (Phase 2)
// ===================================

/// 사용자 본인의 OAuth 계정으로 SNS에 자동 게시하기 위한 자격증명 저장
/// 플랫폼별 사용자당 1개. 토큰은 평문 저장 (기존 UserPlatformVerification 관행 동일, TODO: 암호화)
model UserSnsCredential {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  platform     String    @db.VarChar(20) // "X" | "NAVER_CAFE"
  accessToken  String    @map("access_token") @db.Text // TODO: 암호화 필요
  refreshToken String?   @map("refresh_token") @db.Text // TODO: 암호화 필요
  expiresAt    DateTime? @map("expires_at") @db.DateTime(0)
  platformMeta Json?     @map("platform_meta") // 외부 계정 핸들/사용자ID 등 캐시
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId, isActive])
  @@map("user_sns_credentials")
}

/// 주간 시간표 이미지 렌더 결과의 SNS 게시 내역
/// render 기준, platform별 상태 전이 (QUEUED → POSTING → POSTED | FAILED)
model ScheduleSnsPublication {
  id              Int       @id @default(autoincrement())
  renderId        Int       @map("render_id")
  channelId       Int       @map("channel_id")
  userId          Int       @map("user_id") // 게시 실행 주체 (연동한 사용자)
  platform        String    @db.VarChar(20) // "X" | "NAVER_CAFE"
  status          String    @db.VarChar(20) // "QUEUED" | "POSTING" | "POSTED" | "FAILED"
  externalPostId  String?   @map("external_post_id") @db.VarChar(200)
  externalPostUrl String?   @map("external_post_url") @db.VarChar(500)
  errorMessage    String?   @map("error_message") @db.Text
  publishBody     String?   @map("publish_body") @db.Text // 게시 본문 (사용자 입력)
  targetMeta      Json?     @map("target_meta") // 네이버 카페용: cafeId, menuId 등
  jobId           String?   @map("job_id") @db.VarChar(100)
  publishedAt     DateTime? @map("published_at") @db.DateTime(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  render  ScheduleImageRender @relation(fields: [renderId], references: [id], onDelete: Cascade)
  channel Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User                @relation("ScheduleSnsPublicationUser", fields: [userId], references: [id])

  @@unique([renderId, platform, userId], map: "uq_sns_publication_render_platform_user")
  @@index([channelId, platform, status])
  @@index([renderId])
  @@index([status])
  @@map("schedule_sns_publications")
}

// ===================================
// Collection page domain (모아보기/지통실)
// ===================================

enum CollectionVisibility {
  PUBLIC  @map("public")
  PRIVATE @map("private")
}

enum CollectionStatus {
  VISIBLE @map("visible")
  HIDDEN  @map("hidden")
  DELETED @map("deleted")
}

model CollectionPage {
  id           Int                  @id @default(autoincrement())
  shortId      String               @unique(map: "collection_pages_short_id_unique") @map("short_id") @db.VarChar(16)
  slug         String?              @unique(map: "collection_pages_slug_unique") @db.VarChar(64)
  ownerUserId  Int                  @map("owner_user_id")
  title        String               @db.VarChar(100)
  description  String?              @db.VarChar(500)
  thumbnailUrl String?              @map("thumbnail_url") @db.Text
  visibility   CollectionVisibility @default(PUBLIC)
  status       CollectionStatus     @default(VISIBLE)
  // 모아보기가 다루는 콘텐츠/이벤트의 진행 기간 (선택). 둘 다 nullable —
  // "지속 기간" 정보 없이도 모아보기를 만들 수 있도록.
  startedAt    DateTime?            @map("started_at") @db.DateTime(0)
  endedAt      DateTime?            @map("ended_at") @db.DateTime(0)
  createdAt    DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt    DateTime?            @map("deleted_at") @db.DateTime(0)

  owner    User                    @relation("CollectionPageOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  channels CollectionPageChannel[]
  tags     CollectionPageTag[]
  stat     CollectionPageStat?
  reports  CollectionPageReport[]
  contents CollectionPageContent[]

  @@index([ownerUserId, status], map: "idx_collection_pages_owner_status")
  @@index([visibility, status, createdAt], map: "idx_collection_pages_visibility_status_created")
  @@map("collection_pages")
}

/// 모아보기 ↔ 콘텐츠 m:n 연결.
/// 한 모아보기에 여러 콘텐츠를 묶어 둘 수 있고 콘텐츠 페이지에서 역방향으로
/// 연결된 모아보기들을 노출할 수 있다.
model CollectionPageContent {
  collectionPageId Int      @map("collection_page_id")
  contentId        Int      @map("content_id")
  position         Int      @default(0)
  addedAt          DateTime @default(now()) @map("added_at") @db.DateTime(0)

  collectionPage CollectionPage @relation(fields: [collectionPageId], references: [id], onDelete: Cascade)
  content        Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([collectionPageId, contentId])
  @@index([contentId], map: "idx_collection_page_contents_content")
  @@index([collectionPageId, position], map: "idx_collection_page_contents_page_position")
  @@map("collection_page_contents")
}

model CollectionPageChannel {
  id                    Int            @id @default(autoincrement())
  collectionPageId      Int            @map("collection_page_id")
  platform              StreamPlatform
  platformChannelId     String         @map("platform_channel_id") @db.VarChar(128)
  cachedName            String?        @map("cached_name") @db.VarChar(255)
  cachedProfileImageUrl String?        @map("cached_profile_image_url") @db.Text
  cachedFetchedAt       DateTime?      @map("cached_fetched_at") @db.DateTime(0)
  melomingChannelId     Int?           @map("meloming_channel_id")
  position              Int
  addedAt               DateTime       @default(now()) @map("added_at") @db.DateTime(0)

  collectionPage  CollectionPage @relation(fields: [collectionPageId], references: [id], onDelete: Cascade)
  melomingChannel Channel?       @relation(fields: [melomingChannelId], references: [id], onDelete: SetNull)

  @@unique([collectionPageId, platform, platformChannelId], map: "uq_collection_page_channels_page_platform_pcid")
  @@unique([collectionPageId, position], map: "uq_collection_page_channels_page_position")
  @@index([platform, platformChannelId], map: "idx_collection_page_channels_platform_pcid")
  @@index([melomingChannelId], map: "idx_collection_page_channels_meloming_channel_id")
  // refresh cron 의 stale row 조회 (`melomingChannelId IS NULL` filter +
  // `cachedFetchedAt asc nulls first` order) 가속용 복합 인덱스.
  @@index([melomingChannelId, cachedFetchedAt], map: "idx_collection_page_channels_meloming_id_cached_fetched_at")
  @@map("collection_page_channels")
}

model CollectionPageTag {
  collectionPageId Int    @map("collection_page_id")
  tag              String @db.VarChar(32)

  collectionPage CollectionPage @relation(fields: [collectionPageId], references: [id], onDelete: Cascade)

  @@id([collectionPageId, tag])
  @@index([tag], map: "idx_collection_page_tags_tag")
  @@map("collection_page_tags")
}

model CollectionPageStat {
  collectionPageId Int      @id @map("collection_page_id")
  channelCount     Int      @default(0) @map("channel_count")
  viewerSum        Int      @default(0) @map("viewer_sum")
  viewCount        Int      @default(0) @map("view_count")
  hotScore         Float    @default(0) @map("hot_score")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  collectionPage CollectionPage @relation(fields: [collectionPageId], references: [id], onDelete: Cascade)

  @@index([hotScore], map: "idx_collection_page_stats_hot_score")
  @@index([viewerSum], map: "idx_collection_page_stats_viewer_sum")
  @@map("collection_page_stats")
}

model CollectionPageReport {
  id               Int          @id @default(autoincrement())
  collectionPageId Int          @map("collection_page_id")
  reporterUserId   Int?         @map("reporter_user_id")
  reasonCode       String       @map("reason_code") @db.VarChar(64)
  memo             String?      @db.Text
  status           ReportStatus @default(PENDING)
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(0)
  resolvedAt       DateTime?    @map("resolved_at") @db.DateTime(0)

  collectionPage CollectionPage @relation(fields: [collectionPageId], references: [id], onDelete: Cascade)
  reporter       User?          @relation("CollectionPageReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)

  @@index([collectionPageId], map: "idx_collection_page_reports_page_id")
  @@index([status], map: "idx_collection_page_reports_status")
  @@map("collection_page_reports")
}

// ===================================
// YouTube Integration domain (Phase 1)
// ===================================

enum YouTubeMatchStatus {
  PENDING       @map("pending")
  MATCHED       @map("matched")
  REVIEW_NEEDED @map("review_needed")
  NO_MATCH      @map("no_match")
  SKIPPED       @map("skipped")
}

enum YouTubeMatchType {
  AUTO   @map("auto")
  MANUAL @map("manual")
}

model YouTubeChannel {
  id                       Int       @id @default(autoincrement())
  userId                   Int       @map("user_id")
  melomingChannelId        Int       @map("meloming_channel_id")
  youtubeChannelId         String    @unique(map: "uq_youtube_channel_id") @map("youtube_channel_id") @db.VarChar(64)
  channelTitle             String    @map("channel_title") @db.VarChar(200)
  customUrl                String?   @map("custom_url") @db.VarChar(100)
  thumbnailUrl             String?   @map("thumbnail_url") @db.VarChar(500)
  subscriberCount          Int       @default(0) @map("subscriber_count")
  uploadsPlaylistId        String?   @map("uploads_playlist_id") @db.VarChar(64)
  // OAuth 토큰 envelope 암호화 (EncryptionService) — Phase 0 패턴
  accessTokenCipher        String    @map("access_token_cipher") @db.Text
  refreshTokenCipher       String?   @map("refresh_token_cipher") @db.Text
  tokenExpiresAt           DateTime? @map("token_expires_at") @db.DateTime(0)
  scope                    String    @map("scope") @db.VarChar(500)
  googleAccountEmail       String?   @map("google_account_email") @db.VarChar(200)
  // 역할 플래그
  streamRecognitionEnabled Boolean   @default(false) @map("stream_recognition_enabled")
  clipMatchingPrimary      Boolean   @default(false) @map("clip_matching_primary")
  // 운영 상태
  isActive                 Boolean   @default(true) @map("is_active")
  lastSyncedAt             DateTime? @map("last_synced_at") @db.DateTime(0)
  lastLiveCheckAt          DateTime? @map("last_live_check_at") @db.DateTime(0)
  lastErrorAt              DateTime? @map("last_error_at") @db.DateTime(0)
  lastErrorCode            String?   @map("last_error_code") @db.VarChar(50)
  createdAt                DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  melomingChannel Channel        @relation(fields: [melomingChannelId], references: [id], onDelete: Cascade)
  uploadedVideos  YouTubeVideo[]

  @@index([userId], map: "idx_youtube_channels_user_id")
  @@index([melomingChannelId], map: "idx_youtube_channels_meloming_channel_id")
  @@index([streamRecognitionEnabled, isActive], map: "idx_youtube_channels_stream_recognition")
  @@map("youtube_channels")
}

model YouTubeVideo {
  id               Int                @id @default(autoincrement())
  youtubeChannelId Int                @map("youtube_channel_id")
  videoId          String             @unique(map: "uq_youtube_video_id") @map("video_id") @db.VarChar(32)
  title            String             @map("title") @db.VarChar(500)
  description      String?            @map("description") @db.Text
  publishedAt      DateTime           @map("published_at") @db.DateTime(0)
  thumbnailUrl     String?            @map("thumbnail_url") @db.VarChar(500)
  duration         Int?               @map("duration")
  viewCount        Int                @default(0) @map("view_count")
  isShort          Boolean            @default(false) @map("is_short")
  // 매칭 상태
  matchStatus      YouTubeMatchStatus @default(PENDING) @map("match_status")
  matchedClipId    Int?               @unique(map: "uq_youtube_video_matched_clip") @map("matched_clip_id")
  matchConfidence  Float?             @map("match_confidence")
  matchedAt        DateTime?          @map("matched_at") @db.DateTime(0)
  matchedByType    YouTubeMatchType?  @map("matched_by_type")
  isHidden         Boolean            @default(false) @map("is_hidden")
  createdAt        DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.DateTime(0)

  youtubeChannel YouTubeChannel @relation(fields: [youtubeChannelId], references: [id], onDelete: Cascade)
  matchedClip    Clip?          @relation("YouTubeVideoMatchedClip", fields: [matchedClipId], references: [id], onDelete: SetNull)

  @@index([youtubeChannelId, publishedAt], map: "idx_youtube_videos_channel_published")
  @@index([matchStatus], map: "idx_youtube_videos_match_status")
  @@index([youtubeChannelId, matchStatus], map: "idx_youtube_videos_channel_match_status")
  @@map("youtube_videos")
}

// ====================================================================
// Meloming Store (멜로밍 스토어) — Phase 0
// 위탁(드랍쉬핑) / 사입 / 골라담기 + 스트리머 익명 주소 선물
// 결제: 다날 (기존 src/payments/providers/danal 재사용)
// 스펙: docs/superpowers/specs/2026-05-05-meloming-store-design.md
// ====================================================================

// -------- Catalog --------

model StoreCategory {
  id        Int             @id @default(autoincrement())
  name      String          @db.VarChar(100)
  slug      String          @unique(map: "store_categories_slug_unique") @db.VarChar(100)
  parentId  Int?            @map("parent_id")
  parent    StoreCategory?  @relation("StoreCategoryTree", fields: [parentId], references: [id])
  children  StoreCategory[] @relation("StoreCategoryTree")
  sortOrder Int             @default(0) @map("sort_order")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.DateTime(0)

  products StoreProduct[]

  @@index([parentId], map: "idx_store_categories_parent")
  @@map("store_categories")
}

enum StoreSaleType {
  CONSIGNMENT            @map("consignment") // 위탁 (드랍쉬핑)
  IN_STOCK               @map("in_stock") // 사입
  /// @deprecated. 골라담기는 saleType 직교의 Product.isPickAndMix 로 표현. 신규 product 에 사용 X.
  /// 값은 StoreOrderItem.saleTypeSnapshot 과거 데이터 보존 위해 유지.
  PICK_AND_MIX_COMPONENT @map("pick_and_mix_component")
}

enum StoreProductDiscountType {
  PERCENT @map("percent")
  AMOUNT  @map("amount")
}

enum StoreProductStatus {
  DRAFT    @map("draft")
  ACTIVE   @map("active")
  ARCHIVED @map("archived")
}

model StoreProduct {
  id                     Int                       @id @default(autoincrement())
  name                   String                    @db.VarChar(200)
  /// 카드/검색 결과용 한 줄 요약. 일반 텍스트.
  shortDescription       String?                   @map("short_description") @db.Text
  /// 일반 텍스트 설명 (간단 문단).
  description            String?                   @db.Text
  /// 상품 본문 — 이미지/비디오 포함하는 rich content (sanitized HTML).
  bodyHtml               String?                   @map("body_html") @db.LongText
  saleType               StoreSaleType             @map("sale_type")
  status                 StoreProductStatus        @default(DRAFT)
  categoryId             Int?                      @map("category_id")
  category               StoreCategory?            @relation(fields: [categoryId], references: [id])
  isGiftEligible         Boolean                   @default(true) @map("is_gift_eligible")
  /// 골라담기 가능 여부. saleType(IN_STOCK/CONSIGNMENT) 직교 — 사입/위탁 모두 마킹 가능.
  /// true 인 상품만 /store/pick-and-mix 그리드에 노출 + 골라담기 카트 라인에 추가 가능.
  isPickAndMix           Boolean                   @default(false) @map("is_pick_and_mix")
  /// Product 레벨 할인 (variant.salePrice 보다 약함; variant.salePrice 가 우선).
  /// 활성 조건: discountActive && (now ∈ [discountStartsAt, discountEndsAt]) && discountValue > 0.
  /// 비활성/조건 미충족 시 retailPrice 그대로.
  discountActive         Boolean                   @default(false) @map("discount_active")
  discountType           StoreProductDiscountType? @map("discount_type")
  discountValue          Int?                      @map("discount_value") // PERCENT: 0~100, AMOUNT: 원
  discountStartsAt       DateTime?                 @map("discount_starts_at") @db.DateTime(0)
  discountEndsAt         DateTime?                 @map("discount_ends_at") @db.DateTime(0)
  thumbnailUrl           String?                   @map("thumbnail_url") @db.VarChar(500)
  /// 취급 플래그 (FRAGILE/FROZEN/REFRIGERATED/HAZARDOUS 등). MySQL 은 enum array 미지원이라
  /// JSON 배열 of string. 유효성은 service 단에서 StoreHandlingFlag enum 으로 강제.
  /// null 또는 빈 배열 = 일반 취급.
  handlingFlags          Json?                     @map("handling_flags")
  /// 자동 SKU 생성 시 사용된 base 부분. SKU 자체는 Variant.sku.
  baseSku                String?                   @map("base_sku") @db.VarChar(50)
  /// 브랜드/제조사
  vendor                 String?                   @db.VarChar(200)
  /// 검색/필터용 태그 배열 (Json string[]).
  tags                   Json?
  /// SEO
  metaTitle              String?                   @map("meta_title") @db.VarChar(255)
  metaDescription        String?                   @map("meta_description") @db.Text
  /// 상품별 정책 텍스트 override. null 이면 StoreSetting 의 사이트 기본값 fallback.
  shippingPolicyOverride String?                   @map("shipping_policy_override") @db.Text
  returnPolicyOverride   String?                   @map("return_policy_override") @db.Text
  exchangePolicyOverride String?                   @map("exchange_policy_override") @db.Text
  refundPolicyOverride   String?                   @map("refund_policy_override") @db.Text
  createdAt              DateTime                  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt              DateTime                  @updatedAt @map("updated_at") @db.DateTime(0)
  viewCount              Int                       @default(0) @map("view_count")

  variants                 StoreProductVariant[]
  images                   StoreProductImage[]
  suppliers                StoreProductSupplier[]
  reviews                  StoreProductReview[]
  postalSurchargeOverrides StoreProductSurcharge[]
  collectionLinks          StoreCollectionProduct[]

  @@index([categoryId], map: "idx_store_products_category")
  @@index([saleType, status], map: "idx_store_products_sale_status")
  @@index([isPickAndMix, status], map: "idx_store_products_pick_status")
  @@index([viewCount], map: "idx_store_products_view_count")
  @@map("store_products")
}

model StoreProductVariant {
  id          Int                @id @default(autoincrement())
  productId   Int                @map("product_id")
  product     StoreProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String             @unique(map: "store_product_variants_sku_unique") @db.VarChar(50)
  /// "L / 빨강". 옵션 없는 상품도 단일 Variant 자동 생성 (product.name 복사)
  name        String             @db.VarChar(200)
  /// 옵션 표현 (EAV 대신 단순 JSON). 예: {"size": "L", "color": "red"}
  options     Json?
  retailPrice Int                @map("retail_price")
  /// 할인가 (정가 < retailPrice). NULL = 할인 없음.
  /// 카트/체크아웃 가격 = salePrice ?? retailPrice. 정가 strikethrough + 할인 배지 표시.
  salePrice   Int?               @map("sale_price")
  /// 가중평균 캐시 (입고 시 갱신, KPI 빠른 조회용)
  avgUnitCost Int?               @map("avg_unit_cost")
  weightGram  Int?               @map("weight_gram")
  /// 변종 외형 치수 (mm). 박스 추천 계산 입력. 옵셔널.
  widthMm     Int?               @map("width_mm")
  depthMm     Int?               @map("depth_mm")
  heightMm    Int?               @map("height_mm")
  status      StoreProductStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.DateTime(0)

  inventoryLots        StoreInventoryLot[]
  pickAndMixComponents StorePickAndMixBundleComponent[]
  receiptItems         StoreGoodsReceiptItem[]
  orderItems           StoreOrderItem[]
  cartItems            StoreCartItem[]
  wishlistItems        StoreWishlistItem[]
  reviews              StoreProductReview[]
  stocktakeItems       StoreStocktakeItem[]

  @@index([productId], map: "idx_store_product_variants_product")
  @@index([status], map: "idx_store_product_variants_status")
  @@map("store_product_variants")
}

/// 상품 ↔ 도매상 다대다 (가격 비교 / 도매처 갈아타기)
model StoreProductSupplier {
  id           Int           @id @default(autoincrement())
  productId    Int           @map("product_id")
  product      StoreProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId   Int           @map("supplier_id")
  supplier     StoreSupplier @relation(fields: [supplierId], references: [id])
  /// 기본 발주처. 위탁 발주 / 입고 시 자동 선택 후보 (admin 변경 가능)
  isPrimary    Boolean       @default(false) @map("is_primary")
  /// 최근 입고 도매가 (변동 추적)
  lastUnitCost Int?          @map("last_unit_cost")
  notes        String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([productId, supplierId], map: "store_product_suppliers_product_supplier_unique")
  @@index([supplierId], map: "idx_store_product_suppliers_supplier")
  @@map("store_product_suppliers")
}

/// 상품 미디어 종류. 갤러리 슬라이더에 IMAGE/VIDEO 혼합 노출 가능.
enum StoreMediaType {
  IMAGE @map("image")
  VIDEO @map("video")
}

model StoreProductImage {
  id        Int            @id @default(autoincrement())
  productId Int            @map("product_id")
  product   StoreProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StoreMediaType @default(IMAGE)
  url       String         @db.VarChar(500)
  altText   String?        @map("alt_text") @db.VarChar(255)
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([productId], map: "idx_store_product_images_product")
  @@map("store_product_images")
}

enum StoreBesellerCatalogSyncStatus {
  RUNNING @map("running")
  SUCCESS @map("success")
  FAILED  @map("failed")
}

model StoreBesellerCatalogSyncRun {
  id               Int                            @id @default(autoincrement())
  status           StoreBesellerCatalogSyncStatus @default(RUNNING)
  sourceUrl        String?                        @map("source_url") @db.VarChar(1000)
  totalRows        Int                            @default(0) @map("total_rows")
  insertedCount    Int                            @default(0) @map("inserted_count")
  updatedCount     Int                            @default(0) @map("updated_count")
  unchangedCount   Int                            @default(0) @map("unchanged_count")
  deactivatedCount Int                            @default(0) @map("deactivated_count")
  failedReason     String?                        @map("failed_reason") @db.Text
  startedAt        DateTime                       @default(now()) @map("started_at") @db.DateTime(0)
  finishedAt       DateTime?                      @map("finished_at") @db.DateTime(0)
  createdAt        DateTime                       @default(now()) @map("created_at") @db.DateTime(0)

  @@index([status, startedAt], map: "idx_store_beseller_sync_runs_status_started")
  @@map("store_beseller_catalog_sync_runs")
}

model StoreBesellerCatalogItem {
  id                  Int      @id @default(autoincrement())
  productUid          String   @unique(map: "store_beseller_catalog_product_uid_unique") @map("product_uid") @db.VarChar(50)
  membershipCode      String?  @map("membership_code") @db.VarChar(50)
  productName         String   @map("product_name") @db.VarChar(255)
  sellPrice           Int?     @map("sell_price")
  stockText           String?  @map("stock_text") @db.VarChar(100)
  sellAccept          Boolean  @default(true) @map("sell_accept")
  categoryCode        String?  @map("category_code") @db.VarChar(50)
  cate1Name           String?  @map("cate1_name") @db.VarChar(100)
  cate2Name           String?  @map("cate2_name") @db.VarChar(100)
  cate3Name           String?  @map("cate3_name") @db.VarChar(100)
  maxImage            String?  @map("max_image") @db.VarChar(1000)
  miniImage           String?  @map("mini_image") @db.VarChar(1000)
  tinyImage           String?  @map("tiny_image") @db.VarChar(1000)
  productDetail       String?  @map("product_detail") @db.LongText
  production          String?  @db.VarChar(255)
  origin              String?  @db.VarChar(255)
  brandName           String?  @map("brand_name") @db.VarChar(255)
  modelName           String?  @map("model_name") @db.VarChar(255)
  uniqueness          String?  @db.Text
  provider            String?  @db.VarChar(100)
  productUrl          String?  @map("product_url") @db.VarChar(1000)
  vatType             String?  @map("vat_type") @db.VarChar(100)
  deliveryText        String?  @map("delivery_text") @db.VarChar(255)
  freedeli            String?  @db.VarChar(255)
  additionalInfo      Json?    @map("additional_info")
  rawRow              Json?    @map("raw_row")
  rowHash             String   @map("row_hash") @db.Char(64)
  isActive            Boolean  @default(true) @map("is_active")
  registeredProductId Int?     @map("registered_product_id")
  firstSeenAt         DateTime @default(now()) @map("first_seen_at") @db.DateTime(0)
  lastSeenAt          DateTime @default(now()) @map("last_seen_at") @db.DateTime(0)
  lastChangedAt       DateTime @default(now()) @map("last_changed_at") @db.DateTime(0)
  lastSyncRunId       Int?     @map("last_sync_run_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([sellAccept, isActive], map: "idx_store_beseller_catalog_sell_active")
  @@index([provider], map: "idx_store_beseller_catalog_provider")
  @@index([membershipCode], map: "idx_store_beseller_catalog_membership")
  @@index([registeredProductId], map: "idx_store_beseller_catalog_registered_product")
  @@index([lastChangedAt], map: "idx_store_beseller_catalog_changed")
  @@map("store_beseller_catalog_items")
}

// -------- Supplier / Warehouse --------

/// 위탁 발주 처리 방식.
/// MANUAL: admin이 도매꾹/온채널 등 외부 사이트에서 직접 주문하고, 시스템에는 송장번호만 입력.
/// AUTOMATION: 도매상 API/시트 자동 발주 (미래 — 현재는 미구현, enum 으로 자리만 예약).
enum SupplierDispatchChannel {
  MANUAL     @map("manual")
  AUTOMATION @map("automation")
}

/// 도매상 / 발주 대상. 입점 파트너 X — 단순 데이터 (로그인/대시보드 X)
/// 도매상.
/// 2-tier 구조 지원 — 위탁 플랫폼(예: 온채널) 아래 다수 벤더사가 입점한 흐름을 표현.
///   PLATFORM (parentSupplierId=null): 우리가 발주/결제하는 상위 채널.
///   VENDOR   (parentSupplierId=plat): 실제 발송/CS 주체. ProductSupplier·Receipt·
///            ConsignmentDispatch 는 vendor 와 연결됨. 발주 채널·target 은 vendor
///            본인의 dispatchChannel/dispatchTarget 이 비어 있으면 parent 를 fallback.
/// 단일 거래(직접 도매)는 parentSupplierId=null + 단독 사용.
model StoreSupplier {
  id                 Int                     @id @default(autoincrement())
  name               String                  @db.VarChar(200)
  contactName        String?                 @map("contact_name") @db.VarChar(100)
  contactEmail       String?                 @map("contact_email") @db.VarChar(255)
  contactPhone       String?                 @map("contact_phone") @db.VarChar(20)
  dispatchChannel    SupplierDispatchChannel @map("dispatch_channel")
  /// 채널별 상세: EMAIL=수신주소, SHEET=spreadsheet URL, API=endpoint, MANUAL=메모
  dispatchTarget     String?                 @map("dispatch_target") @db.VarChar(500)
  memo               String?                 @db.Text
  isActive           Boolean                 @default(true) @map("is_active")
  /// 상위 supplier (위탁 플랫폼). null = 자기 자신이 최상위 (PLATFORM 또는 단독 도매).
  parentSupplierId   Int?                    @map("parent_supplier_id")
  parentSupplier     StoreSupplier?          @relation("SupplierHierarchy", fields: [parentSupplierId], references: [id])
  childSuppliers     StoreSupplier[]         @relation("SupplierHierarchy")
  /// 도매처/플랫폼이 강제하는 정책 텍스트.
  /// chain: Product.xxxPolicyOverride → primary supplier.xxxPolicyText → parent supplier.xxxPolicyText → 사이트 default.
  shippingPolicyText String?                 @map("shipping_policy_text") @db.Text
  returnPolicyText   String?                 @map("return_policy_text") @db.Text
  exchangePolicyText String?                 @map("exchange_policy_text") @db.Text
  refundPolicyText   String?                 @map("refund_policy_text") @db.Text
  createdAt          DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.DateTime(0)

  productLinks       StoreProductSupplier[]
  receipts           StoreGoodsReceipt[]
  consignments       StoreConsignmentDispatch[]
  inventoryLots      StoreInventoryLot[]
  packagingMaterials StorePackagingMaterial[]

  @@index([parentSupplierId], map: "idx_store_suppliers_parent")
  @@map("store_suppliers")
}

/// 창고. 1창고 시작 + 다창고 대비 (Inventory.warehouseId FK 처음부터 분리)
model StoreWarehouse {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  address   String?  @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  inventoryLots StoreInventoryLot[]
  stocktakes    StoreStocktake[]

  @@map("store_warehouses")
}

// -------- Goods Receipt (입고) --------

model StoreGoodsReceipt {
  id               Int           @id @default(autoincrement())
  receiptNumber    String        @unique(map: "store_goods_receipts_number_unique") @map("receipt_number") @db.VarChar(50)
  supplierId       Int           @map("supplier_id")
  supplier         StoreSupplier @relation(fields: [supplierId], references: [id])
  warehouseId      Int           @map("warehouse_id")
  receivedAt       DateTime      @map("received_at") @db.DateTime(0)
  receivedByUserId Int?          @map("received_by_user_id")
  receivedBy       User?         @relation("StoreReceiptReceiver", fields: [receivedByUserId], references: [id])
  /// 도매상에 지급한 총액 (라인 합계와 별개로 운송비 등 포함 가능)
  totalAmount      Int           @map("total_amount")
  memo             String?       @db.Text
  createdAt        DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.DateTime(0)

  items StoreGoodsReceiptItem[]

  @@index([supplierId], map: "idx_store_goods_receipts_supplier")
  @@index([receivedAt], map: "idx_store_goods_receipts_received_at")
  @@map("store_goods_receipts")
}

model StoreGoodsReceiptItem {
  id              Int                 @id @default(autoincrement())
  receiptId       Int                 @map("receipt_id")
  receipt         StoreGoodsReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variantId       Int                 @map("variant_id")
  variant         StoreProductVariant @relation(fields: [variantId], references: [id])
  quantity        Int
  unitCost        Int                 @map("unit_cost")
  expiryDate      DateTime?           @map("expiry_date") @db.Date
  manufactureDate DateTime?           @map("manufacture_date") @db.Date
  createdLotId    Int?                @unique(map: "store_goods_receipt_items_lot_unique") @map("created_lot_id")
  createdLot      StoreInventoryLot?  @relation(fields: [createdLotId], references: [id])

  @@index([receiptId], map: "idx_store_goods_receipt_items_receipt")
  @@index([variantId], map: "idx_store_goods_receipt_items_variant")
  @@map("store_goods_receipt_items")
}

// -------- Inventory (Lot 단위 — 도매가/유통기한 별 분리, FEFO 출고) --------

enum StoreInventoryLotStatus {
  ACTIVE   @map("active")
  EXPIRED  @map("expired")
  DEPLETED @map("depleted")
  DISPOSED @map("disposed")
}

/// 입고 lot 단위 재고. FEFO 출고 (유통기한 짧은 것 먼저)
model StoreInventoryLot {
  id               Int                     @id @default(autoincrement())
  variantId        Int                     @map("variant_id")
  variant          StoreProductVariant     @relation(fields: [variantId], references: [id])
  warehouseId      Int                     @map("warehouse_id")
  warehouse        StoreWarehouse          @relation(fields: [warehouseId], references: [id])
  /// 입고 출처 (정규화 비용 < 조회 편의 — receipt 통한 간접 조회 회피)
  supplierId       Int                     @map("supplier_id")
  supplier         StoreSupplier           @relation(fields: [supplierId], references: [id])
  lotNumber        String                  @unique(map: "store_inventory_lots_lot_number_unique") @map("lot_number") @db.VarChar(50)
  /// 이 lot의 도매가 (입고 시 결정, 변경 X)
  unitCost         Int                     @map("unit_cost")
  expiryDate       DateTime?               @map("expiry_date") @db.Date
  manufactureDate  DateTime?               @map("manufacture_date") @db.Date
  receivedAt       DateTime                @map("received_at") @db.DateTime(0)
  quantityOnHand   Int                     @map("quantity_on_hand")
  quantityReserved Int                     @default(0) @map("quantity_reserved")
  status           StoreInventoryLotStatus @default(ACTIVE)
  disposedAt       DateTime?               @map("disposed_at") @db.DateTime(0)
  disposedReason   String?                 @map("disposed_reason") @db.VarChar(500)
  createdAt        DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.DateTime(0)

  receiptItem          StoreGoodsReceiptItem?
  orderItemAllocations StoreOrderItemLotAllocation[]
  stocktakeLotChanges  StoreStocktakeItemLotChange[]

  @@index([variantId, warehouseId, status], map: "idx_store_inventory_lots_variant_wh_status")
  @@index([expiryDate], map: "idx_store_inventory_lots_expiry") // FEFO
  @@index([status], map: "idx_store_inventory_lots_status")
  @@index([supplierId], map: "idx_store_inventory_lots_supplier")
  @@map("store_inventory_lots")
}

// -------- Stocktake (재고조사 — 실사 수량 대조 + lot 조정) --------

/// 재고조사 차이 사유. 사은품/경품 등으로 별도 출고돼 시스템에 안 잡힌 재고를 맞출 때 분류.
enum StoreStocktakeReason {
  GIFT       @map("gift") // 사은품
  PRIZE      @map("prize") // 경품/이벤트 증정
  DAMAGE     @map("damage") // 파손/폐기
  LOSS       @map("loss") // 분실/도난
  FOUND      @map("found") // 재고 발견 (+)
  CORRECTION @map("correction") // 단순 실사 보정
  OTHER      @map("other") // 기타
}

/// 재고조사 1건 (창고 단위). 생성과 동시에 각 라인 차이를 FEFO 로 lot 에 반영하는 단일 트랜잭션 —
/// 항상 적용 완료 상태로만 존재. lot 변동은 StoreStocktakeItemLotChange 로 감사 기록.
model StoreStocktake {
  id              Int            @id @default(autoincrement())
  stocktakeNumber String         @unique(map: "store_stocktakes_number_unique") @map("stocktake_number") @db.VarChar(50)
  warehouseId     Int            @map("warehouse_id")
  warehouse       StoreWarehouse @relation(fields: [warehouseId], references: [id])
  note            String?        @db.Text
  createdByUserId Int?           @map("created_by_user_id")
  createdByUser   User?          @relation(fields: [createdByUserId], references: [id])
  /// 차이를 lot 에 적용 완료한 시각.
  completedAt     DateTime       @default(now()) @map("completed_at") @db.DateTime(0)
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(0)

  items StoreStocktakeItem[]

  @@index([warehouseId], map: "idx_store_stocktakes_warehouse")
  @@index([completedAt], map: "idx_store_stocktakes_completed")
  @@map("store_stocktakes")
}

/// 재고조사 라인 — variant 1개의 시스템 수량 vs 실사 수량.
model StoreStocktakeItem {
  id          Int                   @id @default(autoincrement())
  stocktakeId Int                   @map("stocktake_id")
  stocktake   StoreStocktake        @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  variantId   Int                   @map("variant_id")
  variant     StoreProductVariant   @relation(fields: [variantId], references: [id])
  /// 적용 시점 시스템 수량 스냅샷 (창고 한정 ACTIVE lot 의 quantityOnHand 합).
  systemQty   Int                   @map("system_qty")
  /// 실사(물리 카운트) 수량.
  countedQty  Int                   @map("counted_qty")
  /// countedQty - systemQty. 음수 = 감모(사은품/경품 등), 양수 = 발견.
  variance    Int
  reason      StoreStocktakeReason?
  note        String?               @db.Text
  createdAt   DateTime              @default(now()) @map("created_at") @db.DateTime(0)

  lotChanges StoreStocktakeItemLotChange[]

  @@unique([stocktakeId, variantId], map: "store_stocktake_items_stocktake_variant_unique")
  @@index([variantId], map: "idx_store_stocktake_items_variant")
  @@map("store_stocktake_items")
}

/// 재고조사 차이를 lot 에 적용한 내역 (감사/원가 추적). quantityDelta signed.
model StoreStocktakeItemLotChange {
  id               Int                @id @default(autoincrement())
  itemId           Int                @map("item_id")
  item             StoreStocktakeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inventoryLotId   Int                @map("inventory_lot_id")
  inventoryLot     StoreInventoryLot  @relation(fields: [inventoryLotId], references: [id])
  /// signed: 음수 = 차감(FEFO), 양수 = 증가.
  quantityDelta    Int                @map("quantity_delta")
  /// 변동 시점 해당 lot 의 unitCost (원가 추적).
  unitCostAtChange Int                @map("unit_cost_at_change")
  createdAt        DateTime           @default(now()) @map("created_at") @db.DateTime(0)

  @@index([itemId], map: "idx_store_stocktake_lot_changes_item")
  @@index([inventoryLotId], map: "idx_store_stocktake_lot_changes_lot")
  @@map("store_stocktake_item_lot_changes")
}

// -------- Pick and Mix (골라담기) --------

/// 골라담기 정책 — id=1 상온, id=2 냉장, id=3 냉동.
/// 상품 타입은 StoreProduct.handlingFlags(FROZEN/REFRIGERATED) 에서 파생하고, flag 없음은 상온.
/// 사용자 정책: 타입별 단가 합산 / 최소 19,900원 / 39,900원+ 무료배송 / 그 외 2,500원 (default).
/// admin /store-admin/store/pick-and-mix 에서 편집.
model StorePickAndMixPolicy {
  id                    Int                       @id @default(1)
  minOrderAmount        Int                       @default(19900) @map("min_order_amount")
  freeShippingThreshold Int                       @default(39900) @map("free_shipping_threshold")
  baseShippingFee       Int                       @default(2500) @map("base_shipping_fee")
  isActive              Boolean                   @default(true) @map("is_active")
  /// 골라담기 전용 일괄 할인. variant.salePrice / Product 인라인 할인이 있으면 그 값이 우선.
  discountActive        Boolean                   @default(false) @map("discount_active")
  discountType          StoreProductDiscountType? @map("discount_type")
  discountValue         Int?                      @map("discount_value") // PERCENT: 0~100, AMOUNT: 원
  discountStartsAt      DateTime?                 @map("discount_starts_at") @db.DateTime(0)
  discountEndsAt        DateTime?                 @map("discount_ends_at") @db.DateTime(0)
  /// 사용자 안내 문구 override. null = 기본 ("최소 X원, Y원~ 무료배송")
  noticeText            String?                   @map("notice_text") @db.Text
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("store_pick_and_mix_policy")
}

enum StorePickAndMixSnackRequestStatus {
  REQUESTED
  NOTIFIED
  ARCHIVED
}

model StorePickAndMixSnackRequest {
  id                Int                               @id @default(autoincrement())
  userId            Int                               @map("user_id")
  user              User                              @relation("StorePickAndMixSnackRequester", fields: [userId], references: [id])
  productName       String                            @map("product_name") @db.VarChar(120)
  reason            String?                           @db.Text
  requesterEmail    String?                           @map("requester_email") @db.VarChar(255)
  requesterNickname String?                           @map("requester_nickname") @db.VarChar(100)
  requesterPhone    String?                           @map("requester_phone") @db.VarChar(30)
  status            StorePickAndMixSnackRequestStatus @default(REQUESTED)
  adminMemo         String?                           @map("admin_memo") @db.Text
  smsSentAt         DateTime?                         @map("sms_sent_at") @db.DateTime(0)
  smsSentByUserId   Int?                              @map("sms_sent_by_user_id")
  smsSentBy         User?                             @relation("StorePickAndMixSnackRequestSmsSender", fields: [smsSentByUserId], references: [id])
  smsMessage        String?                           @map("sms_message") @db.Text
  createdAt         DateTime                          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime                          @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([status, createdAt], map: "idx_store_pick_mix_snack_req_status_created")
  @@index([userId, createdAt], map: "idx_store_pick_mix_snack_req_user_created")
  @@index([smsSentByUserId], map: "idx_store_pick_mix_snack_req_sms_sender")
  @@map("store_pick_and_mix_snack_requests")
}

/// @deprecated. 번들 wrapper 모델 폐기 (2026-05-07). 신규 사용 X.
/// admin/UI/API 진입은 모두 제거. DB 컬럼은 과거 주문(StoreOrderItem.bundleId snapshot) 보존 위해 유지.
/// 신규 골라담기 = StoreProduct.isPickAndMix=true 마킹 + StorePickAndMixPolicy 단일 정책.
model StorePickAndMixBundle {
  id                    Int      @id @default(autoincrement())
  name                  String   @db.VarChar(200)
  description           String?  @db.Text
  thumbnailUrl          String?  @map("thumbnail_url") @db.VarChar(500)
  minOrderAmount        Int      @default(19900) @map("min_order_amount")
  freeShippingThreshold Int      @default(39900) @map("free_shipping_threshold")
  baseShippingFee       Int      @default(2500) @map("base_shipping_fee")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  components StorePickAndMixBundleComponent[]
  cartItems  StoreCartItem[]
  orderItems StoreOrderItem[]

  @@map("store_pick_and_mix_bundles")
}

/// @deprecated. StoreProduct.isPickAndMix 로 대체. 신규 사용 X.
model StorePickAndMixBundleComponent {
  id        Int                   @id @default(autoincrement())
  bundleId  Int                   @map("bundle_id")
  bundle    StorePickAndMixBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  variantId Int                   @map("variant_id")
  variant   StoreProductVariant   @relation(fields: [variantId], references: [id])
  sortOrder Int                   @default(0) @map("sort_order")

  @@unique([bundleId, variantId], map: "store_pmb_components_bundle_variant_unique")
  @@index([bundleId], map: "idx_store_pmb_components_bundle")
  @@index([variantId], map: "idx_store_pmb_components_variant")
  @@map("store_pick_and_mix_bundle_components")
}

// -------- Cart --------

model StoreCart {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique(map: "store_carts_user_unique") @map("user_id")
  expiresAt DateTime? @map("expires_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  items StoreCartItem[]

  @@map("store_carts")
}

model StoreCartItem {
  id            Int                    @id @default(autoincrement())
  cartId        Int                    @map("cart_id")
  cart          StoreCart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId     Int?                   @map("variant_id")
  variant       StoreProductVariant?   @relation(fields: [variantId], references: [id])
  /// @deprecated. 신규 골라담기 라인은 bundleId=null + pickSelection 만 set.
  /// 컬럼은 과거 데이터 호환 위해 유지.
  bundleId      Int?                   @map("bundle_id")
  bundle        StorePickAndMixBundle? @relation(fields: [bundleId], references: [id])
  quantity      Int
  /// 골라담기 라인 = bundleId=null + 이 필드만 set: [{variantId, qty}, ...]. 1 카트 당 1 라인 (정책 단일).
  /// 일반 라인 = variantId + quantity (pickSelection=null).
  pickSelection Json?                  @map("pick_selection")
  createdAt     DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([cartId], map: "idx_store_cart_items_cart")
  @@map("store_cart_items")
}

// -------- User Address (KMS 암호화 — 일반 배송 + 선물 수령 통합) --------

/// 모든 주소 KMS envelope 암호화 (AES-256-GCM).
/// User.giftReceivingAddressId @unique FK 로 1명당 1개를 선물 수령용 지정.
/// 본인 자기 조회는 KmsAuditLog 미기록 (audit explosion 방지).
/// 송장/admin/디버깅 복호화만 KmsAuditLog 기록.
model StoreUserAddress {
  id     Int     @id @default(autoincrement())
  userId Int     @map("user_id")
  user   User    @relation("UserStoreAddresses", fields: [userId], references: [id])
  label  String? @db.VarChar(50)

  // KMS envelope 암호화 (v1:edk:iv:ct:tag) — StoreAddressEncryptionService 사용
  recipientNameEncrypted  String  @map("recipient_name_encrypted") @db.Text
  recipientPhoneEncrypted String  @map("recipient_phone_encrypted") @db.Text
  zipCodeEncrypted        String  @map("zip_code_encrypted") @db.Text
  addressEncrypted        String  @map("address_encrypted") @db.Text
  detailAddressEncrypted  String? @map("detail_address_encrypted") @db.Text

  /// 일반 배송 기본 (체크아웃 자동 선택)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  giftReceivingForUsers    User[]                    @relation("UserGiftReceivingAddress")
  auditLogs                StoreKmsAuditLog[]
  anongiftRecipientProfile AnongiftRecipientProfile? @relation("AnongiftRecipientAddress")
  rentalOrders             RentalOrder[]             @relation("RentalOrderAddress")
  haejuseyoOrders          HaejuseyoOrder[]          @relation("HaejuseyoOrderShippingAddress")

  @@index([userId], map: "idx_store_user_addresses_user")
  @@map("store_user_addresses")
}

