// ===================================
// Channel membership domain
// ===================================

/// A channel owns its plans; platform-specific product IDs/prices are kept as
/// configuration snapshots so iOS/Android receipt handling never trusts a
/// client-supplied amount or plan identity.
model ChannelMembershipPlan {
  id                      String   @id @default(cuid()) @db.VarChar(36)
  channelId               Int?     @map("channel_id")
  code                    String   @db.VarChar(40)
  name                    String   @db.VarChar(80)
  description             String?  @db.VarChar(500)
  webMonthlyPrice         Int      @map("web_monthly_price")
  iosProductId            String?  @unique(map: "uq_channel_membership_plans_ios_product_id") @map("ios_product_id") @db.VarChar(191)
  androidProductId        String?  @unique(map: "uq_channel_membership_plans_android_product_id") @map("android_product_id") @db.VarChar(191)
  iosMonthlyPrice         Int?     @map("ios_monthly_price")
  androidMonthlyPrice     Int?     @map("android_monthly_price")
  streamerRevenueShareBps Int      @default(7000) @map("streamer_revenue_share_bps")
  settlementFeeBps        Int      @default(0) @map("settlement_fee_bps")
  isActive                Boolean  @default(false) @map("is_active")
  sortOrder               Int      @default(0) @map("sort_order")
  createdAt               DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  channel   Channel?                    @relation(fields: [channelId], references: [id], onDelete: SetNull)
  terms     ChannelMembershipTerm[]
  emotes    ChannelMembershipEmote[]
  checkouts ChannelMembershipCheckout[]

  @@unique([channelId, code], name: "unique_channel_membership_plan_code", map: "uq_channel_membership_plans_channel_code")
  @@index([channelId, isActive, sortOrder], map: "idx_channel_membership_plans_channel_active_sort")
  @@map("channel_membership_plans")
}

enum ChannelMembershipTermStatus {
  ACTIVE
  CANCELED
  EXPIRED
  REVOKED

  @@map("channel_membership_term_status")
}

enum ChannelMembershipBillingSource {
  WEB_PAYPLE
  IOS_APP_STORE
  ANDROID_GOOGLE_PLAY
  ADMIN_GRANT

  @@map("channel_membership_billing_source")
}

/// One activeKey exists per member/channel. Terminal terms receive a
/// historical key at transition, mirroring the Talk session active-key model
/// and making upgrade/cancel callbacks idempotent without MySQL partial keys.
model ChannelMembershipTerm {
  id                      String                         @id @default(cuid()) @db.VarChar(36)
  channelId               Int?                           @map("channel_id")
  planId                  String                         @map("plan_id") @db.VarChar(36)
  memberUserId            Int                            @map("member_user_id")
  status                  ChannelMembershipTermStatus    @default(ACTIVE)
  activeKey               String                         @unique(map: "uq_channel_membership_terms_active_key") @map("active_key") @db.VarChar(191)
  billingSource           ChannelMembershipBillingSource @map("billing_source")
  externalSubscriptionId  String?                        @unique(map: "uq_channel_membership_terms_external_subscription") @map("external_subscription_id") @db.VarChar(191)
  planNameSnapshot        String                         @map("plan_name_snapshot") @db.VarChar(80)
  priceSnapshot           Int                            @map("price_snapshot")
  streamerRevenueShareBps Int                            @map("streamer_revenue_share_bps")
  settlementFeeBps        Int                            @default(0) @map("settlement_fee_bps")
  startsAt                DateTime                       @map("starts_at") @db.DateTime(0)
  endsAt                  DateTime                       @map("ends_at") @db.DateTime(0)
  autoRenew               Boolean                        @default(false) @map("auto_renew")
  canceledAt              DateTime?                      @map("canceled_at") @db.DateTime(0)
  revokedAt               DateTime?                      @map("revoked_at") @db.DateTime(0)
  createdAt               DateTime                       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt               DateTime                       @updatedAt @map("updated_at") @db.DateTime(0)

  channel   Channel?                    @relation(fields: [channelId], references: [id], onDelete: SetNull)
  plan      ChannelMembershipPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  member    User                        @relation("ChannelMembershipMember", fields: [memberUserId], references: [id], onDelete: Restrict)
  checkouts ChannelMembershipCheckout[]

  @@index([channelId, status, endsAt], map: "idx_channel_membership_terms_channel_status_end")
  @@index([memberUserId, status, endsAt], map: "idx_channel_membership_terms_member_status_end")
  @@map("channel_membership_terms")
}

/// A payment attempt is immutable financial evidence.  One approved checkout
/// grants or renews one membership term, while a billing event is retained
/// separately so Payple retries and store webhooks can be made idempotent.
model ChannelMembershipCheckout {
  id                      String                          @id @default(cuid()) @db.VarChar(36)
  orderNumber             String                          @unique(map: "uq_channel_membership_checkouts_order_number") @map("order_number") @db.VarChar(64)
  channelId               Int?                            @map("channel_id")
  planId                  String                          @map("plan_id") @db.VarChar(36)
  purchaserUserId         Int                             @map("purchaser_user_id")
  termId                  String?                         @map("term_id") @db.VarChar(36)
  billingSource           ChannelMembershipBillingSource  @map("billing_source")
  status                  ChannelMembershipCheckoutStatus @default(READY)
  paymentMethod           PaymentMethod?                  @map("payment_method")
  amount                  Int
  currency                String                          @default("KRW") @db.VarChar(3)
  streamerRevenueShareBps Int                             @map("streamer_revenue_share_bps")
  settlementFeeBps        Int                             @default(0) @map("settlement_fee_bps")
  externalTransactionId   String?                         @unique(map: "uq_channel_membership_checkouts_external_transaction") @map("external_transaction_id") @db.VarChar(191)
  externalSubscriptionId  String?                         @map("external_subscription_id") @db.VarChar(191)
  idempotencyKey          String?                         @map("idempotency_key") @db.VarChar(96)
  providerPayload         Json?                           @map("provider_payload")
  expiresAt               DateTime?                       @map("expires_at") @db.DateTime(0)
  approvedAt              DateTime?                       @map("approved_at") @db.DateTime(0)
  canceledAt              DateTime?                       @map("canceled_at") @db.DateTime(0)
  refundedAt              DateTime?                       @map("refunded_at") @db.DateTime(0)
  settlementPublishedAt   DateTime?                       @map("settlement_published_at") @db.DateTime(0)
  settlementEventId       String?                         @map("settlement_event_id") @db.VarChar(64)
  createdAt               DateTime                        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt               DateTime                        @updatedAt @map("updated_at") @db.DateTime(0)

  channel          Channel?                            @relation(fields: [channelId], references: [id], onDelete: SetNull)
  plan             ChannelMembershipPlan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  purchaser        User                                @relation("ChannelMembershipCheckoutPurchaser", fields: [purchaserUserId], references: [id], onDelete: Restrict)
  term             ChannelMembershipTerm?              @relation(fields: [termId], references: [id], onDelete: SetNull)
  events           ChannelMembershipBillingEvent[]
  settlementOutbox ChannelMembershipSettlementOutbox[]

  @@unique([purchaserUserId, idempotencyKey], name: "uq_channel_membership_checkouts_purchaser_idempotency")
  @@index([channelId, status, createdAt], map: "idx_channel_membership_checkouts_channel_status_created")
  @@index([purchaserUserId, status, createdAt], map: "idx_channel_membership_checkouts_purchaser_status_created")
  @@index([settlementPublishedAt, status], map: "idx_channel_membership_checkouts_settlement_publish")
  @@map("channel_membership_checkouts")
}

enum ChannelMembershipCheckoutStatus {
  READY
  PROCESSING
  APPROVED
  CANCELED
  EXPIRED
  REFUNDED
  REVOKED
  FAILED

  @@map("channel_membership_checkout_status")
}

enum ChannelMembershipBillingEventType {
  WEB_PAYPLE_APPROVED
  WEB_PAYPLE_REFUNDED
  STORE_INITIAL_PURCHASE
  STORE_RENEWAL
  STORE_PRODUCT_CHANGE
  STORE_CANCELLATION
  STORE_EXPIRATION
  STORE_REFUND
  STORE_BILLING_ISSUE

  @@map("channel_membership_billing_event_type")
}

/// A durable outbox keeps partner settlement events recoverable when Redis is
/// temporarily unavailable. A checkout can publish one original settlement
/// and one compensating refund event; both are idempotent downstream.
enum ChannelMembershipSettlementOutboxKind {
  ORIGINAL
  REFUND

  @@map("channel_membership_settlement_outbox_kind")
}

/// Immutable webhook/PG event inbox.  The external event ID is globally unique
/// so replayed provider notifications cannot grant membership twice.
model ChannelMembershipBillingEvent {
  id              String                            @id @default(cuid()) @db.VarChar(36)
  checkoutId      String?                           @map("checkout_id") @db.VarChar(36)
  channelId       Int                               @map("channel_id")
  planId          String?                           @map("plan_id") @db.VarChar(36)
  purchaserUserId Int                               @map("purchaser_user_id")
  billingSource   ChannelMembershipBillingSource    @map("billing_source")
  type            ChannelMembershipBillingEventType @map("event_type")
  externalEventId String                            @unique(map: "uq_channel_membership_billing_events_external_event") @map("external_event_id") @db.VarChar(191)
  occurredAt      DateTime                          @map("occurred_at") @db.DateTime(0)
  payload         Json
  appliedAt       DateTime?                         @map("applied_at") @db.DateTime(0)
  createdAt       DateTime                          @default(now()) @map("created_at") @db.DateTime(0)

  checkout         ChannelMembershipCheckout?         @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  settlementOutbox ChannelMembershipSettlementOutbox?

  @@index([channelId, occurredAt], map: "idx_channel_membership_billing_events_channel_occurred")
  @@index([purchaserUserId, occurredAt], map: "idx_channel_membership_billing_events_purchaser_occurred")
  @@map("channel_membership_billing_events")
}

/// Immutable settlement intent created with the billing state transition and
/// published later by a retryable worker. `amount` is the streamer's share,
/// already snapshotted at checkout approval, so downstream payout logic never
/// recalculates historical revenue splits.
model ChannelMembershipSettlementOutbox {
  id             String                                @id @default(cuid()) @db.VarChar(36)
  checkoutId     String                                @map("checkout_id") @db.VarChar(36)
  billingEventId String?                               @unique(map: "uq_channel_membership_settlement_outbox_billing_event") @map("billing_event_id") @db.VarChar(36)
  kind           ChannelMembershipSettlementOutboxKind @map("event_kind")
  amount         Int
  occurredAt     DateTime                              @map("occurred_at") @db.DateTime(0)
  publishedAt    DateTime?                             @map("published_at") @db.DateTime(0)
  streamEventId  String?                               @unique(map: "uq_channel_membership_settlement_outbox_stream_event") @map("stream_event_id") @db.VarChar(64)
  attempts       Int                                   @default(0)
  lastError      String?                               @map("last_error") @db.Text
  createdAt      DateTime                              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime                              @updatedAt @map("updated_at") @db.DateTime(0)

  checkout     ChannelMembershipCheckout      @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  billingEvent ChannelMembershipBillingEvent? @relation(fields: [billingEventId], references: [id], onDelete: SetNull)

  @@unique([checkoutId, kind], name: "unique_channel_membership_settlement_outbox_checkout_kind", map: "uq_channel_membership_settlement_outbox_checkout_kind")
  @@index([publishedAt, occurredAt], map: "idx_channel_membership_settlement_outbox_pending")
  @@map("channel_membership_settlement_outbox")
}

/// A channel owner selects from already-approved channel emoticons. The same
/// asset can be offered by multiple tiers; entitlement is resolved from any
/// active membership term for the channel.
model ChannelMembershipEmote {
  id         String   @id @default(cuid()) @db.VarChar(36)
  planId     String   @map("plan_id") @db.VarChar(36)
  emoticonId Int      @map("emoticon_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)

  plan     ChannelMembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  emoticon ChannelEmoticon       @relation(fields: [emoticonId], references: [id], onDelete: Cascade)

  @@unique([planId, emoticonId], name: "unique_channel_membership_emote", map: "uq_channel_membership_emotes_plan_emoticon")
  @@index([emoticonId], map: "idx_channel_membership_emotes_emoticon")
  @@map("channel_membership_emotes")
}

// ===================================
// Promotions domain (Items / Slots / Orders)
// ===================================

enum PromotionPlacement {
  HERO_BANNER
  HEADER_SEARCH_SIDE_BANNER
  SIDE_TOP_BANNER
  SIDE_CENTER_BANNER
  SIDE_BOTTOM_BANNER
  CONTENT_TOP_PINNED
}

model PromotionItem {
  id                Int                @id @default(autoincrement())
  code              String             @unique(map: "uq_promo_item_code")
  name              String
  placement         PromotionPlacement
  listPrice         Int?               @map("list_price")
  discountPrice     Int?               @map("discount_price")
  discountPercent   Int?               @map("discount_percent")
  description       String?            @db.Text
  description_html  String?            @map("description_html") @db.LongText
  image_url         String?            @db.VarChar(500)
  target_url        String?            @db.VarChar(500)
  unit_price        Int                @map("unit_price")
  default_capacity  Int?               @map("default_capacity")
  slot_horizon_days Int?               @default(30) @map("slot_horizon_days")
  currency          String             @default("KRW") @db.VarChar(3)
  is_active         Boolean            @default(true) @map("is_active")
  creative_spec     Json?              @map("creative_spec")
  created_at        DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  updated_at        DateTime           @updatedAt @map("updated_at") @db.DateTime(0)

  slots            PromotionSlot[]
  promotion_orders PromotionOrder[]

  @@index([placement, is_active], map: "idx_promo_item_place_active")
  @@map("promotion_items")
}

model PromotionSlot {
  id             Int           @id @default(autoincrement())
  item_id        Int           @map("item_id")
  item           PromotionItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  slot_date      DateTime      @map("slot_date") @db.Date
  capacity       Int
  sold           Int           @default(0)
  reserved       Int           @default(0) @map("reserved")
  price_override Int?          @map("price_override")
  is_active      Boolean       @default(true) @map("is_active")
  created_at     DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updated_at     DateTime      @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([item_id, slot_date], map: "uq_promo_slot_item_date")
  @@index([item_id, slot_date, is_active], map: "idx_promo_slot_item_date_active")
  @@map("promotion_slots")
}

model PromotionOrder {
  id               Int                  @id @default(autoincrement())
  order_id         Int                  @map("order_id")
  order            Order                @relation(fields: [order_id], references: [id], onDelete: Cascade)
  item_id          Int                  @map("item_id")
  item             PromotionItem        @relation(fields: [item_id], references: [id])
  slot_date        DateTime?            @map("slot_date") @db.Date
  slot_dates       Json?                @map("slot_dates")
  quantity         Int                  @default(1)
  status           PromotionOrderStatus @default(PENDING_APPROVAL) @map("status")
  rejection_reason String?              @map("rejection_reason") @db.Text

  // User-provided creative at order time
  creative_title          String? @map("creative_title")
  creative_description    String? @map("creative_description") @db.Text
  creative_image_url      String? @map("creative_image_url") @db.VarChar(500)
  creative_image_dark_url String? @map("creative_image_dark_url") @db.VarChar(500)
  creative_target_url     String? @map("creative_target_url") @db.VarChar(500)

  // Price snapshot at order time
  unit_price_snapshot  Int    @map("unit_price_snapshot")
  total_price_snapshot Int    @map("total_price_snapshot")
  currency             String @db.VarChar(3)

  // Content pinning (CONTENT_TOP_PINNED only)
  content_id Int?     @map("content_id")
  content    Content? @relation(fields: [content_id], references: [id])

  created_at DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updated_at DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  // Relations
  banners         Banner[]
  bannerEventLogs BannerEventLog[]

  @@unique([order_id], map: "uq_promotion_orders_order")
  @@index([item_id, slot_date], map: "idx_promo_order_item_date")
  @@index([status], map: "idx_promo_order_status")
  @@index([content_id], map: "idx_promo_order_content_id")
  @@map("promotion_orders")
}

// 커뮤니티 전용 enum
enum PostStatus {
  VISIBLE @map("visible") // 노출
  HIDDEN  @map("hidden") // 숨김(모더레이션)
  DELETED @map("deleted") // 삭제(소프트 딜리트)
}

enum ReactionTargetType {
  POST         @map("post") // 게시글 대상
  COMMENT      @map("comment") // 댓글 대상
  REPLY        @map("reply") // 대댓글 대상
  CLIP         @map("clip") // 클립 대상
  CLIP_COMMENT @map("clip_comment") // 클립 댓글 대상
  CLIP_REPLY   @map("clip_reply") // 클립 대댓글 대상
  PLAYLIST     @map("playlist") // 플레이리스트 대상
}

enum ReactionKind {
  LIKE @map("like") // 좋아요 (추후 이모지/기타 반응 확장 가능)
}

enum PlaylistVisibility {
  PUBLIC   @map("public")
  UNLISTED @map("unlisted")
  PRIVATE  @map("private")
}

enum PlaylistOwnerType {
  USER    @map("user")
  CHANNEL @map("channel")
}

enum ReportStatus {
  PENDING  @map("pending") // 신고 접수
  RESOLVED @map("resolved") // 처리 완료
  REJECTED @map("rejected") // 반려
}

// 커스텀 필드(게시판/도메인 확장용) 타입 정의
enum CommunityFieldType {
  TEXT         @map("text") // 한 줄 텍스트
  TEXTAREA     @map("textarea") // 여러 줄 텍스트
  RICHTEXT     @map("richtext") // 리치 텍스트(마크다운/HTML 등)
  NUMBER_INT   @map("number_int") // 정수
  NUMBER_FLOAT @map("number_float") // 실수
  BOOLEAN      @map("boolean") // 불리언
  DATE         @map("date") // 날짜
  DATETIME     @map("datetime") // 날짜시간
  SELECT       @map("select") // 단일 선택(프리셋 옵션)
  MULTI_SELECT @map("multi_select") // 다중 선택(프리셋 옵션)
  URL          @map("url") // URL
  PRICE        @map("price") // 가격(센트 단위 등 정수 권장)
  IMAGE        @map("image") // 이미지(업로드 키)
  FILE         @map("file") // 파일(업로드 키)
  LOCATION     @map("location") // 위치(위경도/주소 등 JSON)
}

enum CommunityPostAttachmentType {
  IMAGE @map("image")
  VIDEO @map("video")
}

enum CommunityBoardPermission {
  PUBLIC          @map("public")
  AUTHENTICATED   @map("authenticated")
  CHANNEL_MANAGER @map("channel_manager")
  CHANNEL_OWNER   @map("channel_owner")
}

/**
 * ========= Group / Board =========
 */

// 커뮤니티 보드 묶음(상위 그룹)
model CommunityBoardGroup {
  id          Int       @id @default(autoincrement())
  channelId   Int?      @unique(map: "uq_community_board_groups_channel_id") @map("channel_id")
  name        String // 그룹 이름
  description String? // 설명
  isActive    Boolean?  @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  channel Channel?         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  boards  CommunityBoard[] // 하위 보드들

  @@map("community_board_groups")
}

// 실제 게시판(자유/유머/정보/홍보/스트리머 전용 등)
model CommunityBoard {
  id                Int                      @id @default(autoincrement())
  boardGroupId      Int                      @map("board_group_id")
  channelId         Int?                     @map("channel_id")
  channelBoardKey   String?                  @map("channel_board_key") @db.VarChar(64)
  name              String // 보드 이름
  slug              String                   @unique(map: "community_boards_slug_unique") // 라우팅/SEO용 슬러그
  isStreamerOnly    Boolean?                 @default(false) @map("is_streamer_only") // 스트리머/매니저 전용 여부
  isAnonymous       Boolean?                 @default(false) @map("is_anonymous") // 익명 게시판 여부
  isAdminOnly       Boolean?                 @default(false) @map("is_admin_only") // Admin 전용 게시판 여부
  description       String?
  readPermission    CommunityBoardPermission @default(PUBLIC) @map("read_permission")
  writePermission   CommunityBoardPermission @default(AUTHENTICATED) @map("write_permission")
  commentPermission CommunityBoardPermission @default(AUTHENTICATED) @map("comment_permission")
  allowReplies      Boolean                  @default(true) @map("allow_replies")
  allowReactions    Boolean                  @default(true) @map("allow_reactions")
  displayOrder      Int?                     @default(0) @map("display_order")
  isActive          Boolean?                 @default(true) @map("is_active")
  createdAt         DateTime?                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime?                @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  group        CommunityBoardGroup    @relation(fields: [boardGroupId], references: [id], onDelete: Cascade)
  channel      Channel?               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  posts        CommunityPost[] // 게시글
  fieldSchemas CommunityFieldSchema[] // 커스텀 필드 스키마(버전 관리)
  categories   CommunityCategory[] // 말머리 카테고리

  @@unique([channelId, channelBoardKey], map: "uq_community_boards_channel_key")
  @@index([boardGroupId, isActive], map: "idx_community_boards_group_active")
  @@index([channelId, isActive], map: "idx_community_boards_channel_active")
  @@index([channelId, displayOrder], map: "idx_community_boards_channel_order")
  @@map("community_boards")
}

model CommunityChannelUserBlock {
  id              Int      @id @default(autoincrement())
  channelId       Int      @map("channel_id")
  userId          Int      @map("user_id")
  blockedByUserId Int?     @map("blocked_by_user_id")
  reason          String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User    @relation("CommunityBlockedUser", fields: [userId], references: [id], onDelete: Cascade)
  blockedBy User?   @relation("CommunityBlockCreator", fields: [blockedByUserId], references: [id], onDelete: SetNull)

  @@unique([channelId, userId], map: "uq_community_channel_user_blocks")
  @@index([userId], map: "idx_community_channel_user_blocks_user")
  @@index([blockedByUserId], map: "idx_community_channel_user_blocks_creator")
  @@map("community_channel_user_blocks")
}

// 게시판별 말머리 카테고리
model CommunityCategory {
  id           Int       @id @default(autoincrement())
  boardId      Int       @map("board_id")
  name         String    @db.VarChar(50) // 말머리 이름
  displayOrder Int?      @default(0) @map("display_order") // 표시 순서
  isActive     Boolean?  @default(true) @map("is_active")
  createdAt    DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  board CommunityBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  posts CommunityPost[]

  @@index([boardId, isActive], map: "idx_community_categories_board_active")
  @@index([boardId, displayOrder], map: "idx_community_categories_board_order")
  @@map("community_categories")
}

/**
 * ========= Post / Stat / Comment =========
 */

// 게시글(핵심 본문 + 선택적으로 커스텀 필드 스키마 버전 참조)
model CommunityPost {
  id              Int         @id @default(autoincrement())
  boardId         Int         @map("board_id")
  categoryId      Int         @map("category_id") // 말머리 카테고리 (필수)
  userId          Int         @map("user_id")
  title           String // 제목
  content         String      @db.Text // 본문(마크다운/HTML 등)
  status          PostStatus? @default(VISIBLE)
  isPinned        Boolean?    @default(false) @map("is_pinned") // 상단 고정
  hotScore        Float?      @default(0) @map("hot_score") // 핫 점수(시간 감쇠 기반)
  fieldSchemaId   Int?        @map("field_schema_id") // 생성 시 사용한 커스텀 스키마 버전
  createdAt       DateTime?   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime?   @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt       DateTime?   @map("deleted_at") @db.DateTime(0)
  ghostSlug       String?     @unique @map("ghost_slug") // Ghost CMS 마이그레이션 멱등성 키
  slug            String?     @unique(map: "community_posts_slug_unique") @map("slug") // post-level 공개 URL 슬러그 (블로그/SEO용)
  metaDescription String?     @map("meta_description") @db.Text // SEO meta description (검색 스니펫)
  seoKeywords     String?     @map("seo_keywords") @db.Text // 쉼표구분 SEO 키워드
  ogImageUrl      String?     @map("og_image_url") @db.VarChar(1000) // OG/공유 카드 이미지 URL

  board       CommunityBoard            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  category    CommunityCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  fieldSchema CommunityFieldSchema?     @relation(fields: [fieldSchemaId], references: [id])
  stat        CommunityPostStat? // 파생 카운터(집계)
  comments    CommunityComment[] // 댓글
  replies     CommunityReply[] // 대댓글(포스트 기준 접근)
  fieldValues CommunityPostFieldValue[] // 커스텀 필드 값들
  attachments CommunityPostAttachment[] // 게시글 이미지/영상 첨부

  @@index([boardId, createdAt], map: "idx_community_posts_board_created_at") // 최신순 목록
  @@index([boardId, categoryId, createdAt], map: "idx_community_posts_board_category_created") // 카테고리 필터
  @@index([hotScore, createdAt], map: "idx_community_posts_hot_created_at") // 핫 정렬
  @@index([status], map: "idx_community_posts_status")
  @@index([userId, createdAt], map: "idx_community_posts_user_created_at") // 내 글 목록 최적화
  @@index([categoryId], map: "idx_community_posts_category")
  @@map("community_posts")
}

// 게시글 파생 카운터(경합 완화/스케일 아웃)
model CommunityPostStat {
  postId       Int  @id @map("post_id")
  likeCount    Int? @default(0) @map("like_count")
  commentCount Int? @default(0) @map("comment_count")
  viewCount    Int? @default(0) @map("view_count")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("community_post_stats")
}

model CommunityPostAttachment {
  id           Int                         @id @default(autoincrement())
  postId       Int                         @map("post_id")
  userId       Int                         @map("user_id")
  mediaType    CommunityPostAttachmentType @map("media_type")
  fileKey      String                      @map("file_key") @db.VarChar(500)
  fileUrl      String                      @map("file_url") @db.VarChar(1000)
  originalName String?                     @map("original_name") @db.VarChar(255)
  mimeType     String                      @map("mime_type") @db.VarChar(120)
  sizeBytes    BigInt                      @map("size_bytes")
  displayOrder Int                         @default(0) @map("display_order")
  createdAt    DateTime                    @default(now()) @map("created_at") @db.DateTime(0)

  post     CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  uploader User          @relation("CommunityPostAttachmentUploader", fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, displayOrder], map: "idx_community_post_attachments_post_order")
  @@index([userId, createdAt], map: "idx_community_post_attachments_user_created")
  @@index([mediaType, createdAt], map: "idx_community_post_attachments_media_created")
  @@index([fileKey], map: "idx_community_post_attachments_file_key")
  @@map("community_post_attachments")
}

// 1-depth 댓글
model CommunityComment {
  id        Int         @id @default(autoincrement())
  postId    Int         @map("post_id")
  userId    Int         @map("user_id")
  content   String      @db.Text
  status    PostStatus? @default(VISIBLE)
  createdAt DateTime?   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime?   @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt DateTime?   @map("deleted_at") @db.DateTime(0)

  post    CommunityPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies CommunityReply[]

  @@index([postId, createdAt], map: "idx_community_comments_post_created_at")
  @@index([userId, createdAt], map: "idx_community_comments_user_created_at")
  @@map("community_comments")
}

// 1-depth 대댓글 (댓글에 소속)
model CommunityReply {
  id        Int         @id @default(autoincrement())
  postId    Int         @map("post_id")
  commentId Int         @map("comment_id")
  userId    Int         @map("user_id")
  content   String      @db.Text
  status    PostStatus? @default(VISIBLE)
  createdAt DateTime?   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime?   @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt DateTime?   @map("deleted_at") @db.DateTime(0)

  // relations
  post    CommunityPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt], map: "idx_community_replies_post_created_at")
  @@index([commentId, createdAt], map: "idx_community_replies_comment_created_at")
  @@index([userId, createdAt], map: "idx_community_replies_user_created_at")
  @@map("community_replies")
}

/**
 * ========= Reactions / Reports =========
 */

// 반응(좋아요 등) - 추후 이모지/확장 가능
model CommunityReaction {
  id         Int                @id @default(autoincrement())
  userId     Int                @map("user_id")
  targetType ReactionTargetType // POST/COMMENT/REPLY
  targetId   Int                @map("target_id")
  kind       ReactionKind // LIKE 등
  createdAt  DateTime?          @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([userId, targetType, targetId, kind], map: "uq_community_reactions_user_target_kind") // 토글 보장
  @@index([userId, createdAt], map: "idx_community_reactions_user_created")
  @@index([targetType, targetId], map: "idx_community_reactions_target")
  @@map("community_reactions")
}

// 신고(모더레이션)
model CommunityReport {
  id         Int                @id @default(autoincrement())
  reporterId Int                @map("reporter_id")
  targetType ReactionTargetType
  targetId   Int                @map("target_id")
  reasonCode String             @map("reason_code") // 사유 코드(카테고리화 권장)
  memo       String? // 자유 서술
  status     ReportStatus       @default(PENDING)
  createdAt  DateTime?          @default(now()) @map("created_at") @db.DateTime(0)
  resolvedAt DateTime?          @map("resolved_at") @db.DateTime(0)

  @@index([status, createdAt], map: "idx_community_reports_status_created")
  @@map("community_reports")
}

/**
 * ========= Field Schema / Field Def / Field Value =========
 */

// 보드별 커스텀 필드 스키마(버전 관리)
// - 구인구직/중고장터 등 도메인별 필드 구성을 보드에서 정의
// - 게시글은 생성 시점의 스키마 버전을 고정 참조(변경 내성)
model CommunityFieldSchema {
  id        Int       @id @default(autoincrement())
  boardId   Int       @map("board_id")
  name      String // 스키마 이름(예: "채용 공고 v2")
  version   Int       @default(1) // 버전
  isActive  Boolean?  @default(true) @map("is_active")
  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  board  CommunityBoard      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  fields CommunityFieldDef[] // 필드 정의들
  posts  CommunityPost[] // 해당 스키마를 사용한 게시글들

  @@unique([boardId, version], map: "uq_field_schema_board_version")
  @@index([boardId, isActive], map: "idx_field_schema_board_active")
  @@map("community_field_schemas")
}

// 커스텀 필드 정의(데이터 타입/옵션/필수 여부 등)
model CommunityFieldDef {
  id           Int                @id @default(autoincrement())
  schemaId     Int                @map("schema_id")
  code         String // 내부 코드(예: "salary", "price", "images")
  label        String // 표시 라벨
  fieldType    CommunityFieldType @map("field_type")
  isRequired   Boolean?           @default(false) @map("is_required")
  isRepeatable Boolean?           @default(false) @map("is_repeatable") // 반복 항목(이미지 여러 장 등)
  isFilterable Boolean?           @default(false) @map("is_filterable") // 목록 필터 사용 여부
  displayOrder Int?               @default(0) @map("display_order")
  settings     Json? // 선택지/유효성 규칙/단위/mime 제한 등
  createdAt    DateTime?          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime?          @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  schema CommunityFieldSchema      @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  values CommunityPostFieldValue[]

  @@unique([schemaId, code], map: "uq_field_def_schema_code") // 같은 스키마 내 코드 유니크
  @@index([schemaId, displayOrder], map: "idx_field_def_schema_order")
  @@map("community_field_defs")
}

// 게시글의 커스텀 필드 값 저장(다형성 컬럼 + 반복값 ordinal)
// - 타입별로 해당 value_* 컬럼만 사용
// - 이미지/파일은 file_key(+value_json 메타) 사용, 반복 시 ordinal 증가
model CommunityPostFieldValue {
  id         Int  @id @default(autoincrement())
  postId     Int  @map("post_id")
  fieldDefId Int  @map("field_def_id")
  ordinal    Int? @default(0) // 반복 필드 순서(0부터)

  valueText     String?   @map("value_text") @db.Text // TEXT/TEXTAREA/RICHTEXT/URL/SELECT 등
  valueInt      Int?      @map("value_int") // NUMBER_INT/PRICE(센트 권장)
  valueFloat    Float?    @map("value_float") // NUMBER_FLOAT
  valueBool     Boolean?  @map("value_bool") // BOOLEAN
  valueDate     DateTime? @map("value_date") @db.Date // DATE
  valueDateTime DateTime? @map("value_datetime") @db.DateTime(0) // DATETIME
  valueJson     Json?     @map("value_json") // MULTI_SELECT/LOCATION/이미지 메타 등
  fileKey       String?   @map("file_key") // IMAGE/FILE 업로드 key

  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)

  post     CommunityPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  fieldDef CommunityFieldDef @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)

  @@unique([postId, fieldDefId, ordinal], map: "uq_field_value_post_field_ordinal") // 비반복은 ordinal=0
  @@index([fieldDefId, valueInt], map: "idx_field_value_int") // 필터 최적화(가격/숫자)
  @@index([fieldDefId, valueFloat], map: "idx_field_value_float")
  @@index([fieldDefId, valueDate], map: "idx_field_value_date")
  @@index([fieldDefId, valueDateTime], map: "idx_field_value_datetime")
  @@index([fieldDefId, valueText(length: 191)], map: "idx_field_value_text") // MySQL TEXT 인덱스는 prefix length 필요
  @@index([fieldDefId, fileKey], map: "idx_field_value_file")
  @@map("community_post_field_values")
}

// KCP 본인인증 (PortOne API 연동용)
enum IdentityMethod {
  SMS   @map("sms")
  APP   @map("app")
  DIDIT @map("didit")
}

enum Operator {
  SKT      @map("skt")
  KT       @map("kt")
  LGU      @map("lgu")
  SKT_MVNO @map("skt_mvno")
  KT_MVNO  @map("kt_mvno")
  LGU_MVNO @map("lgu_mvno")
}

enum IdentityStatus {
  REQUESTED @map("requested")
  SENT      @map("sent")
  VERIFIED  @map("verified")
  FAILED    @map("failed")
  CANCELED  @map("canceled")
  EXPIRED   @map("expired")
}

model UserIdentity {
  id                     Int             @id @default(autoincrement())
  userId                 Int             @map("user_id")
  identityVerificationId String          @unique @map("identity_verification_id") @db.VarChar(100)
  ci                     String          @map("ci") @db.VarChar(200)
  di                     String          @map("di") @db.VarChar(200)
  ciCipher               String?         @map("ci_cipher") @db.Text
  diCipher               String?         @map("di_cipher") @db.Text
  ciHash                 String?         @map("ci_hash") @db.VarChar(128)
  diHash                 String?         @map("di_hash") @db.VarChar(128)
  method                 IdentityMethod? @map("method")
  operator               Operator?       @map("operator")
  phoneNumber            String?         @map("phone_number") @db.VarChar(20)
  name                   String?         @db.VarChar(100)
  birthDate              String?         @map("birth_date") @db.VarChar(20) // YYYYMMDD
  gender                 String?         @db.VarChar(10)
  isForeigner            Boolean?        @map("is_foreigner")
  rawResponse            Json?           @map("raw_response")
  certifiedAt            DateTime?       @map("certified_at") @db.DateTime(0)
  createdAt              DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identityVerificationId], map: "idx_user_identity_verification_id")
  @@index([ci], map: "idx_user_identity_ci")
  @@index([di], map: "idx_user_identity_di")
  @@index([ciHash], map: "idx_user_identity_ci_hash")
  @@index([diHash], map: "idx_user_identity_di_hash")
  @@index([userId, createdAt], map: "idx_user_identity_user_created")
  @@map("user_identity")
}

// ===================================
// Coupons domain models
// ===================================

/// 쿠폰 카테고리
model CouponCategory {
  id           Int     @id @default(autoincrement())
  code         String  @unique @map("code") @db.VarChar(32)
  name         String  @map("name") @db.VarChar(100)
  description  String? @map("description") @db.Text
  prefix       String  @map("prefix") @db.VarChar(8)
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")
  metadata     Json?   @map("metadata")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  campaigns CouponCampaign[]

  @@index([isActive, displayOrder], map: "idx_category_active_order")
  @@map("coupon_categories")
}

/// 쿠폰 캠페인
model CouponCampaign {
  id          Int            @id @default(autoincrement())
  name        String         @map("name") @db.VarChar(255)
  description String?        @map("description") @db.Text
  categoryId  Int            @map("category_id")
  category    CouponCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // 할인 설정
  discountType      DiscountType @map("discount_type")
  discountAmount    Int?         @map("discount_amount")
  discountPercent   Int?         @map("discount_percent")
  fixedPrice        Int?         @map("fixed_price")
  minOrderAmount    Int?         @map("min_order_amount")
  maxDiscountAmount Int?         @map("max_discount_amount")

  // 적용 대상
  applicableTarget  ApplicableTarget @map("applicable_target")
  applicableItemIds Json?            @map("applicable_item_ids")

  // 발급 설정
  totalQuantity    Int? @map("total_quantity")
  issuedQuantity   Int  @default(0) @map("issued_quantity")
  maxIssuesPerUser Int? @map("max_issues_per_user")

  // 유효 기간
  validFrom  DateTime @map("valid_from") @db.DateTime(0)
  validUntil DateTime @map("valid_until") @db.DateTime(0)

  // 사용 기간 (발급 후 사용 가능 기간)
  usagePeriodDays Int? @map("usage_period_days")

  // 상태
  status CouponCampaignStatus @default(ACTIVE) @map("status")

  // 메타데이터
  metadata Json? @map("metadata")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  coupons Coupon[]

  @@index([status, validFrom, validUntil], map: "idx_campaign_status_valid")
  @@index([categoryId], map: "idx_campaign_category")
  @@map("coupon_campaigns")
}

/// 쿠폰 코드
model Coupon {
  id         Int            @id @default(autoincrement())
  campaignId Int            @map("campaign_id")
  campaign   CouponCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  code String @unique @map("code") @db.VarChar(64)

  // 발급 정보
  userId   Int?     @map("user_id")
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  issuedAt DateTime @default(now()) @map("issued_at") @db.DateTime(0)
  issuedBy String?  @map("issued_by") @db.VarChar(64)

  // 유효 기간
  validFrom  DateTime @map("valid_from") @db.DateTime(0)
  validUntil DateTime @map("valid_until") @db.DateTime(0)

  // 상태
  status CouponStatus @default(ISSUED) @map("status")

  // 사용 정보
  usedAt      DateTime? @map("used_at") @db.DateTime(0)
  usedOrderId Int?      @map("used_order_id")
  usedOrder   Order?    @relation("CouponUsedOrder", fields: [usedOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  redemptions CouponRedemption[]

  @@index([code], map: "idx_coupon_code")
  @@index([userId, status], map: "idx_coupon_user_status")
  @@index([campaignId, status], map: "idx_coupon_campaign_status")
  @@index([status, validUntil], map: "idx_coupon_status_valid")
  @@map("coupons")
}

/// 쿠폰 사용 이력
model CouponRedemption {
  id       Int    @id @default(autoincrement())
  couponId Int    @map("coupon_id")
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // 할인 정보 (스냅샷)
  discountAmount    Int @map("discount_amount")
  orderAmountBefore Int @map("order_amount_before")
  orderAmountAfter  Int @map("order_amount_after")

  // 상태
  status CouponRedemptionStatus @default(APPLIED) @map("status")

  // 취소 정보
  canceledAt   DateTime? @map("canceled_at") @db.DateTime(0)
  cancelReason String?   @map("cancel_reason") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([couponId, orderId], map: "uq_redemption_coupon_order")
  @@index([orderId], map: "idx_redemption_order")
  @@index([couponId], map: "idx_redemption_coupon")
  @@index([status], map: "idx_redemption_status")
  @@map("coupon_redemptions")
}

// ===================================
// OpenAPI developer platform domain
// ===================================

enum DeveloperStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ApplicationStatus {
  DEVELOPMENT
  REVIEW
  APPROVED
  SUSPENDED
  DELETED
}

enum ApiKeyEnvironment {
  LIVE
  TEST
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum QuotaTier {
  FREE
  UNPAID
  PRO
  ENTERPRISE
}

model Developer {
  id             BigInt          @id @default(autoincrement())
  melomingUserId BigInt?         @unique(map: "developers_meloming_user_id_unique") @map("meloming_user_id")
  email          String          @unique(map: "developers_email_unique") @db.VarChar(255)
  name           String          @db.VarChar(255)
  company        String?         @db.VarChar(255)
  status         DeveloperStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(0)

  applications Application[]

  @@map("developers")
}

model Application {
  id                BigInt            @id @default(autoincrement())
  clientId          String            @unique(map: "applications_client_id_unique") @map("client_id") @db.VarChar(64)
  name              String            @db.VarChar(255)
  description       String?           @db.Text
  websiteUrl        String?           @map("website_url") @db.VarChar(500)
  privacyPolicyUrl  String?           @map("privacy_policy_url") @db.VarChar(500)
  termsOfServiceUrl String?           @map("terms_of_service_url") @db.VarChar(500)
  logoUrl           String?           @map("logo_url") @db.VarChar(500)
  developerId       BigInt            @map("developer_id")
  status            ApplicationStatus @default(DEVELOPMENT)
  createdAt         DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.DateTime(0)

  developer    Developer     @relation(fields: [developerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  apiKeys      ApiKey[]
  oauthClients OAuthClient[]

  @@index([developerId], map: "idx_applications_developer_id")
  @@map("applications")
}

model QuotaPlan {
  id           BigInt    @id @default(autoincrement())
  name         String    @unique(map: "quota_plans_name_unique") @db.VarChar(50)
  tier         QuotaTier
  monthlyLimit Int       @map("monthly_limit")
  dailyLimit   Int?      @map("daily_limit")
  rateLimit    Int       @map("rate_limit")
  description  String?   @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  apiKeys ApiKey[]

  @@map("quota_plans")
}

model ApiKey {
  id                BigInt            @id @default(autoincrement())
  keyId             String            @unique(map: "api_keys_key_id_unique") @map("key_id") @db.VarChar(32)
  keyHash           String            @map("key_hash") @db.VarChar(64)
  keyPrefix         String            @map("key_prefix") @db.VarChar(12)
  name              String            @db.VarChar(255)
  environment       ApiKeyEnvironment
  applicationId     BigInt            @map("application_id")
  quotaPlanId       BigInt?           @map("quota_plan_id")
  status            ApiKeyStatus      @default(ACTIVE)
  expiresAt         DateTime?         @map("expires_at") @db.DateTime(0)
  lastUsedAt        DateTime?         @map("last_used_at") @db.DateTime(0)
  allowedIps        Json?             @map("allowed_ips")
  rateLimitOverride Int?              @map("rate_limit_override")
  createdAt         DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.DateTime(0)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quotaPlan   QuotaPlan?  @relation(fields: [quotaPlanId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([keyId], map: "idx_api_key_key_id")
  @@index([keyPrefix], map: "idx_api_key_prefix")
  @@map("api_keys")
}

model OAuthClient {
  id               BigInt   @id @default(autoincrement())
  clientId         String   @unique(map: "oauth_clients_client_id_unique") @map("client_id") @db.VarChar(64)
  clientSecretHash String   @map("client_secret_hash") @db.VarChar(64)
  name             String   @db.VarChar(255)
  grantTypes       Json?    @map("grant_types")
  redirectUris     Json?    @map("redirect_uris")
  allowedScopes    Json?    @map("allowed_scopes")
  applicationId    BigInt?  @map("application_id")
  accessTokenTtl   Int      @default(3600) @map("access_token_ttl")
  refreshTokenTtl  Int      @default(604800) @map("refresh_token_ttl")
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  application   Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  accessTokens  OAuthAccessToken[]
  refreshTokens OAuthRefreshToken[]

  @@index([clientId], map: "idx_oauth_client_client_id")
  @@map("oauth_clients")
}

model OAuthAccessToken {
  id        BigInt    @id @default(autoincrement())
  jti       String    @unique(map: "oauth_access_tokens_jti_unique") @db.VarChar(64)
  clientId  BigInt    @map("client_id")
  userId    BigInt?   @map("user_id")
  scopes    Json?     @db.Json
  revokedAt DateTime? @map("revoked_at") @db.DateTime(0)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([jti], map: "idx_access_token_jti")
  @@index([clientId], map: "idx_access_token_client_id")
  @@map("oauth_access_tokens")
}

model OAuthRefreshToken {
  id        BigInt    @id @default(autoincrement())
  token     String    @unique(map: "oauth_refresh_tokens_token_unique") @db.VarChar(64)
  clientId  BigInt    @map("client_id")
  userId    BigInt?   @map("user_id")
  scopes    String?   @db.Text
  revokedAt DateTime? @map("revoked_at") @db.DateTime(0)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([token], map: "idx_refresh_token_token")
  @@index([clientId], map: "idx_refresh_token_client_id")
  @@map("oauth_refresh_tokens")
}

model UsageRecord {
  id                  BigInt   @id @default(autoincrement())
  apiKeyId            String   @map("api_key_id") @db.VarChar(64)
  recordDate          DateTime @map("record_date") @db.Date
  recordMonth         String   @map("record_month") @db.VarChar(7)
  totalRequests       Int      @default(0) @map("total_requests")
  successfulRequests  Int      @default(0) @map("successful_requests")
  failedRequests      Int      @default(0) @map("failed_requests")
  rateLimitedRequests Int      @default(0) @map("rate_limited_requests")
  endpointBreakdown   Json?    @map("endpoint_breakdown")
  avgResponseTime     Float?   @map("avg_response_time")

  @@unique([apiKeyId, recordDate], map: "uk_usage_apikey_date")
  @@index([apiKeyId, recordMonth], map: "idx_usage_apikey_month")
  @@map("usage_records")
}

// ===================================
// OAuth Consent domain
// ===================================

model OAuthConsent {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  clientId        String    @map("client_id") @db.VarChar(64)
  applicationName String    @map("application_name") @db.VarChar(255)
  scopes          Json
  consentedAt     DateTime  @default(now()) @map("consented_at") @db.DateTime(0)
  revokedAt       DateTime? @map("revoked_at") @db.DateTime(0)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId], map: "uq_oauth_consent_user_client")
  @@index([userId], map: "idx_oauth_consent_user_id")
  @@index([clientId], map: "idx_oauth_consent_client_id")
  @@map("oauth_consents")
}

// ===================================
// Live Session & Song Request domain
// ===================================

/// 라이브 세션 상태
enum LiveSessionStatus {
  ACTIVE @map("active")
  ENDED  @map("ended")
  PAUSED @map("paused")
}

/// 라이브 세션 종류. STANDARD 는 기존 채널 단독 신청곡 세션,
/// SYNC 는 SyncRoom 전용 통합 대기열 세션이다.
enum LiveSessionType {
  STANDARD @map("standard")
  SYNC     @map("sync")
}

/// 노래방 영상 재생 방식
enum KaraokePlaybackMode {
  DIRECT  @map("direct")
  YOUTUBE @map("youtube")
}

/// 노래방/원곡 재생 영상 선택
enum KaraokeVideoType {
  KARAOKE  @map("karaoke")
  ORIGINAL @map("original")
}

/// 신청곡 상태
enum SongRequestStatus {
  PENDING   @map("pending")
  ACCEPTED  @map("accepted")
  REJECTED  @map("rejected")
  PLAYING   @map("playing")
  COMPLETED @map("completed")
}

/// 신청곡 소스
enum SongRequestSource {
  CHAT       @map("chat")
  DONATION   @map("donation")
  MANUAL     @map("manual")
  COMPETITOR @map("competitor")
}

/// 신청곡 타입 — NORMAL: 일반 신청, RANDOM: 신청 가능 풀에서 임의 1곡 추출
enum SongRequestType {
  NORMAL @map("normal")
  RANDOM @map("random")
}

/// 신청곡 허용 범위 모드
enum SongRequestMode {
  EVERYONE      @map("everyone")
  VERIFIED_ONLY @map("verified_only")
  CHAT_ONLY     @map("chat_only")
}

/// 신청곡 신청자 차단 범위
enum SongRequestUserBlockScope {
  CHANNEL @map("channel")
  GLOBAL  @map("global")
}

/// 신청곡 신청자 차단 대상 식별 방식
enum SongRequestUserBlockTargetType {
  USER      @map("user")
  PLATFORM  @map("platform")
  DI        @map("di")
  ANONYMOUS @map("anonymous")
}

/// 채널 유저 차단 적용 기능
enum ChannelUserBlockFeature {
  ALL              @map("all")
  SONG_REQUEST     @map("song_request")
  BOARD            @map("board")
  HOMEWORK_SONG    @map("homework_song")
  VOICE_COMMISSION @map("voice_commission")
  GIFT             @map("gift")
  TALK             @map("talk")
}

/// 가격 출처
enum PriceSource {
  SONG       @map("song")
  CATEGORY   @map("category")
  DIFFICULTY @map("difficulty")
  DEFAULT    @map("default")
  FREE       @map("free")
}

/// 오마카세 장부 증감 사유
enum OmakaseLedgerType {
  CHAT_PAID        @map("chat_paid")
  MANUAL_INCREMENT @map("manual_increment")
  MANUAL_DECREMENT @map("manual_decrement")
  MANUAL_SET       @map("manual_set")
  CONSUME_QUEUE    @map("consume_queue")
  CONSUME_PLAY_NOW @map("consume_play_now")
}

/// extract-job (clip 추출 batch) 처리 상태. 라이브 종료 직후 즉시 orchestrator
/// 호출 대신 pending 으로만 표시 → 6h CronJob 이 due-now list 일괄 처리 →
/// orchestrator 호출 후 processing → callback 받으면 completed.
enum LiveSessionExtractStatus {
  pending
  processing
  completed
  failed
}

enum OverlayPlaybackOutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  SUPERSEDED
  DEAD
}

/// 라이브 세션 (방송 세션)
model LiveSession {
  id                Int                @id @default(autoincrement())
  channelId         Int                @map("channel_id")
  userId            Int                @map("user_id")
  platform          StreamPlatform?
  platformChannelId String?            @map("platform_channel_id") @db.VarChar(64)
  status            LiveSessionStatus  @default(ACTIVE)
  sessionType       LiveSessionType    @default(STANDARD) @map("session_type")
  syncRoomId        Int?               @map("sync_room_id")
  /// 셋리스트 노출 가시성. PUBLIC = 채널 셋리스트 페이지 / 캘린더에 노출,
  /// PRIVATE = 채널 owner 의 setlist 관리 페이지에서만 보임. 채널 셋리스트와 캘린더의
  /// public 쿼리 (`getPublicSetlists`/`getPublicSetlistDetail`/`getPublicSetlistAvailability`) 는
  /// `visibility = PUBLIC` 만 통과시킨다.
  visibility        ScheduleVisibility @default(PUBLIC)
  overlayToken      String             @map("overlay_token") @db.VarChar(64)
  startedAt         DateTime           @default(now()) @map("started_at") @db.DateTime(0)
  endedAt           DateTime?          @map("ended_at") @db.DateTime(0)

  /// extract-job 처리 상태. 라이브 종료 webhook 핸들러가 즉시 orchestrator 호출
  /// 하지 않고 pending 으로 두면 6h CronJob batch endpoint 가 due-now list 일괄
  /// 처리. orchestrator API 호출 성공 후 processing, callback 도착 시 completed.
  extractStatus      LiveSessionExtractStatus @default(pending) @map("extract_status")
  /// `endedAt + 5min` 마진. 라이브 종료 직후 segment upload 완료 대기. batch
  /// SELECT 의 `<= NOW()` 조건과 함께 사용.
  extractScheduledAt DateTime?                @map("extract_scheduled_at") @db.DateTime(0)
  extractStartedAt   DateTime?                @map("extract_started_at") @db.DateTime(0)
  extractCompletedAt DateTime?                @map("extract_completed_at") @db.DateTime(0)

  /// competitor 폴링으로 생성된 세션의 외부 공연 식별자. null = 멜로밍 오버레이 세션.
  /// 폴러가 자신이 만든 competitor 세션 + 어느 공연인지 식별하는 데 사용.
  sourcePerformanceId Int? @map("source_performance_id")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  /// 오버레이 재생 스냅샷 순서 판정용 단조 증가 revision. snapshot-producing
  /// command (playNext/playNow/skip/status 변경/reorder/settings/session 등) 가
  /// 트랜잭션 안에서 { increment: 1 } 로 bump. client reducer 는
  /// (sessionEpoch = LiveSession.id, playbackRevision) 로 stale/out-of-order 이벤트 reject.
  /// expand-only: NOT NULL DEFAULT 0 이라 롤링 중 구 pod 의 INSERT 는 DB default 0 사용.
  playbackRevision Int @default(0) @map("playback_revision")

  channel                 Channel                  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncRoom                SyncRoom?                @relation(fields: [syncRoomId], references: [id], onDelete: SetNull)
  songRequests            SongRequest[]
  settings                LiveSessionSettings?
  donationLogs            DonationLog[]
  omakaseLedgerEntries    OmakaseLedgerEntry[]
  overlayPlaybackOutbox   OverlayPlaybackOutbox[]
  lyricsQuotaConsumptions LyricsQuotaConsumption[]

  @@index([channelId, status], map: "idx_live_session_channel_status")
  @@index([channelId, sessionType, status], map: "idx_live_session_channel_type_status")
  @@index([syncRoomId, sessionType, status], map: "idx_live_session_sync_room_type_status")
  @@index([channelId, status, visibility], map: "idx_live_session_channel_status_visibility")
  @@index([userId], map: "idx_live_session_user_id")
  @@index([overlayToken], map: "idx_live_session_overlay_token")
  @@index([platform, platformChannelId, status], map: "idx_live_session_platform_channel_status")
  @@index([extractStatus, extractScheduledAt], map: "idx_live_session_extract_status_scheduled")
  @@index([sourcePerformanceId], map: "idx_live_session_source_performance")
  @@map("live_sessions")
}

/// 신청곡 command와 같은 transaction에서 기록되는 durable playback publish intent.
/// full snapshot이나 raw overlay token은 저장하지 않고 ordering/audit 정보만 보관한다.
model OverlayPlaybackOutbox {
  id                 BigInt                      @id @default(autoincrement())
  liveSessionId      Int                         @map("live_session_id")
  sessionEpoch       Int                         @map("session_epoch")
  revision           Int
  commandType        String                      @map("command_type") @db.VarChar(64)
  commandId          String                      @map("command_id") @db.VarChar(64)
  causationRequestId Int?                        @map("causation_request_id")
  status             OverlayPlaybackOutboxStatus @default(PENDING)
  attempts           Int                         @default(0)
  availableAt        DateTime                    @default(now()) @map("available_at") @db.DateTime(0)
  lockedAt           DateTime?                   @map("locked_at") @db.DateTime(0)
  lockToken          String?                     @map("lock_token") @db.VarChar(64)
  lastError          String?                     @map("last_error") @db.Text
  emittedRevision    Int?                        @map("emitted_revision")
  publishedAt        DateTime?                   @map("published_at") @db.DateTime(0)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.DateTime(0)

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, revision], map: "overlay_playback_outbox_session_revision_key")
  @@index([status, availableAt, id], map: "idx_overlay_playback_outbox_status_available")
  @@index([liveSessionId, status], map: "idx_overlay_playback_outbox_session_status")
  @@map("overlay_playback_outbox")
}

/// 신청곡
model SongRequest {
  id              Int  @id @default(autoincrement())
  liveSessionId   Int  @map("live_session_id")
  songId          Int? @map("song_id")
  sourceChannelId Int? @map("source_channel_id")

  rawArtist  String  @map("raw_artist") @db.VarChar(255)
  rawTitle   String  @map("raw_title") @db.VarChar(255)
  rawMessage String? @map("raw_message") @db.Text

  requesterPlatformId String @map("requester_platform_id") @db.VarChar(64)
  requesterNickname   String @map("requester_nickname") @db.VarChar(255)

  status               SongRequestStatus @default(PENDING)
  source               SongRequestSource @default(CHAT)
  requestType          SongRequestType   @default(NORMAL) @map("request_type")
  donationAmount       Int?              @map("donation_amount")
  donationNativeAmount Int?              @map("donation_native_amount")
  donationCurrency     String?           @map("donation_currency")
  donationRateVersion  Int?              @map("donation_rate_version")
  streamMessageId      String?           @unique @map("stream_message_id") @db.VarChar(128)
  priority             Int               @default(0)
  queueOrder           Int               @default(0) @map("queue_order")

  // 가격 정보 스냅샷 (신청 시점의 계산된 가격)
  calculatedPrice Int?         @map("calculated_price")
  priceSource     PriceSource? @map("price_source")

  playedAt        DateTime? @map("played_at") @db.DateTime(0)
  completedAt     DateTime? @map("completed_at") @db.DateTime(0)
  rejectionReason String?   @map("rejection_reason") @db.VarChar(255)

  // recording-worker session-wide agent (gpt-5.5) 결과 — 클립 추출 후 라벨 정정
  // 검수용. agent 가 transcript + 가사 + 외부 검색으로 식별한 실제 곡명/아티스트.
  // raw_title/raw_artist 와 다르면 labelMismatch=true → admin 검수 큐로 노출.
  identifiedSong    String?   @map("identified_song") @db.VarChar(255)
  identifiedArtist  String?   @map("identified_artist") @db.VarChar(255)
  labelMismatch     Boolean   @default(false) @map("label_mismatch")
  // post-hoc gate 적용 후 confidence (자동 게시 판단 기준)
  clipConfidence    String?   @map("clip_confidence") @db.VarChar(16)
  // worker agent 의 gate 전 원본 confidence — false positive root cause 영구 추적용.
  clipConfidenceRaw String?   @map("clip_confidence_raw") @db.VarChar(16)
  clipReason        String?   @map("clip_reason") @db.VarChar(500)
  // worker ffprobe 로 측정한 mp4 실제 길이 (sec). chzzk live 메시지 시각 추정
  // (playedAt/completedAt 차이) 와 어긋날 수 있어 admin 검수 표시는 본 값 우선.
  clipDurationSec   Int?      @map("clip_duration_sec")
  // 자동 게시 시각 (auto_session_agent 가 생성한 Clip 이 ChannelClipSettings.autoClipEnabled=true 채널 페이지에 게시된 시각)
  clipPublishedAt   DateTime? @map("clip_published_at") @db.DateTime(0)
  // 어드민 반려 시각 — 게시 안 함 (미게시 → 반려) 또는 게시 취소 (게시됨 → 반려).
  // clipPublishedAt 와 동시 박힐 수 있음 (게시 후 취소). frontend 노출 차단은 Clip.status=DELETED 별도 처리.
  clipRejectedAt    DateTime? @map("clip_rejected_at") @db.DateTime(0)
  clipRejectReason  String?   @map("clip_reject_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  requestUserId Int?    @map("request_user_id")
  isAnonymous   Boolean @default(false) @map("is_anonymous")

  // 자동 게시된 Clip 의 FK. 멀티채널 콜라보 라이브 (멜로밍 싱크) 시 N개의 SongRequest
  // 가 같은 Clip 을 가리킬 수 있어 unique 제약 없음. 한 SongRequest 는 1개 Clip 에만 매핑.
  clipId Int? @map("clip_id")

  liveSession             LiveSession              @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  song                    Song?                    @relation(fields: [songId], references: [id], onDelete: SetNull)
  sourceChannel           Channel?                 @relation("SongRequestSourceChannel", fields: [sourceChannelId], references: [id], onDelete: SetNull)
  requestUser             User?                    @relation("userSongRequests", fields: [requestUserId], references: [id], onDelete: SetNull)
  clip                    Clip?                    @relation("SongRequestAutoClip", fields: [clipId], references: [id], onDelete: SetNull)
  omakaseLedgerEntries    OmakaseLedgerEntry[]
  lyricsQuotaConsumptions LyricsQuotaConsumption[]

  @@index([liveSessionId, status], map: "idx_song_request_session_status")
  @@index([liveSessionId, queueOrder], map: "idx_song_request_queue_order")
  @@index([sourceChannelId], map: "idx_song_request_source_channel")
  @@index([songId], map: "idx_song_request_song_id")
  @@index([songId, createdAt(sort: Desc)], map: "idx_song_request_song_created")
  @@index([liveSessionId, requesterPlatformId, status], map: "idx_song_request_session_requester_status")
  @@index([requestUserId], map: "idx_song_request_user_id")
  @@index([clipId], map: "idx_song_request_clip_id")
  @@map("song_requests")
}

/// 라이브 세션 설정
model LiveSessionSettings {
  id            Int @id @default(autoincrement())
  liveSessionId Int @unique @map("live_session_id")

  requestEnabled              Boolean             @default(true) @map("request_enabled")
  paused                      Boolean             @default(false) @map("paused")
  requestCommand              String              @default("!신청") @map("request_command") @db.VarChar(50)
  maxQueueSize                Int                 @default(50) @map("max_queue_size")
  donationPriorityEnabled     Boolean             @default(true) @map("donation_priority_enabled")
  enforceDonationMinimumPrice Boolean             @default(true) @map("enforce_donation_minimum_price")
  karaokePlaybackMode         KaraokePlaybackMode @default(DIRECT) @map("karaoke_playback_mode")
  karaokeVideoType            KaraokeVideoType    @default(KARAOKE) @map("karaoke_video_type")

  // 신청 방식 설정
  donationOnlyEnabled           Boolean         @default(false) @map("donation_only_enabled")
  requestMode                   SongRequestMode @default(EVERYONE) @map("request_mode")
  chatRequestEnabled            Boolean         @default(true) @map("chat_request_enabled")
  donationRequestEnabled        Boolean         @default(true) @map("donation_request_enabled")
  allowAnonymous                Boolean         @default(false) @map("allow_anonymous")
  requireSongMatch              Boolean         @default(true) @map("require_song_match")
  /// 랜덤 신청 허용 여부. true 면 `!랜덤신청` 채팅 명령과 웹/모바일 "랜덤신청" 버튼이 작동.
  /// false 면 dispatcher/back 진입 시 거부 (BadRequest). 기본 true.
  randomRequestEnabled          Boolean         @default(true) @map("random_request_enabled")
  /// Sync Live Session 전용: 참가 채팅방에서 일반 신청곡을 받을지 여부.
  syncChatRequestsEnabled       Boolean         @default(true) @map("sync_chat_requests_enabled")
  /// Sync Live Session 전용: 전체 참가 채널 노래책 기준 랜덤 곡 명령어.
  syncRandomSongCommand         String          @default("!노래랜덤") @map("sync_random_song_command") @db.VarChar(50)
  syncRandomSongMinDonation     Int             @default(100) @map("sync_random_song_min_donation")
  /// Sync Live Session 전용: 참가 스트리머 랜덤 선택 명령어.
  syncRandomStreamerCommand     String          @default("!스트리머랜덤") @map("sync_random_streamer_command") @db.VarChar(50)
  syncRandomStreamerMinDonation Int             @default(100) @map("sync_random_streamer_min_donation")

  // 신청 제한 설정
  preventDuplicateSongs Boolean @default(false) @map("prevent_duplicate_songs")
  blockedCategoryIds    Json    @default("[]") @map("blocked_category_ids")
  maxRequestsPerUser    Int     @default(0) @map("max_requests_per_user")
  maxTotalRequests      Int     @default(50) @map("max_total_requests")

  // 오버레이 표시 설정
  showRequesterName Boolean @default(true) @map("show_requester_name")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@map("live_session_settings")
}

/// 채널 단위 신청곡 설정 (2026-05-14 채널화 재설계 P0).
///
/// 기존 LiveSessionSettings 가 LiveSession 1:1 묶임 + createSession 의 prev 복제로 채널 단위
/// 환상을 만들던 prototype 패턴의 근본 결함을 해소. 라이브 비활성 상태에서도 토글 변경 가능.
///
/// LiveSessionSettings 는 라이브 한정 일시 상태(requestEnabled/paused) 만 남기는 방향으로
/// 점진 축소 예정. 본 모델 backfill 완료 후 별도 cycle 로 컬럼 drop.
model ChannelSongRequestSettings {
  id        Int @id @default(autoincrement())
  channelId Int @unique @map("channel_id")

  // 신청 명령어 + 큐
  requestCommand              String  @default("!신청") @map("request_command") @db.VarChar(50)
