/// 가사가 실제 존재(status=OK)한 신청곡의 최초 노출 ledger.
/// 콘솔/OBS 재연결과 중복 조회는 동일 channel/session/request 키로 재차감하지 않는다.
model LyricsQuotaConsumption {
  id              BigInt   @id @default(autoincrement())
  userId          Int      @map("user_id")
  channelId       Int      @map("channel_id")
  liveSessionId   Int      @map("live_session_id")
  songRequestId   Int      @map("song_request_id")
  windowStartedAt DateTime @map("window_started_at") @db.DateTime(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  songRequest SongRequest @relation(fields: [songRequestId], references: [id], onDelete: Cascade)

  @@unique([channelId, liveSessionId, songRequestId], map: "uq_lyrics_quota_consumption_context")
  @@index([userId, windowStartedAt], map: "idx_lyrics_quota_user_window")
  @@map("lyrics_quota_consumptions")
}

enum LyricsQuotaResetScope {
