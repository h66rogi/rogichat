# LOCAL ONLY. Replace placeholders; never commit the populated .env file.
APP_ENV=local
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=mysql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:13306/rogichat_local
DB_TLS_MODE=disabled
