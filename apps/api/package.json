{
  "name": "@rogichat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "prisma:generate": "prisma generate --config prisma.generate.config.ts",
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm prisma:generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev:api": "node --env-file=.env --watch dist/main.js",
    "dev:worker": "node --env-file=.env --watch dist/worker.js",
    "test:unit": "pnpm build && node --test test/unit/*.test.mjs",
    "test:e2e": "pnpm build && node --test test/e2e/*.test.mjs",
    "test:integration": "pnpm build && node test/run-mysql.mjs",
    "contracts:check": "pnpm build && node --test test/contracts/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1135.0",
    "@aws-sdk/s3-request-presigner": "3.1135.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "emoji-regex": "11.0.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "eslint": "10.10.0",
    "mysql2": "3.24.4",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
